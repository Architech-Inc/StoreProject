{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.Http": "Warning",
      "Microsoft.Extensions.Http.DefaultHttpClientFactory": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "_comment": "Set via env var ConnectionStrings__ControlPlane. Empty-password is rejected on startup.",
    "ControlPlane": "Server=localhost;Port=3306;Database=store_controlplane;User Id=root;Password=__REPLACE_ME__;AllowPublicKeyRetrieval=True;"
  },
  "ControlPlane": {
    "RootDomain": "store.example.com",
    "HttpsPort": 443,
    "HttpPort": 80,
    "AutoDeployDocker": false,
    "StoreApiImage": "ghcr.io/architech-inc/store-api:latest",
    "StoreUiImage": "ghcr.io/architech-inc/store-ui:latest",
    "UseHostMySql": false,
    "_comment": "MasterEncryptionKey MUST be supplied via env var ControlPlane__MasterEncryptionKey. Fallback values are rejected on startup.",
    "MasterEncryptionKey": "OVERRIDE_ME__MASTER_ENCRYPTION_KEY__MIN_32_CHARS",
    "WebhookSigningSecret": "OVERRIDE_ME__WEBHOOK_SIGNING_SECRET",
    "Provisioning": {
      "DefaultPlanTier": "Standard",
      "MaxConcurrentProvisions": 3
    }
  },
  "Payments": {
    "Flutterwave": {
      "PublicKey": "OVERRIDE_ME__FLWPUBK",
      "SecretKey": "OVERRIDE_ME__FLWSECK",
      "SecretHash": "OVERRIDE_ME__FLW_SECRET_HASH",
      "BaseUrl": "https://api.flutterwave.com/v3/"
    }
  }
}
