@page
@model StoreUI.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_LandingLayout";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <img src="~/images/clarkstore.png" alt="ClexAn Foods" class="auth-logo">
            <h2>Welcome Back</h2>
            <p>Sign in to your workspace</p>
        </div>

        @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
        {
            <div class="auth-error-banner" role="alert">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form method="post" id="loginForm" novalidate class="auth-form">
            @Html.AntiForgeryToken()
            
            <div class="form-group">
                <label for="inputUserName">Username</label>
                <input type="text" asp-for="Username" id="inputUserName" class="form-control" autocomplete="username" />
                <span id="inputError-0" class="field-validation-error"></span>
            </div>
            
            <div class="form-group">
                <label for="inputPassword">Password</label>
                <input type="password" asp-for="Password" id="inputPassword" class="form-control" autocomplete="current-password" />
                <span id="inputError-1" class="field-validation-error"></span>
                <div class="forgot-password-link">
                    <a href="/ForgotPassword">Forgot password?</a>
                </div>
            </div>

            <button type="submit" id="loginBtn" class="btn-primary-glow full-width">
                <span class="btn-text">Login</span>
            </button>
            
            <div class="auth-divider"><span>or</span></div>
            
            <button type="button" id="biometricBtn" class="btn-glass full-width" onclick="loginBiometrics()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 0 0-10 10v2a10 10 0 0 0 10 10 10 10 0 0 0 10-10v-2a10 10 0 0 0-10-10z"></path><path d="M12 6v6l4 2"></path></svg>
                <span class="btn-text" style="margin-left: 8px;">Sign in with Biometrics</span>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/webauthn.js" asp-append-version="true"></script>
    <script>
        (function () {
            const form = document.getElementById('loginForm');
            const usernameInput = document.getElementById('inputUserName');
            const passwordInput = document.getElementById('inputPassword');
            const usernameErr = document.getElementById('inputError-0');
            const passwordErr = document.getElementById('inputError-1');
            const loginBtn = document.getElementById('loginBtn');

            function validateUsername() {
                const val = usernameInput.value.trim();
                if (!val) {
                    usernameErr.textContent = 'Username is required.';
                    return false;
                }
                if (val.length < 3) {
                    usernameErr.textContent = 'Username must be at least 3 characters.';
                    return false;
                }
                usernameErr.textContent = '';
                return true;
            }

            function validatePassword() {
                const val = passwordInput.value;
                if (!val) {
                    passwordErr.textContent = 'Password is required.';
                    return false;
                }
                if (val.length < 8) {
                    passwordErr.textContent = 'Password must be at least 8 characters.';
                    return false;
                }
                passwordErr.textContent = '';
                return true;
            }

            usernameInput.addEventListener('input', validateUsername);
            passwordInput.addEventListener('input', validatePassword);

            form.addEventListener('submit', function (e) {
                const u = validateUsername();
                const p = validatePassword();
                if (!u || !p) {
                    e.preventDefault();
                } else {
                    // Update button state to loading
                    const btnText = loginBtn.querySelector('.btn-text');
                    btnText.textContent = 'Logging in...';
                    loginBtn.style.opacity = '0.7';
                    loginBtn.style.cursor = 'wait';
                }
            });
        })();
    </script>
}
