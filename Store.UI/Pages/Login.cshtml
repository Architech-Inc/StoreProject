@page
@model StoreUI.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClexAn Login</title>
    <link rel="icon" type="image/png" href="~/images/clarkstore.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/images/clarkstore.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="auth-page">
    <div id="welcomeView">
        <div class="viewNameSpace">
            <img src="~/images/clarkstore.png" alt="logo" class="ns-image">
        </div>

        <div id="avatarBox">
            <img src="~/images/admin.png" alt="avatar" id="avatar" />
            <span id="avatarText" class="avatarText" style="display: none;"></span>
        </div>

        @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
        {
            <p class="auth-error">@Model.ErrorMessage</p>
        }

        <div class="formArea">
            <form method="post" id="loginForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="formSection">
                    <label for="inputUserName">Username</label>
                    <input title="username" tabindex="0" type="text" asp-for="Username" id="inputUserName"
                           autocomplete="username" minlength="3" maxlength="100" />
                    <span id="inputError-0"></span>
                </div>
                <div class="formSection password-section">
                    <label for="inputPassword">Password</label>
                    <div class="password-input-wrapper">
                        <input title="password" type="password" asp-for="Password" id="inputPassword"
                               autocomplete="current-password" minlength="8" maxlength="128" />
                        <button type="button" id="togglePassword" class="password-toggle-btn" tabindex="-1">
                            <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                            </svg>
                        </button>
                    </div>
                    <span id="inputError-1"></span>
                </div>
                <div class="formSection LDiv">
                    <button type="submit" id="login">
                        <span id="loginText">Login</span>
                        <div id="loginSpinner" class="spinner" style="display: none;"></div>
                    </button>
                    <button type="button" id="biometricLogin" onclick="loginBiometrics()" class="btn-biometrics">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                            <path d="M11 6h2v6h-2zm0 8h2v2h-2z"/>
                            <!-- Replace with a more accurate fingerprint SVG if desired, using a generic icon for now -->
                        </svg>
                        Login with Biometrics
                    </button>
                </div>
                <p class="forgot_pass"><a href="/ForgotPassword">Forgot password?</a></p>
            </form>
        </div>
    </div>
</div>
<script src="~/js/webauthn.js" asp-append-version="true"></script>
<script>
    (function () {
        const form = document.getElementById('loginForm');
        const usernameInput = document.getElementById('inputUserName');
        const passwordInput = document.getElementById('inputPassword');
        const usernameErr = document.getElementById('inputError-0');
        const passwordErr = document.getElementById('inputError-1');

        function validateUsername() {
            const val = usernameInput.value.trim();
            if (!val) {
                usernameErr.textContent = 'Username is required.';
                return false;
            }
            if (val.length < 3) {
                usernameErr.textContent = 'Username must be at least 3 characters.';
                return false;
            }
            usernameErr.textContent = '';
            return true;
        }

        function validatePassword() {
            const val = passwordInput.value;
            if (!val) {
                passwordErr.textContent = 'Password is required.';
                return false;
            }
            if (val.length < 8) {
                passwordErr.textContent = 'Password must be at least 8 characters.';
                return false;
            }
            passwordErr.textContent = '';
            return true;
        }

        const eyeIcon = document.getElementById('eyeIcon');
        
        let typingTimer;
        const doneTypingInterval = 500;

        usernameInput.addEventListener('input', function() {
            validateUsername();
            clearTimeout(typingTimer);
            if (usernameInput.value.trim()) {
                typingTimer = setTimeout(fetchAvatar, doneTypingInterval);
            }
        });
        
        async function fetchAvatar() {
            const val = usernameInput.value.trim();
            if (val.length >= 3) {
                try {
                    const response = await fetch(`/api/auth/avatar/${encodeURIComponent(val)}`);
                    if (response.ok) {
                        const data = await response.json();
                        const avatarImg = document.getElementById('avatar');
                        const avatarText = document.getElementById('avatarText');
                        
                        if (data.data) {
                            avatarImg.src = data.data;
                            avatarText.textContent = val;
                            avatarText.style.display = 'block';
                        }
                    }
                } catch (e) {
                    console.error('Failed to fetch avatar', e);
                }
            }
        }

        const togglePassword = document.getElementById('togglePassword');
        togglePassword.addEventListener('click', function() {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            if (type === 'text') {
                eyeIcon.innerHTML = `<path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z"/><path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/><path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12-.708.708z"/>`;
            } else {
                eyeIcon.innerHTML = `<path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>`;
            }
        });

        form.addEventListener('submit', function (e) {
            const u = validateUsername();
            const p = validatePassword();
            if (!u || !p) {
                e.preventDefault();
            } else {
                document.getElementById('loginText').style.display = 'none';
                document.getElementById('loginSpinner').style.display = 'block';
                document.getElementById('login').disabled = true;
            }
        });
    })();
</script>
</body>
</html>
