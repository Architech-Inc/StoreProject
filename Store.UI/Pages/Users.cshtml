@page
@model StoreUI.Pages.UsersModel
@{
    ViewData["Title"] = "User Accounts & Security";
    ViewData["ActivePage"] = "Users";
    ViewData["PageDescription"] = "Manage system user credentials, security roles, session tokens, and identity lifecycle.";
    Layout = "~/Pages/Shared/_AppLayout.cshtml";
}

<div class="users-container">
    @* ── ACTION TOOLBAR ── *@
    <div class="users-action-bar">
        <div class="users-status-pill">
            <span class="status-indicator-dot"></span>
            <span>Security Identity &amp; Operator Access Governance</span>
        </div>
        <div class="users-header-actions">
            <a href="/ContactRequests" class="btn-users-action btn-users-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                </svg>
                Contact Requests
                @if (Model.PendingContactChangesCount > 0)
                {
                    <span class="badge-pill-alert">@Model.PendingContactChangesCount</span>
                }
            </a>
            <a href="/RoleMatrix" class="btn-users-action btn-users-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                Role Matrix
            </a>
            <button type="button" class="btn-users-action btn-users-primary" onclick="openCreateUserModal()">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
                Create User
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="users-alert @(Model.StatusMessage.StartsWith("Error") ? "error" : "ok")">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>@Model.StatusMessage</span>
        </div>
    }

    @* ── 4-CARD FLUENT 2.0 KPI GRID ── *@
    <div class="users-kpi-grid">
        @* KPI 1: Total Users *@
        <div class="users-kpi-card">
            <div class="kpi-icon-wrap kpi-emerald">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Registered Accounts</span>
                <span class="kpi-value">@Model.TotalUsers.ToString("N0") <small>Users</small></span>
                <span class="kpi-subtext">System personnel accounts</span>
            </div>
        </div>

        @* KPI 2: Active Operators *@
        <div class="users-kpi-card">
            <div class="kpi-icon-wrap kpi-teal">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Active Credentials</span>
                <span class="kpi-value text-emerald">@Model.ActiveUsersCount.ToString("N0") <small>Active</small></span>
                <span class="kpi-subtext">Operational login access</span>
            </div>
        </div>

        @* KPI 3: Suspended Accounts *@
        <div class="users-kpi-card">
            <div class="kpi-icon-wrap @(Model.SuspendedUsersCount > 0 ? "kpi-rose" : "kpi-emerald")">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Suspended Accounts</span>
                <span class="kpi-value" style="color:@(Model.SuspendedUsersCount > 0 ? "#e11d48" : "#059669");">
                    @Model.SuspendedUsersCount.ToString("N0") <small>Locked</small>
                </span>
                <span class="kpi-subtext">@(Model.SuspendedUsersCount > 0 ? "Access restricted by admin" : "No locked accounts")</span>
            </div>
        </div>

        @* KPI 4: Pending Contact Requests *@
        <div class="users-kpi-card">
            <div class="kpi-icon-wrap @(Model.PendingContactChangesCount > 0 ? "kpi-amber" : "kpi-purple")">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Contact Verification</span>
                <span class="kpi-value" style="color:@(Model.PendingContactChangesCount > 0 ? "#d97706" : "#7c3aed");">
                    @Model.PendingContactChangesCount.ToString("N0") <small>Pending</small>
                </span>
                <span class="kpi-subtext">@(Model.PendingContactChangesCount > 0 ? "Requests awaiting review" : "All requests approved")</span>
            </div>
        </div>
    </div>

    @* ── SEARCH & FILTER DOCK ── *@
    <div class="users-filter-dock">
        <form method="get" class="users-filter-form">
            <div class="filter-field">
                <label for="searchInput">Search User Accounts</label>
                <div style="display:flex; gap:8px;">
                    <input type="search" id="searchInput" name="search" value="@Model.SearchQuery" placeholder="Search by username, email..." class="form-control form-control-sm" />
                    <button type="submit" class="btn-filter-apply">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        Search
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                    {
                        <a href="/Users" class="btn-filter-clear">Clear</a>
                    }
                </div>
            </div>
        </form>
    </div>

    @* ── USERS TABLE PANEL ── *@
    <div class="users-panel">
        <div class="panel-header-dock">
            <div class="panel-title-wrap">
                <h3>User Accounts Directory</h3>
                <p>System operators, cashier terminals, and supervisory credentials.</p>
            </div>
        </div>

        @if (!Model.Users.Any())
        {
            <div class="users-empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                <h4>No Users Found</h4>
                <p>There are no operator records matching your search query.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th style="width:50px; text-align:center;">Avatar</th>
                            <th>Username &amp; Identity</th>
                            <th>Assigned Role</th>
                            <th style="text-align:center;">Account Status</th>
                            <th>Created Date</th>
                            <th style="text-align:right;">Security Controls</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td style="text-align:center;">
                                    @if (!string.IsNullOrEmpty(u.ThumbnailUrl))
                                    {
                                        <img src="@u.ThumbnailUrl" alt="@u.Username" class="user-avatar-img" onclick="openUserDrawer('@u.UserId')" />
                                    }
                                    else
                                    {
                                        <div class="user-avatar-placeholder" onclick="openUserDrawer('@u.UserId')">
                                            @(u.Username.Length > 0 ? u.Username[0].ToString().ToUpper() : "U")
                                        </div>
                                    }
                                </td>
                                <td>
                                    <strong class="user-name-link" onclick="openUserDrawer('@u.UserId')">@u.Username</strong>
                                    <span style="font-size:0.75rem; color:#64748b; display:block;">@(u.PrimaryEmail ?? "No email associated")</span>
                                </td>
                                <td>
                                    <span class="role-pill">
                                        @(u.RoleName ?? (u.RoleId == 1 ? "Admin" : u.RoleId == 2 ? "Manager" : "Cashier / Staff"))
                                    </span>
                                </td>
                                <td style="text-align:center;">
                                    @if (u.Status == Store.Models.Enums.UserStatus.Active)
                                    {
                                        <span class="status-badge status-reviewed">Active</span>
                                    }
                                    else if (u.Status == Store.Models.Enums.UserStatus.Suspended)
                                    {
                                        <span class="status-badge status-danger">Suspended</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">@u.Status</span>
                                    }
                                </td>
                                <td style="font-size:0.80rem; color:#64748b;">
                                    @u.DateCreated.ToString("dd MMM yyyy")
                                </td>
                                <td style="text-align:right;">
                                    <div style="display:inline-flex; gap:6px; align-items:center;">
                                        <button type="button" class="btn-ctrl-action" onclick="openEditUserModal('@u.UserId', '@Html.Raw(Html.Encode(u.Username))', '@Html.Raw(Html.Encode(u.PrimaryEmail ?? ""))', @u.RoleId, '@u.Status')">
                                            Edit
                                        </button>
                                        
                                        <form method="post" asp-page-handler="IssuePassword" style="margin:0; display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.UserId" />
                                            <button type="submit" class="btn-ctrl-action" data-confirm="Generate a temporary password for @u.Username?" data-confirm-type="warning">
                                                Reset Pwd
                                            </button>
                                        </form>

                                        @if (u.Status == Store.Models.Enums.UserStatus.Active)
                                        {
                                            <form method="post" asp-page-handler="Suspend" style="margin:0; display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@u.UserId" />
                                                <button type="submit" class="btn-ctrl-danger" data-confirm="Suspend user account @u.Username?" data-confirm-type="danger">
                                                    Suspend
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="users-pagination">
                    @if (Model.PageNumber > 1)
                    {
                        <a href="?page=@(Model.PageNumber - 1)&search=@Uri.EscapeDataString(Model.SearchQuery ?? "")" class="btn-page-ctrl">&larr; Previous</a>
                    }
                    <span class="page-current">Page @Model.PageNumber of @Model.TotalPages</span>
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a href="?page=@(Model.PageNumber + 1)&search=@Uri.EscapeDataString(Model.SearchQuery ?? "")" class="btn-page-ctrl">Next &rarr;</a>
                    }
                </div>
            }
        }
    </div>
</div>

@* ── CREATE / EDIT USER MODAL ── *@
<div class="custom-modal-overlay" id="userModalOverlay" onclick="closeUserModal()"></div>
<div class="custom-modal" id="userModal">
    <div class="custom-modal-header">
        <h3 id="userModalTitle">Create User Account</h3>
        <button type="button" class="btn-close-modal" onclick="closeUserModal()">&times;</button>
    </div>
    <form method="post" asp-page-handler="Create" enctype="multipart/form-data" id="userForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="EditUserId" id="modalEditUserId" />
        <input type="hidden" asp-for="CropX" id="modalCropX" />
        <input type="hidden" asp-for="CropY" id="modalCropY" />
        <input type="hidden" asp-for="CropW" id="modalCropW" />
        <input type="hidden" asp-for="CropH" id="modalCropH" />

        <div class="custom-modal-body">
            <div class="form-group">
                <label asp-for="NewUsername" class="form-label">Username <span class="text-danger">*</span></label>
                <input asp-for="NewUsername" id="modalUsername" class="form-control" placeholder="e.g. jdoe" required maxlength="100" />
            </div>

            <div class="form-group" id="emailGroup">
                <label asp-for="NewEmail" class="form-label">Email Address <span class="text-danger">*</span></label>
                <input asp-for="NewEmail" id="modalEmail" type="email" class="form-control" placeholder="e.g. jdoe@clexanfoods.cm" maxlength="200" />
            </div>

            <div class="form-group" id="passwordGroup">
                <label asp-for="NewPassword" class="form-label">Initial Password <span class="text-danger">*</span></label>
                <input asp-for="NewPassword" id="modalPassword" type="password" class="form-control" placeholder="Minimum 8 characters" />
            </div>

            <div class="form-group">
                <label asp-for="NewRoleId" class="form-label">System Role <span class="text-danger">*</span></label>
                <select asp-for="NewRoleId" id="modalRoleId" class="form-control" required>
                    <option value="1">Admin</option>
                    <option value="2">Manager</option>
                    <option value="3" selected>Cashier / Staff</option>
                </select>
            </div>

            <div class="form-group" id="statusGroup" style="display:none;">
                <label asp-for="NewStatus" class="form-label">Account Status</label>
                <select asp-for="NewStatus" id="modalStatus" class="form-control">
                    <option value="Active">Active</option>
                    <option value="Suspended">Suspended</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Profile Avatar Image</label>
                <input type="file" asp-for="ImageUpload" id="modalImageUpload" class="form-control" accept="image/*" />
            </div>
        </div>
        <div class="custom-modal-footer">
            <button type="button" class="btn-users-action btn-users-secondary" onclick="closeUserModal()">Cancel</button>
            <button type="submit" class="btn-users-action btn-users-primary" id="btnSubmitUser">Save User</button>
        </div>
    </form>
</div>

@* ── USER 360 INSPECTOR DRAWER ── *@
<div class="drawer-overlay" id="userDrawerOverlay" onclick="closeUserDrawer()"></div>
<div class="drawer" id="userDrawer">
    <div class="drawer-header">
        <div class="drawer-title-wrap">
            <h3 id="drawerUsername">User Profile</h3>
            <p>Identity details, security tokens, and activity profile.</p>
        </div>
        <button type="button" class="btn-close-drawer" onclick="closeUserDrawer()">&times;</button>
    </div>
    <div class="drawer-body" id="drawerContent">
        <div class="drawer-loading">
            <svg class="spin-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <circle cx="12" cy="12" r="10" stroke-width="3" stroke-dasharray="32" stroke-linecap="round"></circle>
            </svg>
            <p>Loading operator profile…</p>
        </div>
    </div>
</div>

@* ── JAVASCRIPT INTERACTIONS ── *@
@section Scripts {
    <script>
        function openCreateUserModal() {
            document.getElementById('userModalTitle').textContent = 'Create User Account';
            document.getElementById('modalEditUserId').value = '';
            document.getElementById('modalUsername').value = '';
            document.getElementById('modalEmail').value = '';
            document.getElementById('modalPassword').value = '';
            document.getElementById('modalRoleId').value = '3';
            document.getElementById('emailGroup').style.display = 'block';
            document.getElementById('passwordGroup').style.display = 'block';
            document.getElementById('statusGroup').style.display = 'none';
            document.getElementById('btnSubmitUser').textContent = 'Create Account';

            document.getElementById('userModalOverlay').style.display = 'block';
            document.getElementById('userModal').style.display = 'block';
        }

        function openEditUserModal(userId, username, email, roleId, status) {
            document.getElementById('userModalTitle').textContent = 'Edit User: ' + username;
            document.getElementById('modalEditUserId').value = userId;
            document.getElementById('modalUsername').value = username;
            document.getElementById('modalEmail').value = email;
            document.getElementById('modalRoleId').value = roleId;
            document.getElementById('modalStatus').value = status;
            document.getElementById('emailGroup').style.display = 'none';
            document.getElementById('passwordGroup').style.display = 'none';
            document.getElementById('statusGroup').style.display = 'block';
            document.getElementById('btnSubmitUser').textContent = 'Save Changes';

            document.getElementById('userModalOverlay').style.display = 'block';
            document.getElementById('userModal').style.display = 'block';
        }

        function closeUserModal() {
            document.getElementById('userModalOverlay').style.display = 'none';
            document.getElementById('userModal').style.display = 'none';
        }

        async function openUserDrawer(userId) {
            const overlay = document.getElementById('userDrawerOverlay');
            const drawer = document.getElementById('userDrawer');
            const content = document.getElementById('drawerContent');
            const title = document.getElementById('drawerUsername');

            overlay.style.display = 'block';
            drawer.style.display = 'flex';
            content.innerHTML = `
                <div class="drawer-loading">
                    <svg class="spin-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <circle cx="12" cy="12" r="10" stroke-width="3" stroke-dasharray="32" stroke-linecap="round"></circle>
                    </svg>
                    <p>Loading operator profile…</p>
                </div>
            `;

            try {
                const res = await fetch(`/Users?handler=UserDrawer&id=${userId}`);
                if (!res.ok) throw new Error('Could not load user profile.');
                const u = await res.json();

                title.textContent = u.username;
                content.innerHTML = `
                    <div style="display:flex; flex-direction:column; gap:16px;">
                        <div style="display:flex; align-items:center; gap:16px; padding-bottom:16px; border-bottom:1px solid #e2e8f0;">
                            ${u.thumbnailUrl ? `<img src="${u.thumbnailUrl}" style="width:64px;height:64px;border-radius:50%;object-fit:cover;" />` : `<div class="user-avatar-placeholder" style="width:64px;height:64px;font-size:1.5rem;">${u.username[0].toUpperCase()}</div>`}
                            <div>
                                <h4 style="margin:0; font-size:1.15rem; color:#0f172a;">${u.username}</h4>
                                <span class="role-pill" style="margin-top:4px; display:inline-block;">${u.roleName ?? 'Standard User'}</span>
                            </div>
                        </div>
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                            <div>
                                <span style="font-size:0.75rem; color:#64748b; font-weight:600; text-transform:uppercase;">User ID</span>
                                <p style="margin:2px 0 0 0; font-family:'JetBrains Mono', monospace; font-size:0.80rem; color:#0f172a;">${u.userId.substring(0,8)}…</p>
                            </div>
                            <div>
                                <span style="font-size:0.75rem; color:#64748b; font-weight:600; text-transform:uppercase;">Account Status</span>
                                <p style="margin:2px 0 0 0;"><span class="status-badge ${u.status === 0 || u.status === 'Active' ? 'status-reviewed' : 'status-danger'}">${u.status}</span></p>
                            </div>
                            <div style="grid-column: span 2;">
                                <span style="font-size:0.75rem; color:#64748b; font-weight:600; text-transform:uppercase;">Email</span>
                                <p style="margin:2px 0 0 0; font-size:0.85rem; color:#0f172a;">${u.email ?? '—'}</p>
                            </div>
                            <div style="grid-column: span 2;">
                                <span style="font-size:0.75rem; color:#64748b; font-weight:600; text-transform:uppercase;">Phone</span>
                                <p style="margin:2px 0 0 0; font-size:0.85rem; color:#0f172a;">${u.phoneNumber ?? '—'}</p>
                            </div>
                            <div>
                                <span style="font-size:0.75rem; color:#64748b; font-weight:600; text-transform:uppercase;">Created Date</span>
                                <p style="margin:2px 0 0 0; font-size:0.85rem; color:#0f172a;">${new Date(u.dateCreated).toLocaleDateString()}</p>
                            </div>
                            <div>
                                <span style="font-size:0.75rem; color:#64748b; font-weight:600; text-transform:uppercase;">Two-Factor Auth</span>
                                <p style="margin:2px 0 0 0; font-size:0.85rem; color:#0f172a;">${u.isTwoFactorEnabled ? 'Enabled' : 'Disabled'}</p>
                            </div>
                        </div>
                        <div style="margin-top:16px; padding-top:16px; border-top:1px solid #e2e8f0; display:flex; flex-direction:column; gap:8px;">
                            <form method="post" asp-page-handler="RevokeSessions" style="margin:0;">
                                <input type="hidden" name="userId" value="${u.userId}" />
                                <button type="submit" class="btn-ctrl-danger" style="width:100%; text-align:center; padding:8px;" data-confirm="Revoke all active sessions for ${u.username}?" data-confirm-type="danger">
                                    Revoke All Active Sessions
                                </button>
                            </form>
                        </div>
                    </div>
                `;
            } catch (err) {
                content.innerHTML = `<div class="users-alert error" style="margin-top:20px;"><span>Failed to load profile.</span></div>`;
            }
        }

        function closeUserDrawer() {
            document.getElementById('userDrawerOverlay').style.display = 'none';
            document.getElementById('userDrawer').style.display = 'none';
        }
    </script>
}
