@page
@model StoreUI.Pages.UsersModel
@{
    ViewData["Title"] = "User Accounts";
    ViewData["ActivePage"] = "Users";
    ViewData["PageDescription"] = "Manage system user accounts, roles, and account status.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
}

<div class="ops-page">

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="status @(Model.StatusMessage.StartsWith("Error") ? "error" : "ok")">@Model.StatusMessage</div>
    }

    <div class="filter-bar" style="margin-bottom: 24px; justify-content: space-between;">
        <form method="get" class="filter-row">
            <div class="filter-group">
                <label>Search Users:</label>
                <div style="display:flex; gap:8px;">
                    <input type="search" name="search" value="@Model.SearchQuery" placeholder="Username or email..." />
                    <button type="submit" class="button-secondary">Search</button>
                </div>
            </div>
        </form>
        <div style="display:flex; gap:8px;">
            <a href="/ContactRequests" class="button-secondary" style="text-decoration: none;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg> Contact Requests
                @if (Model.PendingContactChangesCount > 0)
                {
                    <span class="badge badge-info" style="margin-left: 6px; background:#d97706; color:white;">@Model.PendingContactChangesCount</span>
                }
            </a>
            <button class="button-secondary" type="button" data-open-blade="settingsBlade" onclick="loadSettings()">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="margin-right:4px;">
                    <path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492zM5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0z"/>
                    <path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52l-.094-.319zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.377l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115l.094-.319z"/>
            </button>
            <button class="button-primary" type="button" data-open-blade="userBlade">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="margin-right:4px;">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                </svg> New User
            </button>
        </div>
    </div>

    <section class="card" style="padding:0; overflow:hidden;">
        @if (!Model.Users.Any())
        {
            <div class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                <h4>No Users Found</h4>
                <p>There are no records matching your criteria.</p>
            </div>
        }
        else
        {
            <div class="table-wrap" style="margin:0; border:none; border-radius:0;">
                <table>
                    <thead>
                        <tr>
                            <th>Avatar</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(u.ThumbnailUrl))
                                    {
                                        <img src="@u.ThumbnailUrl" alt="Avatar" style="width:32px;height:32px;border-radius:50%;object-fit:cover;cursor:pointer;" onclick="viewImage('@(u.FullImageUrl ?? u.ThumbnailUrl)')" />
                                    }
                                    else
                                    {
                                        <div style="width:32px;height:32px;border-radius:50%;background-color:var(--ops-border);display:inline-block;"></div>
                                    }
                                <td>
                                    <strong style="cursor:pointer;color:var(--brand, #019c01);" onclick="openUserDrawer('@u.UserId')">@u.Username</strong>
                                </td>
                                <td>
                                    @if (u.Status == Store.Models.Enums.UserStatus.Active)
                                    {
                                        <span class="badge badge-green">Active</span>
                                    }
                                    else if (u.Status == Store.Models.Enums.UserStatus.Suspended)
                                    {
                                        <span class="badge badge-red">Suspended</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-gray">@u.Status</span>
                                    }
                                </td>
                                <td>@u.DateCreated.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div style="display:flex; gap:4px; flex-wrap:nowrap;">
                                        <button type="button" class="button-secondary" onclick="openEdit(@System.Text.Json.JsonSerializer.Serialize(new { userId = u.UserId, username = u.Username, roleId = u.RoleId, status = u.Status.ToString() }))">Edit</button>
                                        
                                        <form method="post" asp-page-handler="IssuePassword" style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.UserId" />
                                            <button type="submit" class="button-secondary" data-confirm="Issue a temporary password for @u.Username?" data-confirm-type="warning">Issue Pwd</button>
                                        </form>

                                        @if (u.Status == Store.Models.Enums.UserStatus.Active)
                                        {
                                            <form method="post" asp-page-handler="Suspend" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@u.UserId" />
                                                <button type="submit" class="button-command danger" data-confirm="Suspend account @u.Username?" data-confirm-type="warning">Suspend</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div style="padding:16px;">
                    <nav class="pagination" aria-label="User pages">
                        @if (Model.PageNumber > 1)
                        {
                            <a href="?page=@(Model.PageNumber - 1)&search=@Uri.EscapeDataString(Model.SearchQuery ?? "")">‹ Prev</a>
                        }
                        <span class="active">@Model.PageNumber / @Model.TotalPages</span>
                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <a href="?page=@(Model.PageNumber + 1)&search=@Uri.EscapeDataString(Model.SearchQuery ?? "")">Next ›</a>
                        }
                    </nav>
                </div>
            }
        }
    </section>
</div>

<!-- ── Create/Edit User Blade ────────────────────────────────── -->
<div class="blade-overlay" id="userBladeOverlay"></div>
<div class="blade" id="userBlade" data-overlay-id="userBladeOverlay">
    <div class="blade-header">
        <h3 id="userBladeTitle">New User</h3>
        <button type="button" class="btn-close" data-close-blade="userBlade" aria-label="Close">×</button>
    </div>
    <div class="blade-body">
        <form method="post" asp-page-handler="Create" id="userForm" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="EditUserId" id="editUserId" />

            <div class="form-grid" style="grid-template-columns: 1fr;">
                <div>
                    <label for="usernameField">Username <span style="color:var(--ops-danger);">*</span></label>
                    <input asp-for="NewUsername" id="usernameField" required minlength="3" maxlength="100" autocomplete="off" />
                </div>

                <div id="createFields" class="form-grid" style="grid-template-columns: 1fr; gap: inherit;">
                    <div>
                        <label for="emailField">Email <span style="color:var(--ops-danger);">*</span></label>
                        <input asp-for="NewEmail" id="emailField" type="email" />
                    </div>
                    <div>
                        <label for="passwordField">Password <span style="color:var(--ops-danger);">*</span></label>
                        <input asp-for="NewPassword" id="passwordField" type="password" minlength="8" maxlength="128" />
                    </div>
                </div>

                <div>
                    <label for="roleField">Role <span style="color:var(--ops-danger);">*</span></label>
                    <select asp-for="NewRoleId" id="roleField">
                        <option value="1">Admin</option>
                        <option value="2">Manager</option>
                        <option value="3">Cashier</option>
                    </select>
                </div>

                <div id="statusRow" style="display:none;">
                    <label for="statusField">Status</label>
                    <select asp-for="NewStatus" id="statusField">
                        <option value="Active">Active</option>
                        <option value="Suspended">Suspended</option>
                    </select>
                </div>
                
                <div style="margin-top:16px;">
                    <label for="imageUpload">Avatar</label>
                    <input type="file" asp-for="ImageUpload" id="imageUpload" accept="image/*" data-crop="true" />
                </div>
            </div>        </form>
    </div>
    <div class="blade-footer">
        <button type="button" class="button-secondary" data-close-blade="userBlade">Cancel</button>
        <button type="submit" form="userForm" class="button-primary" id="submitBtn">Create User</button>
    </div>
</div>

<!-- ── Security Settings Blade ────────────────────────────────── -->
<div class="blade-overlay" id="settingsBladeOverlay"></div>
<div class="blade" id="settingsBlade" data-overlay-id="settingsBladeOverlay">
    <div class="blade-header">
        <h3>Security Settings</h3>
        <button type="button" class="btn-close" data-close-blade="settingsBlade" aria-label="Close">×</button>
    </div>
    <div class="blade-body">
        <form id="settingsForm" onsubmit="saveSettings(event)">
            <div class="form-grid" style="grid-template-columns: 1fr;">
                <div>
                    <label for="recoveryMethodField">Password Recovery Method</label>
                    <p style="font-size: 12px; color: var(--ops-gray); margin: 0 0 8px 0;">Controls which methods users can use to recover passwords.</p>
                    <select id="recoveryMethodField" required>
                        <option value="Both">Both (OTP & Temp Password)</option>
                        <option value="OTP">OTP Only</option>
                        <option value="TempPassword">Temp Password Only</option>
                    </select>
                </div>
            </div>
            <div id="settingsAlert" class="status" style="display:none; margin-top:16px;"></div>
        </form>
    </div>
    <div class="blade-footer">
        <button type="button" class="button-secondary" data-close-blade="settingsBlade">Cancel</button>
        <button type="submit" form="settingsForm" class="button-primary" id="saveSettingsBtn">Save Settings</button>
    </div>
</div>

<!-- ── User 360 Slide-Over Drawer ───────────────────────────── -->
<div class="crm-drawer-backdrop" id="userDrawerBackdrop" onclick="closeUserDrawer()"></div>
<aside class="crm-drawer" id="userDrawer" aria-label="User 360 Profile">
    <div class="crm-drawer-header">
        <div style="display:flex;gap:14px;align-items:center;">
            <div class="drawer-avatar" id="drawerUserInitials" style="width:48px;height:48px;border-radius:50%;background:#e5e7eb;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:1.2rem;">--</div>
            <div>
                <h3 id="drawerUsername" style="margin:0 0 4px 0;font-size:1.25rem;">Username</h3>
                <span id="drawerRoleBadge" class="badge badge-blue">Role</span>
                <span id="drawerStatusBadge" class="badge badge-green">Active</span>
            </div>
        </div>
        <button type="button" class="drawer-close-btn" onclick="closeUserDrawer()" title="Close Drawer">&times;</button>
    </div>

    <!-- Quick Actions -->
    <div style="padding:16px; display:flex; gap:8px; border-bottom:1px solid var(--border);">
        <button type="button" class="button-primary" style="flex:1;" onclick="alert('Manage settings not implemented')">Manage Settings</button>
        <form method="post" asp-page-handler="RevokeSessions" style="flex:1; margin:0; display:flex;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" id="revokeSessionsUserId" />
            <button type="submit" class="button-secondary" style="flex:1; width:100%;" id="drawerRevokeSessionsBtn" data-confirm="Revoke all active sessions for this user?" data-confirm-type="warning">Revoke Sessions</button>
        </form>
    </div>

    <div class="drawer-nav-tabs">
        <button type="button" class="drawer-tab-btn active" onclick="switchUserTab(event, 'tabUserOverview')">Overview</button>
        <button type="button" class="drawer-tab-btn" onclick="switchUserTab(event, 'tabUserActivity')">Activity Log</button>
        <button type="button" class="drawer-tab-btn" onclick="switchUserTab(event, 'tabUserChanges')">Contact Changes</button>
        <button type="button" class="drawer-tab-btn" onclick="switchUserTab(event, 'tabUserSessions')">Active Sessions</button>
    </div>

    <div class="crm-drawer-body">
        <!-- Tab 1: Overview -->
        <div id="tabUserOverview" class="drawer-tab-content active" style="display:block;">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
                <div style="background:var(--canvas); padding:16px; border-radius:8px; border:1px solid var(--border);">
                    <div style="font-size:0.85rem; color:var(--text-secondary); margin-bottom:4px;">Date Created</div>
                    <div id="drawerDateCreated" style="font-weight:600;">--</div>
                </div>
                <div style="background:var(--canvas); padding:16px; border-radius:8px; border:1px solid var(--border);">
                    <div style="font-size:0.85rem; color:var(--text-secondary); margin-bottom:4px;">2FA Status</div>
                    <div id="drawer2FAStatus" style="font-weight:600;">--</div>
                </div>
            </div>

            <h4>Contact Details</h4>
            <div style="background:var(--canvas); padding:16px; border-radius:8px; border:1px solid var(--border); margin-bottom:16px;">
                <div style="margin-bottom:8px;"><strong>Email:</strong> <span id="drawerEmail">--</span></div>
                <div><strong>Phone:</strong> <span id="drawerPhone">--</span></div>
            </div>

            <h4>Linked Employee</h4>
            <div id="drawerLinkedEmployee" style="background:var(--canvas); padding:16px; border-radius:8px; border:1px solid var(--border);">
                <span style="color:var(--text-secondary);">No linked employee.</span>
            </div>
        </div>

        <!-- Tab 2: Activity Log -->
        <div id="tabUserActivity" class="drawer-tab-content" style="display:none;">
            <div id="drawerActivityList" style="display:flex; flex-direction:column; gap:8px;">
                <div style="text-align:center; color:var(--text-secondary); padding:20px;">No recent activity.</div>
            </div>
        </div>

        <!-- Tab 3: Contact Changes -->
        <div id="tabUserChanges" class="drawer-tab-content" style="display:none;">
            <div id="drawerChangesList" style="display:flex; flex-direction:column; gap:8px;">
                <div style="text-align:center; color:var(--text-secondary); padding:20px;">No pending contact changes.</div>
            </div>
        </div>

        <!-- Tab 4: Active Sessions -->
        <div id="tabUserSessions" class="drawer-tab-content" style="display:none;">
            <div id="drawerSessionsList" style="display:flex; flex-direction:column; gap:8px;">
                <div style="text-align:center; color:var(--text-secondary); padding:20px;">No active sessions.</div>
            </div>
        </div>
    </div>
</aside>

@section Scripts {
        document.addEventListener('DOMContentLoaded', () => {
            const openNewBtn = document.querySelector('[data-open-blade="userBlade"]');
            const blade = document.getElementById('userBlade');
            const overlay = document.getElementById('userBladeOverlay');
            
            const emailField = document.getElementById('emailField');
            const passwordField = document.getElementById('passwordField');

            function openCreate() {
                document.getElementById('userBladeTitle').textContent = 'New User';
                document.getElementById('editUserId').value = '';
                document.getElementById('usernameField').value = '';
                emailField.value = '';
                passwordField.value = '';
                document.getElementById('roleField').value = '3';
                
                // Show create fields and require them
                document.getElementById('createFields').style.display = '';
                emailField.required = true;
                passwordField.required = true;
                
                document.getElementById('statusRow').style.display = 'none';
                document.getElementById('submitBtn').textContent = 'Create User';
                
                blade.classList.add('open');
                overlay.classList.add('open');
            }

            if (openNewBtn && blade && overlay) {
                openNewBtn.addEventListener('click', openCreate);
            }

            // Expose openEdit to window so onclick can call it
            window.openEdit = function(data) {
                document.getElementById('userBladeTitle').textContent = 'Edit User';
                document.getElementById('editUserId').value = data.userId;
                document.getElementById('usernameField').value = data.username;
                document.getElementById('roleField').value = data.roleId;
                document.getElementById('statusField').value = data.status;
                
                // Hide create fields and remove required
                document.getElementById('createFields').style.display = 'none';
                emailField.required = false;
                passwordField.required = false;
                
                document.getElementById('statusRow').style.display = '';
                document.getElementById('submitBtn').textContent = 'Save Changes';
                
                blade.classList.add('open');
                overlay.classList.add('open');
            };

            // Security Settings Logic
            const settingsBlade = document.getElementById('settingsBlade');
            const settingsOverlay = document.getElementById('settingsBladeOverlay');
            
            window.loadSettings = async function() {
                try {
                    const response = await fetch('/api/settings/Auth:PasswordRecoveryMethod');
                    if (response.ok) {
                        const result = await response.json();
                        document.getElementById('recoveryMethodField').value = result.data || 'Both';
                    }
                    settingsBlade.classList.add('open');
                    settingsOverlay.classList.add('open');
                } catch (e) {
                    console.error('Failed to load settings', e);
                }
            };

            window.saveSettings = async function(e) {
                e.preventDefault();
                const btn = document.getElementById('saveSettingsBtn');
                const alertBox = document.getElementById('settingsAlert');
                btn.disabled = true;
                btn.textContent = 'Saving...';
                
                try {
                    const method = document.getElementById('recoveryMethodField').value;
                    const response = await fetch('/api/settings/Auth:PasswordRecoveryMethod', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ value: method })
                    });
                    
                    const result = await response.json();
                    if (response.ok) {
                        alertBox.className = 'status ok';
                        alertBox.textContent = result.message || 'Settings saved successfully.';
                        alertBox.style.display = 'block';
                        setTimeout(() => {
                            settingsBlade.classList.remove('open');
                            settingsOverlay.classList.remove('open');
                            alertBox.style.display = 'none';
                        }, 1500);
                    } else {
                        throw new Error(result.error?.message || 'Failed to save');
                    }
                } catch (err) {
                    alertBox.className = 'status error';
                    alertBox.textContent = err.message;
                    alertBox.style.display = 'block';
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Save Settings';
                }
            };
        });
        // User 360 Drawer Logic
        async function openUserDrawer(userId) {
            const backdrop = document.getElementById('userDrawerBackdrop');
            const drawer = document.getElementById('userDrawer');
            
            // Show loading state (optional: reset fields)
            document.getElementById('drawerUsername').textContent = 'Loading...';
            document.getElementById('drawerUserInitials').textContent = '--';
            document.getElementById('drawerRoleBadge').textContent = '...';
            document.getElementById('drawerStatusBadge').textContent = '...';
            
            backdrop.classList.add('active');
            drawer.classList.add('active');
            
            try {
                const response = await fetch(`?handler=UserDrawer&id=${userId}`);
                if (response.ok) {
                    const data = await response.json();
                    const profile = data.profile;
                    
                    // Header
                    document.getElementById('revokeSessionsUserId').value = userId;
                    document.getElementById('drawerUsername').textContent = profile.username;
                    document.getElementById('drawerUserInitials').textContent = profile.username.substring(0, 2).toUpperCase();
                    
                    const roleBadge = document.getElementById('drawerRoleBadge');
                    roleBadge.textContent = profile.roleName || 'Unknown';
                    
                    const statusBadge = document.getElementById('drawerStatusBadge');
                    statusBadge.textContent = profile.status === 1 ? 'Active' : (profile.status === 2 ? 'Suspended' : 'Deleted');
                    statusBadge.className = 'badge ' + (profile.status === 1 ? 'badge-green' : 'badge-red');
                    
                    // Overview Tab
                    document.getElementById('drawerDateCreated').textContent = new Date(profile.dateCreated).toLocaleDateString();
                    document.getElementById('drawer2FAStatus').textContent = profile.twoFactorEnabled ? 'Enabled' : 'Disabled';
                    document.getElementById('drawerEmail').textContent = profile.primaryEmail || 'None';
                    document.getElementById('drawerPhone').textContent = profile.primaryPhone || 'None';
                    
                    // Linked Employee
                    const linkedEmpDiv = document.getElementById('drawerLinkedEmployee');
                    if (data.linkedEmployee) {
                        linkedEmpDiv.innerHTML = `
                            <div style="margin-bottom:4px;"><strong>${data.linkedEmployee.firstName} ${data.linkedEmployee.lastName}</strong></div>
                            <div style="font-size:0.85rem; color:var(--text-secondary);">Date Employed: ${new Date(data.linkedEmployee.dateEmployed).toLocaleDateString()}</div>
                        `;
                    } else {
                        linkedEmpDiv.innerHTML = '<span style="color:var(--text-secondary);">No linked employee.</span>';
                    }
                    
                    // Activity Log
                    const activityList = document.getElementById('drawerActivityList');
                    if (data.recentActivity && data.recentActivity.length > 0) {
                        activityList.innerHTML = data.recentActivity.map(a => `
                            <div style="background:var(--canvas); padding:12px; border-radius:6px; border:1px solid var(--border);">
                                <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                                    <strong>${a.action}</strong>
                                    <span style="font-size:0.75rem; color:var(--text-secondary);">${new Date(a.dateCreated).toLocaleString()}</span>
                                </div>
                                <div style="font-size:0.85rem;">${a.details || ''}</div>
                                <div style="font-size:0.75rem; color:var(--text-secondary); margin-top:4px;">IP: ${a.ipAddress || 'Unknown'}</div>
                            </div>
                        `).join('');
                    } else {
                        activityList.innerHTML = '<div style="text-align:center; color:var(--text-secondary); padding:20px;">No recent activity.</div>';
                    }
                    
                    // Contact Changes
                    const changesList = document.getElementById('drawerChangesList');
                    if (data.pendingContactChanges && data.pendingContactChanges.length > 0) {
                        changesList.innerHTML = data.pendingContactChanges.map(c => `
                            <div style="background:var(--canvas); padding:12px; border-radius:6px; border:1px solid var(--border);">
                                <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                                    <strong>Status: ${c.status}</strong>
                                    <span style="font-size:0.75rem; color:var(--text-secondary);">${new Date(c.dateCreated).toLocaleDateString()}</span>
                                </div>
                                <div style="font-size:0.85rem;">
                                    ${c.newEmail ? `New Email: ${c.newEmail}<br/>` : ''}
                                    ${c.newPhone ? `New Phone: ${c.newPhone}` : ''}
                                </div>
                            </div>
                        `).join('');
                    } else {
                        changesList.innerHTML = '<div style="text-align:center; color:var(--text-secondary); padding:20px;">No pending contact changes.</div>';
                    }
                    
                    // Active Sessions
                    const sessionsList = document.getElementById('drawerSessionsList');
                    if (data.activeSessions && data.activeSessions.length > 0) {
                        sessionsList.innerHTML = data.activeSessions.map(s => `
                            <div style="background:var(--canvas); padding:12px; border-radius:6px; border:1px solid var(--border);">
                                <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                                    <strong>${s.deviceName || 'Unknown Device'}</strong>
                                    <span style="font-size:0.75rem; color:var(--text-secondary);">${new Date(s.lastActive).toLocaleString()}</span>
                                </div>
                                <div style="font-size:0.85rem;">
                                    IP: ${s.ipAddress || 'Unknown'}<br/>
                                    <span style="color:var(--text-secondary); font-size:0.8rem; word-break:break-all;">${s.userAgent || 'Unknown Browser'}</span>
                                </div>
                            </div>
                        `).join('');
                    } else {
                        sessionsList.innerHTML = '<div style="text-align:center; color:var(--text-secondary); padding:20px;">No active sessions.</div>';
                    }
                    
                } else {
                    console.error("Failed to load User 360 Data");
                    document.getElementById('drawerUsername').textContent = "Error loading user";
                }
            } catch (err) {
                console.error("Error fetching user drawer:", err);
            }
        }

        function closeUserDrawer() {
            document.getElementById('userDrawerBackdrop').classList.remove('active');
            document.getElementById('userDrawer').classList.remove('active');
        }

        function switchUserTab(event, tabId) {
            document.querySelectorAll('#userDrawer .drawer-tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('#userDrawer .drawer-tab-content').forEach(c => c.style.display = 'none');
            
            event.currentTarget.classList.add('active');
            document.getElementById(tabId).style.display = 'block';
        }
    </script>
}
