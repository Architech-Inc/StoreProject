@page
@model StoreUI.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_LandingLayout";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header text-center">
            <div class="auth-logo">
                <i class="fas fa-key"></i>
            </div>
            <h2>Create New Password</h2>
            <p>Please enter your new password below.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-4">
                @TempData["SuccessMessage"]
                <div class="mt-3">
                    <a href="/Login" class="btn-login" style="text-decoration: none;">Proceed to Login</a>
                </div>
            </div>
        }
        else if (Model.IsError)
        {
            <div class="alert alert-danger mt-4">
                @Model.ErrorMessage
                <div class="mt-3">
                    <a href="/ForgotPassword" class="auth-link">Request a new link</a>
                </div>
            </div>
        }
        else
        {
            <form method="post" id="resetPasswordForm">
                @if (!ModelState.IsValid && ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger">
                        <div asp-validation-summary="All" class="text-danger"></div>
                    </div>
                }

                <input type="hidden" asp-for="Input.Token" />
                <input type="hidden" asp-for="Input.Email" />

                <div class="form-group mb-4">
                    <label asp-for="Input.NewPassword">New Password</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock"></i>
                        <input asp-for="Input.NewPassword" type="password" class="form-control" placeholder="••••••••" autocomplete="new-password" required minlength="8" />
                    </div>
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock"></i>
                        <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="••••••••" autocomplete="new-password" required minlength="8" />
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-login" id="btnSubmit">
                    <span>Reset Password</span>
                    <div class="btn-loader" style="display: none;">
                        <i class="fas fa-circle-notch fa-spin"></i>
                    </div>
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('resetPasswordForm')?.addEventListener('submit', function (e) {
            if (this.checkValidity()) {
                const btn = document.getElementById('btnSubmit');
                btn.classList.add('loading');
                btn.querySelector('span').style.opacity = '0';
                btn.querySelector('.btn-loader').style.display = 'block';
            }
        });
    </script>
}
