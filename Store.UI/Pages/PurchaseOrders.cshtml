@page
@model StoreUI.Pages.PurchaseOrdersModel
@{
    ViewData["Title"] = "Purchase Orders & Goods Receipt (GRN)";
    ViewData["ActivePage"] = "PurchaseOrders";
    ViewData["PageDescription"] = "Manage supplier procurement orders, management approvals, and Goods Received Notes (GRN).";
    Layout = "~/Pages/Shared/_AppLayout.cshtml";
}

<div class="po-hub-container">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="toast-banner @(Model.StatusMessage.StartsWith("Error") ? "error" : "success")">
            @if (Model.StatusMessage.StartsWith("Error"))
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            }
            <span>@Model.StatusMessage</span>
        </div>
    }

    <!-- 4-Card Interactive KPI Banner -->
    <div class="po-kpi-grid">
        <div class="po-kpi-card">
            <div class="kpi-icon-box emerald">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Active Procurement Value</span>
                <span class="kpi-value" title="@Model.Metrics.TotalCommittedValuationXaf.ToString("N0") XAF">@Model.Metrics.TotalCommittedValuationXaf.ToString("N0") XAF</span>
                <span class="kpi-sub">Committed supplier orders</span>
            </div>
        </div>

        <div class="po-kpi-card">
            <div class="kpi-icon-box amber">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Pending Approval</span>
                <span class="kpi-value">@Model.Metrics.PendingApprovalCount</span>
                <span class="kpi-sub">Draft & submitted orders</span>
            </div>
        </div>

        <div class="po-kpi-card">
            <div class="kpi-icon-box purple">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Awaiting Delivery</span>
                <span class="kpi-value">@Model.Metrics.AwaitingDeliveryCount</span>
                <span class="kpi-sub">Approved / in-transit from vendors</span>
            </div>
        </div>

        <div class="po-kpi-card">
            <div class="kpi-icon-box teal">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Fulfilled Orders</span>
                <span class="kpi-value">@Model.Metrics.FulfilledCount</span>
                <span class="kpi-sub">@Model.Metrics.TotalReceivedValuationXaf.ToString("N0") XAF received</span>
            </div>
        </div>
    </div>

    <!-- Filter Dock & Search Toolbar -->
    <div class="po-toolbar">
        <div class="toolbar-left">
            <form method="get" id="filterForm" class="search-box-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text" name="Search" value="@Model.Search" class="search-input" placeholder="Search PO #, supplier, item, ref, user..." onchange="document.getElementById('filterForm').submit();" />
                @if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
                {
                    <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                }
            </form>

            <!-- Status Filter Pills -->
            <div class="status-filter-pills">
                <a href="?Search=@Model.Search" class="filter-pill @(string.IsNullOrWhiteSpace(Model.StatusFilter) ? "active" : "")">All Orders</a>
                @foreach (var st in Model.Statuses)
                {
                    <a href="?StatusFilter=@st&Search=@Model.Search" class="filter-pill @(Model.StatusFilter == st.ToString() ? "active" : "")">@st</a>
                }
            </div>
        </div>

        <div class="toolbar-right">
            <a asp-page-handler="ExportCsv" asp-route-Search="@Model.Search" asp-route-StatusFilter="@Model.StatusFilter" class="btn-brand-secondary" title="Export Procurement Log">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Export CSV
            </a>

            <button type="button" class="btn-brand-primary" onclick="openCreatePoModal()">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                New Purchase Order
            </button>
        </div>
    </div>

    <!-- Data Stream Table Card -->
    <div class="po-table-card">
        @if (!Model.OrdersPaged.Items.Any())
        {
            <div style="padding: 48px 24px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px;">
                <div style="width: 64px; height: 64px; border-radius: 50%; background: #f1f5f9; color: #94a3b8; display: flex; align-items: center; justify-content: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <h4 style="font-size: 1.05rem; font-weight: 600; color: #0f172a; margin: 0;">No Purchase Orders Found</h4>
                <p style="font-size: 0.85rem; color: #64748b; margin: 0; max-width: 360px;">
                    No procurement orders match your filter criteria. Use "+ New Purchase Order" to draft a new order.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>PO Reference</th>
                            <th>Supplier Details</th>
                            <th>Consignment Scope</th>
                            <th>Valuation (XAF)</th>
                            <th>Status</th>
                            <th>Expected Delivery</th>
                            <th>Requester / User</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var po in Model.OrdersPaged.Items)
                        {
                            var statusClass = po.Status.ToLowerInvariant();
                            <tr>
                                <td>
                                    <div style="display: flex; flex-direction: column; gap: 2px;">
                                        <span class="code-badge">@(po.ReferenceNumber ?? $"PO-{po.PurchaseOrderId}")</span>
                                        <span style="font-size: 0.72rem; color: #94a3b8;">ID: #@po.PurchaseOrderId</span>
                                    </div>
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column; gap: 2px;">
                                        <span style="font-weight: 600; color: #0f172a;">@po.SupplierName</span>
                                        <div style="display: flex; align-items: center; gap: 6px;">
                                            @if (!string.IsNullOrWhiteSpace(po.BranchName))
                                            {
                                                <span class="badge-branch">@po.BranchName</span>
                                            }
                                            <span style="font-size: 0.75rem; color: #64748b;">@(po.SupplierPhone ?? po.SupplierEmail ?? "—")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column;">
                                        <span style="font-weight: 600; color: #1e293b;">@po.LineCount lines • @po.TotalOrderedUnits units</span>
                                        @if (po.TotalReceivedUnits > 0)
                                        {
                                            <span style="font-size: 0.75rem; color: #059669;">@po.TotalReceivedUnits / @po.TotalOrderedUnits received</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: #0f172a;">@po.TotalValuation.ToString("N0") XAF</span>
                                </td>
                                <td>
                                    <span class="badge-status @statusClass">@po.Status</span>
                                </td>
                                <td>
                                    @if (po.ExpectedDeliveryDate.HasValue)
                                    {
                                        var isOverdue = po.ExpectedDeliveryDate.Value < DateTime.UtcNow && po.Status != "Received" && po.Status != "Cancelled";
                                        <span style="font-size: 0.82rem; font-weight: 500; color: @(isOverdue ? "#dc2626" : "#475569");">
                                            @po.ExpectedDeliveryDate.Value.ToString("dd MMM yyyy")
                                            @if (isOverdue)
                                            {
                                                <small style="display: block; font-size: 0.7rem; color: #dc2626; font-weight: 700;">OVERDUE</small>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color: #94a3b8; font-size: 0.8rem;">—</span>
                                    }
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column;">
                                        <span style="font-weight: 500; color: #475569;">@po.RequestedByUser</span>
                                        <span style="font-size: 0.75rem; color: #94a3b8;">@po.DateCreated.ToLocalTime().ToString("dd MMM yyyy")</span>
                                    </div>
                                </td>
                                <td style="text-align: right;">
                                    <div style="display: flex; align-items: center; justify-content: flex-end; gap: 4px;">
                                        <!-- Printable Manifest Button -->
                                        <button type="button" class="btn-table-action" onclick="openPoManifestModal(@po.PurchaseOrderId)" title="View & Print PO / GRN Manifest">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                                            </svg>
                                            Manifest
                                        </button>

                                        @if (po.Status == "Draft")
                                        {
                                            <form method="post" asp-page-handler="Submit" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="ActionPurchaseOrderId" value="@po.PurchaseOrderId" />
                                                <button type="submit" class="btn-table-action teal">Submit</button>
                                            </form>
                                            <form method="post" asp-page-handler="Cancel" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="ActionPurchaseOrderId" value="@po.PurchaseOrderId" />
                                                <button type="submit" class="btn-table-action danger" onclick="return confirm('Cancel this draft purchase order?');">✕</button>
                                            </form>
                                        }

                                        @if (po.Status == "Submitted")
                                        {
                                            <form method="post" asp-page-handler="Approve" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="ActionPurchaseOrderId" value="@po.PurchaseOrderId" />
                                                <button type="submit" class="btn-table-action emerald">Approve</button>
                                            </form>
                                            <form method="post" asp-page-handler="Cancel" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="ActionPurchaseOrderId" value="@po.PurchaseOrderId" />
                                                <button type="submit" class="btn-table-action danger" onclick="return confirm('Cancel this purchase order?');">✕</button>
                                            </form>
                                        }

                                        @if (po.Status == "Approved" || po.Status == "PartiallyReceived")
                                        {
                                            <button type="button" class="btn-table-action emerald" onclick="openReceiveModal(@po.PurchaseOrderId)">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                                                </svg>
                                                Receive (GRN)
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.OrdersPaged.TotalPages > 1)
            {
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-top: 1px solid #e2e8f0;">
                    <span style="font-size: 0.82rem; color: #64748b;">
                        Showing page <strong>@Model.OrdersPaged.Page</strong> of <strong>@Model.OrdersPaged.TotalPages</strong> (@Model.OrdersPaged.TotalCount total records)
                    </span>
                    <div style="display: flex; gap: 6px;">
                        @if (Model.OrdersPaged.HasPreviousPage)
                        {
                            <a href="?PageNumber=@(Model.OrdersPaged.Page - 1)&Search=@Model.Search&StatusFilter=@Model.StatusFilter" class="btn-brand-secondary" style="padding: 4px 10px; font-size: 0.8rem;">Previous</a>
                        }
                        @if (Model.OrdersPaged.HasNextPage)
                        {
                            <a href="?PageNumber=@(Model.OrdersPaged.Page + 1)&Search=@Model.Search&StatusFilter=@Model.StatusFilter" class="btn-brand-secondary" style="padding: 4px 10px; font-size: 0.8rem;">Next</a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Create Purchase Order Modal -->
<div class="modern-modal-overlay" id="createPoOverlay" onclick="closeCreatePoModal()"></div>
<div class="modern-modal" id="createPoModal" style="max-width: 820px;">
    <div class="modal-header">
        <h3 class="modal-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#019c01">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            New Purchase Order
        </h3>
        <button type="button" class="btn-close-modal" onclick="closeCreatePoModal()">&times;</button>
    </div>
    <form method="post" asp-page-handler="Create" id="createPoForm">
        @Html.AntiForgeryToken()
        <div class="modal-body">
            <div class="form-row-group">
                <div class="form-field">
                    <label class="form-label">Vendor / Supplier <span style="color: #dc2626;">*</span></label>
                    <select name="CreateRequest.SupplierId" id="supplierSelect" class="form-select" required>
                        <option value="">-- Select Supplier --</option>
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Destination Branch (Optional)</label>
                    <select name="CreateRequest.BranchId" id="branchSelect" class="form-select">
                        <option value="">-- Main Central Warehouse --</option>
                    </select>
                </div>
            </div>

            <div class="form-row-group">
                <div class="form-field">
                    <label class="form-label">Reference Number</label>
                    <input type="text" name="CreateRequest.ReferenceNumber" id="createPoRef" class="form-input" placeholder="e.g. PO-2026-001" maxlength="100" />
                </div>
                <div class="form-field">
                    <label class="form-label">Expected Delivery Date</label>
                    <input type="date" name="CreateRequest.ExpectedDeliveryDate" class="form-input" />
                </div>
            </div>

            <!-- Dynamic Line Items Section -->
            <div class="line-items-section">
                <div class="line-items-header">
                    <span style="font-weight: 700; font-size: 0.88rem; color: #0f172a;">Procurement Line Items</span>
                    <button type="button" class="btn-brand-secondary" style="padding: 4px 10px; font-size: 0.78rem;" onclick="addPoItemRow()">+ Add Product</button>
                </div>

                <div class="table-responsive">
                    <table class="line-items-table" id="poItemsTable">
                        <thead>
                            <tr>
                                <th style="width: 45%;">Product Item</th>
                                <th style="width: 20%;">Qty</th>
                                <th style="width: 25%;">Unit Cost (XAF)</th>
                                <th style="width: 10%; text-align: right;"></th>
                            </tr>
                        </thead>
                        <tbody id="poItemsBody">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Valuation Summary Banner -->
            <div class="valuation-summary-banner">
                <div class="valuation-metric">
                    <span class="val-label">Total Lines</span>
                    <span class="val-num" id="valPoLines">0</span>
                </div>
                <div class="valuation-metric">
                    <span class="val-label">Total Units</span>
                    <span class="val-num" id="valPoUnits">0</span>
                </div>
                <div class="valuation-metric" style="text-align: right;">
                    <span class="val-label">Estimated Order Valuation</span>
                    <span class="val-num" id="valPoTotal">0 XAF</span>
                </div>
            </div>

            <div class="form-field">
                <label class="form-label">Procurement & Delivery Notes</label>
                <textarea name="CreateRequest.Notes" class="form-textarea" rows="2" placeholder="Payment terms, delivery instructions, contact details..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-brand-secondary" onclick="closeCreatePoModal()">Cancel</button>
            <button type="submit" class="btn-brand-primary">Create Purchase Order</button>
        </div>
    </form>
</div>

<!-- Goods Receipt (GRN) Modal -->
<div class="modern-modal-overlay" id="receiveModalOverlay" onclick="closeReceiveModal()"></div>
<div class="modern-modal" id="receivePoModal" style="max-width: 760px;">
    <div class="modal-header">
        <h3 class="modal-title" style="color: #059669;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
            Goods Received Note (GRN) Verification
        </h3>
        <button type="button" class="btn-close-modal" onclick="closeReceiveModal()">&times;</button>
    </div>
    <form method="post" asp-page-handler="Receive" id="receivePoForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ActionPurchaseOrderId" id="receiveActionPoId" />
        <div class="modal-body">
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 16px; font-size: 0.85rem; color: #334155;">
                Verify quantities delivered at the warehouse dock. Inflow stock movements and item catalog counts will be synchronized automatically upon confirmation.
            </div>

            <div class="table-responsive">
                <table class="line-items-table" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px;">
                    <thead>
                        <tr>
                            <th>Item Details</th>
                            <th style="text-align: center;">Ordered</th>
                            <th style="text-align: center;">Prev Received</th>
                            <th style="text-align: right; width: 140px;">Receiving Now</th>
                        </tr>
                    </thead>
                    <tbody id="grnItemsBody">
                        <!-- Populated dynamically -->
                    </tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-brand-secondary" onclick="closeReceiveModal()">Cancel</button>
            <button type="submit" class="btn-brand-primary">Confirm Goods Receipt</button>
        </div>
    </form>
</div>

<!-- Printable PO / GRN Waybill Manifest Modal -->
<div class="modern-modal-overlay" id="poManifestOverlay" onclick="closePoManifestModal()"></div>
<div class="modern-modal printable-manifest" id="poManifestModal" style="max-width: 820px;">
    <div class="modal-header">
        <h3 class="modal-title">Official Procurement Voucher & GRN</h3>
        <div style="display:flex; gap: 8px; align-items: center;">
            <button type="button" class="btn-brand-primary" style="padding: 6px 12px; font-size: 0.8rem;" onclick="window.print()">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                Print Voucher
            </button>
            <button type="button" class="btn-close-modal" onclick="closePoManifestModal()">&times;</button>
        </div>
    </div>
    <div class="modal-body" id="poManifestContent">
        <!-- Rendered dynamically -->
    </div>
    <div class="modal-footer">
        <button type="button" class="btn-brand-secondary" onclick="closePoManifestModal()">Close</button>
    </div>
</div>

@section Scripts {
    <script>
        let catalogItemsCache = [];
        let rowCounter = 0;

        async function initCatalog() {
            try {
                // Preload suppliers and branches for fast modal opening
                const [supRes, brRes, itmRes] = await Promise.all([
                    fetch('?handler=SearchSuppliers'),
                    fetch('?handler=SearchBranches'),
                    fetch('?handler=SearchCatalog')
                ]);

                if (supRes.ok) {
                    const sups = await supRes.json();
                    const supSelect = document.getElementById('supplierSelect');
                    supSelect.innerHTML = '<option value="">-- Select Supplier --</option>';
                    sups.forEach(s => {
                        supSelect.innerHTML += `<option value="${s.id}">${escapeHtml(s.name)} (${escapeHtml(s.contact)})</option>`;
                    });
                }

                if (brRes.ok) {
                    const brs = await brRes.json();
                    const brSelect = document.getElementById('branchSelect');
                    brSelect.innerHTML = '<option value="">-- Main Central Warehouse --</option>';
                    brs.forEach(b => {
                        brSelect.innerHTML += `<option value="${b.id}">${escapeHtml(b.name)} [${escapeHtml(b.code)}]</option>`;
                    });
                }

                if (itmRes.ok) {
                    catalogItemsCache = await itmRes.json();
                }
            } catch (e) {
                console.error("Init catalog failed", e);
            }
        }

        document.addEventListener('DOMContentLoaded', initCatalog);

        function openCreatePoModal() {
            document.getElementById('createPoOverlay').classList.add('open');
            document.getElementById('createPoModal').classList.add('open');
            
            if (!document.getElementById('createPoRef').value) {
                const now = new Date();
                const yr = now.getFullYear();
                const mo = String(now.getMonth() + 1).padStart(2, '0');
                const rnd = Math.floor(1000 + Math.random() * 9000);
                document.getElementById('createPoRef').value = `PO-${yr}${mo}-${rnd}`;
            }

            if (document.getElementById('poItemsBody').children.length === 0) {
                addPoItemRow();
            }
        }

        function closeCreatePoModal() {
            document.getElementById('createPoOverlay').classList.remove('open');
            document.getElementById('createPoModal').classList.remove('open');
        }

        function addPoItemRow() {
            const idx = rowCounter++;
            const tbody = document.getElementById('poItemsBody');
            const tr = document.createElement('tr');
            tr.id = `poRow_${idx}`;
            
            let options = '<option value="">-- Select Product --</option>';
            catalogItemsCache.forEach(i => {
                options += `<option value="${i.id}" data-cost="${i.costPrice}">${escapeHtml(i.name)} (${escapeHtml(i.barcode)})</option>`;
            });

            tr.innerHTML = `
                <td>
                    <select name="CreateRequest.Items[${idx}].ItemId" class="form-select" required onchange="handleItemSelect(this, ${idx})">
                        ${options}
                    </select>
                </td>
                <td>
                    <input type="number" name="CreateRequest.Items[${idx}].OrderedQuantity" class="form-input po-qty" value="1" min="1" required oninput="recalcPoSummary()" />
                </td>
                <td>
                    <input type="number" name="CreateRequest.Items[${idx}].UnitCost" id="cost_${idx}" class="form-input po-cost" value="0" min="0" step="0.01" required oninput="recalcPoSummary()" />
                </td>
                <td style="text-align: right;">
                    <button type="button" class="btn-table-action danger" onclick="removePoRow(${idx})">✕</button>
                </td>
            `;
            tbody.appendChild(tr);
            recalcPoSummary();
        }

        function removePoRow(idx) {
            const row = document.getElementById(`poRow_${idx}`);
            if (row && document.getElementById('poItemsBody').children.length > 1) {
                row.remove();
                recalcPoSummary();
            }
        }

        function handleItemSelect(selectElem, idx) {
            const selectedOpt = selectElem.options[selectElem.selectedIndex];
            const cost = parseFloat(selectedOpt.getAttribute('data-cost')) || 0;
            const costInput = document.getElementById(`cost_${idx}`);
            if (costInput) {
                costInput.value = cost;
            }
            recalcPoSummary();
        }

        function recalcPoSummary() {
            let totalLines = 0;
            let totalUnits = 0;
            let totalCost = 0;

            document.querySelectorAll('#poItemsBody tr').forEach(tr => {
                totalLines++;
                const qty = parseInt(tr.querySelector('.po-qty')?.value) || 0;
                const cost = parseFloat(tr.querySelector('.po-cost')?.value) || 0;
                totalUnits += qty;
                totalCost += (qty * cost);
            });

            document.getElementById('valPoLines').textContent = totalLines;
            document.getElementById('valPoUnits').textContent = totalUnits;
            document.getElementById('valPoTotal').textContent = `${formatNumber(totalCost)} XAF`;
        }

        // Receive Modal & GRN
        async function openReceiveModal(poId) {
            document.getElementById('receiveActionPoId').value = poId;
            const tbody = document.getElementById('grnItemsBody');
            tbody.innerHTML = '<tr><td colspan="4" style="text-align: center; color: #94a3b8; padding: 18px;">Loading line items...</td></tr>';
            
            document.getElementById('receiveModalOverlay').classList.add('open');
            document.getElementById('receivePoModal').classList.add('open');

            try {
                const res = await fetch(`?handler=DetailsJson&id=${poId}`);
                if (!res.ok) throw new Error("Failed to load PO details");
                const po = await res.json();

                tbody.innerHTML = '';
                po.items.forEach((item, idx) => {
                    const remaining = Math.max(0, item.orderedQuantity - item.receivedQuantity);
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>
                            <div style="font-weight: 600; color: #0f172a;">${escapeHtml(item.itemName)}</div>
                            <div style="font-size: 0.75rem; color: #64748b;">Barcode: ${escapeHtml(item.itemCode || "N/A")} | Cost: ${formatNumber(item.unitCost)} XAF</div>
                            <input type="hidden" name="ReceiveRequest.Lines[${idx}].PurchaseOrderItemId" value="${item.purchaseOrderItemId}" />
                        </td>
                        <td style="text-align: center; font-weight: 600;">${item.orderedQuantity}</td>
                        <td style="text-align: center; color: #64748b;">${item.receivedQuantity}</td>
                        <td style="text-align: right;">
                            <input type="number" name="ReceiveRequest.Lines[${idx}].ReceivedQuantity" class="form-input" style="width: 100px; margin-left: auto;" value="${remaining}" min="0" max="${remaining}" />
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            } catch (e) {
                tbody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: #dc2626;">Error: ${e.message}</td></tr>`;
            }
        }

        function closeReceiveModal() {
            document.getElementById('receiveModalOverlay').classList.remove('open');
            document.getElementById('receivePoModal').classList.remove('open');
        }

        // Printable Manifest & GRN Voucher
        async function openPoManifestModal(poId) {
            const container = document.getElementById('poManifestContent');
            container.innerHTML = '<div style="text-align:center; padding: 32px; color: #94a3b8;">Generating Procurement Voucher...</div>';
            
            document.getElementById('poManifestOverlay').classList.add('open');
            document.getElementById('poManifestModal').classList.add('open');

            try {
                const res = await fetch(`?handler=DetailsJson&id=${poId}`);
                if (!res.ok) throw new Error("Failed to load PO details");
                const po = await res.json();

                let linesHtml = '';
                po.items.forEach((item, idx) => {
                    linesHtml += `
                        <tr style="border-bottom: 1px solid #e2e8f0;">
                            <td style="padding: 8px;">${idx + 1}</td>
                            <td style="padding: 8px;"><strong>${escapeHtml(item.itemName)}</strong><br/><small style="color:#64748b;">${escapeHtml(item.itemCode || "—")}</small></td>
                            <td style="padding: 8px; text-align: center;">${item.orderedQuantity}</td>
                            <td style="padding: 8px; text-align: center;">${item.receivedQuantity}</td>
                            <td style="padding: 8px; text-align: right;">${formatNumber(item.unitCost)} XAF</td>
                            <td style="padding: 8px; text-align: right; font-weight: 700;">${formatNumber(item.orderedQuantity * item.unitCost)} XAF</td>
                        </tr>
                    `;
                });

                container.innerHTML = `
                    <div style="border-bottom: 2px solid #019c01; padding-bottom: 16px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <h2 style="margin: 0; color: #019c01; font-size: 1.4rem;">CLEXAN FOODS</h2>
                            <div style="font-size: 0.85rem; color: #475569;">Procurement & Inventory Operations • Official Goods Received Note (GRN)</div>
                        </div>
                        <div style="text-align: right;">
                            <div style="font-size: 1.1rem; font-weight: 700; color: #0f172a;">${escapeHtml(po.referenceNumber || `PO-${po.purchaseOrderId}`)}</div>
                            <div style="font-size: 0.8rem; color: #64748b;">Date: ${new Date(po.dateCreated).toLocaleDateString()}</div>
                            <div style="display: inline-block; font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px; background: #f1f5f9; text-transform: uppercase;">Status: ${po.status}</div>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px 18px; font-size: 0.88rem;">
                        <div>
                            <strong style="color: #64748b; font-size: 0.75rem; text-transform: uppercase;">Vendor / Supplier:</strong>
                            <div style="font-weight: 700; font-size: 1rem; color: #0f172a;">${escapeHtml(po.supplierName)}</div>
                            <div style="color: #475569;">Contact: ${escapeHtml(po.supplierPhone || po.supplierEmail || "—")}</div>
                        </div>
                        <div>
                            <strong style="color: #64748b; font-size: 0.75rem; text-transform: uppercase;">Delivery Destination:</strong>
                            <div style="font-weight: 700; font-size: 1rem; color: #0f172a;">${escapeHtml(po.branchName || "Main Central Warehouse")}</div>
                            <div style="color: #475569;">Expected Delivery: ${po.expectedDeliveryDate ? new Date(po.expectedDeliveryDate).toLocaleDateString() : "—"}</div>
                        </div>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem; margin-bottom: 20px;">
                        <thead>
                            <tr style="background: #f1f5f9; border-bottom: 2px solid #cbd5e1; text-transform: uppercase; font-size: 0.75rem; color: #475569;">
                                <th style="padding: 8px; text-align: left;">#</th>
                                <th style="padding: 8px; text-align: left;">Item Description</th>
                                <th style="padding: 8px; text-align: center;">Ordered</th>
                                <th style="padding: 8px; text-align: center;">Received</th>
                                <th style="padding: 8px; text-align: right;">Unit Cost</th>
                                <th style="padding: 8px; text-align: right;">Total Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${linesHtml}
                        </tbody>
                        <tfoot>
                            <tr style="border-top: 2px solid #0f172a; font-weight: 700;">
                                <td colspan="5" style="padding: 10px 8px; text-align: right; text-transform: uppercase;">Total Order Valuation:</td>
                                <td style="padding: 10px 8px; text-align: right; font-size: 1.1rem; color: #019c01;">${formatNumber(po.totalValuation)} XAF</td>
                            </tr>
                        </tfoot>
                    </table>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 40px; padding-top: 20px; border-top: 1px dashed #cbd5e1;">
                        <div style="border-top: 1px solid #94a3b8; padding-top: 8px; text-align: center;">
                            <div style="font-weight: 600; font-size: 0.85rem;">Authorized Procurement Officer</div>
                            <div style="font-size: 0.75rem; color: #64748b;">${escapeHtml(po.approvedByUser || po.requestedByUser)} • Signature & Date</div>
                        </div>
                        <div style="border-top: 1px solid #94a3b8; padding-top: 8px; text-align: center;">
                            <div style="font-weight: 600; font-size: 0.85rem;">Warehouse Receiving Officer (GRN)</div>
                            <div style="font-size: 0.75rem; color: #64748b;">Dock Receipt Stamp & Signature</div>
                        </div>
                    </div>
                `;
            } catch (e) {
                container.innerHTML = `<div style="color: #dc2626; text-align: center; padding: 32px;">Error generating document: ${e.message}</div>`;
            }
        }

        function closePoManifestModal() {
            document.getElementById('poManifestOverlay').classList.remove('open');
            document.getElementById('poManifestModal').classList.remove('open');
        }

        function formatNumber(num) {
            return Number(num || 0).toLocaleString('en-US');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
    </script>
}
