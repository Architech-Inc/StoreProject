@page
@model StoreUI.Pages.PurchaseOrdersModel
@using Store.Models.Enums
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Purchase Orders";
    ViewData["ActivePage"] = "PurchaseOrders";
}



<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Purchase Orders</h4>
    <button class="button-primary btn-sm" onclick="window.openBlade('createPoBlade')">
        + New Purchase Order
    </button>
</div>

<!-- Filter bar -->
<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="status" class="form-select form-select-sm">
            <option value="">All Statuses</option>
            @foreach (var s in Model.Statuses)
            {
                <option value="@s" selected="@(Model.FilterStatus == s.ToString())">@s</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-secondary btn-sm" type="submit">Filter</button>
    </div>
</form>

<!-- PO List -->
<div class="table-responsive">
    <table class="table table-hover table-sm align-middle">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Reference</th>
                <th>Supplier</th>
                <th>Branch</th>
                <th>Status</th>
                <th>Expected Delivery</th>
                <th>Requested By</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var po in Model.PurchaseOrders)
            {
                <tr>
                    <td>@po.PurchaseOrderId</td>
                    <td>@(po.ReferenceNumber ?? "—")</td>
                    <td>@po.SupplierName</td>
                    <td>@(po.BranchName ?? "—")</td>
                    <td>
                        <span class="badge @(po.Status switch {
                            "Draft" => "bg-secondary",
                            "Submitted" => "bg-info text-dark",
                            "Approved" => "bg-primary",
                            "PartiallyReceived" => "bg-warning text-dark",
                            "Received" => "bg-success",
                            "Cancelled" => "bg-danger",
                            _ => "bg-secondary" })">
                            @po.Status
                        </span>
                    </td>
                    <td>@(po.ExpectedDeliveryDate?.ToString("dd MMM yyyy") ?? "—")</td>
                    <td>@po.RequestedByUser</td>
                    <td>@po.DateCreated.ToString("dd MMM yyyy")</td>
                    <td>
                        <div class="d-flex gap-1">
                            @if (po.Status == "Draft")
                            {
                                <form method="post" asp-page-handler="Submit">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ActionPurchaseOrderId" value="@po.PurchaseOrderId" />
                                    <button class="btn btn-outline-info btn-sm" type="submit">Submit</button>
                                </form>
                                <form method="post" asp-page-handler="Cancel">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ActionPurchaseOrderId" value="@po.PurchaseOrderId" />
                                    <button class="btn btn-outline-danger btn-sm" type="submit"
                                            onclick="return confirm('Cancel this PO?')">Cancel</button>
                                </form>
                            }
                            @if (po.Status == "Submitted")
                            {
                                <form method="post" asp-page-handler="Approve">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ActionPurchaseOrderId" value="@po.PurchaseOrderId" />
                                    <button class="btn btn-outline-primary btn-sm" type="submit">Approve</button>
                                </form>
                                <form method="post" asp-page-handler="Cancel">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ActionPurchaseOrderId" value="@po.PurchaseOrderId" />
                                    <button class="btn btn-outline-danger btn-sm" type="submit"
                                            onclick="return confirm('Cancel this PO?')">Cancel</button>
                                </form>
                            }
                            @if (po.Status == "Approved" || po.Status == "PartiallyReceived")
                            {
                                <button type="button" class="button-secondary btn-sm"
                                        onclick="openReceiveBlade('@po.PurchaseOrderId', '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(po.Items).Replace("\"", "&quot;").Replace("'", "\\'"))')">
                                    Receive
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.PurchaseOrders.Any())
            {
                <tr><td colspan="9" class="text-center text-muted py-3"><div class="empty-state"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg><h4>No Purchase Orders Found</h4><p>There are no records matching your criteria.</p></div></td></tr>
            }
        </tbody>
    </table>
</div>

<!-- ===== Create PO Blade ===== -->
<div class="blade-overlay" id="createPoOverlay"></div>
<div class="blade" id="createPoBlade" data-overlay-id="createPoOverlay">
    <div class="blade-header">
        <h3 id="createPoModalLabel">New Purchase Order</h3>
        <button type="button" class="btn-close" data-close-blade aria-label="Close">×</button>
    </div>
    <div class="blade-body">
        <form method="post" asp-page-handler="Create" id="createPoForm">
            @Html.AntiForgeryToken()
            <div class="form-grid">
                <div>
                    <label>Supplier <span class="text-danger">*</span></label>
                    <div class="smart-lookup-wrap" data-url="?handler=SearchSuppliers" data-placeholder="Search supplier by name, email...">
                        <input type="hidden" name="CreateSupplierId" required />
                    </div>
                </div>
                <div>
                    <label>Branch (Optional)</label>
                    <div class="smart-lookup-wrap" data-url="?handler=SearchBranches" data-placeholder="Search receiving branch...">
                        <input type="hidden" name="CreateBranchId" />
                    </div>
                </div>
                <div>
                    <label>Reference Number</label>
                    <input type="text" name="CreateReferenceNumber" placeholder="e.g. PO-2024-001" />
                </div>
                <div>
                    <label>Expected Delivery</label>
                    <input type="date" name="CreateExpectedDelivery" />
                </div>
                <div style="grid-column:1/-1;">
                    <label>Notes</label>
                    <textarea name="CreateNotes" rows="2" placeholder="Optional PO notes..."></textarea>
                </div>
            </div>

            <hr style="margin: 16px 0; border: none; border-top: 1px solid var(--ops-border, var(--border));" />
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                <strong>Line Items</strong>
                <button type="button" class="button-secondary btn-sm" id="addLineBtn">+ Add Item</button>
            </div>
            <table class="table" id="lineItemsTable">
                <thead>
                    <tr>
                        <th style="width:50%;">Item</th>
                        <th style="width:20%;">Qty</th>
                        <th style="width:25%;">Unit Cost ($)</th>
                        <th style="width:5%;"></th>
                    </tr>
                </thead>
                <tbody id="lineItemsBody">
                    <tr class="po-item-row">
                        <td>
                            <div class="smart-lookup-wrap po-item-lookup" data-url="?handler=SearchItems" data-placeholder="Search item...">
                                <input type="hidden" name="CreateItemIds" required />
                            </div>
                        </td>
                        <td><input type="number" name="CreateQuantities" value="1" min="1" required style="width:100%;box-sizing:border-box;" /></td>
                        <td><input type="number" name="CreateUnitCosts" value="0.00" min="0" step="0.01" required style="width:100%;box-sizing:border-box;" class="po-unit-cost" /></td>
                        <td><button type="button" class="button-command danger remove-line-btn" style="padding:4px 8px;">✕</button></td>
                    </tr>
                </tbody>
            </table>
        </form>
    </div>
    <div class="blade-footer">
        <button type="button" class="button-command" data-close-blade>Cancel</button>
        <button type="button" class="button-primary" onclick="document.getElementById('createPoForm').submit()">Create Order</button>
    </div>
</div>

<!-- ===== Receive Blade ===== -->
<div class="blade-overlay" id="receiveOverlay"></div>
<div class="blade" id="receiveBlade" data-overlay-id="receiveOverlay">
    <div class="blade-header">
        <h3>Receive Purchase Order</h3>
        <button type="button" class="btn-close" data-close-blade aria-label="Close">×</button>
    </div>
    <div class="blade-body">
        <form method="post" asp-page-handler="Receive" id="receiveForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ActionPurchaseOrderId" id="receivePoId" />
            <table class="table">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Ordered</th>
                        <th>Received</th>
                        <th>Receiving Now</th>
                    </tr>
                </thead>
                <tbody id="receiveItemsBody"></tbody>
            </table>
        </form>
    </div>
    <div class="blade-footer">
        <button type="button" class="button-command" data-close-blade>Cancel</button>
        <button type="button" class="button-primary" onclick="document.getElementById('receiveForm').submit()">Confirm Receipt</button>
    </div>
</div>

@section Scripts {
<script>
// Attach on-select callback for PO items to automatically set unit cost
function attachPoItemLookup(wrap) {
    if (!wrap || !window.SmartLookup) return;
    window.SmartLookup.attach(wrap, {
        onSelect: function(item, container) {
            if (item && item.cost !== undefined) {
                const row = container.closest('tr');
                if (row) {
                    const costInput = row.querySelector('.po-unit-cost');
                    if (costInput && (!parseFloat(costInput.value) || parseFloat(costInput.value) === 0)) {
                        costInput.value = item.cost.toFixed(2);
                    }
                }
            }
        }
    });
}

document.querySelectorAll('.po-item-lookup').forEach(attachPoItemLookup);

// Add line item row
document.getElementById('addLineBtn').addEventListener('click', function () {
    const tbody = document.getElementById('lineItemsBody');
    const row = document.createElement('tr');
    row.className = 'po-item-row';
    row.innerHTML = `
        <td>
            <div class="smart-lookup-wrap po-item-lookup" data-url="?handler=SearchItems" data-placeholder="Search item...">
                <input type="hidden" name="CreateItemIds" required />
            </div>
        </td>
        <td><input type="number" name="CreateQuantities" value="1" min="1" required style="width:100%;box-sizing:border-box;" /></td>
        <td><input type="number" name="CreateUnitCosts" value="0.00" min="0" step="0.01" required style="width:100%;box-sizing:border-box;" class="po-unit-cost" /></td>
        <td><button type="button" class="button-command danger remove-line-btn" style="padding:4px 8px;">✕</button></td>`;
    tbody.appendChild(row);
    const wrap = row.querySelector('.po-item-lookup');
    attachPoItemLookup(wrap);
});

document.addEventListener('click', function (e) {
    if (e.target.classList.contains('remove-line-btn')) {
        const tbody = document.getElementById('lineItemsBody');
        if (tbody.rows.length > 1) e.target.closest('tr').remove();
    }
});

// Receive blade population
window.openReceiveBlade = function(poId, itemsJson) {
    const items = JSON.parse(itemsJson);
    document.getElementById('receivePoId').value = poId;
    const tbody = document.getElementById('receiveItemsBody');
    tbody.innerHTML = '';

    items.forEach(function (item) {
        const remaining = item.orderedQuantity - item.receivedQuantity;
        const row = document.createElement('tr');
        row.innerHTML = `
            <td>${item.itemName} <small class="text-muted">(${item.itemCode})</small></td>
            <td>${item.orderedQuantity}</td>
            <td>${item.receivedQuantity}</td>
            <td><input type="number" name="ReceiveQuantities" class="form-control form-control-sm"
                        value="${remaining}" min="0" max="${item.orderedQuantity}" /></td>
            <td><input type="hidden" name="ReceiveItemLineIds" value="${item.purchaseOrderItemId}" /></td>`;
        tbody.appendChild(row);
    });
    
    window.openBlade('receiveBlade');
};
</script>
}

