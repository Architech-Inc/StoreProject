@page
@model StoreUI.Pages.PayrollModel
@using Store.Models.Enums
@using Store.Models.Entities.HR
@{
    ViewData["Title"] = "Payroll Management";
    ViewData["ActivePage"] = "Payroll";
    ViewData["PageDescription"] = "Manage payroll runs, approvals, and payouts.";
}

<div class="ops-page">

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="status @(Model.StatusMessage.StartsWith("Error") || Model.StatusMessage.StartsWith("Failed") ? "error" : "ok")" style="margin-bottom: 20px;">
            @Model.StatusMessage
        </div>
    }

    <!-- ── Top KPI Metric Summary Cards ──────────────────────── -->
    <section class="hr-kpi-grid">
        <div class="hr-kpi-card" style="cursor:default;">
            <div class="hr-kpi-icon hr-icon-blue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <div class="hr-kpi-info">
                <span class="hr-kpi-label">Draft Runs</span>
                <span class="hr-kpi-val">@(Model.PayrollRuns?.Count(r => r.Status == PayrollRunStatus.Draft) ?? 0)</span>
                <span class="hr-kpi-sub">Awaiting review</span>
            </div>
        </div>

        <div class="hr-kpi-card" style="cursor:default;">
            <div class="hr-kpi-icon hr-icon-purple">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div class="hr-kpi-info">
                <span class="hr-kpi-label">Approved Runs</span>
                <span class="hr-kpi-val">@(Model.PayrollRuns?.Count(r => r.Status == PayrollRunStatus.Approved) ?? 0)</span>
                <span class="hr-kpi-sub">Ready for payout</span>
            </div>
        </div>

        <div class="hr-kpi-card" style="cursor:default;">
            <div class="hr-kpi-icon hr-icon-green">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
            </div>
            <div class="hr-kpi-info">
                <span class="hr-kpi-label">Total Paid (YTD)</span>
                <span class="hr-kpi-val">@(Model.PayrollRuns?.Where(r => r.Status == PayrollRunStatus.Paid).Sum(r => r.TotalNet).ToString("N0") ?? "0") <small style="font-size:0.75rem;">XAF</small></span>
                <span class="hr-kpi-sub">Net payouts</span>
            </div>
        </div>
    </section>

    <!-- ── Filter Dock & Action ─────────────────────────────── -->
    <section class="catalog-filter-dock">
        <div class="filter-dock-top" style="justify-content: flex-end; gap: 10px;">
            <button type="button" class="btn-brand-secondary" onclick="openTaxBracketsModal()" style="padding:9px 16px;font-weight:600;display:flex;align-items:center;gap:6px;background:#f8fafc;border:1px solid #cbd5e1;border-radius:8px;cursor:pointer;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"/><circle cx="18" cy="17" r="3"/></svg> PAYE Tax Brackets (@(Model.TaxBrackets?.Count() ?? 0))
            </button>
            <button type="button" class="btn-brand-primary" onclick="document.getElementById('draftModalOverlay').classList.add('open')" style="padding:9px 16px;font-weight:600;display:flex;align-items:center;gap:6px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Draft New Payroll
            </button>
        </div>
    </section>

    <!-- ── Data Table ──────────────────────────────────────── -->
    <div class="table-responsive" style="background: var(--surface); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); border: 1px solid var(--border-soft);">
        <table class="data-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th>Run ID</th>
                    <th>Period</th>
                    <th>Status</th>
                    <th class="num">Total Gross</th>
                    <th class="num">Commissions</th>
                    <th class="num">Total Net</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PayrollRuns != null && Model.PayrollRuns.Any())
                {
                    foreach (var run in Model.PayrollRuns)
                    {
                        <tr>
                            <td>
                                <strong>@run.PayrollRunId.ToString().Substring(0, 8)</strong>
                            </td>
                            <td>@run.PeriodStartDate.ToShortDateString() - @run.PeriodEndDate.ToShortDateString()</td>
                            <td>
                                @if (run.Status == PayrollRunStatus.Draft)
                                {
                                    <span class="badge badge-draft">Draft</span>
                                }
                                else if (run.Status == PayrollRunStatus.Approved)
                                {
                                    <span class="badge badge-approved">Approved</span>
                                }
                                else if (run.Status == PayrollRunStatus.Paid)
                                {
                                    <span class="badge badge-paid">Paid</span>
                                }
                                else
                                {
                                    <span class="badge badge-posted">Posted</span>
                                }
                            </td>
                            <td class="num">@run.TotalGross.ToString("N0") XAF</td>
                            <td class="num" style="color:var(--brand-secondary);">@run.TotalCommissions.ToString("N0") XAF</td>
                            <td class="num font-bold">@run.TotalNet.ToString("N0") XAF</td>
                            <td style="text-align: right;">
                                <div style="display:flex; gap:8px; justify-content:flex-end;">
                                    @if (run.Status == PayrollRunStatus.Draft && Model.CanApprove)
                                    {
                                        <form method="post" asp-page-handler="Approve" style="display:inline;">
                                            <input type="hidden" name="runId" value="@run.PayrollRunId" />
                                            <button type="submit" class="btn-brand-secondary btn-sm" title="Approve Payroll">
                                                Approve
                                            </button>
                                        </form>
                                    }
                                    else if (run.Status == PayrollRunStatus.Approved)
                                    {
                                        <form method="post" asp-page-handler="Pay" style="display:inline;">
                                            <input type="hidden" name="runId" value="@run.PayrollRunId" />
                                            <button type="submit" class="btn-brand-primary btn-sm" title="Post & Pay"
                                                    data-confirm="Initiate payout for this payroll run? This will generate General Ledger journal entries."
                                                    data-confirm-title="Confirm Payroll Payout"
                                                    data-confirm-type="warning">
                                                Pay
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-sm text-gray" style="display:inline-block; padding: 4px 8px;">Completed</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="padding: 40px; text-align: center; color: var(--text-muted);">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="margin-bottom: 1rem; opacity: 0.5;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <p>No payroll runs found.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ── Glassmorphic Draft Modal ──────────────────────────────────────── -->
    <div id="draftModalOverlay" class="glass-modal-overlay">
        <div class="glass-modal">
            <div class="glass-modal-header">
                <h3 class="glass-modal-title">Draft Payroll</h3>
                <button type="button" class="glass-modal-close" onclick="document.getElementById('draftModalOverlay').classList.remove('open')">&times;</button>
            </div>
            <form method="post" asp-page-handler="Draft">
                <div class="glass-form-group">
                    <label class="glass-label">Period Start</label>
                    <input asp-for="DraftPeriodStart" type="date" class="glass-input" required />
                </div>
                <div class="glass-form-group">
                    <label class="glass-label">Period End</label>
                    <input asp-for="DraftPeriodEnd" type="date" class="glass-input" required />
                </div>
                <div class="glass-actions">
                    <button type="button" class="btn-brand-secondary" onclick="document.getElementById('draftModalOverlay').classList.remove('open')" style="padding: 10px 16px;">Cancel</button>
                    <button type="submit" class="btn-brand-primary" style="padding: 10px 16px;">Draft Run</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ── PAYE Tax Brackets Management Modal ──────────────────── -->
    <div id="taxBracketsModalOverlay" class="glass-modal-overlay">
        <div class="glass-modal" style="max-width: 780px; max-height: 90vh; overflow-y: auto;">
            <div class="glass-modal-header">
                <div>
                    <h3 class="glass-modal-title">PAYE Tax Brackets &amp; Thresholds</h3>
                    <p style="font-size:0.80rem; color:var(--text-muted); margin:4px 0 0 0;">
                        Configure progressive statutory income tax rates applied during automatic payroll deduction calculations.
                    </p>
                </div>
                <button type="button" class="glass-modal-close" onclick="closeTaxBracketsModal()">&times;</button>
            </div>

            <!-- Existing Brackets Table -->
            <div style="margin-bottom: 24px; border: 1px solid var(--border); border-radius: 8px; overflow: hidden;">
                <table style="width:100%; border-collapse:collapse; font-size:0.84rem;">
                    <thead>
                        <tr style="background:#f8fafc; border-bottom:1px solid var(--border); text-align:left;">
                            <th style="padding:10px 14px; font-weight:600; color:#475569;">Income Bracket (XAF)</th>
                            <th style="padding:10px 14px; font-weight:600; color:#475569;">Tax Rate</th>
                            <th style="padding:10px 14px; font-weight:600; color:#475569;">Fixed Tax</th>
                            <th style="padding:10px 14px; font-weight:600; color:#475569;">Status</th>
                            <th style="padding:10px 14px; font-weight:600; color:#475569; text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TaxBrackets == null || !Model.TaxBrackets.Any())
                        {
                            <tr>
                                <td colspan="5" style="padding:24px; text-align:center; color:var(--text-muted);">
                                    No tax brackets configured. Progressive PAYE will default to 0%.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var tb in Model.TaxBrackets!.OrderBy(b => b.MinAmount))
                            {
                                var rangeStr = tb.MaxAmount.HasValue
                                    ? $"{tb.MinAmount:N0} – {tb.MaxAmount.Value:N0} XAF"
                                    : $"> {tb.MinAmount:N0} XAF (Uncapped)";

                                <tr style="border-bottom:1px solid #f1f5f9;">
                                    <td style="padding:10px 14px; font-weight:600; color:#0f172a;">
                                        @rangeStr
                                    </td>
                                    <td style="padding:10px 14px;">
                                        <span style="font-weight:700; color:#059669;">@tb.TaxPercentage.ToString("G29")%</span>
                                    </td>
                                    <td style="padding:10px 14px; color:#64748b;">
                                        @tb.FixedTaxAmount.ToString("N0") XAF
                                    </td>
                                    <td style="padding:10px 14px;">
                                        @if (tb.IsActive)
                                        {
                                            <span style="background:#ecfdf5; color:#059669; padding:2px 8px; border-radius:12px; font-size:0.75rem; font-weight:600;">Active</span>
                                        }
                                        else
                                        {
                                            <span style="background:#f1f5f9; color:#64748b; padding:2px 8px; border-radius:12px; font-size:0.75rem; font-weight:600;">Inactive</span>
                                        }
                                    </td>
                                    <td style="padding:10px 14px; text-align:right;">
                                        <div style="display:inline-flex; gap:6px; align-items:center;">
                                            <button type="button" class="btn-table-action"
                                                    onclick="openEditTaxBracket(@tb.TaxBracketId, @tb.MinAmount, @(tb.MaxAmount.HasValue ? tb.MaxAmount.Value.ToString() : "null"), @tb.TaxPercentage, @tb.FixedTaxAmount, @(tb.IsActive ? "true" : "false"))"
                                                    style="padding:3px 8px; font-size:0.78rem;">
                                                Edit
                                            </button>
                                            @if (Model.CanDelete)
                                            {
                                                <form method="post" asp-page-handler="DeleteTaxBracket" style="margin:0; display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@tb.TaxBracketId" />
                                                    <button type="submit" class="btn-table-action danger" data-confirm="Delete tax bracket @rangeStr?" data-confirm-type="danger" data-confirm-title="Delete Tax Bracket" style="padding:3px 8px; font-size:0.78rem;">
                                                        Delete
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Add / Edit Form Card -->
            <div style="background:#f8fafc; border:1px solid var(--border); border-radius:10px; padding:16px;">
                <h4 id="tbFormTitle" style="font-size:0.92rem; font-weight:700; margin:0 0 12px 0; color:#0f172a;">
                    Add New Tax Bracket
                </h4>
                <form method="post" asp-page-handler="SaveTaxBracket">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="tbId" value="0" />
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
                        <div class="glass-form-group" style="margin-bottom:0;">
                            <label class="glass-label" style="font-size:0.80rem;">Minimum Income (XAF) <span style="color:#ef4444;">*</span></label>
                            <input type="number" name="minAmount" id="tbMin" class="glass-input" placeholder="0" min="0" step="100" required />
                        </div>
                        <div class="glass-form-group" style="margin-bottom:0;">
                            <label class="glass-label" style="font-size:0.80rem;">Maximum Income (XAF) <small style="color:var(--text-muted);">(Empty if uncapped)</small></label>
                            <input type="number" name="maxAmount" id="tbMax" class="glass-input" placeholder="e.g. 150000" min="0" step="100" />
                        </div>
                        <div class="glass-form-group" style="margin-bottom:0;">
                            <label class="glass-label" style="font-size:0.80rem;">Tax Percentage (%) <span style="color:#ef4444;">*</span></label>
                            <input type="number" name="taxPercentage" id="tbPct" class="glass-input" placeholder="e.g. 10 for 10%" min="0" max="100" step="0.1" required />
                        </div>
                        <div class="glass-form-group" style="margin-bottom:0;">
                            <label class="glass-label" style="font-size:0.80rem;">Fixed Tax Amount (XAF)</label>
                            <input type="number" name="fixedTaxAmount" id="tbFixed" class="glass-input" placeholder="0" min="0" step="100" value="0" />
                        </div>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px;">
                        <label style="display:flex; align-items:center; gap:8px; font-size:0.84rem; font-weight:600; cursor:pointer;">
                            <input type="checkbox" name="isActive" id="tbActive" value="true" checked />
                            Active for payroll calculation
                        </label>
                        <div style="display:flex; gap:8px;">
                            <button type="button" class="btn-brand-secondary" onclick="resetTaxBracketForm()" style="padding:6px 14px; font-size:0.82rem;">Reset Form</button>
                            <button type="submit" class="btn-brand-primary" id="tbSubmitBtn" style="padding:6px 14px; font-size:0.82rem;">Save Bracket</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openTaxBracketsModal() {
            document.getElementById('taxBracketsModalOverlay').classList.add('open');
        }
        function closeTaxBracketsModal() {
            document.getElementById('taxBracketsModalOverlay').classList.remove('open');
            resetTaxBracketForm();
        }
        function openEditTaxBracket(id, min, max, pct, fixed, active) {
            document.getElementById('tbFormTitle').textContent = 'Edit Tax Bracket (ID: ' + id + ')';
            document.getElementById('tbId').value = id;
            document.getElementById('tbMin').value = min;
            document.getElementById('tbMax').value = (max !== null && max !== undefined) ? max : '';
            document.getElementById('tbPct').value = pct;
            document.getElementById('tbFixed').value = fixed;
            document.getElementById('tbActive').checked = active;
            document.getElementById('tbSubmitBtn').textContent = 'Update Bracket';
        }
        function resetTaxBracketForm() {
            document.getElementById('tbFormTitle').textContent = 'Add New Tax Bracket';
            document.getElementById('tbId').value = '0';
            document.getElementById('tbMin').value = '';
            document.getElementById('tbMax').value = '';
            document.getElementById('tbPct').value = '';
            document.getElementById('tbFixed').value = '0';
            document.getElementById('tbActive').checked = true;
            document.getElementById('tbSubmitBtn').textContent = 'Save Bracket';
        }
    </script>
}
