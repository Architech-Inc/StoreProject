@page
@model PaymentsModel
@using StoreUI.Pages
@using Store.Models.Enums
@using Store.Models.DTOs.Payments
@{
    ViewData["Title"] = "Mobile Money & Digital Settlements";
    ViewData["ActivePage"] = "Payments";
    ViewData["PageDescription"] = "Live monitoring of MTN Mobile Money, Orange Money, and electronic payment provider settlements.";
    Layout = "~/Pages/Shared/_AppLayout.cshtml";
    var s = Model.Settlement;
}

<div class="pay-container">
    @* ── ACTION TOOLBAR ── *@
    <div class="pay-action-bar">
        <div class="pay-status-pill">
            <span class="status-indicator-dot"></span>
            <span>Electronic Settlement Gateway &amp; Provider Feeds</span>
        </div>
        <div class="pay-header-actions">
            <a href="?handler=ExportCsv&status=@((int?)Model.StatusFilter)&from=@Model.FromDate?.ToString("yyyy-MM-dd")&to=@Model.ToDate?.ToString("yyyy-MM-dd")" class="btn-pay-action btn-pay-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Export Settlement CSV
            </a>
            <a href="/Invoices" class="btn-pay-action btn-pay-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Invoices &amp; Billing
            </a>
            <a href="/Pos" class="btn-pay-action btn-pay-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                POS Register
            </a>
        </div>
    </div>

    @* ── DATE & STATUS FILTER DOCK ── *@
    <div class="pay-filter-dock">
        <form method="get" class="pay-filter-form">
            <input type="hidden" name="page" value="1" />
            <div class="filter-field">
                <label for="fromDate">Settlement From</label>
                <input type="date" id="fromDate" name="from" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="filter-field">
                <label for="toDate">Settlement To</label>
                <input type="date" id="toDate" name="to" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="filter-field">
                <label for="statusSelect">Provider Status</label>
                <select id="statusSelect" name="status" class="form-control form-control-sm">
                    <option value="">All Provider Statuses</option>
                    @foreach (MobileMoneyStatus st in Enum.GetValues<MobileMoneyStatus>())
                    {
                        <option value="@((int)st)" selected="@(Model.StatusFilter == st)">@st</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn-filter-apply">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                </svg>
                Apply Settlement Filters
            </button>
        </form>
    </div>

    @* ── 4-CARD FLUENT 2.0 KPI GRID ── *@
    @if (s is not null)
    {
        <div class="pay-kpi-grid">
            @* KPI 1: Total Sales *@
            <div class="pay-kpi-card">
                <div class="kpi-icon-wrap kpi-emerald">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="kpi-data">
                    <span class="kpi-label">Electronic Settlement Total</span>
                    <span class="kpi-value">@s.TotalSales.ToString("N0") <small>XAF</small></span>
                    <span class="kpi-subtext">Across @s.TotalInvoices Settled Invoices</span>
                </div>
            </div>

            @* KPI 2: Total Invoices *@
            <div class="pay-kpi-card">
                <div class="kpi-icon-wrap kpi-teal">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <div class="kpi-data">
                    <span class="kpi-label">Settled Invoices</span>
                    <span class="kpi-value">@s.TotalInvoices.ToString("N0") <small>Tickets</small></span>
                    <span class="kpi-subtext">Completed digital transactions</span>
                </div>
            </div>

            @* KPI 3: Pending Transactions *@
            <div class="pay-kpi-card">
                <div class="kpi-icon-wrap @(s.PendingMobileMoneyTransactions.Count > 0 ? "kpi-amber" : "kpi-emerald")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="kpi-data">
                    <span class="kpi-label">Pending MoMo Authorizations</span>
                    <span class="kpi-value" style="color:@(s.PendingMobileMoneyTransactions.Count > 0 ? "#d97706" : "#059669");">
                        @s.PendingMobileMoneyTransactions.Count.ToString("N0") <small>Awaiting PIN</small>
                    </span>
                    <span class="kpi-subtext">@(s.PendingMobileMoneyTransactions.Count > 0 ? "USSD prompts in progress" : "All prompts resolved")</span>
                </div>
            </div>

            @* KPI 4: Channels Active *@
            <div class="pay-kpi-card">
                <div class="kpi-icon-wrap kpi-purple">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                </div>
                <div class="kpi-data">
                    <span class="kpi-label">Provider Channels</span>
                    <span class="kpi-value">@s.ByChannel.Count <small>Active</small></span>
                    <span class="kpi-subtext">MTN, Orange, Card Terminals</span>
                </div>
            </div>
        </div>
    }

    @* ── 2-PANEL LAYOUT ── *@
    <div style="display:grid; grid-template-columns: 1fr 2.2fr; gap:1.25rem;">
        @* Left: Settlement Channels Matrix *@
        <div class="pay-panel">
            <div class="panel-header-dock">
                <div class="panel-title-wrap">
                    <h3>Settlement Channels</h3>
                    <p>Volume distribution by provider.</p>
                </div>
            </div>
            @if (s is null || !s.ByChannel.Any())
            {
                <div class="pay-empty-state">
                    <p>No settlement records for period.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="pay-table">
                        <thead>
                            <tr>
                                <th>Channel</th>
                                <th style="text-align:center;">Invoices</th>
                                <th style="text-align:right;">Volume (XAF)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ch in s.ByChannel)
                            {
                                <tr>
                                    <td>
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <span class="channel-pill @(ch.Channel.Contains("MTN", StringComparison.OrdinalIgnoreCase) ? "ch-mtn" : ch.Channel.Contains("Orange", StringComparison.OrdinalIgnoreCase) ? "ch-orange" : "ch-card")">
                                                @ch.Channel
                                            </span>
                                        </div>
                                    </td>
                                    <td style="text-align:center; font-weight:600;">@ch.InvoiceCount</td>
                                    <td style="text-align:right; font-weight:700; color:#0f172a;">
                                        @ch.TotalAmount.ToString("N0")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* Right: Transaction Feed Ledger *@
        <div class="pay-panel">
            <div class="panel-header-dock">
                <div class="panel-title-wrap">
                    <h3>Live Mobile Money &amp; Provider Feed</h3>
                    <p>Detailed transaction log with provider references and timestamps.</p>
                </div>
            </div>
            @if (!Model.Transactions.Any())
            {
                <div class="pay-empty-state">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <h4>No Transactions Found</h4>
                    <p>There are no payment feed records matching your criteria.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="pay-table">
                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>Invoice</th>
                                <th>Provider</th>
                                <th>Customer Phone</th>
                                <th style="text-align:right;">Amount (XAF)</th>
                                <th style="text-align:center;">Status</th>
                                <th>Provider Reference</th>
                                <th style="text-align:center;">Polling &amp; Audit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in Model.Transactions)
                            {
                                var isPending = string.Equals(tx.Status, "Pending", StringComparison.OrdinalIgnoreCase);
                                <tr id="row-@tx.MobileMoneyTransactionId">
                                    <td style="font-size:0.78rem; color:#64748b; white-space:nowrap;">
                                        @tx.DateCreated.ToLocalTime().ToString("dd MMM HH:mm")
                                    </td>
                                    <td>
                                        <code style="font-size:0.80rem; font-weight:700; color:#019c01;">#@tx.InvoiceId.ToString()[..8]</code>
                                    </td>
                                    <td>
                                        <span class="provider-badge @(tx.Provider.Contains("MTN", StringComparison.OrdinalIgnoreCase) ? "prov-mtn" : tx.Provider.Contains("Orange", StringComparison.OrdinalIgnoreCase) ? "prov-orange" : "prov-generic")">
                                            @tx.Provider
                                        </span>
                                    </td>
                                    <td style="font-family:'JetBrains Mono', monospace; font-size:0.80rem; color:#0f172a;">
                                        @(string.IsNullOrWhiteSpace(tx.PhoneNumber) ? "—" : tx.PhoneNumber)
                                    </td>
                                    <td style="text-align:right; font-weight:700; color:#0f172a;">
                                        @tx.Amount.ToString("N0")
                                    </td>
                                    <td style="text-align:center;">
                                        @{
                                            var badgeClass = tx.Status switch
                                            {
                                                "Completed" or "Successful" => "status-completed",
                                                "Pending"                   => "status-pending",
                                                "Failed"                    => "status-failed",
                                                "TimedOut"                  => "status-timedout",
                                                _                           => "status-generic"
                                            };
                                        }
                                        <span class="pay-status-badge @badgeClass cell-status">@tx.Status</span>
                                    </td>
                                    <td style="font-family:'JetBrains Mono', monospace; font-size:0.75rem; color:#64748b;" class="cell-provider-ref">
                                        @(tx.ProviderTransactionId ?? "—")
                                    </td>
                                    <td style="text-align:center;" class="cell-action">
                                        @if (isPending)
                                        {
                                            <button type="button" 
                                                    class="btn-tx-poll" 
                                                    data-tx-id="@tx.MobileMoneyTransactionId" 
                                                    onclick="pollTxStatus(this)"
                                                    title="Re-query status directly from payment gateway">
                                                <svg class="poll-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                                </svg>
                                                <span>Poll Gateway</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span style="font-size:0.72rem; color:#94a3b8; font-weight:600;">Settled</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pay-pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="?page=@(Model.CurrentPage - 1)&status=@((int?)Model.StatusFilter)&from=@Model.FromDate?.ToString("yyyy-MM-dd")&to=@Model.ToDate?.ToString("yyyy-MM-dd")" class="btn-page-ctrl">&larr; Previous</a>
                    }
                    <span class="page-current">Page @Model.CurrentPage</span>
                    @if (Model.Transactions.Count == Model.PageSize)
                    {
                        <a href="?page=@(Model.CurrentPage + 1)&status=@((int?)Model.StatusFilter)&from=@Model.FromDate?.ToString("yyyy-MM-dd")&to=@Model.ToDate?.ToString("yyyy-MM-dd")" class="btn-page-ctrl">Next &rarr;</a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* ── TRANSACTION STATUS POLLING SCRIPT ── *@
<script>
    async function pollTxStatus(btn) {
        if (btn.classList.contains('loading')) return;

        const txId = btn.getAttribute('data-tx-id');
        if (!txId) return;

        btn.classList.add('loading');

        try {
            const pollFn = async (attempt) => {
                const resp = await fetch(`?handler=QueryStatus&id=${txId}`);
                if (!resp.ok) {
                    const errData = await resp.json().catch(() => ({}));
                    throw new Error(errData.message || `Server responded with status ${resp.status}`);
                }

                const data = await resp.json();
                if (!data.success) {
                    throw new Error(data.message || 'Unable to retrieve status from gateway.');
                }

                // If not pending (i.e. completed or failed), terminal state reached
                return { done: !data.isPending, data: data };
            };

            let resultData = null;
            if (typeof window.pollWithExponentialBackoff === 'function') {
                const pollResult = await window.pollWithExponentialBackoff(pollFn, {
                    maxAttempts: 3,
                    initialDelayMs: 1500,
                    onRetry: (attempt, delayMs) => {
                        if (window.showToast) {
                            window.showToast(`Gateway pending... retrying status verification in ${(delayMs/1000).toFixed(1)}s (Attempt ${attempt}/3)`, 'info');
                        }
                    }
                });
                resultData = pollResult?.data;
            } else {
                const singleRes = await pollFn(1);
                resultData = singleRes?.data;
            }

            if (resultData) {
                const row = document.getElementById(`row-${txId}`);
                if (row) {
                    const statusCell = row.querySelector('.cell-status');
                    const refCell = row.querySelector('.cell-provider-ref');
                    const actionCell = row.querySelector('.cell-action');

                    if (statusCell) {
                        statusCell.textContent = resultData.status;
                        statusCell.className = `pay-status-badge cell-status ${resultData.isSuccess ? 'status-completed' : (resultData.isPending ? 'status-pending' : 'status-failed')}`;
                    }

                    if (refCell && resultData.providerRef !== 'N/A') {
                        refCell.textContent = resultData.providerRef;
                    }

                    if (actionCell && !resultData.isPending) {
                        actionCell.innerHTML = '<span style="font-size:0.72rem; color:#94a3b8; font-weight:600;">Settled</span>';
                    }
                }

                if (window.showToast) {
                    window.showToast(resultData.message, resultData.isSuccess ? 'success' : (resultData.isPending ? 'info' : 'warning'));
                }
            }
        } catch (err) {
            if (window.showToast) {
                window.showToast(`Polling error: ${err.message}`, 'error');
            } else {
                alert(`Error: ${err.message}`);
            }
        } finally {
            btn.classList.remove('loading');
        }
    }
</script>
