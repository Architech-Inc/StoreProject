@page
@model StoreUI.Pages.DashboardModel
@{
    ViewData["Title"] = "Store Command Dashboard";
    ViewData["ActivePage"] = "Dashboard";
    ViewData["PageDescription"] = "Real-time executive summary of sales velocity, customer accounts, and supply chain health.";
    Layout = "~/Pages/Shared/_AppLayout.cshtml";
}

<div class="dash-container">
    @* ── WELCOME & ACTION HEADER ── *@
    <div class="dash-header-bar">
        <div class="dash-greeting">
            <h1 class="dash-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color:#019c01;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                Operations Command Center
            </h1>
            <p class="dash-subtitle">Real-time overview across Point of Sale registers, customer CRM, and supply chain inventory.</p>
        </div>
        <div class="dash-header-actions">
            <a href="/Pos" class="btn-dash-action btn-dash-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                Launch POS Terminal
            </a>
            <a href="/Invoices" class="btn-dash-action btn-dash-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Invoices &amp; Billing Hub
            </a>
        </div>
    </div>

    @if (Model.HasLoadError)
    {
        <div class="dash-alert error" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span><strong>Data Sync Issue:</strong> @Model.LoadErrorMessage</span>
        </div>
    }

    @* ── 4-CARD FLUENT 2.0 KPI GRID ── *@
    <div class="dash-kpi-grid">
        @* KPI 1: Total Catalog Items *@
        <div class="dash-kpi-card">
            <div class="kpi-icon-wrap kpi-emerald">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Active Catalog Items</span>
                <span class="kpi-value">@Model.TotalItems.ToString("N0") <small>SKUs</small></span>
                <span class="kpi-subtext">Merchandise in store catalog</span>
            </div>
        </div>

        @* KPI 2: Total Customers *@
        <div class="dash-kpi-card">
            <div class="kpi-icon-wrap kpi-teal">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Registered Customers</span>
                <span class="kpi-value">@Model.TotalCustomers.ToString("N0") <small>Accounts</small></span>
                <span class="kpi-subtext">Active loyalty accounts</span>
            </div>
        </div>

        @* KPI 3: Invoices Processed *@
        <div class="dash-kpi-card">
            <div class="kpi-icon-wrap kpi-purple">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Invoices Processed</span>
                <span class="kpi-value">@Model.TotalInvoices.ToString("N0") <small>Settled</small></span>
                <span class="kpi-subtext">Total transactions billed</span>
            </div>
        </div>

        @* KPI 4: Low Stock Alert *@
        <div class="dash-kpi-card">
            <div class="kpi-icon-wrap @(Model.LowStockItems > 0 ? "kpi-rose" : "kpi-emerald")">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Low Stock Alerts</span>
                <span class="kpi-value" style="color:@(Model.LowStockItems > 0 ? "#e11d48" : "#059669");">
                    @Model.LowStockItems.ToString("N0") <small>Items</small>
                </span>
                <span class="kpi-subtext">@(Model.LowStockItems > 0 ? "Items below reorder point" : "Inventory levels healthy")</span>
            </div>
        </div>
    </div>

    @* ── 2-COLUMN OPERATIONAL GRID ── *@
    <div class="dash-split-grid">
        @* Left: Recent Invoices *@
        <div class="dash-panel">
            <div class="panel-header-dock">
                <div class="panel-title-wrap">
                    <h3>Recent Invoices &amp; Transactions</h3>
                    <p>Latest customer billing tickets processed at POS registers.</p>
                </div>
                <a href="/Invoices" class="btn-panel-link">View All &rarr;</a>
            </div>

            @if (!Model.RecentInvoices.Any())
            {
                <div class="dash-empty-state">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <h4>No Invoices Recorded</h4>
                    <p>No recent billing activity found in system.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Customer</th>
                                <th style="text-align:right;">Amount (XAF)</th>
                                <th style="text-align:center;">Status</th>
                                <th style="text-align:right;">Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Model.RecentInvoices)
                            {
                                <tr>
                                    <td>
                                        <code style="font-size:0.82rem; font-weight:700; color:#019c01;">#@inv.InvoiceId.ToString()[..8]</code>
                                    </td>
                                    <td>
                                        <span style="font-weight:600; color:#0f172a;">@(string.IsNullOrWhiteSpace(inv.CustomerName) ? "Walk-in Customer" : inv.CustomerName)</span>
                                    </td>
                                    <td style="text-align:right; font-weight:700; color:#0f172a;">
                                        @inv.TotalAmount.ToString("N0") <small style="color:#64748b;">XAF</small>
                                    </td>
                                    <td style="text-align:center;">
                                        <span class="status-badge @(inv.IsPaid ? "status-reviewed" : "status-pending")">
                                            @(inv.IsPaid ? "Paid" : "Pending")
                                        </span>
                                    </td>
                                    <td style="text-align:right; font-size:0.75rem; color:#64748b;">
                                        @inv.DateCreated.ToString("dd MMM HH:mm")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* Right: Low Stock Watchlist *@
        <div class="dash-panel">
            <div class="panel-header-dock">
                <div class="panel-title-wrap">
                    <h3>Low Stock Reorder Watchlist</h3>
                    <p>Products at or below their designated minimum threshold.</p>
                </div>
                <a href="/PurchaseOrders" class="btn-panel-link">Procurement &rarr;</a>
            </div>

            @if (!Model.LowStockList.Any())
            {
                <div class="dash-empty-state">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="#059669">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <h4 style="color:#059669;">Inventory Levels Optimal</h4>
                    <p>All catalog products exceed minimum safety stock thresholds.</p>
                </div>
            }
            else
            {
                <div class="low-stock-list">
                    @foreach (var item in Model.LowStockList)
                    {
                        <div class="stock-item-row">
                            <div style="display:flex; align-items:center; gap:10px;">
                                <div class="stock-alert-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                    </svg>
                                </div>
                                <div>
                                    <strong style="font-size:0.88rem; color:#0f172a;">@item.Name</strong>
                                    <span style="font-size:0.75rem; color:#64748b; display:block;">@(item.CategoryName ?? "General Goods")</span>
                                </div>
                            </div>
                            <div style="display:flex; align-items:center; gap:10px;">
                                <span class="stock-count-pill">
                                    <strong>@item.InStock</strong> in stock
                                </span>
                                <a href="/PurchaseOrders" class="btn-restock-sm" title="Create Purchase Order">Restock</a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* ── CATEGORIZED OPERATIONAL SHORTCUTS ── *@
    <div class="dash-panel">
        <div class="panel-header-dock">
            <div class="panel-title-wrap">
                <h3>Store Operations &amp; Management Hubs</h3>
                <p>Fast navigation shortcuts to all functional modules across ClexAn Foods operations.</p>
            </div>
        </div>
        <div class="shortcuts-grid">
            @* Category 1: Sales & Customers *@
            <div class="shortcut-group">
                <span class="group-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    Sales &amp; Customers
                </span>
                <div class="group-links">
                    <a href="/Pos" class="shortcut-pill">POS Terminal</a>
                    <a href="/Catalog" class="shortcut-pill">Product Catalog</a>
                    <a href="/Customers" class="shortcut-pill">Customers 360</a>
                    <a href="/Invoices" class="shortcut-pill">Invoices &amp; Billing</a>
                    <a href="/Loyalty" class="shortcut-pill">Customer Loyalty</a>
                </div>
            </div>

            @* Category 2: Supply Chain & Stock *@
            <div class="shortcut-group">
                <span class="group-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                    Supply Chain &amp; Stock
                </span>
                <div class="group-links">
                    <a href="/PurchaseOrders" class="shortcut-pill">Purchase Orders</a>
                    <a href="/Suppliers" class="shortcut-pill">Suppliers Hub</a>
                    <a href="/StockTransfers" class="shortcut-pill">Stock Transfers</a>
                    <a href="/BatchTracking" class="shortcut-pill">Batch Tracking</a>
                    <a href="/Wastage" class="shortcut-pill">Wastage &amp; Shrinkage</a>
                    @if (Model.CanInventoryRead)
                    {
                        <a href="/InventoryOps" class="shortcut-pill">Inventory Operations</a>
                    }
                </div>
            </div>

            @* Category 3: Cash & Fiscal *@
            <div class="shortcut-group">
                <span class="group-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Cash &amp; Fiscal Balancing
                </span>
                <div class="group-links">
                    <a href="/CashReports" class="shortcut-pill">Cash Reports / Z-Reports</a>
                    <a href="/Reconciliation" class="shortcut-pill">Day-End Reconciliation</a>
                    <a href="/CashVariance" class="shortcut-pill">Cash Variance &amp; Audits</a>
                    @if (Model.CanPaymentsRead)
                    {
                        <a href="/Payments" class="shortcut-pill">Mobile Money Payments</a>
                    }
                </div>
            </div>

            @* Category 4: Pricing, Audit & Admin *@
            <div class="shortcut-group">
                <span class="group-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    Pricing, Governance &amp; Admin
                </span>
                <div class="group-links">
                    <a href="/PricingOps" class="shortcut-pill">Pricing Operations</a>
                    <a href="/DiscountOverrides" class="shortcut-pill">Discount Overrides</a>
                    <a href="/PromotionEffectiveness" class="shortcut-pill">Promo Effectiveness</a>
                    <a href="/Employees" class="shortcut-pill">Employees Hub</a>
                    <a href="/AuditLog" class="shortcut-pill">Audit Trail</a>
                    @if (Model.CanAdminBranches)
                    {
                        <a href="/BranchAdmin" class="shortcut-pill">Branch Admin</a>
                        <a href="/BranchDashboard" class="shortcut-pill">Branch Performance</a>
                    }
                    @if (Model.CanAdminRoleMatrix)
                    {
                        <a href="/Users" class="shortcut-pill">Users</a>
                        <a href="/RoleMatrix" class="shortcut-pill">Role Matrix</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
