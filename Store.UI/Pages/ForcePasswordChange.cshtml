@page
@model StoreUI.Pages.ForcePasswordChangeModel
@{
    ViewData["Title"] = "Update Password Required";
    Layout = "_LandingLayout";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header text-center">
            <div class="auth-logo">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h2>Update Required</h2>
            <p>For your security, you must change your temporary password before accessing the system.</p>
        </div>

        @if (Model.IsError)
        {
            <div class="alert alert-danger mt-4">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" id="forcePasswordForm">
            @if (!ModelState.IsValid && ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger">
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>
            }

            <div class="form-group mb-4">
                <label asp-for="Input.CurrentPassword">Current Temporary Password</label>
                <div class="input-wrapper">
                    <i class="fas fa-unlock"></i>
                    <input asp-for="Input.CurrentPassword" type="password" class="form-control" placeholder="••••••••" required />
                </div>
                <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.NewPassword">New Password</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock"></i>
                    <input asp-for="Input.NewPassword" type="password" class="form-control" placeholder="••••••••" autocomplete="new-password" required minlength="8" />
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.ConfirmPassword">Confirm New Password</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock"></i>
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="••••••••" autocomplete="new-password" required minlength="8" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-login" id="btnSubmit">
                <span>Update Password</span>
                <div class="btn-loader" style="display: none;">
                    <i class="fas fa-circle-notch fa-spin"></i>
                </div>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('forcePasswordForm')?.addEventListener('submit', function (e) {
            if (this.checkValidity()) {
                const btn = document.getElementById('btnSubmit');
                btn.classList.add('loading');
                btn.querySelector('span').style.opacity = '0';
                btn.querySelector('.btn-loader').style.display = 'block';
            }
        });
    </script>
}
