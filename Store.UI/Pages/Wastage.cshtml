@page
@model StoreUI.Pages.WastageModel
@{
    ViewData["Title"] = "Wastage & Loss Prevention Log";
    ViewData["ActivePage"] = "Wastage";
    ViewData["PageDescription"] = "Audit stock write-offs, shrinkage, damages, and expiration financial losses.";
    Layout = "~/Pages/Shared/_AppLayout.cshtml";
}

<div class="wastage-hub-container">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="toast-banner @(Model.StatusMessage.StartsWith("Error") ? "error" : "success")">
            @if (Model.StatusMessage.StartsWith("Error"))
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            }
            <span>@Model.StatusMessage</span>
        </div>
    }

    <!-- 4-Card Interactive KPI Banner -->
    <div class="wastage-kpi-grid">
        <div class="wastage-kpi-card">
            <div class="kpi-icon-box red">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Total Written-Off Value</span>
                <span class="kpi-value" title="@Model.Metrics.TotalValuationXaf.ToString("N0") XAF">@Model.Metrics.TotalValuationXaf.ToString("N0") XAF</span>
                <span class="kpi-sub">@Model.Metrics.TotalQuantity units across all reasons</span>
            </div>
        </div>

        <div class="wastage-kpi-card">
            <div class="kpi-icon-box amber">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Expired Stock Losses</span>
                <span class="kpi-value" title="@Model.Metrics.TotalExpiredLossXaf.ToString("N0") XAF">@Model.Metrics.TotalExpiredLossXaf.ToString("N0") XAF</span>
                <span class="kpi-sub">Past shelf-life write-offs</span>
            </div>
        </div>

        <div class="wastage-kpi-card">
            <div class="kpi-icon-box purple">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Damages & Spoilage</span>
                <span class="kpi-value" title="@((Model.Metrics.TotalDamagedLossXaf + Model.Metrics.TotalSpoiledLossXaf).ToString("N0")) XAF">@((Model.Metrics.TotalDamagedLossXaf + Model.Metrics.TotalSpoiledLossXaf).ToString("N0")) XAF</span>
                <span class="kpi-sub">Handling damages & perishables</span>
            </div>
        </div>

        <div class="wastage-kpi-card">
            <div class="kpi-icon-box emerald">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Total Write-Off Entries</span>
                <span class="kpi-value">@Model.Metrics.TotalEntries</span>
                <span class="kpi-sub">Loss prevention log count</span>
            </div>
        </div>
    </div>

    <!-- Filter Dock & Search Toolbar -->
    <div class="wastage-toolbar">
        <div class="toolbar-left">
            <form method="get" id="filterForm" class="search-box-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text" name="Search" value="@Model.Search" class="search-input" placeholder="Search item, barcode, ref code, user..." onchange="document.getElementById('filterForm').submit();" />
                @if (!string.IsNullOrWhiteSpace(Model.WastageTypeFilter))
                {
                    <input type="hidden" name="WastageTypeFilter" value="@Model.WastageTypeFilter" />
                }
            </form>

            <!-- Reason Filter Pills -->
            <div class="reason-filter-pills">
                <a href="?Search=@Model.Search" class="filter-pill @(string.IsNullOrWhiteSpace(Model.WastageTypeFilter) ? "active" : "")">All Reasons</a>
                @foreach (var wt in Model.AvailableWastageTypes)
                {
                    <a href="?WastageTypeFilter=@wt&Search=@Model.Search" class="filter-pill @(Model.WastageTypeFilter == wt.ToString() ? "active" : "")">@wt</a>
                }
            </div>
        </div>

        <div class="toolbar-right">
            <a asp-page-handler="ExportCsv" asp-route-Search="@Model.Search" asp-route-WastageTypeFilter="@Model.WastageTypeFilter" class="btn-brand-secondary" title="Export Loss Prevention Manifest">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Export CSV
            </a>

            <button type="button" class="btn-brand-primary" onclick="openRecordModal()">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Record Wastage
            </button>
        </div>
    </div>

    <!-- Data Stream Table Card -->
    <div class="wastage-table-card">
        @if (!Model.WastagePaged.Items.Any())
        {
            <div class="empty-state-wrap">
                <div class="empty-icon-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                </div>
                <h4 style="font-size: 1.05rem; font-weight: 600; color: #0f172a; margin: 0;">No Wastage Entries Found</h4>
                <p style="font-size: 0.85rem; color: #64748b; margin: 0; max-width: 360px;">
                    No inventory write-off records match your filter criteria. Use "+ Record Wastage" to log a new loss event.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Product Details</th>
                            <th>Reason</th>
                            <th>Qty</th>
                            <th>Valuation (XAF)</th>
                            <th>Recorded By</th>
                            <th>Timestamp</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.WastagePaged.Items)
                        {
                            var reasonClass = item.WastageType.ToLowerInvariant() switch
                            {
                                "expiry" => "expiry",
                                "damage" => "damage",
                                "spoilage" => "spoilage",
                                "theft" => "theft",
                                "adminerror" => "adminerror",
                                _ => "other"
                            };

                            <tr>
                                <td>
                                    <span class="code-badge">@(item.ReferenceCode ?? $"WASTE-{item.WastageEntryId}")</span>
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column; gap: 2px;">
                                        <span style="font-weight: 600; color: #0f172a;">@item.ItemName</span>
                                        <div style="display: flex; align-items: center; gap: 6px;">
                                            @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                                            {
                                                <span class="badge-category">@item.CategoryName</span>
                                            }
                                            <span style="font-size: 0.75rem; color: #94a3b8; font-family: monospace;">@item.ItemCode</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge-reason @reasonClass">@item.WastageType</span>
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: #0f172a;">@item.Quantity</span> <span style="font-size: 0.78rem; color: #64748b;">units</span>
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column;">
                                        <span style="font-weight: 700; color: #dc2626;">@item.LineValuation.ToString("N0") XAF</span>
                                        <span style="font-size: 0.72rem; color: #94a3b8;">@@ @item.UnitCost.ToString("N0") XAF/unit</span>
                                    </div>
                                </td>
                                <td>
                                    <span style="font-weight: 500; color: #475569;">@item.RecordedByUser</span>
                                </td>
                                <td>
                                    <span style="font-size: 0.8rem; color: #64748b;">@item.DateCreated.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                                </td>
                                <td style="text-align: right;">
                                    <button type="button" class="btn-table-action danger" onclick="openDeleteModal(@item.WastageEntryId, '@item.ItemName', @item.Quantity)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.WastagePaged.TotalPages > 1)
            {
                <div class="pagination-container">
                    <span style="font-size: 0.82rem; color: #64748b;">
                        Showing page <strong>@Model.WastagePaged.Page</strong> of <strong>@Model.WastagePaged.TotalPages</strong> (@Model.WastagePaged.TotalCount total records)
                    </span>
                    <div style="display: flex; gap: 6px;">
                        @if (Model.WastagePaged.HasPreviousPage)
                        {
                            <a href="?PageNumber=@(Model.WastagePaged.Page - 1)&Search=@Model.Search&WastageTypeFilter=@Model.WastageTypeFilter" class="btn-brand-secondary" style="padding: 4px 10px; font-size: 0.8rem;">Previous</a>
                        }
                        @if (Model.WastagePaged.HasNextPage)
                        {
                            <a href="?PageNumber=@(Model.WastagePaged.Page + 1)&Search=@Model.Search&WastageTypeFilter=@Model.WastageTypeFilter" class="btn-brand-secondary" style="padding: 4px 10px; font-size: 0.8rem;">Next</a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Record Wastage Modal -->
<div class="modern-modal-overlay" id="recordModalOverlay" onclick="closeRecordModal()"></div>
<div class="modern-modal" id="recordWastageModal">
    <div class="modal-header">
        <h3 class="modal-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#019c01">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Record Inventory Wastage
        </h3>
        <button type="button" class="btn-close-modal" onclick="closeRecordModal()">&times;</button>
    </div>
    <form method="post" asp-page-handler="Record" id="recordWastageForm">
        @Html.AntiForgeryToken()
        <div class="modal-body">
            <!-- Product Smart Lookup -->
            <div class="form-field autocomplete-wrapper">
                <label class="form-label">Search Product Catalog <span style="color: #dc2626;">*</span></label>
                <input type="text" id="catalogSearchInput" class="form-input" placeholder="Type product name or scan barcode..." autocomplete="off" oninput="handleCatalogSearch(this.value)" data-scanner-input />
                <input type="hidden" name="RecordRequest.ItemId" id="selectedItemId" required />
                
                <div class="autocomplete-dropdown" id="catalogDropdown"></div>

                <div class="selected-item-pill" id="selectedItemDisplay" style="display: none;">
                    <div>
                        <div style="font-weight: 600; color: #065f46;" id="dispItemName">Item Name</div>
                        <div style="font-size: 0.75rem; color: #047857;" id="dispItemDetails">Category | Barcode</div>
                    </div>
                    <button type="button" class="btn-table-action" style="font-size: 0.72rem; padding: 2px 6px;" onclick="clearSelectedItem()">Change</button>
                </div>
            </div>

            <div class="form-row-group">
                <div class="form-field">
                    <label class="form-label">Wastage Reason <span style="color: #dc2626;">*</span></label>
                    <select name="RecordRequest.WastageType" class="form-select">
                        @foreach (var wt in Model.AvailableWastageTypes)
                        {
                            <option value="@wt">@wt</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Quantity to Write Off <span style="color: #dc2626;">*</span></label>
                    <input type="number" name="RecordRequest.Quantity" id="writeOffQty" class="form-input" min="1" value="1" required oninput="recalcValuation()" />
                </div>
            </div>

            <div class="form-field">
                <label class="form-label">Reference / Incident Code</label>
                <input type="text" name="RecordRequest.ReferenceCode" id="refCodeInput" class="form-input" placeholder="e.g. WASTE-2026-001" maxlength="100" />
            </div>

            <!-- Dynamic Loss Valuation Summary -->
            <div class="valuation-summary-banner" id="valuationBanner">
                <div class="valuation-metric">
                    <span class="val-label">Unit Cost</span>
                    <span class="val-num" id="valUnitCost">0 XAF</span>
                </div>
                <div class="valuation-metric">
                    <span class="val-label">On-Hand Stock</span>
                    <span class="val-num" id="valInStock">0 units</span>
                </div>
                <div class="valuation-metric" style="text-align: right;">
                    <span class="val-label">Estimated Financial Loss</span>
                    <span class="val-num" style="color: #dc2626;" id="valTotalLoss">0 XAF</span>
                </div>
            </div>

            <div class="form-field">
                <label class="form-label">Audit Notes / Quality Inspection</label>
                <textarea name="RecordRequest.Notes" class="form-textarea" rows="2" placeholder="Describe the cause of loss or damage..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-brand-secondary" onclick="closeRecordModal()">Cancel</button>
            <button type="submit" class="btn-brand-primary">Record Write-Off</button>
        </div>
    </form>
</div>

<!-- Delete Confirmation Modal -->
<div class="modern-modal-overlay" id="deleteModalOverlay" onclick="closeDeleteModal()"></div>
<div class="modern-modal" id="deleteWastageModal" style="max-width: 440px;">
    <div class="modal-header">
        <h3 class="modal-title" style="color: #dc2626;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Delete Wastage Record
        </h3>
        <button type="button" class="btn-close-modal" onclick="closeDeleteModal()">&times;</button>
    </div>
    <form method="post" asp-page-handler="Delete">
        @Html.AntiForgeryToken()
        <input type="hidden" name="DeleteEntryId" id="delEntryId" />
        <div class="modal-body">
            <p style="font-size: 0.9rem; color: #334155; margin: 0;">
                Are you sure you want to delete this wastage entry for <strong id="delItemName">Item</strong> (<span id="delItemQty">0</span> units)?
            </p>
            <div style="font-size: 0.78rem; color: #dc2626; background: #fef2f2; border: 1px solid #fecaca; border-radius: 6px; padding: 8px 12px; margin-top: 8px;">
                Note: Deleting this record removes the audit entry from the wastage log. Stock adjustments must be reconciled manually if needed.
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-brand-secondary" onclick="closeDeleteModal()">Cancel</button>
            <button type="submit" class="btn-brand-primary" style="background: #dc2626;">Delete Record</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let currentItemCost = 0;
        let currentInStock = 0;
        let searchTimeout = null;

        function openRecordModal() {
            document.getElementById('recordModalOverlay').classList.add('open');
            document.getElementById('recordWastageModal').classList.add('open');
            if (!document.getElementById('refCodeInput').value) {
                const now = new Date();
                const yr = now.getFullYear();
                const mo = String(now.getMonth() + 1).padStart(2, '0');
                const rnd = Math.floor(1000 + Math.random() * 9000);
                document.getElementById('refCodeInput').value = `WASTE-${yr}${mo}-${rnd}`;
            }
        }

        function closeRecordModal() {
            document.getElementById('recordModalOverlay').classList.remove('open');
            document.getElementById('recordWastageModal').classList.remove('open');
        }

        function openDeleteModal(id, name, qty) {
            document.getElementById('delEntryId').value = id;
            document.getElementById('delItemName').textContent = name;
            document.getElementById('delItemQty').textContent = qty;
            document.getElementById('deleteModalOverlay').classList.add('open');
            document.getElementById('deleteWastageModal').classList.add('open');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModalOverlay').classList.remove('open');
            document.getElementById('deleteWastageModal').classList.remove('open');
        }

        function handleCatalogSearch(term) {
            clearTimeout(searchTimeout);
            const dropdown = document.getElementById('catalogDropdown');
            if (!term || term.trim().length < 2) {
                dropdown.classList.remove('show');
                dropdown.innerHTML = '';
                return;
            }

            searchTimeout = setTimeout(async () => {
                try {
                    const res = await fetch(`?handler=SearchCatalog&q=${encodeURIComponent(term.trim())}`);
                    if (!res.ok) return;
                    const items = await res.json();
                    
                    dropdown.innerHTML = '';
                    if (items.length === 0) {
                        dropdown.innerHTML = '<div style="padding: 10px 14px; font-size: 0.8rem; color: #94a3b8;">No matching catalog items found</div>';
                    } else {
                        items.forEach(i => {
                            const div = document.createElement('div');
                            div.className = 'autocomplete-item';
                            div.innerHTML = `
                                <div>
                                    <div style="font-weight: 600; font-size: 0.85rem; color: #0f172a;">${escapeHtml(i.name)}</div>
                                    <div class="item-search-meta">${escapeHtml(i.category)} | Barcode: ${escapeHtml(i.barcode)} | On-Hand: <strong>${i.inStock}</strong></div>
                                </div>
                                <div style="text-align: right;">
                                    <div style="font-size: 0.85rem; font-weight: 700; color: #019c01;">${formatNumber(i.costPrice)} XAF</div>
                                </div>
                            `;
                            div.onclick = () => selectItem(i);
                            dropdown.appendChild(div);
                        });
                    }
                    dropdown.classList.add('show');
                } catch (e) {
                    console.error("Search failed", e);
                }
            }, 250);
        }

        function selectItem(item) {
            document.getElementById('selectedItemId').value = item.id;
            document.getElementById('dispItemName').textContent = item.name;
            document.getElementById('dispItemDetails').textContent = `${item.category} | Barcode: ${item.barcode} | On-Hand: ${item.inStock} units`;
            
            document.getElementById('catalogSearchInput').style.display = 'none';
            document.getElementById('catalogDropdown').classList.remove('show');
            document.getElementById('selectedItemDisplay').style.display = 'flex';

            currentItemCost = item.costPrice || 0;
            currentInStock = item.inStock || 0;

            document.getElementById('valUnitCost').textContent = `${formatNumber(currentItemCost)} XAF`;
            document.getElementById('valInStock').textContent = `${currentInStock} units`;

            recalcValuation();
        }

        function clearSelectedItem() {
            document.getElementById('selectedItemId').value = '';
            document.getElementById('catalogSearchInput').value = '';
            document.getElementById('catalogSearchInput').style.display = 'block';
            document.getElementById('selectedItemDisplay').style.display = 'none';
            currentItemCost = 0;
            currentInStock = 0;
            document.getElementById('valUnitCost').textContent = '0 XAF';
            document.getElementById('valInStock').textContent = '0 units';
            recalcValuation();
            document.getElementById('catalogSearchInput').focus();
        }

        function recalcValuation() {
            const qty = parseInt(document.getElementById('writeOffQty').value) || 0;
            const total = qty * currentItemCost;
            document.getElementById('valTotalLoss').textContent = `${formatNumber(total)} XAF`;
        }

        function formatNumber(num) {
            return Number(num || 0).toLocaleString('en-US');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function (e) {
            const wrap = document.querySelector('.autocomplete-wrapper');
            if (wrap && !wrap.contains(e.target)) {
                document.getElementById('catalogDropdown').classList.remove('show');
            }
        });
    </script>
}
