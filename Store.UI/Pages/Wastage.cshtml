@page
@model StoreUI.Pages.WastageModel
@{
    ViewData["Title"] = "Wastage Log";
    ViewData["ActivePage"] = "Wastage";
    ViewData["PageDescription"] = "Record and track stock write-offs due to damage, expiry, theft, or spoilage.";
    Layout = "~/Pages/Shared/_AppLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
}

<div class="ops-page">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="status @(Model.StatusMessage.StartsWith("Error") ? "error" : "ok")">@Model.StatusMessage</div>
    }

    <div class="filter-bar" style="margin-bottom: 24px; justify-content: space-between;">
        <form method="get" class="filter-row">
            <div class="filter-group">
                <label>Filter by Type:</label>
                <select name="wastageType" onchange="this.form.submit()">
                    <option value="">All Types</option>
                    @foreach (var t in Model.WastageTypes)
                    {
                        <option value="@t" selected="@(Model.FilterType == t.ToString())">@t</option>
                    }
                </select>
            </div>
        </form>
        <button class="button-primary" type="button" data-open-blade="recordBlade">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="margin-right:4px;">
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
            </svg> Record Wastage
        </button>
    </div>

    <div class="card" style="padding:0; overflow:hidden;">
        @if (!Model.Entries.Any())
        {
            <div class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                <h4>No Wastage Entries Found</h4>
                <p>There are no records matching your criteria.</p>
            </div>
        }
        else
        {
            <div class="table-wrap" style="margin:0; border:none; border-radius:0;">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Item</th>
                            <th>Code</th>
                            <th>Type</th>
                            <th>Qty</th>
                            <th>Reference</th>
                            <th>Notes</th>
                            <th>Recorded By</th>
                            <th>Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Entries)
                        {
                            <tr>
                                <td>@e.WastageEntryId</td>
                                <td>@e.ItemName</td>
                                <td><span style="font-family:monospace; background:var(--ops-surface-alt, #f1f5f9); padding:2px 4px; border-radius:4px;">@e.ItemCode</span></td>
                                <td>
                                    <span class="badge badge-yellow">@e.WastageType</span>
                                </td>
                                <td>@e.Quantity</td>
                                <td>@(e.ReferenceCode ?? "—")</td>
                                <td>
                                    <div style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@e.Notes">
                                        @(e.Notes ?? "—")
                                    </div>
                                </td>
                                <td>@e.RecordedByUser</td>
                                <td>@e.DateCreated.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    <form method="post" asp-page-handler="Delete" data-confirm="Delete this wastage entry?" data-confirm-type="danger">
                                        <input type="hidden" name="DeleteEntryId" value="@e.WastageEntryId" />
                                        <button type="submit" class="button-command danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Record Wastage Blade -->
<div class="blade-overlay" id="recordBladeOverlay"></div>
<div class="blade" id="recordBlade" data-overlay-id="recordBladeOverlay">
    <div class="blade-header">
        <h3 id="recordModalLabel">Record Wastage</h3>
        <button type="button" class="btn-close" data-close-blade="recordBlade" aria-label="Close">×</button>
    </div>
    <div class="blade-body">
        <form method="post" asp-page-handler="Record" id="recordForm">
            @Html.AntiForgeryToken()
            <div class="form-grid" style="grid-template-columns: 1fr;">
                <div>
                    <label>Select Item <span style="color:var(--ops-danger);">*</span></label>
                    <div class="smart-lookup-wrap" data-url="?handler=SearchItems" data-placeholder="Search item by name or barcode...">
                        <input type="hidden" name="RecordItemId" id="RecordItemId" required />
                    </div>
                </div>
                <div>
                    <label>Wastage Type</label>
                    <select name="RecordWastageType">
                        @foreach (var t in Model.WastageTypes)
                        {
                            <option value="@((int)t)">@t</option>
                        }
                    </select>
                </div>
                <div>
                    <label>Quantity <span style="color:var(--ops-danger);">*</span></label>
                    <input type="number" name="RecordQuantity" min="1" value="1" required />
                </div>
                <div>
                    <label>Reference Code</label>
                    <input type="text" name="RecordReferenceCode" maxlength="100" placeholder="e.g. WASTE-2024-001" />
                </div>
                <div>
                    <label>Notes</label>
                    <textarea name="RecordNotes" rows="3" maxlength="1000" placeholder="Optional description"></textarea>
                </div>
            </div>
        </form>
    </div>
    <div class="blade-footer">
        <button type="button" class="button-secondary" data-close-blade="recordBlade">Cancel</button>
        <button type="submit" form="recordForm" class="button-primary">Save Record</button>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Blade open functionality for custom blade
            const openBtn = document.querySelector('[data-open-blade="recordBlade"]');
            const blade = document.getElementById('recordBlade');
            const overlay = document.getElementById('recordBladeOverlay');
            
            if (openBtn && blade && overlay) {
                openBtn.addEventListener('click', () => {
                    blade.classList.add('open');
                    overlay.classList.add('open');
                });
            }
        });
    </script>
}

