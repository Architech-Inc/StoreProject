@page "/ForgotPassword"
@model StoreUI.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password</title>
    <link rel="icon" type="image/png" href="~/images/clarkstore.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/images/clarkstore.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="auth-page">
    <div id="welcomeView">
        <div class="viewNameSpace">
            <img src="~/images/clarkstore.png" alt="logo" class="ns-image">
            <h2>Account Recovery</h2>
        </div>

        @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
        {
            <p class="auth-error">@Model.ErrorMessage</p>
        }

        <div class="formArea">
            <form method="post" id="recoveryForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="formSection">
                    <label for="inputUserName">Enter your username to request an OTP</label>
                    <input title="username" tabindex="0" type="text" asp-for="Username" id="inputUserName"
                           autocomplete="username" minlength="3" maxlength="100" placeholder="e.g. jdoe" required />
                    <span asp-validation-for="Username" style="color:var(--error); font-size:12px;"></span>
                </div>
                
                <div class="formSection LDiv">
                    <button type="submit" id="requestOtp" class="resetbtn">
                        <span id="btnText">Request OTP</span>
                        <div id="btnSpinner" class="spinner" style="display: none;"></div>
                    </button>
                </div>
                
                <p class="forgot_pass">
                    <a href="/">Back to Login</a>
                </p>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById('recoveryForm').addEventListener('submit', function() {
        var btnText = document.getElementById('btnText');
        var spinner = document.getElementById('btnSpinner');
        var btn = document.getElementById('requestOtp');
        
        btnText.textContent = 'Requesting...';
        spinner.style.display = 'inline-block';
        btn.disabled = true;
    });
</script>
</body>
</html>
