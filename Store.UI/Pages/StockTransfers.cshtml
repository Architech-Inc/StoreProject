@page
@model StoreUI.Pages.StockTransfersModel
@{
    ViewData["Title"] = "Stock Transfers";
    ViewData["PageDescription"] = "Request, approve, dispatch, and receive inter-branch stock transfers.";
    ViewData["ActivePage"] = "StockTransfers";
}

@section Styles {
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
}

<div class="panel">
    



    <!-- Filter bar -->
    <form method="get" style="display:flex;gap:10px;align-items:center;margin-bottom:16px;flex-wrap:wrap;">
        <select name="status" class="input-text" style="min-width:160px;">
            <option value="" selected="@(Model.FilterStatus == null)">All Statuses</option>
            <option value="Requested" selected="@(Model.FilterStatus == "Requested")">Requested</option>
            <option value="Approved" selected="@(Model.FilterStatus == "Approved")">Approved</option>
            <option value="Dispatched" selected="@(Model.FilterStatus == "Dispatched")">Dispatched</option>
            <option value="Received" selected="@(Model.FilterStatus == "Received")">Received</option>
            <option value="Cancelled" selected="@(Model.FilterStatus == "Cancelled")">Cancelled</option>
        </select>
        <button type="submit" class="button-secondary">Filter</button>
    </form>

    <section class="card-resource">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
            <h2 style="font-size: var(--fontSize-heading-sm); margin:0;">Transfers <small style="font-weight:400;color:var(--text-secondary);">@Model.Transfers.Count total</small></h2>
            <button type="button" class="button-primary" onclick="window.openBlade('createBlade')">+ New Transfer</button>
        </div>

        @if (!Model.Transfers.Any())
        {
            <div class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                </svg>
                <h4>No Transfers Found</h4>
                <p>There are no stock transfers matching the current criteria. You can create a new transfer to get started.</p>
            </div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="table">
                    <thead style="background-color: var(--surface);">
                        <tr>
                            <th style="padding: 0 8px;">#</th>
                            <th style="padding: 0 8px;">From</th>
                            <th style="padding: 0 8px;">To</th>
                            <th style="padding: 0 8px;">Items</th>
                            <th style="padding: 0 8px;">Requested By</th>
                            <th style="padding: 0 8px;">Date</th>
                            <th style="padding: 0 8px;">Status</th>
                            <th style="padding: 0 8px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Transfers)
                        {
                            <tr>
                                <td><strong>#@t.StockTransferId</strong></td>
                                <td>@t.FromBranchName</td>
                                <td>@t.ToBranchName</td>
                                <td>@t.Items.Count item(s)</td>
                                <td>@t.RequestedByUser</td>
                                <td>@t.DateCreated.ToString("MMM d, yyyy")</td>
                                <td>
                                    @{
                                        var badgeClass = t.Status switch {
                                            "Requested" => "badge-critical\" style=\"background-color: var(--accent-yellow); color: var(--text-primary);",
                                            "Approved" => "badge-success\" style=\"background-color: var(--primary);",
                                            "Dispatched" => "badge-success\" style=\"background-color: var(--primary-light); color: var(--primary-dark);",
                                            "Received" => "badge-success",
                                            "Cancelled" => "badge-critical",
                                            _ => "badge-critical\" style=\"background-color: var(--surface); color: var(--text-secondary);"
                                        };
                                    }
                                    <span class="badge @Html.Raw(badgeClass)">@t.Status</span>
                                </td>
                                <td style="white-space:nowrap; display: flex; gap: 4px;">
                                    @{ var transferJson = System.Text.Json.JsonSerializer.Serialize(t, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }); }
                                    <button type="button" class="button-command" data-transfer="@transferJson" onclick="viewDetails(this)">View</button>
                                    @if (t.Status == "Requested")
                                    {
                                        <button type="button" class="button-primary" onclick="openApprove(@t.StockTransferId)">Approve</button>
                                        <button type="button" class="button-secondary" style="color: var(--accent-red);" onclick="openReject(@t.StockTransferId)">Reject</button>
                                    }
                                    @if (t.Status == "Approved")
                                    {
                                        <button type="button" class="button-primary" data-transfer="@transferJson" onclick="openDispatch(this)">Dispatch</button>
                                    }
                                    @if (t.Status == "Dispatched")
                                    {
                                        <button type="button" class="button-primary" data-transfer="@transferJson" onclick="openReceive(this)">Receive</button>
                                    }
                                    @if (t.Status != "Received" && t.Status != "Cancelled")
                                    {
                                        <button type="button" class="button-command" style="color: var(--accent-red);" title="Cancel" onclick="openCancel(@t.StockTransferId)">✕</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<!-- Create Transfer Blade -->
<div id="createBladeOverlay" class="blade-overlay" data-blade-id="createBlade"></div>
<div id="createBlade" class="blade" data-overlay-id="createBladeOverlay">
    <div class="blade-header">
        <h3>New Stock Transfer</h3>
        <button type="button" class="btn-close" data-close-blade="createBlade" aria-label="Close new transfer">&times;</button>
    </div>
    <form method="post" asp-page-handler="Create" style="display:flex;flex-direction:column;flex:1;overflow:hidden;">
        @Html.AntiForgeryToken()
        <div class="blade-body">
            <div class="form-grid">
                <div>
                    <label>From Branch *</label>
                    <div class="smart-lookup-wrap" data-url="?handler=SearchBranches" data-placeholder="Search origin branch...">
                        <input type="hidden" name="CreateFromBranchId" required />
                    </div>
                </div>
                <div>
                    <label>To Branch *</label>
                    <div class="smart-lookup-wrap" data-url="?handler=SearchBranches" data-placeholder="Search destination branch...">
                        <input type="hidden" name="CreateToBranchId" required />
                    </div>
                </div>
                <label style="grid-column:1/-1;">Notes
                    <textarea name="CreateNotes" rows="2" maxlength="1000" placeholder="Optional transfer notes..."></textarea>
                </label>
            </div>
            <h4 style="margin:16px 0 8px;">Items to Transfer</h4>
            <div id="itemLines">
                <div class="item-line" style="display:grid;grid-template-columns:1.5fr 100px 1fr auto;gap:8px;margin-bottom:8px;align-items:end;">
                    <div>
                        <label style="font-size:.83rem;margin-bottom:3px;display:block;">Select Item *</label>
                        <div class="smart-lookup-wrap" data-url="?handler=SearchItems" data-placeholder="Type item name or barcode...">
                            <input type="hidden" name="TransferItems[0].ItemId" required />
                        </div>
                    </div>
                    <div>
                        <label style="font-size:.83rem;margin-bottom:3px;display:block;">Qty *</label>
                        <input name="TransferItems[0].RequestedQuantity" type="number" min="1" value="1" required style="width:100%;box-sizing:border-box;" />
                    </div>
                    <div>
                        <label style="font-size:.83rem;margin-bottom:3px;display:block;">Notes</label>
                        <input name="TransferItems[0].Notes" type="text" maxlength="500" placeholder="Optional line notes" style="width:100%;box-sizing:border-box;" />
                    </div>
                    <button type="button" onclick="removeLine(this)" style="padding:7px 10px;height:38px;" class="button-command danger" title="Remove">✕</button>
                </div>
            </div>
            <button type="button" onclick="addItemLine()" style="margin-top:6px;" class="button-secondary btn-sm">+ Add Item</button>
        </div>
        <div class="blade-footer">
            <button type="button" class="button-command" data-close-blade="createBlade">Cancel</button>
            <button type="submit" class="button-primary">Submit Transfer</button>
        </div>
    </form>
</div>

<!-- View Details Modal -->
<div id="viewModal" class="modal-overlay" hidden role="dialog" aria-modal="true">
    <div class="modal" style="max-width:600px;">
        <div class="modal-head">
            <h3>Transfer Details</h3>
            <button type="button" class="btn-close" onclick="closeModal('viewModal')" aria-label="Close">×</button>
        </div>
        <div id="viewContent"></div>
    </div>
</div>

<!-- Approve Modal -->
<div id="approveModal" class="modal-overlay" hidden role="dialog" aria-modal="true">
    <div class="modal" style="max-width:420px;">
        <div class="modal-head">
            <h3>Approve Transfer #<span id="approveIdLabel"></span></h3>
            <button type="button" class="btn-close" onclick="closeModal('approveModal')" aria-label="Close">×</button>
        </div>
        <form method="post" asp-page-handler="Approve">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ActionTransferId" id="approveTransferId" />
            <label style="display:flex;flex-direction:column;gap:4px;margin-bottom:12px;">Notes
                <textarea name="ApproveNotes" rows="2"></textarea>
            </label>
            <div style="display:flex;justify-content:flex-end;gap:8px;">
                <button type="button" class="button-command" onclick="closeModal('approveModal')">Cancel</button>
                <button type="submit" class="button-primary">Approve</button>
            </div>
        </form>
    </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="modal-overlay" hidden role="dialog" aria-modal="true">
    <div class="modal" style="max-width:420px;">
        <div class="modal-head">
            <h3>Reject Transfer #<span id="rejectIdLabel"></span></h3>
            <button type="button" class="btn-close" onclick="closeModal('rejectModal')" aria-label="Close">×</button>
        </div>
        <form method="post" asp-page-handler="Reject">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ActionTransferId" id="rejectTransferId" />
            <label style="display:flex;flex-direction:column;gap:4px;margin-bottom:12px;">Reason *
                <textarea name="RejectReason" rows="2" required></textarea>
            </label>
            <div style="display:flex;justify-content:flex-end;gap:8px;">
                <button type="button" class="button-command" onclick="closeModal('rejectModal')">Cancel</button>
                <button type="submit" class="button-primary danger">Reject</button>
            </div>
        </form>
    </div>
</div>

<!-- Dispatch Blade -->
<div class="blade-overlay" id="dispatchOverlay"></div>
<div class="blade" id="dispatchBlade" data-overlay-id="dispatchOverlay">
    <div class="blade-header">
        <h3>Dispatch Transfer #<span id="dispatchIdLabel"></span></h3>
        <button type="button" class="btn-close" data-close-blade aria-label="Close">×</button>
    </div>
    <div class="blade-body">
        <form method="post" asp-page-handler="Dispatch" id="dispatchForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ActionTransferId" id="dispatchTransferId" />
            <div id="dispatchItemLines"></div>
            <label style="display:flex;flex-direction:column;gap:4px;margin:12px 0;">Notes
                <textarea name="DispatchNotes" rows="2"></textarea>
            </label>
        </form>
    </div>
    <div class="blade-footer">
        <button type="button" class="button-command" data-close-blade>Cancel</button>
        <button type="button" class="button-primary" onclick="document.getElementById('dispatchForm').submit()">Mark Dispatched</button>
    </div>
</div>

<!-- Receive Blade -->
<div class="blade-overlay" id="receiveOverlay"></div>
<div class="blade" id="receiveBlade" data-overlay-id="receiveOverlay">
    <div class="blade-header">
        <h3>Receive Transfer #<span id="receiveIdLabel"></span></h3>
        <button type="button" class="btn-close" data-close-blade aria-label="Close">×</button>
    </div>
    <div class="blade-body">
        <form method="post" asp-page-handler="Receive" id="receiveForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ActionTransferId" id="receiveTransferId" />
            <div id="receiveItemLines"></div>
            <label style="display:flex;flex-direction:column;gap:4px;margin:12px 0;">Notes
                <textarea name="ReceiveNotes" rows="2"></textarea>
            </label>
        </form>
    </div>
    <div class="blade-footer">
        <button type="button" class="button-command" data-close-blade>Cancel</button>
        <button type="button" class="button-primary" onclick="document.getElementById('receiveForm').submit()">Confirm Received</button>
    </div>
</div>

<!-- Cancel Modal -->
<div id="cancelModal" class="modal-overlay" hidden role="dialog" aria-modal="true">
    <div class="modal" style="max-width:420px;">
        <div class="modal-head">
            <h3>Cancel Transfer #<span id="cancelIdLabel"></span></h3>
            <button type="button" class="btn-close" onclick="closeModal('cancelModal')" aria-label="Close">×</button>
        </div>
        <form method="post" asp-page-handler="Cancel">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ActionTransferId" id="cancelTransferId" />
            <label style="display:flex;flex-direction:column;gap:4px;margin-bottom:12px;">Reason
                <textarea name="CancelReason" rows="2"></textarea>
            </label>
            <div style="display:flex;justify-content:flex-end;gap:8px;">
                <button type="button" class="button-command" onclick="closeModal('cancelModal')">Close</button>
                <button type="submit" class="button-primary danger">Cancel Transfer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
let itemLineCount = 1;

function closeModal(id) { document.getElementById(id).hidden = true; }



function addItemLine() {
    const container = document.getElementById('itemLines');
    const div = document.createElement('div');
    div.className = 'item-line';
    div.style = 'display:grid;grid-template-columns:1.5fr 100px 1fr auto;gap:8px;margin-bottom:8px;align-items:end;';
    const idx = itemLineCount++;
    div.innerHTML = `
        <div>
            <label style="font-size:.83rem;margin-bottom:3px;display:block;">Select Item *</label>
            <div class="smart-lookup-wrap" data-url="?handler=SearchItems" data-placeholder="Type item name or barcode...">
                <input type="hidden" name="TransferItems[${idx}].ItemId" required />
            </div>
        </div>
        <div>
            <label style="font-size:.83rem;margin-bottom:3px;display:block;">Qty *</label>
            <input name="TransferItems[${idx}].RequestedQuantity" type="number" min="1" value="1" required style="width:100%;box-sizing:border-box;" />
        </div>
        <div>
            <label style="font-size:.83rem;margin-bottom:3px;display:block;">Notes</label>
            <input name="TransferItems[${idx}].Notes" type="text" maxlength="500" placeholder="Optional line notes" style="width:100%;box-sizing:border-box;" />
        </div>
        <button type="button" onclick="removeLine(this)" style="padding:7px 10px;height:38px;" class="button-command danger" title="Remove">✕</button>`;
    container.appendChild(div);
    const wrap = div.querySelector('.smart-lookup-wrap');
    if (wrap && window.SmartLookup) {
        window.SmartLookup.attach(wrap);
    }
}

function removeLine(btn) {
    const line = btn.closest('.item-line');
    if (document.querySelectorAll('.item-line').length > 1) line.remove();
}

function viewDetails(btn) {
    const t = JSON.parse(btn.getAttribute('data-transfer'));
    let html = `<dl style="display:grid;grid-template-columns:auto 1fr;gap:4px 12px;font-size:.9rem;">
        <dt>From</dt><dd>${t.fromBranchName}</dd>
        <dt>To</dt><dd>${t.toBranchName}</dd>
        <dt>Status</dt><dd>${t.status}</dd>
        <dt>Requested By</dt><dd>${t.requestedByUser}</dd>
        <dt>Notes</dt><dd>${t.notes || '—'}</dd>
        ${t.rejectionReason ? `<dt>Rejection</dt><dd>${t.rejectionReason}</dd>` : ''}
    </dl>
    <h4 style="margin:12px 0 6px;">Items</h4>
    <table style="width:100%;font-size:.85rem;"><thead><tr><th>Item</th><th>Requested</th><th>Dispatched</th><th>Received</th></tr></thead><tbody>`;
    for (const i of t.items) {
        html += `<tr><td>${i.itemName}</td><td>${i.requestedQuantity}</td><td>${i.dispatchedQuantity ?? '—'}</td><td>${i.receivedQuantity ?? '—'}</td></tr>`;
    }
    html += '</tbody></table>';
    document.getElementById('viewContent').innerHTML = html;
    document.getElementById('viewModal').hidden = false;
}

function openApprove(id) {
    document.getElementById('approveTransferId').value = id;
    document.getElementById('approveIdLabel').textContent = id;
    document.getElementById('approveModal').hidden = false;
}

function openReject(id) {
    document.getElementById('rejectTransferId').value = id;
    document.getElementById('rejectIdLabel').textContent = id;
    document.getElementById('rejectModal').hidden = false;
}

function openDispatch(btn) {
    const t = JSON.parse(btn.getAttribute('data-transfer'));
    document.getElementById('dispatchTransferId').value = t.stockTransferId;
    document.getElementById('dispatchIdLabel').textContent = t.stockTransferId;
    let html = '';
    t.items.forEach((item, idx) => {
        html += `<div style="display:grid;grid-template-columns:1fr 120px;gap:8px;margin-bottom:8px;font-size:.85rem;">
            <div><input type="hidden" name="DispatchItems[${idx}].StockTransferItemId" value="${item.stockTransferItemId}"/>${item.itemName} (requested: ${item.requestedQuantity})</div>
            <label>Dispatched Qty<input name="DispatchItems[${idx}].DispatchedQuantity" type="number" min="0" value="${item.requestedQuantity}" /></label>
        </div>`;
    });
    document.getElementById('dispatchItemLines').innerHTML = html;
    window.openBlade('dispatchBlade');
}

function openReceive(btn) {
    const t = JSON.parse(btn.getAttribute('data-transfer'));
    document.getElementById('receiveTransferId').value = t.stockTransferId;
    document.getElementById('receiveIdLabel').textContent = t.stockTransferId;
    let html = '';
    t.items.forEach((item, idx) => {
        html += `<div style="display:grid;grid-template-columns:1fr 120px;gap:8px;margin-bottom:8px;font-size:.85rem;">
            <div><input type="hidden" name="ReceiveItems[${idx}].StockTransferItemId" value="${item.stockTransferItemId}"/>${item.itemName} (dispatched: ${item.dispatchedQuantity ?? '?'})</div>
            <label>Received Qty<input name="ReceiveItems[${idx}].ReceivedQuantity" type="number" min="0" value="${item.dispatchedQuantity ?? 0}" /></label>
        </div>`;
    });
    document.getElementById('receiveItemLines').innerHTML = html;
    window.openBlade('receiveBlade');
}

function openCancel(id) {
    document.getElementById('cancelTransferId').value = id;
    document.getElementById('cancelIdLabel').textContent = id;
    document.getElementById('cancelModal').hidden = false;
}
</script>
}
