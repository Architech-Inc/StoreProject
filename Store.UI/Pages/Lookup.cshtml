@page
@model StoreUI.Pages.LookupModel
@{
    ViewData["Title"] = "Master Data & System Lookups";
    ViewData["ActivePage"] = "Lookup";
    ViewData["PageDescription"] = "Configure merchandise categories, measurement units, and store departments across the enterprise.";
    Layout = "~/Pages/Shared/_AppLayout.cshtml";
}

<div class="lookup-container">
    @* ── ACTION TOOLBAR ── *@
    <div class="lookup-action-bar">
        <div class="lookup-status-pill">
            <span class="status-indicator-dot"></span>
            <span>Master Data Taxonomy &amp; Catalog Dictionaries</span>
        </div>
        <div class="lookup-header-actions">
            <a href="/Catalog" class="btn-lookup-action btn-lookup-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
                Product Catalog
            </a>
            <a href="/Dashboard" class="btn-lookup-action btn-lookup-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                Store Dashboard
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="lookup-alert @(Model.StatusMessage.StartsWith("Error") ? "error" : "ok")">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>@Model.StatusMessage</span>
        </div>
    }

    @* ── 3-CARD FLUENT 2.0 KPI GRID ── *@
    <div class="lookup-kpi-grid">
        @* KPI 1: Categories *@
        <div class="lookup-kpi-card" onclick="switchLookupTab('categories')">
            <div class="kpi-icon-wrap kpi-emerald">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Merchandise Categories</span>
                <span class="kpi-value">@Model.TotalCategories <small>Categories</small></span>
                <span class="kpi-subtext">Product classification groups</span>
            </div>
        </div>

        @* KPI 2: Measurement Units *@
        <div class="lookup-kpi-card" onclick="switchLookupTab('units')">
            <div class="kpi-icon-wrap kpi-teal">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Measurement Units</span>
                <span class="kpi-value">@Model.TotalUnits <small>Units</small></span>
                <span class="kpi-subtext">Weight, volume, and packaging</span>
            </div>
        </div>

        @* KPI 3: Departments *@
        <div class="lookup-kpi-card" onclick="switchLookupTab('departments')">
            <div class="kpi-icon-wrap kpi-purple">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Store Departments</span>
                <span class="kpi-value">@Model.TotalDepartments <small>Departments</small></span>
                <span class="kpi-subtext">Commercial sections &amp; aisles</span>
            </div>
        </div>
    </div>

    @* ── 3-TAB DOCK SWITCHER ── *@
    <div class="lookup-tabs-dock">
        <button type="button" class="lookup-tab-btn @(Model.ActiveTab == "categories" ? "active" : "")" onclick="switchLookupTab('categories')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
            Product Categories (@Model.TotalCategories)
        </button>
        <button type="button" class="lookup-tab-btn @(Model.ActiveTab == "units" ? "active" : "")" onclick="switchLookupTab('units')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
            </svg>
            Measurement Units (@Model.TotalUnits)
        </button>
        <button type="button" class="lookup-tab-btn @(Model.ActiveTab == "departments" ? "active" : "")" onclick="switchLookupTab('departments')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            Store Departments (@Model.TotalDepartments)
        </button>
    </div>

    @* ═════════════════════════════════════════════════════════════ *@
    @* ── TAB 1: CATEGORIES ──────────────────────────────────────── *@
    @* ═════════════════════════════════════════════════════════════ *@
    <div id="tab-categories" class="lookup-tab-content @(Model.ActiveTab == "categories" ? "active" : "")">
        <div class="lookup-panel">
            <div class="panel-header-dock">
                <div class="panel-title-wrap">
                    <h3>Product Categories</h3>
                    <p>Hierarchical grouping for catalog merchandising and sales analytics.</p>
                </div>
                <button type="button" class="btn-lookup-action btn-lookup-primary" onclick="openCreateCategoryModal()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    New Category
                </button>
            </div>

            @if (!Model.Categories.Any())
            {
                <div class="lookup-empty-state">
                    <p>No product categories registered yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="lookup-table">
                        <thead>
                            <tr>
                                <th style="width:60px; text-align:center;">Photo</th>
                                <th style="width:80px;">ID</th>
                                <th>Category Name</th>
                                <th>Description</th>
                                <th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Categories)
                            {
                                <tr>
                                    <td style="text-align:center;">
                                        @if (!string.IsNullOrEmpty(c.ThumbnailUrl))
                                        {
                                            <img src="@c.ThumbnailUrl" alt="@c.Name" class="thumb-preview-img" />
                                        }
                                        else
                                        {
                                            <div class="thumb-placeholder-box">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                </svg>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <code style="font-size:0.80rem; font-weight:700; color:#64748b;">#@c.CategoryId</code>
                                    </td>
                                    <td>
                                        <strong style="color:#0f172a; font-size:0.88rem;">@c.Name</strong>
                                    </td>
                                    <td style="color:#64748b; font-size:0.82rem;">
                                        @(c.Description ?? "—")
                                    </td>
                                    <td style="text-align:right;">
                                        <div style="display:inline-flex; gap:6px; align-items:center;">
                                            <button type="button" class="btn-ctrl-action"
                                                    onclick="openEditCategoryModal(@c.CategoryId, '@Html.Raw(Html.Encode(c.Name))', '@Html.Raw(Html.Encode(c.Description ?? ""))')">
                                                Edit
                                            </button>
                                            <form method="post" asp-page-handler="DeleteCategory" style="margin:0; display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@c.CategoryId" />
                                                <button type="submit" class="btn-ctrl-danger" data-confirm="Delete category @c.Name?" data-confirm-type="danger" data-confirm-title="Delete Category">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ═════════════════════════════════════════════════════════════ *@
    @* ── TAB 2: MEASUREMENT UNITS ───────────────────────────────── *@
    @* ═════════════════════════════════════════════════════════════ *@
    <div id="tab-units" class="lookup-tab-content @(Model.ActiveTab == "units" ? "active" : "")">
        <div class="lookup-panel">
            <div class="panel-header-dock">
                <div class="panel-title-wrap">
                    <h3>Measurement Units</h3>
                    <p>Standard units for inventory stock keeping and pricing.</p>
                </div>
                <button type="button" class="btn-lookup-action btn-lookup-primary" onclick="openCreateUnitModal()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    New Unit
                </button>
            </div>

            @if (!Model.Units.Any())
            {
                <div class="lookup-empty-state">
                    <p>No measurement units registered yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="lookup-table">
                        <thead>
                            <tr>
                                <th style="width:80px;">ID</th>
                                <th>Unit Name</th>
                                <th>Abbreviation</th>
                                <th>Description</th>
                                <th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.Units)
                            {
                                <tr>
                                    <td>
                                        <code style="font-size:0.80rem; font-weight:700; color:#64748b;">#@u.UnitId</code>
                                    </td>
                                    <td>
                                        <strong style="color:#0f172a; font-size:0.88rem;">@u.Name</strong>
                                    </td>
                                    <td>
                                        <span class="abbr-pill">@u.Abbreviation</span>
                                    </td>
                                    <td style="color:#64748b; font-size:0.82rem;">
                                        @(u.Description ?? "—")
                                    </td>
                                    <td style="text-align:right;">
                                        <div style="display:inline-flex; gap:6px; align-items:center;">
                                            <button type="button" class="btn-ctrl-action"
                                                    onclick="openEditUnitModal(@u.UnitId, '@Html.Raw(Html.Encode(u.Name))', '@Html.Raw(Html.Encode(u.Abbreviation))', '@Html.Raw(Html.Encode(u.Description ?? ""))')">
                                                Edit
                                            </button>
                                            <form method="post" asp-page-handler="DeleteUnit" style="margin:0; display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@u.UnitId" />
                                                <button type="submit" class="btn-ctrl-danger" data-confirm="Delete measurement unit @u.Name?" data-confirm-type="danger" data-confirm-title="Delete Measurement Unit">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ═════════════════════════════════════════════════════════════ *@
    @* ── TAB 3: DEPARTMENTS ─────────────────────────────────────── *@
    @* ═════════════════════════════════════════════════════════════ *@
    <div id="tab-departments" class="lookup-tab-content @(Model.ActiveTab == "departments" ? "active" : "")">
        <div class="lookup-panel">
            <div class="panel-header-dock">
                <div class="panel-title-wrap">
                    <h3>Store Departments</h3>
                    <p>Physical sections and merchandise departments across store locations.</p>
                </div>
                <button type="button" class="btn-lookup-action btn-lookup-primary" onclick="openCreateDeptModal()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    New Department
                </button>
            </div>

            @if (!Model.Departments.Any())
            {
                <div class="lookup-empty-state">
                    <p>No store departments registered yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="lookup-table">
                        <thead>
                            <tr>
                                <th style="width:80px;">ID</th>
                                <th>Department Name</th>
                                <th>Description</th>
                                <th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Departments)
                            {
                                <tr>
                                    <td>
                                        <code style="font-size:0.80rem; font-weight:700; color:#64748b;">#@d.DepartmentId</code>
                                    </td>
                                    <td>
                                        <strong style="color:#0f172a; font-size:0.88rem;">@d.Name</strong>
                                    </td>
                                    <td style="color:#64748b; font-size:0.82rem;">
                                        @(d.Description ?? "—")
                                    </td>
                                    <td style="text-align:right;">
                                        <div style="display:inline-flex; gap:6px; align-items:center;">
                                            <button type="button" class="btn-ctrl-action"
                                                    onclick="openEditDeptModal(@d.DepartmentId, '@Html.Raw(Html.Encode(d.Name))', '@Html.Raw(Html.Encode(d.Description ?? ""))')">
                                                Edit
                                            </button>
                                            <form method="post" asp-page-handler="DeleteDepartment" style="margin:0; display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@d.DepartmentId" />
                                                <button type="submit" class="btn-ctrl-danger" data-confirm="Delete department @d.Name?" data-confirm-type="danger" data-confirm-title="Delete Department">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@* ── CATEGORY MODAL ── *@
<div class="custom-modal-overlay" id="catModalOverlay" onclick="closeCatModal()"></div>
<div class="custom-modal" id="catModal">
    <div class="custom-modal-header">
        <h3 id="catModalTitle">Add Product Category</h3>
        <button type="button" class="btn-close-modal" onclick="closeCatModal()">&times;</button>
    </div>
    <form method="post" asp-page-handler="SaveCategory" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="catId" value="0" />
        <input type="hidden" asp-for="CropX" id="catCropX" />
        <input type="hidden" asp-for="CropY" id="catCropY" />
        <input type="hidden" asp-for="CropW" id="catCropW" />
        <input type="hidden" asp-for="CropH" id="catCropH" />
        <div class="custom-modal-body">
            <div class="form-group">
                <label class="form-label">Category Name <span class="text-danger">*</span></label>
                <input type="text" name="name" id="catName" class="form-control" placeholder="e.g. Beverages & Soft Drinks" required maxlength="100" />
            </div>
            <div class="form-group">
                <label class="form-label">Description</label>
                <textarea name="description" id="catDesc" class="form-control" placeholder="Optional category details..." rows="3" maxlength="300"></textarea>
            </div>
            <div class="form-group">
                <label class="form-label">Category Photo / Icon</label>
                <input type="file" asp-for="CategoryImageUpload" id="catImageInput" class="form-control" accept="image/*" data-crop="true" data-crop-aspect-ratio="1" />
            </div>
        </div>
        <div class="custom-modal-footer">
            <button type="button" class="btn-lookup-action btn-lookup-secondary" onclick="closeCatModal()">Cancel</button>
            <button type="submit" class="btn-lookup-action btn-lookup-primary">Save Category</button>
        </div>
    </form>
</div>

@* ── UNIT MODAL ── *@
<div class="custom-modal-overlay" id="unitModalOverlay" onclick="closeUnitModal()"></div>
<div class="custom-modal" id="unitModal">
    <div class="custom-modal-header">
        <h3 id="unitModalTitle">Add Measurement Unit</h3>
        <button type="button" class="btn-close-modal" onclick="closeUnitModal()">&times;</button>
    </div>
    <form method="post" asp-page-handler="SaveUnit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="unitId" value="0" />
        <div class="custom-modal-body">
            <div class="form-group">
                <label class="form-label">Unit Name <span class="text-danger">*</span></label>
                <input type="text" name="name" id="unitName" class="form-control" placeholder="e.g. Kilogram" required maxlength="100" />
            </div>
            <div class="form-group">
                <label class="form-label">Abbreviation / Symbol <span class="text-danger">*</span></label>
                <input type="text" name="abbreviation" id="unitAbbr" class="form-control" placeholder="e.g. kg" required maxlength="20" />
            </div>
            <div class="form-group">
                <label class="form-label">Description</label>
                <textarea name="description" id="unitDesc" class="form-control" placeholder="Optional unit details..." rows="3" maxlength="300"></textarea>
            </div>
        </div>
        <div class="custom-modal-footer">
            <button type="button" class="btn-lookup-action btn-lookup-secondary" onclick="closeUnitModal()">Cancel</button>
            <button type="submit" class="btn-lookup-action btn-lookup-primary">Save Unit</button>
        </div>
    </form>
</div>

@* ── DEPARTMENT MODAL ── *@
<div class="custom-modal-overlay" id="deptModalOverlay" onclick="closeDeptModal()"></div>
<div class="custom-modal" id="deptModal">
    <div class="custom-modal-header">
        <h3 id="deptModalTitle">Add Store Department</h3>
        <button type="button" class="btn-close-modal" onclick="closeDeptModal()">&times;</button>
    </div>
    <form method="post" asp-page-handler="SaveDepartment">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="deptId" value="0" />
        <div class="custom-modal-body">
            <div class="form-group">
                <label class="form-label">Department Name <span class="text-danger">*</span></label>
                <input type="text" name="name" id="deptName" class="form-control" placeholder="e.g. Fresh Produce & Dairy" required maxlength="100" />
            </div>
            <div class="form-group">
                <label class="form-label">Description</label>
                <textarea name="description" id="deptDesc" class="form-control" placeholder="Optional department details..." rows="3" maxlength="300"></textarea>
            </div>
        </div>
        <div class="custom-modal-footer">
            <button type="button" class="btn-lookup-action btn-lookup-secondary" onclick="closeDeptModal()">Cancel</button>
            <button type="submit" class="btn-lookup-action btn-lookup-primary">Save Department</button>
        </div>
    </form>
</div>

@* ── JAVASCRIPT INTERACTIONS ── *@
@section Scripts {
    <script>
        function switchLookupTab(tabId) {
            document.querySelectorAll('.lookup-tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.lookup-tab-content').forEach(c => c.classList.remove('active'));

            const targetBtn = Array.from(document.querySelectorAll('.lookup-tab-btn')).find(b => b.getAttribute('onclick')?.includes(tabId));
            if (targetBtn) targetBtn.classList.add('active');

            const content = document.getElementById(`tab-${tabId}`);
            if (content) content.classList.add('active');
        }

        // Category Modal
        function openCreateCategoryModal() {
            document.getElementById('catModalTitle').textContent = 'Add Product Category';
            document.getElementById('catId').value = '0';
            document.getElementById('catName').value = '';
            document.getElementById('catDesc').value = '';
            document.getElementById('catImageInput').value = '';
            document.getElementById('catCropX').value = '';
            document.getElementById('catCropY').value = '';
            document.getElementById('catCropW').value = '';
            document.getElementById('catCropH').value = '';
            document.getElementById('catModalOverlay').style.display = 'block';
            document.getElementById('catModal').style.display = 'block';
        }
        function openEditCategoryModal(id, name, desc) {
            document.getElementById('catModalTitle').textContent = 'Edit Category: ' + name;
            document.getElementById('catId').value = id;
            document.getElementById('catName').value = name;
            document.getElementById('catDesc').value = desc;
            document.getElementById('catImageInput').value = '';
            document.getElementById('catCropX').value = '';
            document.getElementById('catCropY').value = '';
            document.getElementById('catCropW').value = '';
            document.getElementById('catCropH').value = '';
            document.getElementById('catModalOverlay').style.display = 'block';
            document.getElementById('catModal').style.display = 'block';
        }
        function closeCatModal() {
            document.getElementById('catModalOverlay').style.display = 'none';
            document.getElementById('catModal').style.display = 'none';
        }

        // Unit Modal
        function openCreateUnitModal() {
            document.getElementById('unitModalTitle').textContent = 'Add Measurement Unit';
            document.getElementById('unitId').value = '0';
