@page "/_host_legacy"
@namespace StoreUI.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Store Management System</title>
    <base href="~/" />
    <!-- SEC-18 — Bootstrap CSS loaded from jsdelivr CDN with SRI integrity + crossorigin.
         Hash covers bootstrap@5.3.0/dist/css/bootstrap.min.css as of Wave 12.
         Bump the hash whenever the upstream version changes. -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-f67742c946886f3022d855155c98b40a39826a94a63bb4a7a4979fd38f3aaa12e7b99d9c75e4613b4da2b8ae8551454c"
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />
    <style>
            body {
                background-color: #f5f5f5;
            }

            .hero {
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
            }

            .hero h1 {
                font-size: 3rem;
                margin-bottom: 1rem;
            }

            .hero p {
                font-size: 1.25rem;
                margin-bottom: 2rem;
            }
    </style>
</head>

<body>
    <div class="hero">
        <div class="text-center">
            <h1>Store Management System</h1>
            <p>Efficient inventory and business management</p>
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <a href="/dashboard" class="button-secondary btn-lg">Go to Dashboard</a>
            }
            else
            {
                <a href="/login" class="button-secondary btn-lg">Login</a>
            }
        </div>
    </div>

    <!-- SEC-18 — Bootstrap JS loaded from jsdelivr CDN with SRI integrity + crossorigin.
         Hash covers bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js as of Wave 12.
         Bump the hash whenever the upstream version changes. -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-81e585efa442c0bb6767cab05a8c0f40d82e2f7466c075410bd16119d94aaf17622498a06ff8ffebc488cb74dee01933"
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
</body>

</html>
