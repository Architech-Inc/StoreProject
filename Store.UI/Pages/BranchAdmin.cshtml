@page
@model StoreUI.Pages.BranchAdminModel
@{
    ViewData["Title"] = "Branch Administration";
    ViewData["ActivePage"] = "BranchAdmin";
    ViewData["PageDescription"] = "Manage store branch locations and configure user-to-branch role assignments.";
    Layout = "~/Pages/Shared/_AppLayout.cshtml";
}

<div class="branch-admin-container">
    @* ── ACTION TOOLBAR ── *@
    <div class="ba-action-bar">
        <div class="ba-status-pill">
            <span class="status-indicator-dot"></span>
            <span>Store Multi-Branch Governance &amp; User Scoping</span>
        </div>
        <div class="ba-header-actions">
            <a href="/BranchDashboard" class="btn-ba-action btn-ba-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                Branch Dashboard
            </a>
            <a href="/Dashboard" class="btn-ba-action btn-ba-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                Store Dashboard
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="ba-alert @(Model.StatusMessage.StartsWith("Error", StringComparison.OrdinalIgnoreCase) ? "danger" : "ok")">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>@Model.StatusMessage</span>
        </div>
    }

    @* ── 4-CARD FLUENT 2.0 KPI GRID ── *@
    <div class="ba-kpi-grid">
        @* KPI 1: Total Branches *@
        <div class="ba-kpi-card">
            <div class="kpi-icon-wrap kpi-emerald">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Configured Branches</span>
                <span class="kpi-value">@Model.TotalBranches <small>Locations</small></span>
                <span class="kpi-subtext">Registered physical facilities</span>
            </div>
        </div>

        @* KPI 2: Active Locations *@
        <div class="ba-kpi-card">
            <div class="kpi-icon-wrap kpi-teal">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Active Outlets</span>
                <span class="kpi-value" style="color:#059669;">@Model.ActiveBranchesCount <small>Live</small></span>
                <span class="kpi-subtext">@(Model.InactiveBranchesCount > 0 ? $"{Model.InactiveBranchesCount} decommissioned/inactive" : "100% operational footprint")</span>
            </div>
        </div>

        @* KPI 3: Staff Assignments *@
        <div class="ba-kpi-card">
            <div class="kpi-icon-wrap kpi-amber">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Staff Assignments</span>
                <span class="kpi-value" style="color:#d97706;">@Model.TotalAssignmentsCount <small>Scopes</small></span>
                <span class="kpi-subtext">Active User-Branch-Role links</span>
            </div>
        </div>

        @* KPI 4: Multi-Branch Staff *@
        <div class="ba-kpi-card">
            <div class="kpi-icon-wrap kpi-purple">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Multi-Branch Users</span>
                <span class="kpi-value" style="color:#7c3aed;">@Model.MultiBranchUsersCount <small>Roving</small></span>
                <span class="kpi-subtext">Personnel assigned to >1 branch</span>
            </div>
        </div>
    </div>

    @* ── 2-TAB DOCK SWITCHER ── *@
    <div class="ba-tabs-dock">
        <button type="button" class="ba-tab-btn active" onclick="switchBaTab('branches')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            Branch Locations (@Model.Branches.Count)
        </button>
        <button type="button" class="ba-tab-btn" onclick="switchBaTab('assignments')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            User Branch Assignments (@Model.Assignments.Count)
        </button>
    </div>

    @* ═════════════════════════════════════════════════════════════ *@
    @* ── TAB 1: BRANCH LOCATIONS ────────────────────────────────── *@
    @* ═════════════════════════════════════════════════════════════ *@
    <div id="tab-branches" class="ba-tab-content active">
        <div style="display:grid; grid-template-columns: 1fr 1.6fr; gap:1.25rem;">
            @* Form Card *@
            <div class="ba-panel">
                <div class="panel-header-dock">
                    <div class="panel-title-wrap">
                        <h3 id="formTitle">Add / Edit Branch</h3>
                        <p>Configure store physical location and branch code.</p>
                    </div>
                </div>
                <form method="post" asp-page-handler="UpsertBranch" style="padding:1.25rem; display:flex; flex-direction:column; gap:12px;">
                    <input type="hidden" asp-for="EditBranchId" />
                    <div class="form-group">
                        <label asp-for="BranchName" class="form-label">Branch Name <span class="text-danger">*</span></label>
                        <input asp-for="BranchName" class="form-control" placeholder="e.g. Douala Central Superstore" required maxlength="120" />
                    </div>
                    <div class="form-group">
                        <label asp-for="BranchCode" class="form-label">Branch Code <span class="text-danger">*</span></label>
                        <input asp-for="BranchCode" class="form-control" placeholder="e.g. DLA-01" required maxlength="20" />
                    </div>
                    <div class="form-group">
                        <label asp-for="BranchAddress" class="form-label">Physical Address</label>
                        <input asp-for="BranchAddress" class="form-control" placeholder="e.g. Boulevard de la Liberté, Akwa" maxlength="300" />
                    </div>
                    <div style="display:flex; align-items:center; gap:8px; margin-top:4px;">
                        <input asp-for="BranchIsActive" type="checkbox" id="isActiveCheck" style="width:16px; height:16px;" checked />
                        <label for="isActiveCheck" style="font-size:0.84rem; font-weight:600; color:#0f172a; cursor:pointer;">Active Store Location</label>
                    </div>
                    <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:12px;">
                        <button type="button" class="btn-ba-action btn-ba-secondary" onclick="resetBranchForm()">Clear Form</button>
                        <button type="submit" class="btn-ba-action btn-ba-primary">Save Branch</button>
                    </div>
                </form>
            </div>

            @* Table Panel *@
            <div class="ba-panel">
                <div class="panel-header-dock">
                    <div class="panel-title-wrap">
                        <h3>Registered Store Branches</h3>
                        <p>All active and legacy retail locations.</p>
                    </div>
                </div>
                @if (Model.Branches.Count == 0)
                {
                    <div class="ba-empty-state">
                        <p>No branch locations registered yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="ba-table">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Branch Name</th>
                                    <th>Address</th>
                                    <th style="text-align:center;">Status</th>
                                    <th style="text-align:right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.Branches)
                                {
                                    <tr>
                                        <td>
                                            <code style="font-size:0.82rem; font-weight:700; color:#019c01;">@b.Code</code>
                                        </td>
                                        <td>
                                            <strong style="color:#0f172a;">@b.Name</strong>
                                        </td>
                                        <td style="color:#64748b; font-size:0.80rem;">
                                            @(b.Address ?? "—")
                                        </td>
                                        <td style="text-align:center;">
                                            <span class="status-badge @(b.IsActive ? "status-reviewed" : "status-pending")">
                                                @(b.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td style="text-align:right;">
                                            <button type="button" class="btn-table-action"
                                                    onclick="fillBranchForm(@b.BranchId, '@Html.Raw(Html.Encode(b.Code))', '@Html.Raw(Html.Encode(b.Name))', '@Html.Raw(Html.Encode(b.Address ?? ""))', @(b.IsActive ? "true" : "false"))">
                                                Edit
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ═════════════════════════════════════════════════════════════ *@
    @* ── TAB 2: USER BRANCH ASSIGNMENTS ─────────────────────────── *@
    @* ═════════════════════════════════════════════════════════════ *@
    <div id="tab-assignments" class="ba-tab-content">
        <div style="display:grid; grid-template-columns: 1fr 1.6fr; gap:1.25rem;">
            @* Assignment Form *@
            <div class="ba-panel">
                <div class="panel-header-dock">
                    <div class="panel-title-wrap">
                        <h3>Assign User to Branch</h3>
                        <p>Map personnel to specific branch locations with assigned roles.</p>
                    </div>
                </div>
                <form method="post" asp-page-handler="Assign" style="padding:1.25rem; display:flex; flex-direction:column; gap:12px;">
                    <div class="form-group">
                        <label class="form-label">Search User <span class="text-danger">*</span></label>
                        <div class="smart-lookup-wrap" data-url="?handler=SearchUsers" data-placeholder="Search user by username, email, name...">
                            <input type="hidden" name="AssignUserId" id="AssignUserId" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Search Branch <span class="text-danger">*</span></label>
                        <div class="smart-lookup-wrap" data-url="?handler=SearchBranches" data-placeholder="Search branch by name or code...">
                            <input type="hidden" name="AssignBranchId" id="AssignBranchId" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="AssignRoleId" class="form-label">Assigned Role <span class="text-danger">*</span></label>
                        <select asp-for="AssignRoleId" class="form-control" required>
                            <option value="">— Select branch role —</option>
                            @foreach (var r in Model.RoleMatrix)
                            {
                                <option value="@r.RoleId">@r.RoleName</option>
                            }
                        </select>
                    </div>
                    <div style="display:flex; justify-content:flex-end; margin-top:8px;">
                        <button type="submit" class="btn-ba-action btn-ba-primary">Confirm Assignment</button>
                    </div>
                </form>
            </div>

            @* Assignments Ledger *@
            <div class="ba-panel">
                <div class="panel-header-dock">
                    <div class="panel-title-wrap">
                        <h3>Active User-Branch Mappings</h3>
                        <p>Personnel access authorizations per store location.</p>
                    </div>
                </div>
                @if (Model.Assignments.Count == 0)
                {
                    <div class="ba-empty-state">
                        <p>No user-branch assignments configured yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="ba-table">
                            <thead>
                                <tr>
                                    <th>User Account</th>
                                    <th>Branch Location</th>
                                    <th>Assigned Role</th>
                                    <th style="text-align:right;">Revoke</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.Assignments)
                                {
                                    <tr>
                                        <td>
                                            <strong style="color:#0f172a;">@a.UserName</strong>
                                        </td>
                                        <td>
                                            <span style="font-weight:600; color:#334155;">@a.BranchName</span>
                                        </td>
                                        <td>
                                            <span class="role-pill">@a.RoleName</span>
                                        </td>
                                        <td style="text-align:right;">
                                            <form method="post" asp-page-handler="Revoke" style="display:inline; margin:0;">
                                                <input type="hidden" name="assignmentId" value="@a.UserBranchRoleId" />
                                                <button type="submit" class="btn-revoke-action" data-confirm="Remove this assignment for @a.UserName?" data-confirm-type="danger" data-confirm-title="Revoke Branch Assignment">
                                                    Revoke
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ── JAVASCRIPT INTERACTIONS ── *@
@section Scripts {
    <script>
        function switchBaTab(tabId) {
            document.querySelectorAll('.ba-tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.ba-tab-content').forEach(c => c.classList.remove('active'));

            const targetBtn = Array.from(document.querySelectorAll('.ba-tab-btn')).find(b => b.getAttribute('onclick')?.includes(tabId));
            if (targetBtn) targetBtn.classList.add('active');

            const content = document.getElementById(`tab-${tabId}`);
            if (content) content.classList.add('active');
        }

        function fillBranchForm(id, code, name, address, isActive) {
            document.querySelector('[name="EditBranchId"]').value = id;
            document.querySelector('[name="BranchName"]').value = name;
            document.querySelector('[name="BranchCode"]').value = code;
            document.querySelector('[name="BranchAddress"]').value = address;
            document.querySelector('[name="BranchIsActive"]').checked = isActive;
            document.getElementById('formTitle').textContent = 'Edit Branch: ' + name;
            switchBaTab('branches');
        }

        function resetBranchForm() {
            document.querySelector('[name="EditBranchId"]').value = '';
            document.querySelector('[name="BranchName"]').value = '';
            document.querySelector('[name="BranchCode"]').value = '';
            document.querySelector('[name="BranchAddress"]').value = '';
            document.querySelector('[name="BranchIsActive"]').checked = true;
            document.getElementById('formTitle').textContent = 'Add New Branch';
        }
    </script>
}
