@page
@model StoreUI.Pages.CashVarianceModel
@using Store.Models.Enums
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Cash Variance";
    ViewData["ActivePage"] = "CashVariance";
    ViewData["PageDescription"] = "Record and review cash count variances by shift.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
}

<div class="ops-page">
    <div class="filter-bar" style="justify-content: space-between;">
        <form method="get" class="filter-row">
            <div class="filter-group">
                <label for="statusFilter">Status</label>
                <select id="statusFilter" name="status" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues<CashVarianceStatus>())
                    {
                        <option value="@s" selected="@(Model.FilterStatus == s.ToString())">@s</option>
                    }
                </select>
            </div>
        </form>
        <button type="button" class="button-primary" data-open-modal="recordVarianceModal">+ Record Variance</button>
    </div>

    <div class="card" style="padding:0; overflow:hidden;">
        @if (!Model.Variances.Any())
        {
            <div class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <h4>No Variance Records Found</h4>
                <p>There are no records matching your criteria.</p>
            </div>
        }
        else
        {
            <div class="table-wrap" style="margin:0; border:none; border-radius:0;">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Shift ID</th>
                            <th>Expected</th>
                            <th>Actual</th>
                            <th>Variance</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th>Recorded By</th>
                            <th>Reviewed By</th>
                            <th>Created</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Variances)
                        {
                            var variance = v.ActualAmount - v.ExpectedAmount;
                            var badgeClass = v.Status switch
                            {
                                "Pending" => "badge-yellow",
                                "Reviewed" => "badge-green",
                                "Escalated" => "badge-red",
                                _ => "badge-gray"
                            };
                            <tr>
                                <td>@v.CashVarianceRecordId</td>
                                <td><code title="@v.CashierShiftId">@v.CashierShiftId.ToString()[..8]…</code></td>
                                <td>@v.ExpectedAmount.ToString("N2")</td>
                                <td>@v.ActualAmount.ToString("N2")</td>
                                <td class="@(variance < 0 ? "text-danger" : "text-success")">
                                    @(variance >= 0 ? "+" : "")@variance.ToString("N2")
                                </td>
                                <td>@(v.ReasonCode ?? "—")</td>
                                <td><span class="badge @badgeClass">@v.Status</span></td>
                                <td>@v.RecordedByUser</td>
                                <td>@(v.ReviewedByUser ?? "—")</td>
                                <td>@v.DateCreated.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (v.Status == "Pending")
                                    {
                                        <button type="button"
                                                class="button-command"
                                                data-open-modal="reviewVarianceModal"
                                                data-variance-id="@v.CashVarianceRecordId">
                                            Review
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Record Variance Modal -->
<div class="modal-overlay" id="recordVarianceModal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="recordVarianceTitle" style="width:min(520px,92vw);">
        <div class="modal-head">
            <h3 id="recordVarianceTitle">Record Cash Variance</h3>
            <button type="button" class="btn-close" data-close-modal="recordVarianceModal" aria-label="Close">×</button>
        </div>
        <form method="post" asp-page-handler="Record">
            @Html.AntiForgeryToken()
            <div class="form-grid" style="grid-template-columns:1fr;">
                <div>
                    <label>Select Cashier Shift <span class="req">*</span></label>
                    <div class="smart-lookup-wrap" data-url="?handler=SearchShifts" data-placeholder="Search shift by ID, status, notes...">
                        <input type="hidden" name="RecordShiftId" id="RecordShiftId" required />
                    </div>
                </div>
                <div class="form-grid" style="grid-template-columns:1fr 1fr; gap:12px;">
                    <div>
                        <label for="RecordExpected">Expected Amount</label>
                        <input id="RecordExpected" type="number" name="RecordExpected" step="0.01" value="0.00" required />
                    </div>
                    <div>
                        <label for="RecordActual">Actual Amount</label>
                        <input id="RecordActual" type="number" name="RecordActual" step="0.01" value="0.00" required />
                    </div>
                </div>
                <div>
                    <label for="RecordReasonCode">Reason Code</label>
                    <input id="RecordReasonCode" type="text" name="RecordReasonCode" maxlength="100"
                           placeholder="e.g. COUNTING_ERROR" />
                </div>
                <div>
                    <label for="RecordNotes">Notes</label>
                    <textarea id="RecordNotes" name="RecordNotes" rows="2" maxlength="2000"></textarea>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="button-command" data-close-modal="recordVarianceModal">Cancel</button>
                <button type="submit" class="button-primary">Record Variance</button>
            </div>
        </form>
    </div>
</div>

<!-- Review Variance Modal -->
<div class="modal-overlay" id="reviewVarianceModal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="reviewVarianceTitle" style="width:min(480px,92vw);">
        <div class="modal-head">
            <h3 id="reviewVarianceTitle">Review Variance</h3>
            <button type="button" class="btn-close" data-close-modal="reviewVarianceModal" aria-label="Close">×</button>
        </div>
        <form method="post" asp-page-handler="Review">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReviewVarianceId" id="reviewVarianceId" />
            <div class="form-grid" style="grid-template-columns:1fr;">
                <div>
                    <label for="ReviewStatus">Decision <span class="req">*</span></label>
                    <select id="ReviewStatus" name="ReviewStatus" required>
                        @foreach (var s in Model.ReviewableStatuses)
                        {
                            <option value="@((int)s)">@s</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="ReviewNotes">Review Notes</label>
                    <textarea id="ReviewNotes" name="ReviewNotes" rows="3" maxlength="2000"></textarea>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="button-command" data-close-modal="reviewVarianceModal">Cancel</button>
                <button type="submit" class="button-primary">Submit Review</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-open-modal="reviewVarianceModal"]').forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-variance-id') || '';
            const input = document.getElementById('reviewVarianceId');
            if (input) input.value = id;
        });
    });
});
</script>
}
