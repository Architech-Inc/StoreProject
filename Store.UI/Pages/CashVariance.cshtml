    <div class="drawer-footer" style="display:flex; gap:8px;">
        <button type="button" class="btn-var-action btn-var-secondary" style="flex:1; justify-content:center;" onclick="closeDrawer()">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            Close
        </button>
        <button type="button" class="btn-var-action btn-var-primary" style="flex:1.4; justify-content:center;" onclick="printActiveDrawerVoucher()">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Print Audit Voucher
        </button>
    </div>
</div>

@* ═════════════════════════════════════════════════════════════ *@
@* ── MODAL 3: PRINTABLE VARIANCE AUDIT SLIP ─────────────────── *@
@* ═════════════════════════════════════════════════════════════ *@
<div class="var-modal-overlay" id="varianceSlipModalOverlay" onclick="closeVarianceSlipModal()"></div>
<div class="var-modal" id="varianceSlipModal" style="max-width:540px;">
    <div class="var-modal-header">
        <h3 style="margin:0; font-size:1.15rem; color:#019c01; display:flex; align-items:center; gap:8px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Cash Variance Audit Voucher
        </h3>
        <button type="button" class="btn-close" onclick="closeVarianceSlipModal()" aria-label="Close">×</button>
    </div>
    <div class="var-modal-body" style="padding:1.25rem;">
        <div id="printableVarianceSlipContent" class="variance-voucher-print">
            <div style="text-align:center; border-bottom:2px solid #0f172a; padding-bottom:8px; margin-bottom:12px;">
                <h2 style="margin:0; font-size:1.15rem; font-weight:800; color:#0f172a; letter-spacing:0.5px;">CLEXAN FOODS RETAIL</h2>
                <div style="font-size:0.72rem; color:#64748b;">Fiscal Loss Prevention &amp; Float Audit Control</div>
                <div style="font-size:0.85rem; font-weight:800; margin-top:4px; color:#e11d48;" id="vSlipTitle">CASH VARIANCE AUDIT VOUCHER</div>
                <div style="font-size:0.72rem; color:#64748b;" id="vSlipRef"></div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; font-size:0.78rem; margin-bottom:12px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:8px 10px;">
                <div>
                    <span style="color:#64748b; font-size:0.68rem; text-transform:uppercase; display:block;">Cashier User:</span>
                    <strong id="vSlipCashier" style="color:#0f172a;"></strong>
                </div>
                <div>
                    <span style="color:#64748b; font-size:0.68rem; text-transform:uppercase; display:block;">Audit Status:</span>
                    <strong id="vSlipStatus" style="color:#0f172a;"></strong>
                </div>
                <div>
                    <span style="color:#64748b; font-size:0.68rem; text-transform:uppercase; display:block;">Date Recorded:</span>
                    <span id="vSlipDate" style="color:#0f172a;"></span>
                </div>
                <div>
                    <span style="color:#64748b; font-size:0.68rem; text-transform:uppercase; display:block;">Supervisor:</span>
                    <span id="vSlipReviewer" style="color:#0f172a;"></span>
                </div>
            </div>

            <table style="width:100%; border-collapse:collapse; margin-bottom:12px; font-size:0.80rem;">
                <tr style="border-bottom:1px solid #e2e8f0;">
                    <td style="padding:5px 0; color:#64748b;">Expected Drawer Cash:</td>
                    <td style="padding:5px 0; text-align:right; font-weight:700;" id="vSlipExpected"></td>
                </tr>
                <tr style="border-bottom:1px solid #e2e8f0;">
                    <td style="padding:5px 0; color:#64748b;">Actual Physical Declaration:</td>
                    <td style="padding:5px 0; text-align:right; font-weight:700;" id="vSlipActual"></td>
                </tr>
                <tr style="border-bottom:2px solid #0f172a; font-weight:800; font-size:0.90rem;">
                    <td style="padding:6px 0;">Discrepancy Delta:</td>
                    <td style="padding:6px 0; text-align:right;" id="vSlipDelta"></td>
                </tr>
            </table>

            <div style="font-size:0.75rem; margin-bottom:8px;">
                <span style="color:#64748b; font-weight:700; text-transform:uppercase; display:block; margin-bottom:2px;">Reason / Category:</span>
                <span id="vSlipReason" style="font-weight:600; color:#0f172a;"></span>
            </div>

            <div style="font-size:0.75rem; margin-bottom:8px;">
                <span style="color:#64748b; font-weight:700; text-transform:uppercase; display:block; margin-bottom:2px;">Cashier Declaration Memo:</span>
                <div id="vSlipNotes" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:4px; padding:5px 8px; font-style:italic;"></div>
            </div>

            <div style="font-size:0.75rem; margin-bottom:14px;">
                <span style="color:#64748b; font-weight:700; text-transform:uppercase; display:block; margin-bottom:2px;">Supervisory Audit Determination:</span>
                <div id="vSlipReviewNotes" style="background:#fffbeb; border:1px solid #fef3c7; border-radius:4px; padding:5px 8px;"></div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:20px; padding-top:10px; border-top:1px dashed #cbd5e1;">
                <div style="text-align:center;">
                    <div style="border-top:1px solid #0f172a; width:80%; margin:24px auto 4px auto;"></div>
                    <span style="font-size:0.68rem; color:#64748b; text-transform:uppercase;">Cashier Signature &amp; Date</span>
                </div>
                <div style="text-align:center;">
                    <div style="border-top:1px solid #0f172a; width:80%; margin:24px auto 4px auto;"></div>
                    <span style="font-size:0.68rem; color:#64748b; text-transform:uppercase;">Supervisor / Auditor Sign-off</span>
                </div>
            </div>
        </div>
    </div>
    <div class="var-modal-footer">
        <button type="button" class="btn-var-secondary" onclick="closeVarianceSlipModal()">Close</button>
        <button type="button" class="btn-var-primary" onclick="printVarianceSlip()">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Print Voucher Slip
        </button>
    </div>
</div>

@* ── JAVASCRIPT INTERACTIONS ── *@
<script>
    let activeDrawerVarianceData = null;

    function filterVarianceTable() {
        const query = document.getElementById('varianceSearchInput')?.value.toLowerCase() || '';
        const rows = document.querySelectorAll('#varianceTable tbody tr');
        rows.forEach(r => {
            const text = r.textContent?.toLowerCase() || '';
            r.style.display = text.includes(query) ? '' : 'none';
        });
    }

    // Modal 1: Record Variance
    function openRecordModal() {
        document.getElementById('recordModalOverlay').style.display = 'block';
        document.getElementById('recordModal').style.display = 'block';
    }

    function closeRecordModal() {
        document.getElementById('recordModalOverlay').style.display = 'none';
        document.getElementById('recordModal').style.display = 'none';
    }

    function updateLiveVariance() {
        const exp = parseFloat(document.getElementById('inputExpected')?.value) || 0;
        const act = parseFloat(document.getElementById('inputActual')?.value) || 0;
        const delta = act - exp;

        const box = document.getElementById('liveVarianceBanner');
        const amt = document.getElementById('liveVarianceAmount');
        const msg = document.getElementById('liveVarianceMessage');

        if (!box || !amt || !msg) return;

        amt.textContent = (delta >= 0 ? "+" : "") + delta.toLocaleString() + " XAF";

        box.className = "live-variance-box " + (delta < 0 ? "variance-shortage" : delta > 0 ? "variance-overage" : "variance-neutral");

        if (delta < 0) {
            msg.textContent = "Cash shortage detected! Register is missing " + Math.abs(delta).toLocaleString() + " XAF.";
        } else if (delta > 0) {
            msg.textContent = "Cash surplus detected! Register has " + delta.toLocaleString() + " XAF in excess.";
        } else {
            msg.textContent = "Drawer count perfectly balanced with expected amount.";
        }
    }

    let shiftSearchDebounce;
    function searchShifts(q) {
        clearTimeout(shiftSearchDebounce);
        shiftSearchDebounce = setTimeout(async () => {
            const container = document.getElementById('shiftSearchResults');
            if (!container) return;

            if (!q || q.length < 1) {
                container.style.display = 'none';
                return;
            }

            try {
                const res = await fetch(`?handler=SearchShifts&q=${encodeURIComponent(q)}`);
                const items = await res.json();

                container.innerHTML = '';
                if (!items || items.length === 0) {
                    container.innerHTML = '<div class="shift-drop-item text-muted">No shifts found.</div>';
                    container.style.display = 'block';
                    return;
                }

                items.forEach(item => {
                    const div = document.createElement('div');
                    div.className = 'shift-drop-item';
                    div.innerHTML = `<div style="font-weight:600; font-size:0.84rem;">${item.title}</div><div style="font-size:0.75rem; color:var(--text-secondary);">${item.sub}</div>`;
                    div.onclick = () => {
                        document.getElementById('selectedShiftId').value = item.id;
                        document.getElementById('shiftSearchInput').value = item.title;
                        document.getElementById('selectedShiftTitle').textContent = item.title;
                        document.getElementById('selectedShiftSub').textContent = item.sub;
                        document.getElementById('selectedShiftBanner').style.display = 'flex';

                        if (item.expected) {
                            document.getElementById('inputExpected').value = item.expected;
                        }
                        if (item.actual) {
                            document.getElementById('inputActual').value = item.actual;
                        }
                        updateLiveVariance();
                        container.style.display = 'none';
                    };
                    container.appendChild(div);
                });

                container.style.display = 'block';
            } catch (err) {
                console.error(err);
            }
        }, 200);
    }

    // Modal 2: Review Modal
    function openReviewModal(id, shiftId, expected, actual, reason, notes) {
        document.getElementById('reviewVarianceIdInput').value = id;
        document.getElementById('reviewIdLabel').textContent = id;
        document.getElementById('reviewShiftRef').textContent = shiftId.substring(0, 8) + '…';
        document.getElementById('reviewExpectedVal').textContent = expected.toLocaleString() + ' XAF';
        document.getElementById('reviewActualVal').textContent = actual.toLocaleString() + ' XAF';

        const delta = actual - expected;
        const deltaLabel = document.getElementById('reviewVarianceDelta');
        deltaLabel.textContent = (delta >= 0 ? '+' : '') + delta.toLocaleString() + ' XAF';
        deltaLabel.style.color = delta < 0 ? '#e11d48' : delta > 0 ? '#0d9488' : 'var(--text-primary)';

        document.getElementById('reviewReasonLabel').textContent = reason || 'Unspecified';

        document.getElementById('reviewModalOverlay').style.display = 'block';
        document.getElementById('reviewModal').style.display = 'block';
    }

    function closeReviewModal() {
        document.getElementById('reviewModalOverlay').style.display = 'none';
        document.getElementById('reviewModal').style.display = 'none';
    }

    // Modal 3: Printable Variance Voucher Slip
    function openVarianceSlipModal(id, shiftId, expected, actual, reason, status, cashier, reviewer, notes, reviewNotes, recordedDate, reviewedDate) {
        const delta = actual - expected;
        document.getElementById('vSlipRef').textContent = `Record #VAR-${id} | Shift: #${shiftId.substring(0, 8)}`;
        document.getElementById('vSlipCashier').textContent = cashier || '—';
        document.getElementById('vSlipStatus').textContent = status || 'Pending';
        document.getElementById('vSlipDate').textContent = recordedDate || '—';
        document.getElementById('vSlipReviewer').textContent = reviewer || 'Awaiting Review';

        document.getElementById('vSlipExpected').textContent = expected.toLocaleString() + ' XAF';
        document.getElementById('vSlipActual').textContent = actual.toLocaleString() + ' XAF';

        const deltaEl = document.getElementById('vSlipDelta');
        deltaEl.textContent = (delta >= 0 ? '+' : '') + delta.toLocaleString() + ' XAF';
        deltaEl.style.color = delta < 0 ? '#e11d48' : delta > 0 ? '#0d9488' : '#0f172a';

        document.getElementById('vSlipReason').textContent = reason || 'Unclassified Discrepancy';
        document.getElementById('vSlipNotes').textContent = notes || 'No cashier explanation notes submitted.';
        document.getElementById('vSlipReviewNotes').textContent = reviewNotes || 'Awaiting supervisory resolution and auditor review determination.';

        document.getElementById('varianceSlipModalOverlay').style.display = 'block';
        document.getElementById('varianceSlipModal').style.display = 'block';
    }

    function closeVarianceSlipModal() {
        document.getElementById('varianceSlipModalOverlay').style.display = 'none';
        document.getElementById('varianceSlipModal').style.display = 'none';
    }

    function printVarianceSlip() {
        setTimeout(() => window.print(), 100);
    }

    function printActiveDrawerVoucher() {
        if (!activeDrawerVarianceData) return;
        const d = activeDrawerVarianceData;
        openVarianceSlipModal(d.id, d.shiftId, d.expected, d.actual, d.reason, d.status, d.cashier, d.reviewer, d.notes, d.reviewNotes, d.recordedDate, d.reviewedDate);
    }

    // Drawer: Inspector
    function openDrawer(id, shiftId, expected, actual, reason, status, cashier, reviewer, notes, reviewNotes, recordedDate, reviewedDate) {
        activeDrawerVarianceData = { id, shiftId, expected, actual, reason, status, cashier, reviewer, notes, reviewNotes, recordedDate, reviewedDate };

        document.getElementById('drawerRecordId').textContent = `Record #${id} (Shift: ${shiftId.substring(0,8)}…)`;
        document.getElementById('dExpected').textContent = expected.toLocaleString() + ' XAF';
        document.getElementById('dActual').textContent = actual.toLocaleString() + ' XAF';

        const delta = actual - expected;
        const deltaElem = document.getElementById('dVariance');
        deltaElem.textContent = (delta >= 0 ? '+' : '') + delta.toLocaleString() + ' XAF';
        deltaElem.style.color = delta < 0 ? '#e11d48' : delta > 0 ? '#0d9488' : 'var(--text-primary)';

        document.getElementById('dStatus').textContent = status;
        document.getElementById('dCashier').textContent = cashier;
        document.getElementById('dReason').textContent = reason || '—';
        document.getElementById('dRecordedDate').textContent = recordedDate;
        document.getElementById('dReviewer').textContent = reviewer || 'Not Reviewed';
        document.getElementById('dNotes').textContent = notes || 'No notes provided by cashier.';
        document.getElementById('dReviewNotes').textContent = reviewNotes || 'No supervisor notes recorded.';

        document.getElementById('drawerOverlay').style.display = 'block';
        const drawer = document.getElementById('varianceDrawer');
        drawer.style.display = 'flex';
        setTimeout(() => drawer.classList.add('open'), 10);
    }

    function closeDrawer() {
        const drawer = document.getElementById('varianceDrawer');
        drawer.classList.remove('open');
        setTimeout(() => {
            drawer.style.display = 'none';
            document.getElementById('drawerOverlay').style.display = 'none';
        }, 200);
    }
</script>
