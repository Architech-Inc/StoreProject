<div class="var-drawer" id="varianceDrawer">
    <div class="drawer-header">
        <div>
            <h3 style="margin:0; font-size:1.15rem; color:var(--text-primary);">Forensic Discrepancy Audit</h3>
            <span id="drawerRecordId" style="font-size:0.75rem; color:var(--text-secondary); font-family:'JetBrains Mono', monospace;"></span>
