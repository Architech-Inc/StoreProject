@page
@model StoreUI.Pages.RoleMatrixModel
@{
    ViewData["Title"] = "Role Permission Matrix";
    ViewData["ActivePage"] = "RoleMatrix";
    ViewData["PageDescription"] = "Fine-grained system capability matrix, RBAC policy enforcement, and domain module access control.";
    Layout = "~/Pages/Shared/_AppLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="matrix-container">
    @* ── ACTION TOOLBAR ── *@
    <div class="matrix-action-bar">
        <div class="matrix-status-pill">
            <span class="status-indicator-dot"></span>
            <span>Role-Based Access Control (RBAC) &amp; Security Policy Hub</span>
        </div>
        <div class="matrix-header-actions">
            <a href="/Users" class="btn-matrix-action btn-matrix-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                User Accounts
            </a>
            <a href="/Employees" class="btn-matrix-action btn-matrix-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                Employees Hub
            </a>
        </div>
    </div>

    @* ── 4-CARD FLUENT 2.0 KPI GRID ── *@
    <div class="matrix-kpi-grid">
        @* KPI 1: Total Configured Roles *@
        <div class="matrix-kpi-card">
            <div class="kpi-icon-wrap kpi-emerald">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Configured System Roles</span>
                <span class="kpi-value">@Model.TotalRoles <small>Roles</small></span>
                <span class="kpi-subtext">Active authorization groups</span>
            </div>
        </div>

        @* KPI 2: Discrete Security Capabilities *@
        <div class="matrix-kpi-card">
            <div class="kpi-icon-wrap kpi-teal">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Security Capabilities</span>
                <span class="kpi-value">@Model.TotalCapabilities <small>Keys</small></span>
                <span class="kpi-subtext">Across 4 domain groups</span>
            </div>
        </div>

        @* KPI 3: Elevated Admin Roles *@
        <div class="matrix-kpi-card">
            <div class="kpi-icon-wrap kpi-amber">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Elevated Admin Roles</span>
                <span class="kpi-value" style="color:#d97706;">@Model.ElevatedRolesCount <small>Supervisory</small></span>
                <span class="kpi-subtext">Possess branch/policy rights</span>
            </div>
        </div>

        @* KPI 4: Granted Permission Ratio *@
        <div class="matrix-kpi-card">
            <div class="kpi-icon-wrap kpi-purple">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
            </div>
            <div class="kpi-data">
                <span class="kpi-label">Granted Matrix Ratio</span>
                <span class="kpi-value" style="color:#7c3aed;">@Model.SecurityGrantRatio%</span>
                <span class="kpi-subtext">@Model.GrantedCapabilitiesCount of @(Model.TotalRoles * Model.TotalCapabilities) grants active</span>
            </div>
        </div>
    </div>

    @* ── MATRIX GRID PANEL ── *@
    <div class="matrix-panel">
        <div class="panel-header-dock">
            <div class="panel-title-wrap">
                <h3>System Capability &amp; Role Authorization Matrix</h3>
                <p>Click any cell to toggle permission grant for the specified role in real-time with instant asynchronous policy persistence.</p>
            </div>
            <div class="domain-legend-dock">
                @foreach (var domain in Model.Domains)
                {
                    <span class="legend-badge @domain.ColorClass">
                        <span class="legend-dot" style="background:@domain.BadgeColor;"></span>
                        @domain.DomainName
                    </span>
                }
            </div>
        </div>
        <div class="matrix-table-wrap">
            <table class="matrix-table">
                <thead>
                    @* ── Tier 1: Domain Group Headers ── *@
                    <tr class="domain-header-row">
                        <th class="sticky-col" rowspan="2">
                            <div class="role-title-head">Role Title</div>
                        </th>
                        @foreach (var domain in Model.Domains)
                        {
                            <th colspan="@domain.Permissions.Count" class="domain-group-th @domain.ColorClass">
                                <span>@domain.DomainName</span>
                            </th>
                        }
                    </tr>
                    @* ── Tier 2: Specific Permission Keys ── *@
                    <tr class="perm-key-row">
                        @foreach (var domain in Model.Domains)
                        {
                            @foreach (var perm in domain.Permissions)
                            {
                                <th class="perm-key-th @domain.ColorClass">
                                    <div class="perm-header-cell">
                                        <code>@perm</code>
                                    </div>
                                </th>
                            }
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Matrix)
                    {
                        var isElevated = row.Permissions.Any(p => p.Key.StartsWith("admin.", StringComparison.OrdinalIgnoreCase) && p.Value);
                        <tr>
                            <td class="sticky-col">
                                <div class="role-cell-wrap">
                                    <strong class="role-name">@row.RoleName</strong>
                                    @if (isElevated)
                                    {
                                        <span class="role-elevated-badge">Elevated</span>
                                    }
                                </div>
                            </td>
                            @foreach (var domain in Model.Domains)
                            {
                                @foreach (var perm in domain.Permissions)
                                {
                                    var current = row.Permissions.TryGetValue(perm, out var allowed) && allowed;
                                    <td>
                                        <button type="button" 
                                                class="toggle-btn @(current ? "toggle-allowed" : "toggle-denied")"
                                                data-role-id="@row.RoleId"
                                                data-role-name="@row.RoleName"
                                                data-perm-key="@perm"
                                                data-allowed="@(current ? "true" : "false")"
                                                onclick="togglePermissionAjax(this)">
                                            @if (current)
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                                </svg>
                                                <span class="toggle-text">Allowed</span>
                                            }
                                            else
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                                                </svg>
                                                <span class="toggle-text">Denied</span>
                                            }
                                        </button>
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ── ASYNC AJAX TOGGLE SCRIPT ── *@
<script>
    async function togglePermissionAjax(btn) {
        if (btn.classList.contains('toggle-loading')) return;

        const roleId = parseInt(btn.getAttribute('data-role-id'), 10);
        const roleName = btn.getAttribute('data-role-name') || 'Role';
        const permKey = btn.getAttribute('data-perm-key');
        const currentlyAllowed = btn.getAttribute('data-allowed') === 'true';
        const targetAllowed = !currentlyAllowed;

        // Optimistic UI state flip
        applyBtnState(btn, targetAllowed);
        btn.classList.add('toggle-loading');

        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const requestVerificationToken = tokenInput ? tokenInput.value : '';

        try {
            const resp = await fetch('?handler=ToggleAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': requestVerificationToken
                },
                body: JSON.stringify({
                    roleId: roleId,
                    permissionKey: permKey,
                    isAllowed: targetAllowed
                })
            });

            if (!resp.ok) {
                const errData = await resp.json().catch(() => ({}));
                throw new Error(errData.message || `Server error (${resp.status})`);
            }

            const data = await resp.json();
            if (!data.success) {
                throw new Error(data.message || 'Permission update was rejected.');
            }

            // Confirmed server state
            applyBtnState(btn, data.isAllowed);
            if (window.showToast) {
                window.showToast(data.message || `${roleName}: ${permKey} updated.`, 'success');
            }
        } catch (err) {
            // Rollback optimistic state
            applyBtnState(btn, currentlyAllowed);
            if (window.showToast) {
                window.showToast(`Failed to update ${permKey}: ${err.message}`, 'error');
            } else {
                alert(`Error: ${err.message}`);
            }
        } finally {
            btn.classList.remove('toggle-loading');
        }
    }

    function applyBtnState(btn, isAllowed) {
        btn.setAttribute('data-allowed', isAllowed ? 'true' : 'false');
        if (isAllowed) {
            btn.className = 'toggle-btn toggle-allowed';
            btn.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span class="toggle-text">Allowed</span>
            `;
        } else {
            btn.className = 'toggle-btn toggle-denied';
            btn.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span class="toggle-text">Denied</span>
            `;
        }
    }
</script>
