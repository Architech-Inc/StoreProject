@page
@model StoreUI.Pages.PricingOpsModel
@{
    ViewData["Title"] = "Pricing & Fiscal Operations";
    ViewData["ActivePage"] = "PricingOps";
    ViewData["PageDescription"] = "Manage multi-tier customer pricing, bundle & BOGO deals, tax profiles, and simulate real-time profit margins.";
    Layout = "~/Pages/Shared/_AppLayout.cshtml";
}

<div class="pricing-hub-container">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="toast-banner @(Model.StatusMessage.StartsWith("Error") ? "error" : "success")">
            @if (Model.StatusMessage.StartsWith("Error"))
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            }
            <span>@Model.StatusMessage</span>
        </div>
    }

    <!-- 4-Card Interactive KPI Banner -->
    <div class="pricing-kpi-grid">
        <div class="pricing-kpi-card">
            <div class="kpi-icon-box teal">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Active Tax Profiles</span>
                <span class="kpi-value" style="color: #0d9488;">@Model.Metrics.ActiveTaxProfilesCount</span>
                <span class="kpi-sub">Avg Rate: @Model.Metrics.AverageTaxRatePercent%</span>
            </div>
        </div>

        <div class="pricing-kpi-card">
            <div class="kpi-icon-box purple">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Active Bundle Rules</span>
                <span class="kpi-value" style="color: #7c3aed;">@Model.Metrics.ActiveBundleRulesCount</span>
                <span class="kpi-sub">BOGO & combo promotions</span>
            </div>
        </div>

        <div class="pricing-kpi-card">
            <div class="kpi-icon-box amber">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Customer Tier Overrides</span>
                <span class="kpi-value" style="color: #d97706;">@Model.Metrics.ActiveSegmentPricingsCount</span>
                <span class="kpi-sub">Wholesale & VIP custom rates</span>
            </div>
        </div>

        <div class="pricing-kpi-card">
            <div class="kpi-icon-box emerald">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Simulator Engine</span>
                <span class="kpi-value" style="color: #059669; font-size: 1.15rem;">Active & Ready</span>
                <span class="kpi-sub">Live margin & fiscal calculator</span>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs Dock -->
    <div class="pricing-tabs-dock">
        <button type="button" class="tab-btn @(Model.ActiveTab == "simulator" ? "active" : "")" onclick="switchTab('simulator')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            Live Pricing & Margin Simulator
        </button>
        <button type="button" class="tab-btn @(Model.ActiveTab == "bundles" ? "active" : "")" onclick="switchTab('bundles')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
            </svg>
            Bundle & BOGO Combos (@Model.BundleRules.Count)
        </button>
        <button type="button" class="tab-btn @(Model.ActiveTab == "segments" ? "active" : "")" onclick="switchTab('segments')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            Customer Segment Pricing (@Model.SegmentPricings.Count)
        </button>
        <button type="button" class="tab-btn @(Model.ActiveTab == "taxes" ? "active" : "")" onclick="switchTab('taxes')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" />
            </svg>
            Tax Profiles & Fiscal Rules (@Model.TaxProfiles.Count)
        </button>
    </div>

    <!-- PANEL 1: Live Pricing Simulator -->
    <div class="pricing-panel @(Model.ActiveTab == "simulator" ? "active" : "")" id="panel-simulator">
        <div class="simulator-card">
            <div>
                <h3 style="margin:0 0 4px 0; font-size: 1.15rem; color: #0f172a;">Live Transaction Pricing & Margin Workbench</h3>
                <p style="margin:0; font-size: 0.85rem; color: #64748b;">
                    Simulate how base prices transform through customer tiers, active bundle rules, and tax schedules with instant gross margin analytics in <strong>XAF</strong>.
                </p>
            </div>

            <div class="simulator-inputs-dock">
                <div class="form-field">
                    <label class="form-label">Select Catalog Product</label>
                    <select id="simItemSelect" class="form-select" onchange="runSimulation()">
                        <option value="">-- Choose Product to Simulate --</option>
                    </select>
                </div>

                <div class="form-field">
                    <label class="form-label">Quantity</label>
                    <input type="number" id="simQuantity" class="form-input" min="1" value="1" oninput="runSimulation()" />
                </div>

                <div class="form-field">
                    <label class="form-label">Customer Tier</label>
                    <select id="simSegment" class="form-select" onchange="runSimulation()">
                        <option value="Standard">Standard Retail</option>
                        <option value="Wholesale">Wholesale Tier</option>
                        <option value="Vip">VIP / Loyalty</option>
                    </select>
                </div>

                <button type="button" class="btn-brand-primary" onclick="runSimulation()" style="height: 38px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    Calculate
                </button>
            </div>

            <!-- Simulation Result Container -->
            <div id="simResultContainer" style="display: none; flex-direction: column; gap: 16px;">
                <div class="step-cards-grid">
                    <div class="step-card">
                        <span class="step-label">Catalog Base Price</span>
                        <span class="step-value" id="resBasePrice">0 XAF</span>
                        <small style="color: #64748b; font-size: 0.74rem;">Standard single unit</small>
                    </div>

                    <div class="step-card">
                        <span class="step-label">Tier Effective Unit</span>
                        <span class="step-value" id="resSegmentPrice" style="color: #2563eb;">0 XAF</span>
                        <small style="color: #64748b; font-size: 0.74rem;" id="resTierName">Standard</small>
                    </div>

                    <div class="step-card">
                        <span class="step-label">Bundle / Promo Discount</span>
                        <span class="step-value" id="resDiscount" style="color: #7c3aed;">0 XAF</span>
                        <small style="color: #64748b; font-size: 0.74rem;" id="resPromoNote">No combo applied</small>
                    </div>

                    <div class="step-card">
                        <span class="step-label">Tax Assessment</span>
                        <span class="step-value" id="resTax">0 XAF</span>
                        <small style="color: #64748b; font-size: 0.74rem;" id="resTaxRate">0%</small>
                    </div>

                    <div class="step-card highlight">
                        <span class="step-label" style="color: #065f46;">Cart Grand Total</span>
                        <span class="step-value" id="resGrandTotal" style="color: #019c01;">0 XAF</span>
                        <small style="color: #059669; font-size: 0.74rem;">Final customer payable</small>
                    </div>
                </div>

                <!-- Margin & Safety Guard Banner -->
                <div class="margin-safety-banner" id="resMarginBanner">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(0,0,0,0.06); display: flex; align-items: center; justify-content: center;" id="resMarginIcon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                            </svg>
                        </div>
                        <div>
                            <div style="font-weight: 700; font-size: 1rem;" id="resMarginTitle">Profitability & Margin Analysis</div>
                            <div style="font-size: 0.82rem;" id="resMarginDesc">Unit Cost: 0 XAF | Net Profit: 0 XAF / unit</div>
                        </div>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-size: 1.35rem; font-weight: 800;" id="resMarginPercent">0%</div>
                        <div style="font-size: 0.74rem; text-transform: uppercase; font-weight: 600;">Gross Margin</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PANEL 2: Bundle & BOGO Combos -->
    <div class="pricing-panel @(Model.ActiveTab == "bundles" ? "active" : "")" id="panel-bundles">
        <div class="panel-toolbar">
            <div class="toolbar-left">
                <div class="search-box-wrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="text" id="bundleSearchInput" class="search-input" placeholder="Search bundle rules..." oninput="filterTable('bundleTable', this.value)" />
                </div>
            </div>
            <div style="display: flex; gap: 10px;">
                <a asp-page-handler="ExportCsv" asp-route-type="bundles" class="btn-brand-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    CSV
                </a>
                @if (Model.CanWrite)
                {
                    <button type="button" class="btn-brand-primary" onclick="openBundleModal()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        New Bundle Rule
                    </button>
                }
            </div>
        </div>

        <div class="pricing-table-card">
            <div class="table-responsive">
                <table class="modern-table" id="bundleTable">
                    <thead>
                        <tr>
                            <th>Rule Name</th>
                            <th>Trigger Condition</th>
                            <th>Reward Benefit</th>
                            <th>Schedule Validity</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.BundleRules.Any())
                        {
                            <tr><td colspan="5" style="text-align:center; padding:32px; color:#64748b;">No bundle rules created yet.</td></tr>
                        }
                        @foreach (var b in Model.BundleRules)
                        {
                            <tr>
                                <td>
                                    <strong style="color: #0f172a;">@b.Name</strong>
                                </td>
                                <td>
                                    <span style="font-weight: 600; color: #1e293b;">Buy @b.TriggerQuantity&times; @b.TriggerItemName</span>
                                </td>
                                <td>
                                    <span style="font-weight: 600; color: #7c3aed;">
                                        Get @b.RewardQuantity&times; @b.RewardItemName @(b.RewardDiscountPercent >= 100 ? "FREE" : $"@ {b.RewardDiscountPercent:0.##}% OFF")
                                    </span>
                                </td>
                                <td>
                                    <span style="font-size: 0.8rem; color: #64748b;">
                                        @(b.ValidFrom.HasValue ? b.ValidFrom.Value.ToString("dd MMM yyyy") : "Always") &rarr; @(b.ValidTo.HasValue ? b.ValidTo.Value.ToString("dd MMM yyyy") : "Indefinite")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-pill @(b.IsActive ? "active" : "inactive")">@(b.IsActive ? "Active" : "Inactive")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PANEL 3: Customer Segment Pricing -->
    <div class="pricing-panel @(Model.ActiveTab == "segments" ? "active" : "")" id="panel-segments">
        <div class="panel-toolbar">
            <div class="toolbar-left">
                <div class="search-box-wrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="text" id="segmentSearchInput" class="search-input" placeholder="Search item or tier..." oninput="filterTable('segmentTable', this.value)" />
                </div>
            </div>
            <div style="display: flex; gap: 10px;">
                <a asp-page-handler="ExportCsv" asp-route-type="segments" class="btn-brand-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    CSV
                </a>
                @if (Model.CanWrite)
                {
                    <button type="button" class="btn-brand-primary" onclick="openSegmentModal()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        New Tier Override
                    </button>
                }
            </div>
        </div>

        <div class="pricing-table-card">
            <div class="table-responsive">
                <table class="modern-table" id="segmentTable">
                    <thead>
                        <tr>
                            <th>Catalog Product</th>
                            <th>Customer Tier</th>
                            <th>Base Catalog Price</th>
                            <th>Tier Override Price</th>
                            <th>Estimated Margin</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.SegmentPricings.Any())
                        {
                            <tr><td colspan="6" style="text-align:center; padding:32px; color:#64748b;">No customer segment price overrides configured.</td></tr>
                        }
                        @foreach (var s in Model.SegmentPricings)
                        {
                            var segClass = s.Segment.ToString().ToLowerInvariant();
                            <tr>
                                <td>
                                    <strong style="color: #0f172a;">@s.ItemName</strong>
                                </td>
                                <td>
                                    <span class="badge-pill @segClass">@s.Segment</span>
                                </td>
                                <td>
                                    <span style="color: #64748b;">@s.BaseUnitPrice.ToString("N0") XAF</span>
                                </td>
                                <td>
                                    <strong style="color: #019c01; font-size: 0.92rem;">@s.PriceOverride.ToString("N0") XAF</strong>
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: @(s.MarginPercent < 0 ? "#dc2626" : (s.MarginPercent < 15 ? "#d97706" : "#059669"));">
                                        @s.MarginPercent%
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-pill @(s.IsActive ? "active" : "inactive")">@(s.IsActive ? "Active" : "Inactive")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PANEL 4: Tax Profiles -->
    <div class="pricing-panel @(Model.ActiveTab == "taxes" ? "active" : "")" id="panel-taxes">
        <div class="panel-toolbar">
            <div class="toolbar-left">
                <div class="search-box-wrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="text" id="taxSearchInput" class="search-input" placeholder="Search tax profile..." oninput="filterTable('taxTable', this.value)" />
                </div>
            </div>
            <div style="display: flex; gap: 10px;">
                <a asp-page-handler="ExportCsv" asp-route-type="taxes" class="btn-brand-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    CSV
                </a>
                @if (Model.CanWrite)
                {
                    <button type="button" class="btn-brand-primary" onclick="openTaxModal()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        New Tax Profile
                    </button>
                }
            </div>
        </div>

        <div class="pricing-table-card">
            <div class="table-responsive">
                <table class="modern-table" id="taxTable">
                    <thead>
                        <tr>
                            <th>Tax Profile Name</th>
                            <th>Fiscal Rate (%)</th>
                            <th>Application Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.TaxProfiles.Any())
                        {
                            <tr><td colspan="4" style="text-align:center; padding:32px; color:#64748b;">No tax profiles created yet.</td></tr>
                        }
                        @foreach (var t in Model.TaxProfiles)
                        {
                            var appClass = t.ApplicationType.ToString().ToLowerInvariant();
                            <tr>
                                <td>
                                    <strong style="color: #0f172a;">@t.Name</strong>
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: #0f172a; font-size: 0.92rem;">@t.RatePercent%</span>
                                </td>
                                <td>
                                    <span class="badge-pill @appClass">@t.ApplicationType</span>
                                </td>
                                <td>
                                    <span class="badge-pill @(t.IsActive ? "active" : "inactive")">@(t.IsActive ? "Active" : "Inactive")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Tax Profile -->
<div class="modern-modal-overlay" id="taxModalOverlay" onclick="closeTaxModal()"></div>
<div class="modern-modal" id="taxModal">
    <div class="modal-header">
        <h3 class="modal-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#0d9488">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" />
            </svg>
            Upsert Tax Profile
        </h3>
        <button type="button" class="btn-close-modal" onclick="closeTaxModal()">&times;</button>
    </div>
    <form method="post" asp-page-handler="Tax">
        @Html.AntiForgeryToken()
        <div class="modal-body">
            <div class="form-field">
                <label class="form-label">Profile Name <span style="color:#dc2626;">*</span></label>
                <input type="text" name="TaxRequest.Name" class="form-input" required placeholder="e.g. Standard VAT 19.25%" />
            </div>

            <div class="form-row-group">
                <div class="form-field">
                    <label class="form-label">Tax Rate (%) <span style="color:#dc2626;">*</span></label>
                    <input type="number" name="TaxRequest.RatePercent" class="form-input" min="0" max="100" step="0.01" value="19.25" required />
                </div>
                <div class="form-field">
                    <label class="form-label">Application Type <span style="color:#dc2626;">*</span></label>
                    <select name="TaxRequest.ApplicationType" class="form-select">
                        <option value="Exclusive">Exclusive (Added to Subtotal)</option>
                        <option value="Inclusive">Inclusive (Embedded in Price)</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-brand-secondary" onclick="closeTaxModal()">Cancel</button>
            <button type="submit" class="btn-brand-primary">Save Tax Profile</button>
        </div>
    </form>
</div>

