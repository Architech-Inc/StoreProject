@section Scripts {
    <script>
        let cachedItems = [];

        async function initCatalogData() {
            try {
                const res = await fetch('?handler=SearchItems');
                if (res.ok) {
                    cachedItems = await res.json();
                    populateSelect('simItemSelect', cachedItems, true);
                    populateSelect('bundleTriggerSelect', cachedItems, false);
                    populateSelect('bundleRewardSelect', cachedItems, false);
                    populateSelect('segmentItemSelect', cachedItems, false);
                }
            } catch (e) {
                console.error("Failed to load catalog items", e);
            }
        }

        function populateSelect(elemId, items, includePlaceholder) {
            const select = document.getElementById(elemId);
            if (!select) return;
            select.innerHTML = includePlaceholder ? '<option value="">-- Choose Product --</option>' : '';
            items.forEach(i => {
                select.innerHTML += `<option value="${i.id}">${escapeHtml(i.title)} (${formatNumber(i.unitPrice)} XAF)</option>`;
            });
        }

        async function runSimulation() {
            const itemId = document.getElementById('simItemSelect').value;
            const qty = document.getElementById('simQuantity').value || 1;
            const seg = document.getElementById('simSegment').value;

            if (!itemId) {
                document.getElementById('simResultContainer').style.display = 'none';
                return;
            }

            try {
                const res = await fetch(`?handler=Simulate&itemId=${itemId}&quantity=${qty}&segment=${seg}`);
                if (!res.ok) return;
                const d = await res.json();

                document.getElementById('resBasePrice').textContent = `${formatNumber(d.baseUnitPrice)} XAF`;
                document.getElementById('resSegmentPrice').textContent = `${formatNumber(d.segmentPrice)} XAF`;
                document.getElementById('resTierName').textContent = `${seg} Tier`;

                const totalDisc = (d.discountPerUnit * qty) + d.bundleDiscountTotal;
                document.getElementById('resDiscount').textContent = totalDisc > 0 ? `-${formatNumber(totalDisc)} XAF` : '0 XAF';
                document.getElementById('resPromoNote').textContent = d.bundleDiscountTotal > 0 ? `Includes ${formatNumber(d.bundleDiscountTotal)} XAF combo deal` : 'No bundle discount';

                document.getElementById('resTax').textContent = `${formatNumber(d.taxAmount)} XAF`;
                document.getElementById('resTaxRate').textContent = `${d.taxRatePercent}% Fiscal Rate`;

                document.getElementById('resGrandTotal').textContent = `${formatNumber(d.grandTotal)} XAF`;

                // Margin Banner
                const banner = document.getElementById('resMarginBanner');
                const isLoss = d.isLossLeader;
                banner.className = `margin-safety-banner ${isLoss ? 'loss-warning' : 'healthy'}`;
                
                const iconContainer = document.getElementById('resMarginIcon');
                if (isLoss) {
                    iconContainer.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#dc2626"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`;
                } else {
                    iconContainer.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#059669"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>`;
                }
                
                document.getElementById('resMarginTitle').textContent = isLoss ? 'Loss-Leader Warning (Below Cost!)' : 'Profitable Transaction';
                document.getElementById('resMarginDesc').textContent = `Unit Cost: ${formatNumber(d.unitCostPrice)} XAF | Profit: ${formatNumber(d.estimatedProfitPerUnit)} XAF / unit`;
                document.getElementById('resMarginPercent').textContent = `${d.grossMarginPercent}%`;

                document.getElementById('simResultContainer').style.display = 'flex';
            } catch (e) {
                console.error("Simulation error", e);
            }
        }

        function switchTab(tabId) {
            document.querySelectorAll('.pricing-panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));

            const panel = document.getElementById(`panel-${tabId}`);
            if (panel) panel.classList.add('active');

            const activeBtn = Array.from(document.querySelectorAll('.tab-btn')).find(b => b.getAttribute('onclick')?.includes(tabId));
            if (activeBtn) activeBtn.classList.add('active');
        }

        function filterTable(tableId, query) {
            const q = query.toLowerCase();
            const rows = document.querySelectorAll(`#${tableId} tbody tr`);
            rows.forEach(r => {
                const txt = r.textContent.toLowerCase();
                r.style.display = txt.includes(q) ? '' : 'none';
            });
        }

        function openTaxModal() {
            document.getElementById('taxModalOverlay').classList.add('open');
            document.getElementById('taxModal').classList.add('open');
        }
        function closeTaxModal() {
            document.getElementById('taxModalOverlay').classList.remove('open');
            document.getElementById('taxModal').classList.remove('open');
        }

        function openBundleModal() {
            document.getElementById('bundleModalOverlay').classList.add('open');
            document.getElementById('bundleModal').classList.add('open');
        }
        function closeBundleModal() {
            document.getElementById('bundleModalOverlay').classList.remove('open');
            document.getElementById('bundleModal').classList.remove('open');
        }

        function openSegmentModal() {
            document.getElementById('segmentModalOverlay').classList.add('open');
            document.getElementById('segmentModal').classList.add('open');
        }
        function closeSegmentModal() {
            document.getElementById('segmentModalOverlay').classList.remove('open');
            document.getElementById('segmentModal').classList.remove('open');
        }

        function formatNumber(num) {
            return Number(num || 0).toLocaleString('en-US');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        document.addEventListener('DOMContentLoaded', () => {
            initCatalogData();
        });
    </script>
}
