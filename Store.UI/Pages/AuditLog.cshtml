@page
@model StoreUI.Pages.AuditLogModel
@{
    ViewData["Title"] = "Audit & Forensic Compliance Log";
    ViewData["ActivePage"] = "AuditLog";
    ViewData["PageDescription"] = "Track security events, user authentication, price overrides, inventory changes, and system modifications.";
    Layout = "~/Pages/Shared/_AppLayout.cshtml";
}

<div class="audit-hub-container">
    <!-- 4-Card Interactive KPI Grid -->
    <div class="audit-kpi-grid">
        <div class="audit-kpi-card">
            <div class="kpi-icon-box emerald">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Total System Events</span>
                <span class="kpi-value">@Model.Metrics.TotalEvents</span>
                <span class="kpi-sub">Lifetime audit ledger</span>
            </div>
        </div>

        <div class="audit-kpi-card">
            <div class="kpi-icon-box teal">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Today's Operations</span>
                <span class="kpi-value">@Model.Metrics.TodayEvents</span>
                <span class="kpi-sub">Actions logged in 24h</span>
            </div>
        </div>

        <div class="audit-kpi-card">
            <div class="kpi-icon-box amber">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Security & Auth Alerts</span>
                <span class="kpi-value">@Model.Metrics.SecurityIncidentsCount</span>
                <span class="kpi-sub">Logins, 2FA, session updates</span>
            </div>
        </div>

        <div class="audit-kpi-card">
            <div class="kpi-icon-box purple">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Critical & Privileges</span>
                <span class="kpi-value">@(Model.Metrics.PrivilegeChangesCount + Model.Metrics.CriticalRiskCount)</span>
                <span class="kpi-sub">Roles, overrides & write-offs</span>
            </div>
        </div>
    </div>

    <!-- Filter Dock & Search Toolbar -->
    <div class="audit-toolbar">
        <div class="toolbar-left">
            <form method="get" id="auditFilterForm" class="search-box-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text" name="Search" value="@Model.Search" class="search-input" placeholder="Search actor, action, IP, summary, entity..." onchange="document.getElementById('auditFilterForm').submit();" />
                @if (!string.IsNullOrWhiteSpace(Model.SeverityFilter))
                {
                    <input type="hidden" name="SeverityFilter" value="@Model.SeverityFilter" />
                }
                @if (!string.IsNullOrWhiteSpace(Model.CategoryFilter))
                {
                    <input type="hidden" name="CategoryFilter" value="@Model.CategoryFilter" />
                }
            </form>

            <!-- Category Selector -->
            <select class="filter-select" onchange="applyCategoryFilter(this.value)">
                <option value="">All Categories</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c" selected="@(Model.CategoryFilter == c)">@c</option>
                }
            </select>

            <!-- Severity Filter Pills -->
            <div class="severity-filter-pills">
                <a href="?Search=@Model.Search&CategoryFilter=@Model.CategoryFilter" class="filter-pill @(string.IsNullOrWhiteSpace(Model.SeverityFilter) ? "active" : "")">All Severities</a>
                @foreach (var s in Model.Severities)
                {
                    <a href="?SeverityFilter=@s&CategoryFilter=@Model.CategoryFilter&Search=@Model.Search" class="filter-pill @(Model.SeverityFilter == s ? "active" : "")">@s</a>
                }
            </div>
        </div>

        <div class="toolbar-right">
            <a asp-page-handler="ExportCsv" asp-route-Search="@Model.Search" asp-route-CategoryFilter="@Model.CategoryFilter" asp-route-SeverityFilter="@Model.SeverityFilter" class="btn-brand-secondary" title="Download CSV Audit Log">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                CSV
            </a>
            <a asp-page-handler="ExportJson" asp-route-Search="@Model.Search" asp-route-CategoryFilter="@Model.CategoryFilter" asp-route-SeverityFilter="@Model.SeverityFilter" class="btn-brand-secondary" title="Download JSON Forensic Payload">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
                JSON
            </a>
        </div>
    </div>

    <!-- Data Stream Table Card -->
    <div class="audit-table-card">
        @if (!Model.LogsPaged.Items.Any())
        {
            <div style="padding: 48px 24px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px;">
                <div style="width: 64px; height: 64px; border-radius: 50%; background: #f1f5f9; color: #94a3b8; display: flex; align-items: center; justify-content: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <h4 style="font-size: 1.05rem; font-weight: 600; color: #0f172a; margin: 0;">No Audit Records Found</h4>
                <p style="font-size: 0.85rem; color: #64748b; margin: 0; max-width: 360px;">
                    No audit records match your search or filter criteria. Reset your filters to view the full event stream.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Severity</th>
                            <th>Action & Category</th>
                            <th>Actor / Operator</th>
                            <th>Client & IP</th>
                            <th>Event Summary</th>
                            <th style="text-align: right;">Forensics</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.LogsPaged.Items)
                        {
                            var sevClass = log.Severity.ToLowerInvariant();
                            var initials = string.IsNullOrWhiteSpace(log.ActorUsername) ? "U" : log.ActorUsername.Substring(0, 1).ToUpperInvariant();
                            <tr>
                                <td>
                                    <div style="display: flex; flex-direction: column;">
                                        <span style="font-weight: 600; color: #0f172a; font-size: 0.82rem;">@log.DateCreated.ToLocalTime().ToString("dd MMM yyyy")</span>
                                        <span style="font-size: 0.75rem; color: #64748b;">@log.DateCreated.ToLocalTime().ToString("HH:mm:ss")</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge-severity @sevClass">@log.Severity</span>
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column; gap: 3px;">
                                        <span class="code-badge">@log.Action</span>
                                        <span class="badge-category" style="width: fit-content;">@log.Category</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="actor-chip">
                                        <div class="actor-avatar">@initials</div>
                                        <div class="actor-info">
                                            <span class="actor-name">@(log.ActorFullName ?? log.ActorUsername)</span>
                                            <span class="actor-role">@(log.ActorRole ?? "Operator")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="client-tag">
                                        <span class="ip-badge">@(log.IpAddress ?? "127.0.0.1")</span>
                                        <span class="device-badge">@(log.DeviceType ?? "Client")</span>
                                    </div>
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column; gap: 2px;">
                                        <span style="font-weight: 500; color: #1e293b; max-width: 380px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@log.Summary</span>
                                        @if (!string.IsNullOrWhiteSpace(log.TargetEntity))
                                        {
                                            <span style="font-size: 0.72rem; color: #64748b;">Target: <strong>@log.TargetEntity</strong> @(log.TargetId != null ? $"#{log.TargetId}" : "")</span>
                                        }
                                    </div>
                                </td>
                                <td style="text-align: right;">
                                    <button type="button" class="btn-table-action" onclick="openAuditDetailModal(@log.Id)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                        Inspect
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.LogsPaged.TotalPages > 1)
            {
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-top: 1px solid #e2e8f0;">
                    <span style="font-size: 0.82rem; color: #64748b;">
                        Showing page <strong>@Model.LogsPaged.Page</strong> of <strong>@Model.LogsPaged.TotalPages</strong> (@Model.LogsPaged.TotalCount total records)
                    </span>
                    <div style="display: flex; gap: 6px;">
                        @if (Model.LogsPaged.HasPreviousPage)
                        {
                            <a href="?PageNumber=@(Model.LogsPaged.Page - 1)&Search=@Model.Search&CategoryFilter=@Model.CategoryFilter&SeverityFilter=@Model.SeverityFilter" class="btn-brand-secondary" style="padding: 4px 10px; font-size: 0.8rem;">Previous</a>
                        }
                        @if (Model.LogsPaged.HasNextPage)
                        {
                            <a href="?PageNumber=@(Model.LogsPaged.Page + 1)&Search=@Model.Search&CategoryFilter=@Model.CategoryFilter&SeverityFilter=@Model.SeverityFilter" class="btn-brand-secondary" style="padding: 4px 10px; font-size: 0.8rem;">Next</a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Forensic Detail & JSON Diff Modal -->
<div class="modern-modal-overlay" id="auditDetailOverlay" onclick="closeAuditDetailModal()"></div>
<div class="modern-modal" id="auditDetailModal" style="max-width: 780px;">
    <div class="modal-header">
        <h3 class="modal-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#019c01">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Forensic Audit Inspection
        </h3>
        <button type="button" class="btn-close-modal" onclick="closeAuditDetailModal()">&times;</button>
    </div>
    <div class="modal-body" id="auditDetailBody">
        <!-- Rendered dynamically -->
    </div>
    <div class="modal-footer">
        <button type="button" class="btn-brand-secondary" onclick="closeAuditDetailModal()">Close</button>
    </div>
</div>

@section Scripts {
    <script>
        function applyCategoryFilter(cat) {
            const url = new URL(window.location.href);
            if (cat) {
                url.searchParams.set('CategoryFilter', cat);
            } else {
                url.searchParams.delete('CategoryFilter');
            }
            url.searchParams.set('PageNumber', '1');
            window.location.href = url.toString();
        }

        async function openAuditDetailModal(id) {
            const container = document.getElementById('auditDetailBody');
            container.innerHTML = '<div style="text-align:center; padding: 32px; color: #94a3b8;">Loading audit record forensics...</div>';

            document.getElementById('auditDetailOverlay').classList.add('open');
            document.getElementById('auditDetailModal').classList.add('open');

            try {
                const res = await fetch(`?handler=DetailsJson&id=${id}`);
                if (!res.ok) throw new Error("Failed to load audit record details");
                const log = await res.json();

                let diffHtml = '';
                if (log.oldValuesJson || log.newValuesJson) {
                    diffHtml = `
                        <div style="font-weight: 700; font-size: 0.85rem; color: #0f172a; margin-top: 6px;">Field-Level Mutation Diff</div>
                        <div class="diff-grid">
                            <div class="diff-box old">
                                <div class="diff-header">Before Change (Old State)</div>
                                <div class="json-code">${escapeHtml(formatJson(log.oldValuesJson))}</div>
                            </div>
                            <div class="diff-box new">
                                <div class="diff-header">After Change (New State)</div>
                                <div class="json-code">${escapeHtml(formatJson(log.newValuesJson))}</div>
                            </div>
                        </div>
                    `;
                }

                container.innerHTML = `
                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px 18px; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div style="font-size: 0.75rem; color: #64748b; text-transform: uppercase; font-weight: 700;">Event Action & ID</div>
                            <div style="font-size: 1.15rem; font-weight: 700; color: #0f172a;">${escapeHtml(log.action)} <small style="color:#94a3b8; font-weight:normal;">#${log.id}</small></div>
                        </div>
                        <div style="display: flex; gap: 6px; align-items: center;">
                            <span class="badge-category">${escapeHtml(log.category)}</span>
                            <span class="badge-severity ${log.severity.toLowerCase()}">${escapeHtml(log.severity)}</span>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; font-size: 0.85rem;">
                        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 14px;">
                            <div style="font-size: 0.72rem; color: #64748b; text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">Actor Credentials</div>
                            <div style="font-weight: 700; color: #0f172a;">${escapeHtml(log.actorFullName || log.actorUsername)}</div>
                            <div style="color: #64748b;">Role: ${escapeHtml(log.actorRole || "User")}</div>
                            <div style="font-family: monospace; font-size: 0.75rem; color: #94a3b8;">UID: ${log.actorUserId}</div>
                        </div>

                        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 14px;">
                            <div style="font-size: 0.72rem; color: #64748b; text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">Client Origin & Session</div>
                            <div style="font-weight: 700; color: #0f172a; font-family: monospace;">${escapeHtml(log.ipAddress || "Unknown IP")}</div>
                            <div style="color: #64748b;">Device: ${escapeHtml(log.deviceType || "Browser")}</div>
                            <div style="font-size: 0.75rem; color: #94a3b8;">Time: ${new Date(log.dateCreated).toLocaleString()}</div>
                        </div>
                    </div>

                    <div>
                        <div style="font-size: 0.75rem; color: #64748b; text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">Synopsis & Scope</div>
                        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 14px; font-size: 0.88rem; color: #1e293b;">
                            ${escapeHtml(log.summary)}
                            ${log.targetEntity ? `<div style="font-size: 0.78rem; color: #64748b; margin-top: 4px;">Target Entity: <strong>${escapeHtml(log.targetEntity)}</strong> ${log.targetId ? `(${escapeHtml(log.targetId)})` : ''}</div>` : ''}
                        </div>
                    </div>

                    ${diffHtml}

                    ${log.metadataJson ? `
                        <div>
                            <div style="font-size: 0.75rem; color: #64748b; text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">Metadata & Context Parameters</div>
                            <div class="json-code">${escapeHtml(formatJson(log.metadataJson))}</div>
                        </div>
                    ` : ''}

                    <div>
                        <div style="font-size: 0.75rem; color: #64748b; text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">User-Agent String</div>
                        <div style="font-family: monospace; font-size: 0.72rem; color: #64748b; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px 10px; word-break: break-all;">
                            ${escapeHtml(log.userAgent || "N/A")}
                        </div>
                    </div>
                `;
            } catch (e) {
                container.innerHTML = `<div style="color: #dc2626; text-align: center; padding: 32px;">Error loading record: ${e.message}</div>`;
            }
        }

        function closeAuditDetailModal() {
            document.getElementById('auditDetailOverlay').classList.remove('open');
            document.getElementById('auditDetailModal').classList.remove('open');
        }

        function formatJson(jsonStr) {
            if (!jsonStr) return 'N/A';
            try {
                const parsed = JSON.parse(jsonStr);
                return JSON.stringify(parsed, null, 2);
            } catch {
                return jsonStr;
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
    </script>
}
