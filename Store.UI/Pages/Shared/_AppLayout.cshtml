@using Store.Models.DTOs.Operations
@using StoreUI.Services
@inject Store.Models.Interfaces.Services.IUserService UserService
@inject Store.Models.Interfaces.Services.IEmployeeService EmployeeService
@inject StoreUI.Services.IApiClientService ApiClient
@{
    var token = Context.Session.GetString("access_token") ?? string.Empty;
    var perms = JwtPermissionReader.GetPermissions(token);
    var username = JwtPermissionReader.GetClaim(token, "sub") ?? "User";
    var userRole = JwtPermissionReader.GetClaim(token, "http://schemas.microsoft.com/ws/2008/06/identity/claims/role") ?? "Staff";

    string displayName = username;
    string avatarUrl = "/images/admin.png";
    string employeeInfo = "";

    if (!string.IsNullOrEmpty(token))
    {
        ApiClient.SetToken(token);
        var userIdStr = JwtPermissionReader.GetClaim(token, "uid");
        if (Guid.TryParse(userIdStr, out var userId))
        {
            try
            {
                var currentUser = await UserService.GetByIdAsync(userId, default);
                if (currentUser != null)
                {
                    avatarUrl = currentUser.ThumbnailUrl ?? currentUser.FullImageUrl ?? "/images/admin.png";
                    if (currentUser.EmployeeId.HasValue)
                    {
                        var emp = await EmployeeService.GetByIdAsync(currentUser.EmployeeId.Value, default);
                        if (emp != null)
                        {
                            if (!string.IsNullOrWhiteSpace(emp.FirstName))
                            {
                                displayName = emp.FirstName;
                            }
                            employeeInfo = $"Emp: {emp.DepartmentName ?? "Unassigned"}";
                        }
                    }
                }
            }
            catch { }
        }
    }

    var canInventoryRead = perms.Contains(PermissionKeys.InventoryRead);
    var canPricingRead   = perms.Contains(PermissionKeys.PricingRead);
    var canCashRead      = perms.Contains(PermissionKeys.CashRead);
    var canReportsRead   = perms.Contains(PermissionKeys.ReportsRead);
    var canPaymentsRead  = perms.Contains(PermissionKeys.PaymentsRead);
    var canAdminBranches = perms.Contains(PermissionKeys.AdminBranches);
    var canAdminRoles    = perms.Contains(PermissionKeys.AdminRoleMatrix);
    var hasOpsSection    = canInventoryRead || canPricingRead || canCashRead || canReportsRead || canPaymentsRead;
    var hasAdminSection  = canAdminBranches || canAdminRoles;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClexAn Foods</title>
    <link rel="icon" type="image/png" href="~/images/clarkstore.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/images/clarkstore.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-modern.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" referrerpolicy="no-referrer" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-authenticated="@(!string.IsNullOrWhiteSpace(token) ? "true" : "false")">
    <div class="app-shell" id="appShell">
        <aside class="app-sidebar" id="appSidebar" aria-label="Primary navigation">
            <div class="brand-block">
                <img src="~/images/clarkstore.png" alt="ClexAn Foods" />
                <div>
                    <strong>ClexAn Foods</strong>
                    <span>Operations Console</span>
                </div>
            </div>

            <nav class="main-nav">
                <span class="nav-section-label">Store</span>
                <a class="nav-link" href="/Dashboard">Dashboard</a>
                <a class="nav-link" href="/Pos">POS Terminal</a>
                <a class="nav-link" href="/Catalog">Item Catalog</a>
                <a class="nav-link" href="/Customers">Customers</a>
                <a class="nav-link" href="/Invoices">Invoices</a>
                <a class="nav-link" href="/Suppliers">Suppliers</a>
                <a class="nav-link" href="/Loyalty">Loyalty</a>
                <a class="nav-link" href="/Campaigns">Campaigns</a>

                @if (hasOpsSection)
                {
                    <hr class="nav-divider" />
                    <div class="nav-section" id="nav-section-ops">
                        <div class="nav-section-header" onclick="toggleNavSection('nav-section-ops')">
                            <span class="nav-section-label">Operations</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </div>
                        <div class="nav-section-content">
                            @if (canInventoryRead)
                            {
                                <a class="nav-link" href="/Employees">Employees</a>
                                <a class="nav-link" href="/InventoryOps">Inventory Ops</a>
                                <a class="nav-link" href="/BatchTracking">Batch &amp; Expiry</a>
                                <a class="nav-link" href="/StockTransfers">Stock Transfers</a>
                                <a class="nav-link" href="/Wastage">Wastage Log</a>
                                <a class="nav-link" href="/PurchaseOrders">Purchase Orders</a>
                                <a class="nav-link" href="/AuditLog">Audit Log</a>
                            }
                            @if (canPricingRead)
                            {
                                <a class="nav-link" href="/Discounts">Discount Rules</a>
                                <a class="nav-link" href="/DiscountOverrides">Discount Overrides</a>
                                <a class="nav-link" href="/PricingOps">Pricing Ops</a>
                                <a class="nav-link" href="/PromotionEffectiveness">Promo Effectiveness</a>
                            }
                            @if (canCashRead || canReportsRead)
                            {
                                <a class="nav-link" href="/CashReports">Cash &amp; Reports</a>
                                <a class="nav-link" href="/Reconciliation">Day-End Reconciliation</a>
                                <a class="nav-link" href="/CashVariance">Cash Variance</a>
                            }
                            @if (canPaymentsRead)
                            {
                                <a class="nav-link" href="/Payments">Payments</a>
                            }
                        </div>
                    </div>
                }
                @if (hasAdminSection)
                {
                    <hr class="nav-divider" />
                    <div class="nav-section" id="nav-section-admin">
                        <div class="nav-section-header" onclick="toggleNavSection('nav-section-admin')">
                            <span class="nav-section-label">Admin</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </div>
                        <div class="nav-section-content">
                            @if (canAdminBranches)
                            {
                                <a class="nav-link" href="/BranchAdmin">Branch Admin</a>
                                <a class="nav-link" href="/BranchDashboard">Branch Dashboard</a>
                            }
                            @if (canAdminRoles)
                            {
                                <a class="nav-link" href="/Users">Users</a>
                                <a class="nav-link" href="/Lookup">Lookup Data</a>
                                <a class="nav-link" href="/RoleMatrix">Role Matrix</a>
                                <a class="nav-link" href="/CommunicationLogs">Comm Logs</a>
                            }
                        </div>
                    </div>
                }
            </nav>

            <div class="user-profile-block">
                <button type="button" class="user-profile-btn" id="userMenuBtn" aria-expanded="false" aria-haspopup="true">
                    <img src="@avatarUrl" class="user-avatar" alt="@displayName" onerror="this.src='/images/admin.png'" loading="lazy" />
                    <div class="user-info">
                        <span class="user-name">@displayName</span>
                        <span class="user-role">@userRole</span>
                    </div>
                </button>
                <div class="user-context-menu" id="userContextMenu" role="menu">
                    @if (!string.IsNullOrEmpty(employeeInfo))
                    {
                        <div class="context-menu-item" style="cursor: default; background: transparent; padding-top: 4px; padding-bottom: 4px;">
                            <small style="color: var(--sidebar-muted);">@employeeInfo</small>
                        </div>
                        <div class="context-menu-divider"></div>
                    }
                    <a href="/Profile" class="context-menu-item" role="menuitem">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        My Profile
                    </a>
                    <div class="context-menu-divider"></div>
                    <form method="post" asp-page="/Logout" style="margin:0;">
                        <button type="submit" class="context-menu-item danger" role="menuitem">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                            Sign Out
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <main class="app-main" role="main">
            <header class="topbar">
                <button type="button" class="menu-toggle" id="menuToggle" aria-expanded="false" aria-controls="appSidebar" aria-label="Toggle Navigation">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div class="topbar-content">
                    <h1>@ViewData["Title"]</h1>
                    @if (ViewData["PageDescription"] != null)
                    {
                        <p>@ViewData["PageDescription"]</p>
                    }
                </div>
            </header>
            <div class="app-content">
                @{
                    // Prefer TempData, fall back to ViewData for pages that set StatusMessage as a property
                    var toastMsg = TempData["StatusMessage"] as string
                                   ?? ViewData["StatusMessage"] as string;
                }
                @if (!string.IsNullOrWhiteSpace(toastMsg))
                {
                    var isError = toastMsg.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
                    <div hidden
                         data-toast-message="@toastMsg"
                         data-toast-type="@(isError ? "error" : "success")"></div>
                }
                @RenderBody()
            </div>
        </main>
    </div>

    <div class="loading-overlay" id="loadingOverlay" role="status" aria-live="polite">
        <div class="spinner" aria-hidden="true"></div>
        <p>Loading...</p>
    </div>

    <div id="toast-container" class="toast-container" aria-live="polite"></div>
    
    <!-- Smart Scanner Hub & Floating FAB -->
    <partial name="_SmartScanHub" />

    <!-- Global AppDialog Modal -->
    <div class="dialog-overlay" id="appDialogOverlay" aria-hidden="true" hidden style="display:none;">
        <div class="dialog-box" role="dialog" aria-modal="true" aria-labelledby="appDialogTitle">
            <div class="dialog-head">
                <div class="dialog-icon" id="appDialogIcon"></div>
                <h3 class="dialog-title" id="appDialogTitle">Confirm</h3>
            </div>
            <div class="dialog-body">
                <p id="appDialogMessage"></p>
                <input type="text" id="appDialogInput" class="dialog-prompt-input" style="display:none;" />
            </div>
            <div class="dialog-foot">
                <button type="button" class="dialog-btn dialog-btn-cancel" id="appDialogCancel">Cancel</button>
                <button type="button" class="dialog-btn dialog-btn-confirm" id="appDialogConfirm">Confirm</button>
            </div>
        </div>
    </div>

    <!-- Global Crop Modal -->
    <div class="modal-overlay" id="globalCropModal" hidden>
        <div class="modal" role="dialog" aria-modal="true" style="max-width: 600px; width: 90%;">
            <div class="modal-head">
                <h3>Crop Thumbnail</h3>
                <button type="button" class="btn-close" id="btnCancelCrop" aria-label="Close">×</button>
            </div>
            <div style="max-height: 60vh; overflow: hidden; background: #000; text-align: center; margin-bottom: 15px;">
                <img id="cropperImage" src="" style="max-width: 100%; display: block;" />
            </div>
            <div style="display:flex;justify-content:flex-end;gap:8px;">
                <button type="button" class="button-command" id="btnCancelCrop2">Cancel</button>
                <button type="button" class="button-primary" id="btnApplyCrop">Apply Crop</button>
            </div>
        </div>
    </div>

    <!-- Global Image Viewer Modal -->
    <div class="modal-overlay" id="globalImageViewerModal" hidden style="z-index: var(--z-image-viewer, 10000);">
        <div class="modal" role="dialog" aria-modal="true" style="max-width: 90vw; width: max-content; background: transparent; box-shadow: none; padding: 0;">
            <div style="position: relative; display: inline-block;">
                <button type="button" class="btn-close" onclick="closeImageViewer()" aria-label="Close" style="position: absolute; top: -40px; right: 0; color: white; font-size: 2rem; background: transparent; border: none; cursor: pointer;">×</button>
                <img id="globalImageViewerImage" src="" alt="Full view" style="max-width: 90vw; max-height: 90vh; border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); display: block;" />
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/browser-image-compression@2.0.1/dist/browser-image-compression.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js" referrerpolicy="no-referrer"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
    (() => {
        const overlay = document.getElementById('loadingOverlay');
        const menuToggle = document.getElementById('menuToggle');
        const shell = document.getElementById('appShell');

        window.requestAnimationFrame(() => {
            setTimeout(() => overlay?.classList.add('hide'), 250);
        });

        menuToggle?.addEventListener('click', () => {
            const collapsed = shell?.classList.toggle('sidebar-collapsed');
            menuToggle?.setAttribute('aria-expanded', collapsed ? 'true' : 'false');
        });

        // Deep linking and active state based on URL
        const currentPath = window.location.pathname.toLowerCase();
        let activeLink = null;
        let longestMatch = 0;

        document.querySelectorAll('.nav-link').forEach(link => {
            const href = link.getAttribute('href')?.toLowerCase();
            if (href && currentPath.startsWith(href) && href.length > longestMatch) {
                // Ignore "/" matching everything incorrectly if we had a "/" nav link
                if (href !== "/" || currentPath === "/") {
                    longestMatch = href.length;
                    activeLink = link;
                }
            }
        });

        if (activeLink) {
            document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
            activeLink.classList.add('active');

            const parentSection = activeLink.closest('.nav-section');
            if (parentSection) {
                parentSection.classList.add('expanded');
                localStorage.setItem(parentSection.id, 'expanded');
            }

            setTimeout(() => {
                activeLink.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 150);
        }

        // Setup User Context Menu Toggle
        const userMenuBtn = document.getElementById('userMenuBtn');
        const userContextMenu = document.getElementById('userContextMenu');
        if (userMenuBtn && userContextMenu) {
            userMenuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isOpen = userContextMenu.classList.contains('open');
                userContextMenu.classList.toggle('open', !isOpen);
                userMenuBtn.setAttribute('aria-expanded', !isOpen);
            });

            document.addEventListener('click', (e) => {
                if (!userMenuBtn.contains(e.target) && !userContextMenu.contains(e.target)) {
                    userContextMenu.classList.remove('open');
                    userMenuBtn.setAttribute('aria-expanded', 'false');
                }
            });
        }

        // Setup Expandable Sections
        window.toggleNavSection = (id) => {
            const section = document.getElementById(id);
            if (section) {
                const isExpanded = section.classList.toggle('expanded');
                localStorage.setItem(id, isExpanded ? 'expanded' : 'collapsed');
            }
        };

        // Restore section state from localStorage on load
        document.querySelectorAll('.nav-section').forEach(section => {
            if (section.id) {
                const state = localStorage.getItem(section.id);
                if (state === 'expanded') {
                    section.classList.add('expanded');
                } else if (state === 'collapsed') {
                    section.classList.remove('expanded');
                }
            }
        });
    })();
    </script>
</body>
</html>
