<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#3b82f6" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ClexAn POS" />
    <title>@ViewData["Title"] - ClexAn Foods</title>
    <link rel="manifest" href="~/manifest.json" />
    <link rel="apple-touch-icon" href="~/images/clarkstore.png" />
    <link rel="icon" type="image/png" href="~/images/clarkstore.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/images/clarkstore.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modules/dashboards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modules/sales.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modules/supply-chain.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modules/cash-reconciliation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modules/pricing-promotions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modules/admin-governance.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pwa.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cropper.min.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-authenticated="@(!string.IsNullOrWhiteSpace(Context.Session.GetString("access_token")) ? "true" : "false")">
    @RenderBody()
    
    <div id="toast-container" class="toast-container" aria-live="polite"></div>
    
    <!-- Smart Scanner Hub & Floating FAB -->
    <partial name="_SmartScanHub" />
    
    <!-- Global AppDialog Modal -->
    <div class="dialog-overlay" id="appDialogOverlay" aria-hidden="true" hidden style="display:none;">
        <div class="dialog-box" role="dialog" aria-modal="true" aria-labelledby="appDialogTitle">
            <div class="dialog-head">
                <div class="dialog-icon" id="appDialogIcon"></div>
                <h3 class="dialog-title" id="appDialogTitle">Confirm</h3>
            </div>
            <div class="dialog-body">
                <p id="appDialogMessage"></p>
                <input type="text" id="appDialogInput" class="dialog-prompt-input" style="display:none;" />
            </div>
            <div class="dialog-foot">
                <button type="button" class="dialog-btn dialog-btn-cancel" id="appDialogCancel">Cancel</button>
                <button type="button" class="dialog-btn dialog-btn-confirm" id="appDialogConfirm">Confirm</button>
            </div>
        </div>
    </div>

    <!-- Global Crop Modal -->
    <div class="modal-overlay" id="globalCropModal" hidden style="display:none; align-items:center; justify-content:center; background:rgba(15,23,42,0.75); -webkit-backdrop-filter:blur(4px); backdrop-filter:blur(4px); position:fixed; inset:0;">
        <div class="modal crop-modal-card" role="dialog" aria-modal="true" style="max-width:620px; width:92%; background:#ffffff !important; color:#0f172a !important; border-radius:14px; padding:22px; box-shadow:0 25px 60px -12px rgba(0,0,0,0.6); border:1px solid #e2e8f0; display:flex; flex-direction:column; position:relative;">
            <div class="modal-head" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; border-bottom:1px solid #e2e8f0; padding-bottom:12px;">
                <div>
                    <h3 style="margin:0; font-size:1.15rem; font-weight:700; color:#0f172a;">Crop Image</h3>
                    <span style="font-size:0.75rem; color:#64748b;">Drag the box corners to reposition or resize your selection</span>
                </div>
                <button type="button" class="btn-close" id="btnCancelCrop" aria-label="Close" style="background:none; border:none; cursor:pointer; color:#64748b; padding:4px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            <div style="height:380px; max-height:55vh; width:100%; overflow:hidden; background:#0f172a; border-radius:8px; position:relative; display:flex; align-items:center; justify-content:center; margin-bottom:16px;">
                <img id="cropperImage" src="" style="max-width:100%; display:block;" />
            </div>
            <div style="display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" id="btnCancelCrop2" style="cursor:pointer; padding:9px 18px; border-radius:8px; border:1px solid #cbd5e1; background:#f8fafc; color:#475569; font-weight:600; font-size:0.875rem;">Cancel</button>
                <button type="button" id="btnApplyCrop" style="cursor:pointer; padding:9px 22px; border-radius:8px; border:none; background:#2563eb; color:#ffffff; font-weight:600; font-size:0.875rem; display:inline-flex; align-items:center; gap:6px; box-shadow:0 2px 8px rgba(37,99,235,0.35);">Apply Crop</button>
            </div>
        </div>
    </div>

    <!-- Global Image Viewer Modal -->
    <div class="modal-overlay" id="globalImageViewerModal" hidden style="z-index: var(--z-image-viewer, 10000);">
        <div class="modal" role="dialog" aria-modal="true" style="max-width: 90vw; width: max-content; background: transparent; box-shadow: none; padding: 0;">
            <div style="position: relative; display: inline-block;">
                <button type="button" class="btn-close" onclick="closeImageViewer()" aria-label="Close" style="position: absolute; top: -40px; right: 0; color: white; font-size: 2rem; background: transparent; border: none; cursor: pointer;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
                <img id="globalImageViewerImage" src="" alt="Full view" style="max-width: 90vw; max-height: 90vh; border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); display: block;" />
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/browser-image-compression@2.0.1/dist/browser-image-compression.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/cropper.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/pwa-install.js" asp-append-version="true"></script>
    @if (TempData["StatusMessage"] is string successMsg)
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                window.showToast('success', '@Html.Raw(successMsg.Replace("'", "\\'").Replace("\n", "\\n").Replace("\r", ""))');
            });
        </script>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                window.showToast('error', '@Html.Raw(errorMsg.Replace("'", "\\'").Replace("\n", "\\n").Replace("\r", ""))');
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
