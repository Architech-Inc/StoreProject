@* Global OmniSearch & Command Palette Partial (Ctrl + K) *@
<div class="command-palette-overlay" id="commandPaletteOverlay" hidden style="display: none;">
    <div class="command-palette-box" role="dialog" aria-modal="true" aria-labelledby="cmdPaletteInput">
        <div class="command-palette-search-bar">
            <svg class="cmd-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" 
                   id="cmdPaletteInput" 
                   class="cmd-input" 
                   placeholder="Type a command, item name, barcode, customer, or invoice #..." 
                   autocomplete="off" 
                   spellcheck="false" />
            <div class="cmd-spinner" id="cmdSpinner" style="display: none;"></div>
            <kbd class="cmd-key-badge">ESC</kbd>
        </div>

        <div class="command-palette-results" id="cmdPaletteResults">
            <!-- Navigation Shortcuts Section -->
            <div class="cmd-group" id="cmdNavShortcuts">
                <div class="cmd-group-title">Quick Navigation</div>
                <div class="cmd-item" data-type="nav" data-url="/Pos">
                    <span class="cmd-item-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                    </span>
                    <div class="cmd-item-info">
                        <div class="cmd-item-title">POS Terminal</div>
                        <div class="cmd-item-desc">Point of sale checkout register</div>
                    </div>
                    <span class="cmd-badge">G P</span>
                </div>
                <div class="cmd-item" data-type="nav" data-url="/Invoices">
                    <span class="cmd-item-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                    </span>
                    <div class="cmd-item-info">
                        <div class="cmd-item-title">Invoices &amp; Sales</div>
                        <div class="cmd-item-desc">Browse sales records and print receipts</div>
                    </div>
                    <span class="cmd-badge">G I</span>
                </div>
                <div class="cmd-item" data-type="nav" data-url="/Catalog">
                    <span class="cmd-item-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                    </span>
                    <div class="cmd-item-info">
                        <div class="cmd-item-title">Product Catalog</div>
                        <div class="cmd-item-desc">Manage products, prices, and stock</div>
                    </div>
                    <span class="cmd-badge">G C</span>
                </div>
                <div class="cmd-item" data-type="nav" data-url="/Customers">
                    <span class="cmd-item-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </span>
                    <div class="cmd-item-info">
                        <div class="cmd-item-title">Customers CRM</div>
                        <div class="cmd-item-desc">Customer accounts and loyalty status</div>
                    </div>
                    <span class="cmd-badge">G M</span>
                </div>
                <div class="cmd-item" data-type="nav" data-url="/PurchaseOrders">
                    <span class="cmd-item-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                    </span>
                    <div class="cmd-item-info">
                        <div class="cmd-item-title">Purchase Orders</div>
                        <div class="cmd-item-desc">Supplier procurement and receiving</div>
                    </div>
                    <span class="cmd-badge">G O</span>
                </div>
                <div class="cmd-item" data-type="nav" data-url="/Suppliers">
                    <span class="cmd-item-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="9" y1="22" x2="9" y2="22.01"></line><line x1="15" y1="22" x2="15" y2="22.01"></line><line x1="9" y1="6" x2="9" y2="6.01"></line><line x1="15" y1="6" x2="15" y2="6.01"></line><line x1="9" y1="10" x2="9" y2="10.01"></line><line x1="15" y1="10" x2="15" y2="10.01"></line><line x1="9" y1="14" x2="9" y2="14.01"></line><line x1="15" y1="14" x2="15" y2="14.01"></line><line x1="9" y1="18" x2="9" y2="18.01"></line><line x1="15" y1="18" x2="15" y2="18.01"></line></svg>
                    </span>
                    <div class="cmd-item-info">
                        <div class="cmd-item-title">Suppliers Directory</div>
                        <div class="cmd-item-desc">Supplier profiles and contact matrix</div>
                    </div>
                    <span class="cmd-badge">G S</span>
                </div>
            </div>

            <!-- Dynamic Search Hits -->
            <div class="cmd-group" id="cmdDynamicResults" style="display: none;">
                <div class="cmd-group-title">Search Results</div>
                <div id="cmdDynamicList"></div>
            </div>
        </div>

        <div class="command-palette-footer">
            <div class="cmd-footer-hints">
                <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
                <span><kbd>↵</kbd> Select</span>
                <span><kbd>ESC</kbd> Close</span>
            </div>
            <div class="cmd-footer-tag">ClexAn Omnisearch</div>
        </div>
    </div>
</div>
