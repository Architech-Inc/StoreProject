@page
@model StoreUI.Pages.ContactRequestsModel
@{
    ViewData["Title"] = "Contact Requests";
    ViewData["ActivePage"] = "ContactRequests";
    ViewData["PageDescription"] = "Review, authorize, and audit user contact credentials and verification lifecycle.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
}

<div class="ops-page">
    <!-- Breadcrumb & Top Action -->
    <div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
        <a href="/Users" class="button-secondary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Back to User Accounts
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="status @(Model.StatusMessage.StartsWith("Error") ? "error" : "ok")" style="margin-bottom: 20px;">
            @Model.StatusMessage
        </div>
    }

    <!-- 4-Card Fluent KPI Metric Grid -->
    <section class="kpi-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div class="kpi-card" style="padding: 20px; border-radius: 12px; background: var(--surface-card, #ffffff); border: 1px solid var(--border); box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 8px;">
                <span style="font-size: 0.875rem; color: var(--text-muted); font-weight: 500;">Pending Total</span>
                <span class="badge" style="background: rgba(1, 156, 1, 0.1); color: var(--color-primary, #019c01); font-weight: 600;">Queue</span>
            </div>
            <div style="font-size: 1.875rem; font-weight: 700; color: var(--text-main);">@Model.Metrics.TotalPendingCount</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">Active verification requests</div>
        </div>

        <div class="kpi-card" style="padding: 20px; border-radius: 12px; background: var(--surface-card, #ffffff); border: 1px solid var(--border); box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 8px;">
                <span style="font-size: 0.875rem; color: var(--text-muted); font-weight: 500;">Awaiting Approval</span>
                <span class="badge" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6; font-weight: 600;">Action Req</span>
            </div>
            <div style="font-size: 1.875rem; font-weight: 700; color: #3b82f6;">@Model.Metrics.PendingApprovalCount</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">Verified by user, awaiting admin</div>
        </div>

        <div class="kpi-card" style="padding: 20px; border-radius: 12px; background: var(--surface-card, #ffffff); border: 1px solid var(--border); box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 8px;">
                <span style="font-size: 0.875rem; color: var(--text-muted); font-weight: 500;">Awaiting Verification</span>
                <span class="badge" style="background: rgba(234, 179, 8, 0.1); color: #ca8a04; font-weight: 600;">User Link</span>
            </div>
            <div style="font-size: 1.875rem; font-weight: 700; color: #ca8a04;">@Model.Metrics.PendingVerificationCount</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">Pending token link verification</div>
        </div>

        <div class="kpi-card" style="padding: 20px; border-radius: 12px; background: var(--surface-card, #ffffff); border: 1px solid var(--border); box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 8px;">
                <span style="font-size: 0.875rem; color: var(--text-muted); font-weight: 500;">Approved History</span>
                <span class="badge" style="background: rgba(22, 163, 74, 0.1); color: #16a34a; font-weight: 600;">Resolved</span>
            </div>
            <div style="font-size: 1.875rem; font-weight: 700; color: #16a34a;">@Model.Metrics.TotalApprovedCount</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">Historical approvals logged</div>
        </div>
    </section>

    <!-- Active Review Queue Card -->
    <section class="card" style="padding: 24px; border-radius: 12px; background: var(--surface-card, #ffffff); border: 1px solid var(--border); margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary, #019c01);"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                <h3 style="margin: 0; font-size: 1.125rem; font-weight: 600;">Pending Authorization Queue</h3>
            </div>
            <span class="badge" style="background: var(--bg-muted, #f3f4f6); color: var(--text-secondary); font-size: 0.8rem;">@Model.PendingContactChanges.Count pending</span>
        </div>

        @if (!Model.PendingContactChanges.Any())
        {
            <div class="empty-state" style="padding: 48px; text-align: center; color: var(--text-secondary);">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 12px; color: var(--text-muted);"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <h4 style="margin: 0 0 6px; font-weight: 600;">Queue is Clear</h4>
                <p style="margin: 0; font-size: 0.875rem;">There are no contact information change requests waiting for approval.</p>
            </div>
        }
        else
        {
            <div class="table-wrap" style="overflow-x: auto; border: 1px solid var(--border); border-radius: 8px;">
                <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
                    <thead>
                        <tr style="background: var(--bg-muted, #f9fafb); border-bottom: 1px solid var(--border);">
                            <th style="padding: 12px 16px;">User Account</th>
                            <th style="padding: 12px 16px;">Requested Email</th>
                            <th style="padding: 12px 16px;">Requested Phone</th>
                            <th style="padding: 12px 16px;">Verification Status</th>
                            <th style="padding: 12px 16px;">Verified Timestamp</th>
                            <th style="padding: 12px 16px; text-align: right;">Decision</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model.PendingContactChanges)
                        {
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 12px 16px;">
                                    <div style="font-weight: 600; color: var(--text-main);">@req.Username</div>
                                    <small style="color: var(--text-muted);">ID: @req.Id.ToString()[..8]...</small>
                                </td>
                                <td style="padding: 12px 16px; font-family: monospace;">@(req.NewEmail ?? "—")</td>
                                <td style="padding: 12px 16px; font-family: monospace;">@(req.NewPhone ?? "—")</td>
                                <td style="padding: 12px 16px;">
                                    @if (req.Status == Store.Models.Enums.ContactChangeStatus.PendingVerification)
                                    {
                                        <span class="badge" style="background: rgba(234, 179, 8, 0.15); color: #ca8a04; font-weight: 600;">Awaiting User Link</span>
                                    }
                                    else if (req.Status == Store.Models.Enums.ContactChangeStatus.PendingApproval)
                                    {
                                        <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #2563eb; font-weight: 600;">Verified • Ready for Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge">@req.Status</span>
                                    }
                                </td>
                                <td style="padding: 12px 16px; font-size: 0.875rem; color: var(--text-secondary);">
                                    @(req.VerifiedAt?.ToString("MMM dd, yyyy HH:mm") ?? "Unverified")
                                </td>
                                <td style="padding: 12px 16px; text-align: right;">
                                    <div style="display: inline-flex; gap: 8px; justify-content: flex-end;">
                                        <form method="post" asp-page-handler="Approve" style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="requestId" value="@req.Id" />
                                            @if (req.Status == Store.Models.Enums.ContactChangeStatus.PendingVerification)
                                            {
                                                <button type="button" class="button-command" disabled style="opacity: 0.5; cursor: not-allowed;" title="User must click verification link first">Approve</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="button-primary" data-confirm="Authorize contact update for @req.Username? This will immediately apply the new credentials to the account." data-confirm-type="success" data-confirm-title="Authorize Contact Change">Approve</button>
                                            }
                                        </form>
                                        <form method="post" asp-page-handler="Reject" style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="requestId" value="@req.Id" />
                                            <button type="submit" class="button-command danger" data-confirm="Reject contact update for @req.Username?" data-confirm-type="danger" data-confirm-title="Reject Contact Change">Reject</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- Request History Audit Section -->
    <section class="card" style="padding: 24px; border-radius: 12px; background: var(--surface-card, #ffffff); border: 1px solid var(--border);">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-muted);"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <h3 style="margin: 0; font-size: 1.125rem; font-weight: 600;">Audit Trail & Historical Decisions</h3>
        </div>

        @if (!Model.HistoricalContactChanges.Any())
        {
            <div style="padding: 32px; text-align: center; color: var(--text-secondary); background: var(--bg-muted, #f9fafb); border-radius: 8px; border: 1px dashed var(--border);">
                <p style="margin: 0; font-size: 0.875rem;">No historical decision logs recorded.</p>
            </div>
        }
        else
        {
            <div style="overflow-x: auto; border: 1px solid var(--border); border-radius: 8px;">
                <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
                    <thead>
                        <tr style="background: var(--bg-muted, #f9fafb); border-bottom: 1px solid var(--border);">
                            <th style="padding: 12px 16px;">User Account</th>
                            <th style="padding: 12px 16px;">Requested Email</th>
                            <th style="padding: 12px 16px;">Requested Phone</th>
                            <th style="padding: 12px 16px;">Resolution Status</th>
                            <th style="padding: 12px 16px;">Date Submitted</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model.HistoricalContactChanges)
                        {
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 12px 16px; font-weight: 500;">@req.Username</td>
                                <td style="padding: 12px 16px; font-family: monospace;">@(req.NewEmail ?? "—")</td>
                                <td style="padding: 12px 16px; font-family: monospace;">@(req.NewPhone ?? "—")</td>
                                <td style="padding: 12px 16px;">
                                    @if (req.Status == Store.Models.Enums.ContactChangeStatus.Approved)
                                    {
                                        <span class="badge" style="background: rgba(22, 163, 74, 0.15); color: #16a34a; font-weight: 600;">Approved</span>
                                    }
                                    else if (req.Status == Store.Models.Enums.ContactChangeStatus.Rejected)
                                    {
                                        <span class="badge" style="background: rgba(220, 38, 38, 0.15); color: #dc2626; font-weight: 600;">Rejected</span>
                                    }
                                    else if (req.Status == Store.Models.Enums.ContactChangeStatus.Cancelled)
                                    {
                                        <span class="badge" style="background: rgba(107, 114, 128, 0.15); color: #6b7280; font-weight: 600;">Cancelled</span>
                                    }
                                </td>
                                <td style="padding: 12px 16px; font-size: 0.875rem; color: var(--text-secondary);">@req.DateCreated.ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

