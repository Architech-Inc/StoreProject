@page
@model StoreUI.Pages.ContactRequestsModel
@{
    ViewData["Title"] = "Contact Requests";
    ViewData["ActivePage"] = "Users";
    ViewData["PageDescription"] = "Review and approve pending contact information changes.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
}

<div class="ops-page">
    <div style="margin-bottom: 16px;">
        <a href="/Users" class="button-secondary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"></path><polyline points="12 19 5 12 12 5"></polyline></svg>
            Back to Users
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="status @(Model.StatusMessage.StartsWith("Error") ? "error" : "ok")">@Model.StatusMessage</div>
    }

    <section class="card" style="padding:0; overflow:hidden;">
        @if (!Model.PendingContactChanges.Any())
        {
            <div class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                <h4>No Pending Requests</h4>
                <p>There are no contact change requests waiting for approval.</p>
            </div>
        }
        else
        {
            <div class="table-wrap" style="margin:0; border:none; border-radius:0;">
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>New Email</th>
                            <th>New Phone</th>
                            <th>Status</th>
                            <th>Verified At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model.PendingContactChanges)
                        {
                            <tr>
                                <td><strong>@req.Username</strong></td>
                                <td>@(req.NewEmail ?? "—")</td>
                                <td>@(req.NewPhone ?? "—")</td>
                                <td>
                                    @if (req.Status == Store.Models.Enums.ContactChangeStatus.PendingVerification)
                                    {
                                        <span class="badge badge-warning" style="background:#eab308; color:white;">Awaiting Verification</span>
                                    }
                                    else if (req.Status == Store.Models.Enums.ContactChangeStatus.PendingApproval)
                                    {
                                        <span class="badge badge-info" style="background:#3b82f6; color:white;">Awaiting Approval</span>
                                    }
                                    else
                                    {
                                        @req.Status
                                    }
                                </td>
                                <td>@(req.VerifiedAt?.ToString("MMM dd, yyyy HH:mm") ?? "—")</td>
                                <td>
                                    <div style="display:flex; gap:4px;">
                                        <form method="post" asp-page-handler="Approve" style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="requestId" value="@req.Id" />
                                            @if (req.Status == Store.Models.Enums.ContactChangeStatus.PendingVerification)
                                            {
                                                <button type="submit" class="button-primary" style="background:#9ca3af; border-color:#9ca3af; cursor:not-allowed;" disabled title="User must verify link first">Approve</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="button-primary" style="background:#16a34a; border-color:#16a34a;" data-confirm="Approve this contact change request for @req.Username?" data-confirm-type="success" data-confirm-title="Approve Contact Change">Approve</button>
                                            }
                                        </form>
                                        <form method="post" asp-page-handler="Reject" style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="requestId" value="@req.Id" />
                                            <button type="submit" class="button-command danger" data-confirm="Reject this contact change request for @req.Username?" data-confirm-type="danger" data-confirm-title="Reject Contact Change">Reject</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="kpi-card" style="margin-top: 24px;">
        <div class="kpi-card-header" style="margin-bottom: 24px;">
            <h2 class="kpi-title" style="display: flex; align-items: center; gap: 8px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                Request History
            </h2>
        </div>

        @if (!Model.HistoricalContactChanges.Any())
        {
            <div style="padding: 40px; text-align: center; color: var(--text-secondary); background: var(--background); border-radius: 12px; border: 1px dashed var(--border);">
                <p>No historical requests found.</p>
            </div>
        }
        else
        {
            <div style="overflow-x: auto; border: 1px solid var(--border); border-radius: 12px;">
                <table class="data-table" style="width: 100%; border-collapse: collapse;">
                    <thead style="background: var(--background); text-align: left; border-bottom: 1px solid var(--border);">
                        <tr>
                            <th style="padding: 12px 16px;">User</th>
                            <th style="padding: 12px 16px;">Requested Email</th>
                            <th style="padding: 12px 16px;">Requested Phone</th>
                            <th style="padding: 12px 16px;">Status</th>
                            <th style="padding: 12px 16px;">Requested On</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model.HistoricalContactChanges)
                        {
                            <tr>
                                <td style="padding: 12px 16px;"><strong>@req.Username</strong></td>
                                <td style="padding: 12px 16px;">@(req.NewEmail ?? "—")</td>
                                <td style="padding: 12px 16px;">@(req.NewPhone ?? "—")</td>
                                <td style="padding: 12px 16px;">
                                    @if (req.Status == Store.Models.Enums.ContactChangeStatus.Approved)
                                    {
                                        <span class="badge badge-success" style="background:#16a34a; color:white;">Approved</span>
                                    }
                                    else if (req.Status == Store.Models.Enums.ContactChangeStatus.Rejected)
                                    {
                                        <span class="badge badge-danger" style="background:#dc2626; color:white;">Rejected</span>
                                    }
                                    else if (req.Status == Store.Models.Enums.ContactChangeStatus.Cancelled)
                                    {
                                        <span class="badge" style="background:#6b7280; color:white;">Cancelled</span>
                                    }
                                </td>
                                <td style="padding: 12px 16px;">@req.DateCreated.ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
