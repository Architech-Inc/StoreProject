@page
@model StoreUI.Pages.BranchDashboardModel
@{
    ViewData["Title"] = "Branch Performance Dashboard";
    ViewData["ActivePage"] = "BranchDashboard";
    ViewData["PageDescription"] = "Comparative multi-branch sales velocity, receivables tracking, and tender breakdown.";
    Layout = "~/Pages/Shared/_AppLayout.cshtml";
    var perf = Model.Performance;
}

<div class="branch-dash-container">
    @* ── ACTION TOOLBAR ── *@
    <div class="branch-action-bar">
        <div class="branch-status-pill">
            <span class="status-indicator-dot"></span>
            <span>Multi-Branch Commercial Intelligence &amp; Performance</span>
        </div>
        <div class="branch-header-actions">
            <a href="/BranchAdmin" class="btn-bd-action btn-bd-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                Branch Admin
            </a>
            <a href="/Dashboard" class="btn-bd-action btn-bd-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                Store Dashboard
            </a>
        </div>
    </div>

    @if (Model.ErrorMessage is not null)
    {
        <div class="branch-alert error" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    @* ── FILTER DOCK ── *@
    <div class="branch-filter-dock">
        <form method="get" class="branch-filter-form">
            <div class="filter-field">
                <label for="branchSelect">Branch Location</label>
                <select id="branchSelect" name="branchId" class="form-control form-control-sm">
                    <option value="">— Select branch location —</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.BranchId" selected="@(b.BranchId == Model.SelectedBranchId)">@b.Name</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="fromInput">Date From</label>
                <input type="date" id="fromInput" name="from" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="filter-field">
                <label for="toInput">Date To</label>
                <input type="date" id="toInput" name="to" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <button type="submit" class="btn-filter-apply">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Load Performance
            </button>
        </form>
    </div>

    @if (perf is not null)
    {
        @* ── 6-CARD FLUENT 2.0 KPI GRID ── *@
        <div class="branch-kpi-grid">
            @* KPI 1: Total Revenue *@
            <div class="branch-kpi-card">
                <div class="kpi-icon-wrap kpi-emerald">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="kpi-data">
                    <span class="kpi-label">Gross Revenue</span>
                    <span class="kpi-value">@perf.TotalRevenue.ToString("N0") <small>XAF</small></span>
                    <span class="kpi-subtext">@perf.BranchName Sales</span>
                </div>
            </div>

            @* KPI 2: AOV *@
            <div class="branch-kpi-card">
                <div class="kpi-icon-wrap kpi-teal">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                </div>
                <div class="kpi-data">
                    <span class="kpi-label">Average Ticket (AOV)</span>
                    <span class="kpi-value">@perf.AverageOrderValue.ToString("N0") <small>XAF</small></span>
                    <span class="kpi-subtext">Average spend per invoice</span>
                </div>
            </div>

            @* KPI 3: Total Invoices *@
            <div class="branch-kpi-card">
                <div class="kpi-icon-wrap kpi-purple">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <div class="kpi-data">
                    <span class="kpi-label">Total Invoices</span>
                    <span class="kpi-value">@perf.TotalInvoices.ToString("N0") <small>Tickets</small></span>
                    <span class="kpi-subtext">Invoiced transactions</span>
                </div>
            </div>

            @* KPI 4: Paid *@
            <div class="branch-kpi-card">
                <div class="kpi-icon-wrap kpi-emerald">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="kpi-data">
                    <span class="kpi-label">Fully Settled</span>
                    <span class="kpi-value text-emerald">@perf.PaidInvoices.ToString("N0") <small>Paid</small></span>
                    <span class="kpi-subtext">Zero balance remaining</span>
                </div>
            </div>

            @* KPI 5: Unpaid *@
            <div class="branch-kpi-card">
                <div class="kpi-icon-wrap @(perf.UnpaidInvoices > 0 ? "kpi-amber" : "kpi-emerald")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="kpi-data">
                    <span class="kpi-label">Pending / Unpaid</span>
                    <span class="kpi-value" style="color:@(perf.UnpaidInvoices > 0 ? "#d97706" : "#059669");">
                        @perf.UnpaidInvoices.ToString("N0") <small>Tickets</small>
                    </span>
                    <span class="kpi-subtext">Partial customer debt</span>
                </div>
            </div>

            @* KPI 6: Outstanding Debt Balance *@
            <div class="branch-kpi-card">
                <div class="kpi-icon-wrap @(perf.OutstandingBalance > 0 ? "kpi-rose" : "kpi-emerald")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                    </svg>
                </div>
                <div class="kpi-data">
                    <span class="kpi-label">Customer Receivables</span>
                    <span class="kpi-value" style="color:@(perf.OutstandingBalance > 0 ? "#e11d48" : "#059669");">
                        @perf.OutstandingBalance.ToString("N0") <small>XAF</small>
                    </span>
                    <span class="kpi-subtext">Total uncollected credit</span>
                </div>
            </div>
        </div>

        @* ── 2-COLUMN SPLIT ── *@
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:1.25rem;">
            @* Left: Revenue by Payment Type *@
            <div class="branch-panel">
                <div class="panel-header-dock">
                    <div class="panel-title-wrap">
                        <h3>Revenue by Tender Channel</h3>
                        <p>Settlement distribution across payment methods.</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="branch-table">
                        <thead>
                            <tr>
                                <th>Payment Type</th>
                                <th style="text-align:center;">Invoices</th>
                                <th style="text-align:right;">Total Volume (XAF)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pt in perf.RevenueByPaymentType)
                            {
                                <tr>
                                    <td>
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <span class="tender-icon-box">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                                                </svg>
                                            </span>
                                            <strong style="color:#0f172a;">@pt.PaymentType</strong>
                                        </div>
                                    </td>
                                    <td style="text-align:center; font-weight:600;">@pt.InvoiceCount</td>
                                    <td style="text-align:right; font-weight:700; color:#0f172a;">
                                        @pt.Total.ToString("N0")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* Right: Daily Revenue Velocity *@
            <div class="branch-panel">
                <div class="panel-header-dock">
                    <div class="panel-title-wrap">
                        <h3>Daily Revenue Velocity</h3>
                        <p>Timeline of sales revenue collected over selected period.</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="branch-table">
                        <thead>
                            <tr>
                                <th>Trading Date</th>
                                <th style="text-align:center;">Invoices</th>
                                <th style="text-align:right;">Daily Total (XAF)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var day in perf.DailyRevenue)
                            {
                                <tr>
                                    <td>
                                        <span style="font-weight:600; color:#0f172a;">@day.Date.ToString("dd MMM yyyy")</span>
                                    </td>
                                    <td style="text-align:center; font-weight:600;">@day.InvoiceCount</td>
                                    <td style="text-align:right; font-weight:700; color:#0f172a;">
                                        @day.Total.ToString("N0")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="branch-panel">
            <div class="branch-empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <h4>Select a Branch Location</h4>
                <p>Choose a branch from the filter dock above and specify a date range to view comparative performance metrics.</p>
            </div>
        </div>
    }
</div>
