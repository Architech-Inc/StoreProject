@page
@model StoreUI.Pages.LoyaltyModel
@using Store.Models.Enums
@{
    ViewData["Title"] = "Loyalty & Rewards 360 Hub";
    ViewData["ActivePage"] = "Loyalty";
    ViewData["PageDescription"] = "Customer Rewards Directory, Tier Progression, Points Circulation Liability, and Redemption Management.";
}
<div class="loyalty-container">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        var isErr = Model.StatusMessage.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
        <div class="status @(isErr ? "error" : "ok")" style="margin-bottom: 18px;">
            @Model.StatusMessage
        </div>
    }

    <!-- 1. KPI Metrics Banner -->
    <div class="loyalty-kpi-grid">
        <div class="loyalty-kpi-card">
            <div class="loyalty-kpi-icon purple">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
                <div class="loyalty-kpi-val">@Model.Metrics.TotalMembers.ToString("N0")</div>
                <div class="loyalty-kpi-lbl">Enrolled Members (@Model.Metrics.ActiveMembers Active)</div>
            </div>
        </div>

        <div class="loyalty-kpi-card">
            <div class="loyalty-kpi-icon amber">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            </div>
            <div>
                <div class="loyalty-kpi-val">@Model.Metrics.TotalPointsLiability.ToString("N0") <small style="font-size:0.8rem;color:var(--text-muted);">pts</small></div>
                <div class="loyalty-kpi-lbl">Points Liability (~@Model.Metrics.PointsLiabilityValueXaf.ToString("N0") XAF)</div>
            </div>
        </div>

        <div class="loyalty-kpi-card">
            <div class="loyalty-kpi-icon green">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            </div>
            <div>
                <div class="loyalty-kpi-val">+@Model.Metrics.PointsEarnedThisMonth.ToString("N0")</div>
                <div class="loyalty-kpi-lbl">Points Earned (MTD)</div>
            </div>
        </div>

        <div class="loyalty-kpi-card">
            <div class="loyalty-kpi-icon rose">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
            </div>
            <div>
                <div class="loyalty-kpi-val">-@Model.Metrics.PointsRedeemedThisMonth.ToString("N0")</div>
                <div class="loyalty-kpi-lbl">Points Redeemed (MTD)</div>
            </div>
        </div>

        <div class="loyalty-kpi-card">
            <div class="loyalty-kpi-icon blue">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
            </div>
            <div>
                <div class="loyalty-kpi-val">@Model.Metrics.VipTierRatio.ToString("F1")%</div>
                <div class="loyalty-kpi-lbl">VIP Ratio (Silver: @Model.Metrics.SilverCount | Gold: @Model.Metrics.GoldCount)</div>
            </div>
        </div>
    </div>

    <!-- 2. Controls & Filter Toolbar -->
    <div class="loyalty-toolbar">
        <div class="loyalty-filter-group">
            <!-- Search -->
            <form method="get" id="loyaltyFilterForm" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                <input type="hidden" name="viewMode" value="@Model.ViewMode" />
                <input type="hidden" name="tier" id="tierFilterInput" value="@Model.Tier" />

                <div class="loyalty-search-box">
                    <span class="search-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
                    <input type="text" name="search" id="memberSearchInput" value="@Model.Search" placeholder="Search by name, phone, email, ID..." />
                </div>

                <!-- Tier Filter Pills -->
                <div class="tier-pills">
                    <a href="javascript:void(0)" onclick="setTierFilter('')" class="tier-pill @(string.IsNullOrEmpty(Model.Tier) ? "active" : "")">All Tiers</a>
                    <a href="javascript:void(0)" onclick="setTierFilter('Bronze')" class="tier-pill @(Model.Tier == "Bronze" ? "active" : "")"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg> Bronze</a>
                    <a href="javascript:void(0)" onclick="setTierFilter('Silver')" class="tier-pill @(Model.Tier == "Silver" ? "active" : "")"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg> Silver</a>
                    <a href="javascript:void(0)" onclick="setTierFilter('Gold')" class="tier-pill @(Model.Tier == "Gold" ? "active" : "")"><svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" stroke="none"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg> Gold</a>
                </div>

                <!-- Sort By -->
                <select name="sortBy" onchange="this.form.submit()" style="padding:7px 12px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text-primary);font-size:0.85rem;">
                    <option value="points_desc" selected="@(Model.SortBy == "points_desc")">Highest Points</option>
                    <option value="points_asc" selected="@(Model.SortBy == "points_asc")">Lowest Points</option>
                    <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Name (A-Z)</option>
                    <option value="name_desc" selected="@(Model.SortBy == "name_desc")">Name (Z-A)</option>
                    <option value="tier_desc" selected="@(Model.SortBy == "tier_desc")">VIP Tier First</option>
                    <option value="date_desc" selected="@(Model.SortBy == "date_desc")">Newest Members</option>
                </select>
            </form>
        </div>

        <div class="loyalty-filter-group">
            <!-- View Mode Switcher -->
            <div class="view-mode-toggles">
                <a href="/Loyalty?viewMode=grid&search=@Model.Search&tier=@Model.Tier&sortBy=@Model.SortBy" class="view-mode-btn @(Model.ViewMode == "grid" ? "active" : "")" title="Grid View"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg> Grid</a>
                <a href="/Loyalty?viewMode=table&search=@Model.Search&tier=@Model.Tier&sortBy=@Model.SortBy" class="view-mode-btn @(Model.ViewMode == "table" ? "active" : "")" title="Table View"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/></svg> Table</a>
                <a href="/Loyalty?viewMode=ledger&search=@Model.Search&tier=@Model.Tier&sortBy=@Model.SortBy" class="view-mode-btn @(Model.ViewMode == "ledger" ? "active" : "")" title="Global Ledger"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg> Ledger</a>
            </div>

            <!-- CSV Export -->
            <a href="/Loyalty?handler=ExportCsv&search=@Model.Search&tier=@Model.Tier" class="loyalty-btn-secondary" title="Export to CSV">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export CSV
            </a>

            <!-- Manage Points Action -->
            <button type="button" class="loyalty-btn-primary" onclick="openManageModal()">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                Manage Points &amp; Rewards
            </button>
        </div>
    </div>

    <!-- 3. Main Views -->
    @if (Model.ViewMode == "grid")
    {
        <!-- Member Grid Cards -->
        @if (!Model.Members.Items.Any())
        {
            <div class="card" style="text-align:center;padding:48px 24px;">
                <div style="margin-bottom:16px;color:var(--brand,#019c01);"><svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg></div>
                <h3 style="margin-bottom:6px;">No Loyalty Members Found</h3>
                <p style="color:var(--text-muted);max-width:400px;margin:0 auto 16px;">No loyalty accounts match your current filter. Try adjusting your search or award points to a customer.</p>
                <button type="button" class="loyalty-btn-primary" onclick="openManageModal()">+ Award Loyalty Points</button>
            </div>
        }
        else
        {
            <div class="loyalty-grid">
                @foreach (var m in Model.Members.Items)
                {
                    var initials = !string.IsNullOrWhiteSpace(m.FullName)
                        ? string.Concat(m.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0]))
                        : "CU";

                    <div class="loyalty-card" id="member-card-@m.CustomerId">
                        <div>
                            <!-- Header -->
                            <div class="loyalty-card-top">
                                @if (!string.IsNullOrWhiteSpace(m.ThumbnailUrl))
                                {
                                    <img src="@m.ThumbnailUrl" alt="@m.FullName" class="member-avatar" loading="lazy" />
                                }
                                else
                                {
                                    <div class="member-avatar">@initials</div>
                                }
                                <div class="member-info">
                                    <div class="member-name" onclick="openDrawer('@m.CustomerId')" title="View 360 Loyalty Profile">@m.FullName</div>
                                    <div class="member-meta">
                                        <span class="tier-badge @m.Tier.ToLower()">@m.Tier</span>
                                        <span class="badge" style="font-size:0.75rem;">@m.Segment</span>
                                    </div>
                                    <div style="font-size:0.78rem;color:var(--text-muted);margin-top:4px;">
                                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block;vertical-align:middle;margin-right:3px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.63 3.38 2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.73a16 16 0 0 0 6.29 6.29l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.01z"/></svg> @(string.IsNullOrEmpty(m.PrimaryPhone) ? "No phone" : m.PrimaryPhone)
                                    </div>
                                </div>
                            </div>

                            <!-- Points Box -->
                            <div class="points-box">
                                <div>
                                    <div class="points-val">@m.Points.ToString("N0") <small>pts</small></div>
                                    <div style="font-size:0.75rem;color:var(--text-muted);margin-top:2px;">
                                        Lifetime: <strong>@m.LifetimePointsEarned.ToString("N0")</strong> pts
                                    </div>
                                </div>
                                <div class="points-xaf">
                                    ~@m.EstimatedMonetaryValue.ToString("N0") XAF
                                </div>
                            </div>

                            <!-- Tier Progress -->
                            <div class="tier-progress-container">
                                <div class="tier-progress-header">
                                    <span>
                                        @if (m.Tier == "Gold")
                                        {
                                            <span><svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" stroke="none" style="display:inline-block;vertical-align:middle;margin-right:2px;"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg> Max Tier Reached</span>
                                        }
                                        else
                                        {
                                            <span>Next: @(m.Tier == "Bronze" ? "Silver" : "Gold")</span>
                                        }
                                    </span>
                                    <span>
                                        @if (m.Tier != "Gold")
                                        {
                                            <span>@m.PointsNeededForNextTier pts needed</span>
                                        }
                                        else
                                        {
                                            <span>VIP Elite</span>
                                        }
                                    </span>
                                </div>
                                <div class="tier-progress-track">
                                    <div class="tier-progress-bar @m.Tier.ToLower()" style="width: @m.TierProgressPercentage%;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Actions -->
                        <div class="loyalty-card-actions">
                            <button type="button" class="loyalty-btn-secondary" style="flex:1;justify-content:center;padding:6px 10px;" onclick="openDrawer('@m.CustomerId')">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg> 360 Hub
                            </button>
                            <button type="button" class="loyalty-btn-primary" style="padding:6px 12px;" onclick="quickActionModal('@m.CustomerId', '@m.FullName', @m.Points)" title="Quick Action">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Action
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (Model.ViewMode == "table")
    {
        <!-- Dense Table View -->
        <div class="loyalty-table-wrap">
            <table class="loyalty-table">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Contact</th>
                        <th>Segment</th>
                        <th>Tier</th>
                        <th style="text-align:right;">Points Balance</th>
                        <th style="text-align:right;">Estimated Value</th>
                        <th style="text-align:right;">Lifetime Earned</th>
                        <th style="text-align:right;">Total Redeemed</th>
                        <th>Last Active</th>
                        <th style="text-align:center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Members.Items.Any())
                    {
                        <tr>
                            <td colspan="10" style="text-align:center;padding:32px;color:var(--text-muted);">
                                No loyalty members match your query.
                            </td>
                        </tr>
                    }
                    @foreach (var m in Model.Members.Items)
                    {
                        <tr>
                            <td>
                                <strong style="cursor:pointer;color:var(--brand, #019c01);" onclick="openDrawer('@m.CustomerId')">@m.FullName</strong>
                            </td>
                            <td>
                                <div>@(m.PrimaryPhone ?? "—")</div>
                                <small style="color:var(--text-muted);">@(m.PrimaryEmail ?? "—")</small>
                            </td>
                            <td><span class="badge">@m.Segment</span></td>
                            <td><span class="tier-badge @m.Tier.ToLower()">@m.Tier</span></td>
                            <td style="text-align:right;font-weight:700;">@m.Points.ToString("N0") pts</td>
                            <td style="text-align:right;color:#059669;font-weight:600;">@m.EstimatedMonetaryValue.ToString("N0") XAF</td>
                            <td style="text-align:right;color:var(--text-secondary);">@m.LifetimePointsEarned.ToString("N0")</td>
                            <td style="text-align:right;color:var(--text-secondary);">@m.TotalPointsRedeemed.ToString("N0")</td>
                            <td>@(m.LastTransactionDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td style="text-align:center;">
                                <button type="button" class="loyalty-btn-icon" onclick="openDrawer('@m.CustomerId')" title="View 360 Drawer"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button>
                                <button type="button" class="loyalty-btn-icon" onclick="quickActionModal('@m.CustomerId', '@m.FullName', @m.Points)" title="Manage Points"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.ViewMode == "ledger")
    {
        <!-- Store-Wide Global Audit Ledger -->
        <div class="loyalty-table-wrap">
            <div style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
                <h3 style="margin:0;font-size:1.1rem;">Store-Wide Points Transaction Stream</h3>
                <span style="font-size:0.82rem;color:var(--text-muted);">Showing recent 100 transactions</span>
            </div>
            <table class="loyalty-table">
                <thead>
                    <tr>
                        <th>Date &amp; Time</th>
                        <th>Member</th>
                        <th>Phone</th>
                        <th>Type</th>
                        <th style="text-align:right;">Points</th>
                        <th>Invoice Ref</th>
                        <th>Notes &amp; Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentGlobalTransactions.Any())
                    {
                        <tr>
                            <td colspan="7" style="text-align:center;padding:32px;color:var(--text-muted);">
                                No recent loyalty transactions recorded in the audit ledger.
                            </td>
                        </tr>
                    }
                    @foreach (var t in Model.RecentGlobalTransactions)
                    {
                        var isPos = t.Points > 0;
                        <tr>
                            <td>@t.DateCreated.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                <strong style="cursor:pointer;color:var(--brand, #019c01);" onclick="openDrawer('@t.CustomerId')">@t.CustomerName</strong>
                            </td>
                            <td>@(t.CustomerPhone ?? "—")</td>
                            <td>
                                <span class="badge @t.TransactionType.ToLower()">@t.TransactionType</span>
                            </td>
                            <td style="text-align:right;font-weight:700;color:@(isPos ? "#059669" : "#e11d48");">
                                @(isPos ? "+" + t.Points.ToString("N0") : t.Points.ToString("N0"))
                            </td>
                            <td>
                                @if (t.InvoiceId.HasValue)
                                {
                                    <a href="/Invoices?id=@t.InvoiceId" target="_blank" style="color:var(--brand, #019c01);text-decoration:underline;">
                                        INV-@t.InvoiceId.Value.ToString("D")[..8]
                                    </a>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);">—</span>
                                }
                            </td>
                            <td>@(t.Note ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Pagination -->
    @if (Model.Members.TotalPages > 1 && Model.ViewMode != "ledger")
    {
        <div style="display:flex;justify-content:center;gap:8px;margin-top:20px;">
            @if (Model.Members.HasPreviousPage)
            {
                <a href="/Loyalty?pageNumber=@(Model.Members.Page - 1)&pageSize=@Model.PageSize&search=@Model.Search&tier=@Model.Tier&sortBy=@Model.SortBy&viewMode=@Model.ViewMode" class="loyalty-btn-secondary">
                    &larr; Previous
                </a>
            }
            <span style="padding:8px 16px;font-weight:600;font-size:0.9rem;color:var(--text-secondary);display:flex;align-items:center;">
                Page @Model.Members.Page of @Model.Members.TotalPages (@Model.Members.TotalCount Total)
            </span>
            @if (Model.Members.HasNextPage)
            {
                <a href="/Loyalty?pageNumber=@(Model.Members.Page + 1)&pageSize=@Model.PageSize&search=@Model.Search&tier=@Model.Tier&sortBy=@Model.SortBy&viewMode=@Model.ViewMode" class="loyalty-btn-secondary">
                    Next &rarr;
                </a>
            }
        </div>
    }
</div>

<!-- ========================================== -->
<!-- 4. SLIDE-OVER MEMBER LOYALTY 360 DRAWER   -->
<!-- ========================================== -->
<div class="drawer-overlay" id="drawerOverlay" onclick="closeDrawer()"></div>
<div class="loyalty-drawer" id="loyaltyDrawer">
    <div class="drawer-header">
        <div class="drawer-title-group">
            <div class="member-avatar" id="drawerAvatar">CU</div>
            <div>
                <h3 id="drawerCustomerName" style="margin:0 0 4px 0;font-size:1.15rem;">Customer Name</h3>
                <div style="display:flex;gap:8px;align-items:center;">
                    <span id="drawerTierBadge" class="tier-badge bronze">Bronze</span>
                    <span id="drawerSegmentBadge" class="badge" style="font-size:0.75rem;">Regular</span>
                </div>
            </div>
        </div>
        <button type="button" class="drawer-close-btn" onclick="closeDrawer()" title="Close Drawer">&times;</button>
    </div>

    <!-- Quick Action Bar in Drawer -->
    <div style="padding:12px 24px;background:var(--surface-alt, rgba(0,0,0,0.02));border-bottom:1px solid var(--border);display:flex;gap:8px;align-items:center;">
        <button type="button" class="loyalty-btn-primary" style="flex:1;justify-content:center;padding:7px 12px;" onclick="openManageFromDrawer()">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Manage Points
        </button>
        <a id="drawerCallBtn" href="tel:" class="loyalty-btn-secondary" title="Call Member"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.63 3.38 2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.73a16 16 0 0 0 6.29 6.29l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.01z"/></svg></a>
        <a id="drawerWhatsappBtn" href="https://wa.me/" target="_blank" class="loyalty-btn-secondary" title="WhatsApp Member"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></a>
        <a id="drawerEmailBtn" href="mailto:" class="loyalty-btn-secondary" title="Email Member"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></a>
    </div>

    <!-- Drawer Navigation Tabs -->
    <div style="padding:0 24px;background:var(--surface);">
        <div class="drawer-nav-tabs">
            <button type="button" class="drawer-tab-btn active" onclick="switchDrawerTab('tabOverview')">Overview &amp; Pass</button>
            <button type="button" class="drawer-tab-btn" onclick="switchDrawerTab('tabLedger')">Transaction Ledger</button>
            <button type="button" class="drawer-tab-btn" onclick="switchDrawerTab('tabCampaigns')">Active Campaigns</button>
        </div>
    </div>

    <!-- Drawer Body -->
    <div class="drawer-body">
        <!-- Tab 1: Overview & Pass -->
        <div id="tabOverview">
            <!-- Points Balance Strip -->
            <div class="points-box" style="margin-bottom:18px;">
                <div>
                    <div style="font-size:0.78rem;text-transform:uppercase;color:var(--text-muted);font-weight:600;">Available Points Balance</div>
                    <div id="drawerPointsVal" class="points-val" style="font-size:1.8rem;margin-top:2px;">0 <small>pts</small></div>
                </div>
                <div id="drawerPointsXaf" class="points-xaf" style="font-size:1.1rem;padding:6px 12px;">
                    ~0 XAF
                </div>
            </div>

            <!-- Tier Progression Strip -->
            <div class="card" style="padding:16px;margin-bottom:20px;">
                <div class="tier-progress-header" style="margin-bottom:8px;">
                    <strong id="drawerTierProgressLbl">Tier Standing</strong>
                    <span id="drawerPointsNeededLbl">0 pts to next tier</span>
                </div>
                <div class="tier-progress-track" style="height:10px;margin-bottom:8px;">
                    <div id="drawerTierProgressBar" class="tier-progress-bar bronze" style="width:0%;"></div>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:0.75rem;color:var(--text-muted);">
                    <span style="display:flex;align-items:center;gap:4px;"><svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="#cd7f32" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg> Bronze (0)</span>
                    <span style="display:flex;align-items:center;gap:4px;"><svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="#94a3b8" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg> Silver (500)</span>
                    <span style="display:flex;align-items:center;gap:4px;"><svg viewBox="0 0 24 24" width="10" height="10" fill="#f59e0b" stroke="none"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg> Gold (2,000+)</span>
                </div>
            </div>

            <!-- Lifetime Metrics -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px;">
                <div style="background:var(--surface-alt, rgba(0,0,0,0.03));padding:12px;border-radius:10px;border:1px solid var(--border);">
                    <div style="font-size:0.75rem;color:var(--text-muted);font-weight:600;">Lifetime Points Earned</div>
                    <div id="drawerLifetimePoints" style="font-size:1.2rem;font-weight:700;color:var(--text-primary);margin-top:2px;">0</div>
                </div>
                <div style="background:var(--surface-alt, rgba(0,0,0,0.03));padding:12px;border-radius:10px;border:1px solid var(--border);">
                    <div style="font-size:0.75rem;color:var(--text-muted);font-weight:600;">Total Points Redeemed</div>
                    <div id="drawerTotalRedeemed" style="font-size:1.2rem;font-weight:700;color:#e11d48;margin-top:2px;">0</div>
                </div>
                <div style="background:var(--surface-alt, rgba(0,0,0,0.03));padding:12px;border-radius:10px;border:1px solid var(--border);">
                    <div style="font-size:0.75rem;color:var(--text-muted);font-weight:600;">Total Store Spend</div>
                    <div id="drawerLifetimeSpend" style="font-size:1.2rem;font-weight:700;color:#059669;margin-top:2px;">0 XAF</div>
                </div>
                <div style="background:var(--surface-alt, rgba(0,0,0,0.03));padding:12px;border-radius:10px;border:1px solid var(--border);">
                    <div style="font-size:0.75rem;color:var(--text-muted);font-weight:600;">Total Store Orders</div>
                    <div id="drawerTotalOrders" style="font-size:1.2rem;font-weight:700;color:var(--text-primary);margin-top:2px;">0</div>
                </div>
            </div>

            <!-- Digital Membership Pass -->
            <div id="printablePassContainer">
                <div class="digital-pass-card">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px;">
                        <div>
                            <div style="font-size:0.75rem;text-transform:uppercase;letter-spacing:1px;color:#94a3b8;font-weight:600;">ClexAn Rewards Member</div>
                            <div id="passCustomerName" style="font-size:1.2rem;font-weight:700;margin-top:2px;">Customer Name</div>
                        </div>
                        <span id="passTierBadge" class="tier-badge gold">GOLD MEMBER</span>
                    </div>

                    <!-- Pure Vector SVG Barcode -->
                    <div id="passBarcodeSvgContainer" style="background:#ffffff;padding:12px;border-radius:8px;text-align:center;margin-bottom:12px;">
                        <!-- Generated SVG Barcode Inserted Here -->
                    </div>

                    <div style="display:flex;justify-content:space-between;font-size:0.75rem;color:#cbd5e1;">
                        <span id="passMemberId">MEMBER #--</span>
                        <span>Scan at POS terminal</span>
                    </div>
                </div>
            </div>

            <button type="button" class="loyalty-btn-secondary" style="width:100%;justify-content:center;margin-top:8px;" onclick="window.print()">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                Print Digital Member Pass
            </button>
        </div>

        <!-- Tab 2: Transaction Ledger -->
        <div id="tabLedger" style="display:none;">
            <div id="drawerLedgerContainer">
                <!-- Dynamically Populated Table -->
            </div>
        </div>

        <!-- Tab 3: Active Campaigns -->
        <div id="tabCampaigns" style="display:none;">
            <div id="drawerCampaignsContainer">
                <!-- Dynamically Populated Campaign Cards -->
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 5. UNIFIED MANAGE POINTS & REWARDS MODAL   -->
<!-- ========================================== -->
<div class="modal-overlay" id="managePointsModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3 style="margin:0;font-size:1.2rem;" id="modalHeading">Manage Loyalty Points &amp; Rewards</h3>
            <button type="button" class="drawer-close-btn" onclick="closeManageModal()">&times;</button>
        </div>
        <div class="modal-body">
            <!-- Mode Switcher -->
            <div class="mode-segmented-control">
                <button type="button" class="mode-btn active" id="modeBtnEarn" onclick="setModalMode('Earn')"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg> Earn Points</button>
                <button type="button" class="mode-btn" id="modeBtnRedeem" onclick="setModalMode('Redeem')"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg> Redeem Reward</button>
                <button type="button" class="mode-btn" id="modeBtnAdjust" onclick="setModalMode('Adjust')"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M19.07 19.07l-1.41-1.41M4.93 19.07l1.41-1.41M4.93 4.93l1.41 1.41M21 12h-2M5 12H3M12 21v-2M12 5V3"/></svg> Admin Adjust</button>
            </div>

            <form method="post" asp-page-handler="ManagePoints" id="managePointsForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ManageForm.ActionType" id="modalActionType" value="Earn" />

                <!-- Customer Selection -->
                <div class="form-group" style="margin-bottom:16px;">
                    <label style="font-weight:600;font-size:0.85rem;display:block;margin-bottom:6px;">Select Member</label>
                    <div class="smart-lookup-wrap" data-url="?handler=SearchCustomers" data-placeholder="Search by name, phone, or scan card...">
                        <input type="hidden" name="ManageForm.CustomerId" id="modalCustomerId" required />
                    </div>
                    <div id="modalCustomerHint" style="font-size:0.8rem;color:var(--text-muted);margin-top:6px;display:none;">
                        Selected: <strong id="modalSelectedName"></strong> | Balance: <strong id="modalSelectedPoints" style="color:var(--brand, #019c01);">0</strong> pts (<span id="modalSelectedTier">Bronze</span>)
                    </div>
                </div>

                <!-- Points Input with Live Conversion Preview -->
                <div class="form-group" style="margin-bottom:16px;">
                    <label style="font-weight:600;font-size:0.85rem;display:block;margin-bottom:6px;">
                        <span id="modalPointsLabel">Points to Award</span>
                    </label>
                    <div style="display:flex;gap:10px;align-items:center;">
                        <input type="number" name="ManageForm.Points" id="modalPointsInput" min="1" value="100" required
                               style="flex:1;padding:10px 14px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text-primary);font-size:1.1rem;font-weight:700;"
                               oninput="updateConversionPreview()" />
                        <div id="modalConversionBadge" style="background:rgba(16, 185, 129, 0.12);color:#059669;font-weight:700;padding:10px 14px;border-radius:8px;font-size:0.9rem;white-space:nowrap;">
                            = 500 XAF Value
                        </div>
                    </div>
                    <div id="modalBalanceWarning" style="color:#e11d48;font-size:0.8rem;margin-top:4px;display:none;display:flex;align-items:center;gap:5px;">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg> Warning: Requested points exceed member's available balance!
                    </div>
                </div>

                <!-- Invoice Ref (Earn Mode) -->
                <div class="form-group" id="modalInvoiceGroup" style="margin-bottom:16px;">
                    <label style="font-weight:600;font-size:0.85rem;display:block;margin-bottom:6px;">Invoice Reference ID (Optional)</label>
                    <input type="text" name="ManageForm.InvoiceId" id="modalInvoiceId" placeholder="e.g. 83927f4e-c47b-4856..."
                           style="width:100%;padding:8px 12px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text-primary);font-size:0.88rem;" />
                </div>

                <!-- Notes / Reason -->
                <div class="form-group" style="margin-bottom:20px;">
                    <label style="font-weight:600;font-size:0.85rem;display:block;margin-bottom:6px;">Transaction Note / Reason</label>
                    <input type="text" name="ManageForm.Note" id="modalNote" placeholder="e.g. Purchase reward, Loyalty reward redemption, Promo..."
                           style="width:100%;padding:8px 12px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text-primary);font-size:0.88rem;" />
                </div>

                <div style="display:flex;gap:10px;justify-content:flex-end;">
                    <button type="button" class="loyalty-btn-secondary" onclick="closeManageModal()">Cancel</button>
                    <button type="submit" class="loyalty-btn-primary" id="modalSubmitBtn">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg> Award Points
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // State
        let currentDrawerCustomerId = null;
        let selectedMemberPoints = 0;

        // Auto-open deep-linked customer if present
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const custId = urlParams.get('customerId') || urlParams.get('id');
            if (custId) {
                openDrawer(custId);
            }
        });

        // Search debounce
        let searchTimeout;
        const searchInput = document.getElementById('memberSearchInput');
        if (searchInput) {
            searchInput.addEventListener('input', () => {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    document.getElementById('loyaltyFilterForm').submit();
                }, 400);
            });
        }

        function setTierFilter(tier) {
            document.getElementById('tierFilterInput').value = tier;
            document.getElementById('loyaltyFilterForm').submit();
        }

        // ==========================================
        // DRAWER CONTROLS & AJAX PROFILE FETCHING
        // ==========================================
        async function openDrawer(customerId) {
            currentDrawerCustomerId = customerId;
            const overlay = document.getElementById('drawerOverlay');
            const drawer = document.getElementById('loyaltyDrawer');

            overlay.classList.add('active');
            drawer.classList.add('active');

            try {
                const res = await fetch(`?handler=Profile&customerId=${customerId}`);
                if (!res.ok) throw new Error('Failed to load profile');
                const profile = await res.json();
                populateDrawer(profile);
            } catch (err) {
                console.error('Error fetching loyalty profile:', err);
            }
        }

        function closeDrawer() {
            document.getElementById('drawerOverlay').classList.remove('active');
            document.getElementById('loyaltyDrawer').classList.remove('active');
        }

        function populateDrawer(profile) {
            const m = profile.member;
            const initials = m.fullName ? m.fullName.split(' ').map(n => n[0]).slice(0, 2).join('') : 'CU';

            document.getElementById('drawerAvatar').innerText = initials;
            document.getElementById('drawerCustomerName').innerText = m.fullName;
            document.getElementById('passCustomerName').innerText = m.fullName;

            // Tier Badges
            const tierLower = m.tier.toLowerCase();
            const tb = document.getElementById('drawerTierBadge');
            tb.className = `tier-badge ${tierLower}`;
            tb.innerText = m.tier;

            const pb = document.getElementById('passTierBadge');
            pb.className = `tier-badge ${tierLower}`;
            pb.innerText = `${m.tier.toUpperCase()} MEMBER`;

            document.getElementById('drawerSegmentBadge').innerText = m.segment;

            // Contact Links
            document.getElementById('drawerCallBtn').href = m.primaryPhone ? `tel:${m.primaryPhone}` : 'javascript:window.AppDialog.alert({title:\'Warning\',message:\'No phone recorded\',type:\'warning\'})';
            document.getElementById('drawerWhatsappBtn').href = m.primaryPhone ? `https://wa.me/${m.primaryPhone.replace(/\D/g,'')}` : 'javascript:window.AppDialog.alert({title:\'Warning\',message:\'No phone recorded\',type:\'warning\'})';
            document.getElementById('drawerEmailBtn').href = m.primaryEmail ? `mailto:${m.primaryEmail}` : 'javascript:window.AppDialog.alert({title:\'Warning\',message:\'No email recorded\',type:\'warning\'})';

            // Points & Valuation
            document.getElementById('drawerPointsVal').innerHTML = `${Number(m.points).toLocaleString()} <small>pts</small>`;
            document.getElementById('drawerPointsXaf').innerText = `~${Number(m.estimatedMonetaryValue).toLocaleString()} XAF`;

            // Tier Progress
            document.getElementById('drawerTierProgressLbl').innerText = `${m.tier} Standing (${m.tierProgressPercentage}%)`;
            document.getElementById('drawerPointsNeededLbl').innerText = m.tier === 'Gold' ? 'VIP Status Unlocked' : `${m.pointsNeededForNextTier} pts to next tier`;
            const bar = document.getElementById('drawerTierProgressBar');
            bar.className = `tier-progress-bar ${tierLower}`;
            bar.style.width = `${m.tierProgressPercentage}%`;

            // Lifetime metrics
            document.getElementById('drawerLifetimePoints').innerText = Number(m.lifetimePointsEarned).toLocaleString();
            document.getElementById('drawerTotalRedeemed').innerText = Number(m.totalPointsRedeemed).toLocaleString();
            document.getElementById('drawerLifetimeSpend').innerText = `${Number(profile.lifetimeSpend).toLocaleString()} XAF`;
            document.getElementById('drawerTotalOrders').innerText = Number(profile.totalOrders).toLocaleString();

            document.getElementById('passMemberId').innerText = `MEMBER #${m.loyaltyAccountId}`;

            // Render Vector SVG Barcode
            renderSvgBarcode(`LOYAL-${m.customerId.substring(0,8).toUpperCase()}`);

            // Populate Ledger Tab
            renderLedgerTable(profile.recentTransactions);

            // Populate Campaigns Tab
            renderCampaignsList(profile.activeCampaigns);
        }

        function switchDrawerTab(tabId) {
            document.querySelectorAll('.drawer-tab-btn').forEach(b => b.classList.remove('active'));
            event.target.classList.add('active');

            document.getElementById('tabOverview').style.display = tabId === 'tabOverview' ? 'block' : 'none';
            document.getElementById('tabLedger').style.display = tabId === 'tabLedger' ? 'block' : 'none';
            document.getElementById('tabCampaigns').style.display = tabId === 'tabCampaigns' ? 'block' : 'none';
        }

        function renderLedgerTable(txns) {
            const container = document.getElementById('drawerLedgerContainer');
            if (!txns || txns.length === 0) {
                container.innerHTML = '<p style="color:var(--text-muted);text-align:center;padding:24px;">No transaction records found for this member.</p>';
                return;
            }

            let html = `
                <table class="loyalty-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th style="text-align:right;">Points</th>
                            <th>Note</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            txns.forEach(t => {
                const isPos = t.points > 0;
                html += `
                    <tr>
                        <td>${new Date(t.dateCreated).toLocaleDateString()} ${new Date(t.dateCreated).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})}</td>
                        <td><span class="badge ${t.transactionType.toLowerCase()}">${t.transactionType}</span></td>
                        <td style="text-align:right;font-weight:700;color:${isPos ? '#059669' : '#e11d48'};">
                            ${isPos ? '+' + Number(t.points).toLocaleString() : Number(t.points).toLocaleString()}
                        </td>
                        <td>${t.note || '—'}</td>
                    </tr>
                `;
            });

            html += `</tbody></table>`;
            container.innerHTML = html;
        }

        function renderCampaignsList(campaigns) {
            const container = document.getElementById('drawerCampaignsContainer');
            if (!campaigns || campaigns.length === 0) {
                container.innerHTML = '<p style="color:var(--text-muted);text-align:center;padding:24px;">No active promotional bonus campaigns currently applicable to this customer segment.</p>';
                return;
            }

            let html = '<div style="display:flex;flex-direction:column;gap:12px;">';
            campaigns.forEach(c => {
                html += `
                    <div style="background:var(--surface-alt, rgba(0,0,0,0.03));border:1px solid var(--border);border-radius:10px;padding:14px;">
                        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                            <strong style="font-size:0.95rem;color:var(--text-primary);">${c.name}</strong>
                            <span class="badge" style="background:#059669;color:#fff;">ACTIVE</span>
                        </div>
                        <p style="font-size:0.82rem;color:var(--text-muted);margin:4px 0 8px 0;">${c.description || 'Exclusive loyalty reward promotion.'}</p>
                        <div style="font-size:0.8rem;font-weight:600;color:var(--brand, #019c01);display:flex;align-items:center;gap:5px;">
                            ${c.multiplierFactor ? `<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg> ${c.multiplierFactor}x Point Multiplier` : `<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/></svg> +${c.bonusPoints} Bonus Points`}
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            container.innerHTML = html;
        }

        // ==========================================
        // PURE VECTOR SVG BARCODE GENERATOR
        // ==========================================
        function renderSvgBarcode(code) {
            const container = document.getElementById('passBarcodeSvgContainer');
            const bars = [];
            for (let i = 0; i < code.length; i++) {
                const charCode = code.charCodeAt(i);
                const bitPattern = (charCode * 17) % 31;
                for (let b = 0; b < 5; b++) {
                    bars.push((bitPattern >> b) & 1);
                }
                bars.push(0); // gap
            }

            let svg = `<svg viewBox="0 0 ${bars.length * 4} 48" width="100%" height="48" xmlns="http://www.w3.org/2000/svg">`;
            for (let i = 0; i < bars.length; i++) {
                if (bars[i] === 1) {
                    svg += `<rect x="${i * 4}" y="0" width="3" height="48" fill="#0f172a" />`;
                }
            }
            svg += `</svg><div style="font-family:monospace;font-size:0.8rem;color:#0f172a;font-weight:700;margin-top:4px;letter-spacing:2px;">${code}</div>`;
            container.innerHTML = svg;
        }

        // ==========================================
        // UNIFIED MANAGE MODAL CONTROLS
        // ==========================================
        function openManageModal() {
            document.getElementById('managePointsModal').classList.add('active');
            setModalMode('Earn');
        }

        function closeManageModal() {
            document.getElementById('managePointsModal').classList.remove('active');
        }

        function quickActionModal(customerId, customerName, points) {
            openManageModal();
            document.getElementById('modalCustomerId').value = customerId;
            document.getElementById('modalSelectedName').innerText = customerName;
            document.getElementById('modalSelectedPoints').innerText = Number(points).toLocaleString();
            selectedMemberPoints = points;
            document.getElementById('modalCustomerHint').style.display = 'block';
            updateConversionPreview();
        }

        function openManageFromDrawer() {
            if (currentDrawerCustomerId) {
                const name = document.getElementById('drawerCustomerName').innerText;
                const ptsText = document.getElementById('drawerPointsVal').innerText.replace(/\D/g, '');
                quickActionModal(currentDrawerCustomerId, name, parseInt(ptsText) || 0);
            }
        }

        function setModalMode(mode) {
            document.getElementById('modalActionType').value = mode;
            document.getElementById('modeBtnEarn').classList.toggle('active', mode === 'Earn');
            document.getElementById('modeBtnRedeem').classList.toggle('active', mode === 'Redeem');
            document.getElementById('modeBtnAdjust').classList.toggle('active', mode === 'Adjust');

            const submitBtn = document.getElementById('modalSubmitBtn');
            const pointsLbl = document.getElementById('modalPointsLabel');
            const invGroup = document.getElementById('modalInvoiceGroup');

            if (mode === 'Earn') {
                pointsLbl.innerText = 'Points to Award';
                submitBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block;vertical-align:middle;margin-right:5px;"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg> Award Points';
                invGroup.style.display = 'block';
            } else if (mode === 'Redeem') {
                pointsLbl.innerText = 'Points to Redeem';
                submitBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block;vertical-align:middle;margin-right:5px;"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg> Redeem Reward';
                invGroup.style.display = 'none';
            } else {
                pointsLbl.innerText = 'Points Adjustment (+ or -)';
                submitBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block;vertical-align:middle;margin-right:5px;"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M19.07 19.07l-1.41-1.41M4.93 19.07l1.41-1.41M4.93 4.93l1.41 1.41M21 12h-2M5 12H3M12 21v-2M12 5V3"/></svg> Apply Adjustment';
                invGroup.style.display = 'none';
            }

            updateConversionPreview();
        }

        function updateConversionPreview() {
            const pts = parseInt(document.getElementById('modalPointsInput').value) || 0;
            const xafVal = pts * 5;
            document.getElementById('modalConversionBadge').innerText = `= ${xafVal.toLocaleString()} XAF Value`;

            const mode = document.getElementById('modalActionType').value;
            const warning = document.getElementById('modalBalanceWarning');
            if (mode === 'Redeem' && pts > selectedMemberPoints && selectedMemberPoints > 0) {
                warning.style.display = 'block';
            } else {
                warning.style.display = 'none';
            }
        }
    </script>
}
