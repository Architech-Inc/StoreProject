@page
@model StoreUI.Pages.CatalogModel
@{
    ViewData["Title"] = "Item Catalog & Inventory";
    ViewData["ActivePage"] = "Catalog";
    ViewData["PageDescription"] = "Manage products and services — prices, margin analytics, stock, and barcode labels.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
}

<div class="ops-page">

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="status" style="margin-bottom: 16px;">@Model.StatusMessage</div>
    }

    <!-- ── Top KPI Metric Summary Cards ──────────────────────── -->
    <section class="catalog-kpi-grid">
        <a href="?search=&categoryId=&stockStatus=all&sortBy=@Model.SortBy&viewMode=@Model.ViewMode" 
           class="catalog-kpi-card @(Model.StockStatus == "all" && string.IsNullOrEmpty(Model.Search) ? "active" : "")">
            <div class="catalog-kpi-icon kpi-icon-blue">📦</div>
            <div class="catalog-kpi-info">
                <span class="catalog-kpi-label">Active Products</span>
                <span class="catalog-kpi-val">@Model.TotalSkus.ToString("N0")</span>
                <span class="catalog-kpi-sub">Total catalog items</span>
            </div>
        </a>

        <div class="catalog-kpi-card" style="cursor:default;">
            <div class="catalog-kpi-icon kpi-icon-green">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div class="catalog-kpi-info">
                <span class="catalog-kpi-label">Inventory Valuation</span>
                <span class="catalog-kpi-val">@Model.TotalInventoryCostValue.ToString("N0") <small style="font-size:0.75rem;">XAF</small></span>
                <span class="catalog-kpi-sub">Retail: @Model.TotalInventoryRetailValue.ToString("N0") XAF</span>
            </div>
        </div>

        <a href="?stockStatus=low_stock&sortBy=@Model.SortBy&viewMode=@Model.ViewMode" 
           class="catalog-kpi-card @(Model.StockStatus == "low_stock" ? "active" : "")">
            <div class="catalog-kpi-icon kpi-icon-amber">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <div class="catalog-kpi-info">
                <span class="catalog-kpi-label">Low Stock Items</span>
                <span class="catalog-kpi-val" style="color:#d97706;">@Model.LowStockCount.ToString("N0")</span>
                <span class="catalog-kpi-sub">At or below reorder level</span>
            </div>
        </a>

        <a href="?stockStatus=out_of_stock&sortBy=@Model.SortBy&viewMode=@Model.ViewMode" 
           class="catalog-kpi-card @(Model.StockStatus == "out_of_stock" ? "active" : "")">
            <div class="catalog-kpi-icon kpi-icon-red">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
            </div>
            <div class="catalog-kpi-info">
                <span class="catalog-kpi-label">Out of Stock</span>
                <span class="catalog-kpi-val" style="color:#dc2626;">@Model.OutOfStockCount.ToString("N0")</span>
                <span class="catalog-kpi-sub">Needs immediate replenishment</span>
            </div>
        </a>
    </section>

    <!-- ── Search & Filter Dock ─────────────────────────────── -->
    <section class="catalog-filter-dock">
        <form method="get" id="filterForm" class="filter-dock-top">
            <input type="hidden" name="stockStatus" id="inputStockStatus" value="@Model.StockStatus" />
            <input type="hidden" name="viewMode" id="inputViewMode" value="@Model.ViewMode" />

            <div class="filter-search-box">
                <svg class="filter-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="search" id="catalogSearchInput" 
                       placeholder="Search products by name, barcode, or SKU..." 
                       value="@Model.Search" autocomplete="off" />
                <button type="button" class="filter-search-clear" id="btnSearchClear" title="Clear search">✕</button>
            </div>

            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                <select name="categoryId" onchange="submitFilter()" style="padding:9px 12px;border-radius:8px;border:1px solid var(--ops-border);background:var(--ops-bg);color:var(--ops-ink);font-size:0.9rem;">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId)">@cat.Name</option>
                    }
                </select>

                <select name="sortBy" onchange="submitFilter()" style="padding:9px 12px;border-radius:8px;border:1px solid var(--ops-border);background:var(--ops-bg);color:var(--ops-ink);font-size:0.9rem;">
                    <option value="name" selected="@(Model.SortBy == "name")">Sort: Name (A-Z)</option>
                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Sort: Price (Low to High)</option>
                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Sort: Price (High to Low)</option>
                    <option value="stock_asc" selected="@(Model.SortBy == "stock_asc")">Sort: Stock (Low to High)</option>
                    <option value="stock_desc" selected="@(Model.SortBy == "stock_desc")">Sort: Stock (High to Low)</option>
                    <option value="created" selected="@(Model.SortBy == "created")">Sort: Recently Added</option>
                </select>

                <button type="button" onclick="openCreate()" style="padding:9px 16px;font-weight:600;display:flex;align-items:center;gap:6px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> New Product
                </button>
            </div>
        </form>

        <div class="filter-dock-bottom">
            <div class="filter-pill-group">
                <button type="button" class="filter-pill @(Model.StockStatus == "all" || string.IsNullOrEmpty(Model.StockStatus) ? "active" : "")" 
                        onclick="setStockFilter('all')">
                    All Items
                </button>
                <button type="button" class="filter-pill @(Model.StockStatus == "in_stock" ? "active" : "")" 
                        onclick="setStockFilter('in_stock')">
                    <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#10b981;margin-right:4px;"></span>In Stock
                </button>
                <button type="button" class="filter-pill @(Model.StockStatus == "low_stock" ? "active" : "")" 
                        onclick="setStockFilter('low_stock')">
                    <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#f59e0b;margin-right:4px;"></span>Low Stock (@Model.LowStockCount)
                </button>
                <button type="button" class="filter-pill @(Model.StockStatus == "out_of_stock" ? "active" : "")" 
                        onclick="setStockFilter('out_of_stock')">
                    <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#ef4444;margin-right:4px;"></span>Out of Stock (@Model.OutOfStockCount)
                </button>
                <button type="button" class="filter-pill @(Model.StockStatus == "inactive" ? "active" : "")" 
                        onclick="setStockFilter('inactive')">
                    <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#94a3b8;margin-right:4px;"></span>Inactive
                </button>
            </div>

            <div class="view-toggle-group">
                <button type="button" class="view-toggle-btn @(Model.ViewMode == "table" ? "active" : "")" 
                        onclick="setViewMode('table')" title="Compact Table View">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px;"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>Table
                </button>
                <button type="button" class="view-toggle-btn @(Model.ViewMode == "grid" ? "active" : "")" 
                        onclick="setViewMode('grid')" title="Visual Product Cards">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px;"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>Grid
                </button>
            </div>
        </div>
    </section>

    <!-- ── Data Display: Table or Grid ──────────────────────── -->
    @if (!Model.Items.Any())
    {
        <div class="card" style="padding:48px 24px;text-align:center;">
            <div style="font-size:3rem;margin-bottom:12px;">📦</div>
            <h3 style="margin:0 0 6px;">No Products Found</h3>
            <p style="color:var(--ops-subtle);margin:0 0 16px;">There are no catalog items matching your filter criteria.</p>
            <button type="button" onclick="resetFilters()">Reset Filters</button>
        </div>
    }
    else
    {
        @if (Model.ViewMode == "grid")
        {
            <!-- Visual Grid View -->
            <div class="catalog-product-grid">
                @foreach (var item in Model.Items)
                {
                    var itemJson = System.Text.Json.JsonSerializer.Serialize(new {
                        itemId = item.ItemId,
                        name = item.Name,
                        description = item.Description,
                        unitPrice = item.UnitPrice,
                        costPrice = item.CostPrice,
                        inStock = item.InStock,
                        reorderLevel = item.ReorderLevel,
                        barcode = item.Barcode,
                        categoryId = item.CategoryId,
                        categoryName = item.CategoryName,
                        unitId = item.UnitId,
                        unitAbbreviation = item.UnitAbbreviation,
                        isActive = item.IsActive,
                        type = item.Type.ToString(),
                        thumbnailUrl = item.ThumbnailUrl,
                        fullImageUrl = item.FullImageUrl,
                        dateCreated = item.DateCreated.ToString("yyyy-MM-dd")
                    });

                    var unitProfit = item.CostPrice.HasValue ? item.UnitPrice - item.CostPrice.Value : 0;
                    var marginPct = item.CostPrice.HasValue && item.UnitPrice > 0 
                        ? ((item.UnitPrice - item.CostPrice.Value) / item.UnitPrice) * 100 
                        : 0;

                    <div class="product-card-modern" onclick="openDrawerFromElement(this)" data-item="@itemJson">
                        <div class="card-photo-hero">
                            @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                            {
                                <img src="@item.ThumbnailUrl" alt="@item.Name" loading="lazy" 
                                     onerror="handleImageError(this)" />
                            }
                            else
                            {
                                <span style="font-size:2.5rem;opacity:0.4;">📦</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                            {
                                <span class="card-category-badge">@item.CategoryName</span>
                            }

                            <div class="card-stock-badge">
                                @if (!item.IsActive)
                                {
                                    <span class="stock-badge-pill" style="background:#64748b;color:#fff;">Inactive</span>
                                }
                                else if (item.InStock <= 0)
                                {
                                    <span class="stock-badge-pill stock-out">Out of Stock</span>
                                }
                                else if (item.ReorderLevel.HasValue && item.InStock <= item.ReorderLevel.Value)
                                {
                                    <span class="stock-badge-pill stock-low">@item.InStock left</span>
                                }
                                else
                                {
                                    <span class="stock-badge-pill stock-in">@item.InStock @(item.UnitAbbreviation ?? "")</span>
                                }
                            </div>
                        </div>

                        <div class="card-body-content">
                            <h4 class="card-product-title" title="@item.Name">@item.Name</h4>
                            
                            <div class="card-barcode-sku">
                                @if (!string.IsNullOrWhiteSpace(item.Barcode))
                                {
                                    <span>🏷️ @item.Barcode</span>
                                }
                                else
                                {
                                    <span style="opacity:0.6;">No Barcode</span>
                                }
                            </div>

                            <div class="card-pricing-row">
                                <div>
                                    <span class="card-price-primary">@item.UnitPrice.ToString("N0") <small style="font-size:0.7rem;">XAF</small></span>
                                    @if (item.CostPrice.HasValue)
                                    {
                                        <div class="card-cost-sub">Cost: @item.CostPrice.Value.ToString("N0") XAF</div>
                                    }
                                </div>

                                @if (item.CostPrice.HasValue && marginPct > 0)
                                {
                                    <span class="badge badge-green" style="font-size:0.75rem;" title="Gross Margin">@marginPct.ToString("0.#")% Margin</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Compact Data Table View -->
            <section class="card" style="padding:0;overflow:hidden;margin-bottom:20px;">
                <div style="overflow-x:auto;">
                    <table class="catalog-table" style="margin:0;">
                        <thead>
                            <tr style="background:var(--ops-bg);">
                                <th style="width:48px;">Photo</th>
                                <th>Name &amp; Barcode</th>
                                <th>Category</th>
                                <th>Unit</th>
                                <th>Selling Price</th>
                                <th>Cost Price</th>
                                <th>Margin %</th>
                                <th>Stock Status</th>
                                <th>Status</th>
                                <th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                var itemJson = System.Text.Json.JsonSerializer.Serialize(new {
                                    itemId = item.ItemId,
                                    name = item.Name,
                                    description = item.Description,
                                    unitPrice = item.UnitPrice,
                                    costPrice = item.CostPrice,
                                    inStock = item.InStock,
                                    reorderLevel = item.ReorderLevel,
                                    barcode = item.Barcode,
                                    categoryId = item.CategoryId,
                                    categoryName = item.CategoryName,
                                    unitId = item.UnitId,
                                    unitAbbreviation = item.UnitAbbreviation,
                                    isActive = item.IsActive,
                                    type = item.Type.ToString(),
                                    thumbnailUrl = item.ThumbnailUrl,
                                    fullImageUrl = item.FullImageUrl,
                                    dateCreated = item.DateCreated.ToString("yyyy-MM-dd")
                                });

                                var unitProfit = item.CostPrice.HasValue ? item.UnitPrice - item.CostPrice.Value : 0;
                                var marginPct = item.CostPrice.HasValue && item.UnitPrice > 0 
                                    ? ((item.UnitPrice - item.CostPrice.Value) / item.UnitPrice) * 100 
                                    : 0;

                                <tr onclick="openDrawerFromElement(this)" data-item="@itemJson">
                                    <td onclick="event.stopPropagation();">
                                        @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                                        {
                                            <img src="@item.ThumbnailUrl" alt="@item.Name" class="row-photo-thumb" loading="lazy"
                                                 onerror="handleImageError(this)"
                                                 onclick="viewImage(this.src)" />
                                        }
                                        else
                                        {
                                            <div class="row-photo-placeholder">📦</div>
                                        }
                                    </td>
                                    <td>
                                        <strong style="color:var(--ops-ink);font-size:0.95rem;">@item.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.Barcode))
                                        {
                                            <small style="color:var(--ops-subtle);display:block;font-family:monospace;">@item.Barcode</small>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                                        {
                                            <span class="badge badge-gray">@item.CategoryName</span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--ops-subtle);">—</span>
                                        }
                                    </td>
                                    <td>@(item.UnitAbbreviation ?? "—")</td>
                                    <td><strong style="color:var(--ops-brand);">@item.UnitPrice.ToString("N0")</strong> <small style="color:var(--ops-subtle);">XAF</small></td>
                                    <td>@(item.CostPrice.HasValue ? item.CostPrice.Value.ToString("N0") + " XAF" : "—")</td>
                                    <td>
                                        @if (item.CostPrice.HasValue && marginPct > 0)
                                        {
                                            <span class="badge badge-green" style="font-weight:600;">@marginPct.ToString("0.#")%</span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--ops-subtle);">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.InStock <= 0)
                                        {
                                            <span class="stock-badge-pill stock-out">Out (0)</span>
                                        }
                                        else if (item.ReorderLevel.HasValue && item.InStock <= item.ReorderLevel.Value)
                                        {
                                            <span class="stock-badge-pill stock-low">@item.InStock left ⚠️</span>
                                        }
                                        else
                                        {
                                            <span class="stock-badge-pill stock-in">@item.InStock</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge badge-green">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-gray">Inactive</span>
                                        }
                                    </td>
                                    <td style="text-align:right;" onclick="event.stopPropagation();">
                                        <div style="display:inline-flex;gap:6px;">
                                            <button type="button" class="btn-sm" onclick="editRowItem(this)">Edit</button>
                                            <button type="button" class="btn-sm" onclick="stockAdjustRowItem(this)" title="Adjust Stock">⚡ Stock</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <!-- ── Pagination ────────────────────────────────────── -->
        @if (Model.TotalPages > 1)
        {
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:16px;flex-wrap:wrap;gap:12px;">
                <span style="font-size:0.85rem;color:var(--ops-subtle);">
                    Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalItems total items)
                </span>
                <nav class="pagination" aria-label="Catalog pages">
                    @if (Model.PageNumber > 1)
                    {
                        <a href="?page=@(Model.PageNumber - 1)&search=@Model.Search&categoryId=@Model.CategoryId&stockStatus=@Model.StockStatus&sortBy=@Model.SortBy&viewMode=@Model.ViewMode">‹ Prev</a>
                    }
                    @for (int p = Math.Max(1, Model.PageNumber - 2); p <= Math.Min(Model.TotalPages, Model.PageNumber + 2); p++)
                    {
                        if (p == Model.PageNumber)
                        {
                            <span class="active">@p</span>
                        }
                        else
                        {
                            <a href="?page=@p&search=@Model.Search&categoryId=@Model.CategoryId&stockStatus=@Model.StockStatus&sortBy=@Model.SortBy&viewMode=@Model.ViewMode">@p</a>
                        }
                    }
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a href="?page=@(Model.PageNumber + 1)&search=@Model.Search&categoryId=@Model.CategoryId&stockStatus=@Model.StockStatus&sortBy=@Model.SortBy&viewMode=@Model.ViewMode">Next ›</a>
                    }
                </nav>
            </div>
        }
    }

</div>

<!-- ════════════════════════════════════════════════════════════ -->
<!-- ── SLIDE-OVER ITEM DETAIL DRAWER ────────────────────────── -->
<!-- ════════════════════════════════════════════════════════════ -->
<div class="item-drawer-overlay" id="drawerOverlay" onclick="closeDrawer()"></div>

<aside class="item-drawer" id="itemDetailDrawer">
    <div class="drawer-header">
        <div style="display:flex;align-items:center;gap:8px;">
            <span id="drawerStatusBadge" class="badge badge-green">Active</span>
            <span id="drawerTypeBadge" class="badge badge-gray">Product</span>
        </div>
        <button type="button" class="drawer-close-btn" onclick="closeDrawer()" title="Close (Esc)">✕</button>
    </div>

    <div class="drawer-body">
        <!-- Hero Section -->
        <div class="drawer-hero-section">
            <img id="drawerPhoto" src="" alt="Photo" class="drawer-photo-preview" onclick="openDrawerPhotoZoom()" />
            <div class="drawer-title-group">
                <h2 id="drawerItemName">Product Name</h2>
                <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-top:4px;">
                    <span id="drawerCategoryPill" class="badge badge-blue">Category</span>
                    <span id="drawerUnitPill" class="badge badge-gray">Unit</span>
                </div>
                <p id="drawerDescription" style="font-size:0.85rem;color:var(--ops-subtle);margin:6px 0 0;line-height:1.4;"></p>
            </div>
        </div>

        <!-- Financial & Profit Analytics Grid -->
        <div class="drawer-financial-grid">
            <div class="financial-metric-card">
                <span class="f-label">Selling Price</span>
                <span class="f-val" id="drawerUnitPrice">0 XAF</span>
            </div>
            <div class="financial-metric-card">
                <span class="f-label">Cost Price</span>
                <span class="f-val" id="drawerCostPrice">—</span>
            </div>
            <div class="financial-metric-card highlight">
                <span class="f-label">Estimated Profit / Unit</span>
                <span class="f-val" id="drawerUnitProfit">+0 XAF</span>
            </div>
            <div class="financial-metric-card">
                <span class="f-label">Gross Margin / Markup</span>
                <span class="f-val" id="drawerMarginMarkup">0% / 0%</span>
            </div>
        </div>

        <!-- Inventory Valuation Card -->
        <div class="financial-metric-card" style="background:rgba(59,130,246,0.05);border-color:rgba(59,130,246,0.2);">
            <span class="f-label" style="color:var(--ops-brand);">Total Inventory Valuation (Cost)</span>
            <span class="f-val" id="drawerStockValuation" style="color:var(--ops-brand);">0 XAF</span>
        </div>

        <!-- Stock Level Gauge -->
        <div class="stock-meter-card">
            <div class="stock-meter-header">
                <div>
                    <span style="font-size:0.8rem;font-weight:600;color:var(--ops-subtle);text-transform:uppercase;">Stock Level</span>
                    <h3 style="margin:2px 0 0;font-size:1.3rem;" id="drawerStockText">0 In Stock</h3>
                </div>
                <span id="drawerReorderThreshold" style="font-size:0.85rem;color:var(--ops-subtle);">Reorder at: 0</span>
            </div>
            <div class="stock-progress-track">
                <div class="stock-progress-fill" id="drawerStockProgressFill" style="width:50%;background:#10b981;"></div>
            </div>
        </div>

        <!-- Barcode Studio Widget -->
        <div class="barcode-studio-drawer-box">
            <div style="display:flex;justify-content:space-between;width:100%;align-items:center;">
                <span style="font-size:0.8rem;font-weight:600;color:var(--ops-subtle);text-transform:uppercase;">Barcode &amp; SKU Studio</span>
