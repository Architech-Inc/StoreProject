@section Scripts {
<script>
const fallbackSvg = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><rect width="100" height="100" fill="%23f1f5f9"/><text x="50%" y="50%" font-size="36" text-anchor="middle" dominant-baseline="middle">📦</text></svg>';
let currentSelectedItem = null;
let cropperInstance = null;
let activeLabelFormat = 'sticker';

function handleImageError(img) {
    img.onerror = null;
    img.src = fallbackSvg;
}

function editRowItem(btn) {
    const row = btn.closest('[data-item]');
    if (row) {
        try {
            const item = JSON.parse(row.getAttribute('data-item'));
            openEditFromData(item);
        } catch (e) {
            console.error('Failed to parse item json', e);
        }
    }
}

function stockAdjustRowItem(btn) {
    const row = btn.closest('[data-item]');
    if (row) {
        try {
            const item = JSON.parse(row.getAttribute('data-item'));
            openStockAdjustModal(item);
        } catch (e) {
            console.error('Failed to parse item json', e);
        }
    }
}

/* ── Code128 Pure SVG Barcode Renderer ────────────────────── */
function renderBarcodeSvg(code, height = 50, barWidth = 2) {
    if (!code) return '<span style="color:#94a3b8;font-size:12px;">No Barcode</span>';
    
    // Code128 pattern table (patterns for characters 0..106)
    const patterns = [
        "212222","222122","222221","121223","121322","131222","122213","122312","132212","221213",
        "221312","231212","112232","122132","122231","113222","123122","123221","223211","221132",
        "221231","213212","223112","312131","311222","321122","321221","312212","322112","322211",
        "212123","212321","232121","111323","131123","131321","112313","132113","132311","211313",
        "231113","231311","112133","112331","132131","113123","113321","133121","313121","211331",
        "231131","213113","213311","213131","311123","311321","331121","312113","312311","332111",
        "314111","221411","431111","111224","111422","121124","121421","141122","141221","112214",
        "112412","122114","122411","142112","142211","241211","221114","413111","241112","134111",
        "111242","121142","121241","114212","124112","124211","411212","421112","421211","212141",
        "214121","412121","111143","111341","131141","114113","114311","411113","411311","113141",
        "114131","311141","411131","211412","211214","211232","2331112"
    ];

    let checkSum = 104; // Start Code B
    let patternStr = patterns[104];

    for (let i = 0; i < code.length; i++) {
        let codeVal = code.charCodeAt(i) - 32;
        if (codeVal < 0 || codeVal > 95) codeVal = 0;
        checkSum += codeVal * (i + 1);
        patternStr += patterns[codeVal];
    }

    let checkVal = checkSum % 103;
    patternStr += patterns[checkVal];
    patternStr += patterns[106]; // Stop code

    let svgBars = '';
    let currentX = 0;
    let isBar = true;

    for (let j = 0; j < patternStr.length; j++) {
        let w = parseInt(patternStr[j], 10) * barWidth;
        if (isBar) {
            svgBars += `<rect x="${currentX}" y="0" width="${w}" height="${height}" fill="#000" />`;
        }
        currentX += w;
        isBar = !isBar;
    }

    return `<svg width="${currentX}" height="${height}" viewBox="0 0 ${currentX} ${height}" xmlns="http://www.w3.org/2000/svg">${svgBars}</svg>`;
}

/* ── Item Detail Slide-Over Drawer Controller ─────────────── */
function openDrawerFromElement(el) {
    try {
        const item = JSON.parse(el.getAttribute('data-item'));
        openDrawer(item);
    } catch (e) {
        console.error('Failed to parse item json', e);
    }
}

function openDrawer(item) {
    currentSelectedItem = item;
    
    // Status & Type
    const statusBadge = document.getElementById('drawerStatusBadge');
    statusBadge.className = item.isActive ? 'badge badge-green' : 'badge badge-gray';
    statusBadge.textContent = item.isActive ? 'Active' : 'Inactive';
    
    document.getElementById('drawerTypeBadge').textContent = item.type || 'Product';
    document.getElementById('drawerItemName').textContent = item.name;
    document.getElementById('drawerDescription').textContent = item.description || 'No description provided.';
    
    // Photo with error fallback
    const photo = document.getElementById('drawerPhoto');
    photo.onerror = function() {
        this.onerror = null;
        this.src = fallbackSvg;
    };
    photo.src = item.fullImageUrl || item.thumbnailUrl || fallbackSvg;
    
    // Badges
    document.getElementById('drawerCategoryPill').textContent = item.categoryName || 'Uncategorized';
    document.getElementById('drawerUnitPill').textContent = item.unitAbbreviation ? `Unit: ${item.unitAbbreviation}` : 'Standard Unit';
    
    // Financials
    const unitPrice = parseFloat(item.unitPrice) || 0;
    const costPrice = item.costPrice != null ? parseFloat(item.costPrice) : null;
    
    document.getElementById('drawerUnitPrice').textContent = `${unitPrice.toLocaleString()} XAF`;
    document.getElementById('drawerCostPrice').textContent = costPrice != null ? `${costPrice.toLocaleString()} XAF` : '—';
    
    if (costPrice != null && unitPrice > 0) {
        const profit = unitPrice - costPrice;
        const margin = ((profit / unitPrice) * 100).toFixed(1);
        const markup = costPrice > 0 ? (((profit / costPrice) * 100).toFixed(1)) : '100.0';
        
        document.getElementById('drawerUnitProfit').textContent = `${profit >= 0 ? '+' : ''}${profit.toLocaleString()} XAF`;
        document.getElementById('drawerMarginMarkup').textContent = `${margin}% / ${markup}%`;
    } else {
        document.getElementById('drawerUnitProfit').textContent = '—';
        document.getElementById('drawerMarginMarkup').textContent = '—';
    }
    
    // Valuation
    const inStock = parseInt(item.inStock, 10) || 0;
    const valuation = (costPrice != null ? costPrice : unitPrice) * inStock;
    document.getElementById('drawerStockValuation').textContent = `${valuation.toLocaleString()} XAF`;
    
    // Stock Gauge
    const reorder = item.reorderLevel != null ? parseInt(item.reorderLevel, 10) : 0;
    document.getElementById('drawerStockText').textContent = `${inStock} ${item.unitAbbreviation || 'Units'} in stock`;
    document.getElementById('drawerReorderThreshold').textContent = reorder > 0 ? `Reorder alert at: ${reorder}` : 'No reorder threshold';
    
    const fill = document.getElementById('drawerStockProgressFill');
    let pct = reorder > 0 ? Math.min(100, Math.max(5, (inStock / (reorder * 2)) * 100)) : (inStock > 0 ? 100 : 0);
    fill.style.width = `${pct}%`;
    if (inStock <= 0) {
        fill.style.background = '#ef4444';
    } else if (reorder > 0 && inStock <= reorder) {
        fill.style.background = '#f59e0b';
    } else {
        fill.style.background = '#10b981';
    }
    
    // Barcode Studio
    const barcode = item.barcode || '';
    document.getElementById('drawerBarcodeCode').textContent = barcode || 'NO BARCODE ASSIGNED';
    document.getElementById('drawerBarcodeSvg').innerHTML = renderBarcodeSvg(barcode, 45, 1.8);
    
    // Toggle Status Button
    document.getElementById('drawerToggleItemId').value = item.itemId;
    document.getElementById('drawerToggleMakeActive').value = item.isActive ? 'false' : 'true';
    const btnToggle = document.getElementById('btnDrawerToggleStatus');
    btnToggle.textContent = item.isActive ? 'Deactivate' : 'Activate';
    btnToggle.className = item.isActive ? 'btn-sm danger' : 'btn-sm';
    
    // Open Drawer
    document.getElementById('drawerOverlay').classList.add('open');
    document.getElementById('itemDetailDrawer').classList.add('open');
}

function closeDrawer() {
    document.getElementById('drawerOverlay').classList.remove('open');
    document.getElementById('itemDetailDrawer').classList.remove('open');
}

function editFromDrawer() {
    if (currentSelectedItem) {
        closeDrawer();
        openEditFromData(currentSelectedItem);
    }
}

function stockAdjustFromDrawer() {
    if (currentSelectedItem) {
        openStockAdjustModal(currentSelectedItem);
    }
}

function openInPosFromDrawer() {
    if (currentSelectedItem) {
        window.location.href = `/Pos?addItem=${currentSelectedItem.itemId}`;
    }
}

function copyDrawerBarcode() {
    if (currentSelectedItem && currentSelectedItem.barcode) {
        navigator.clipboard.writeText(currentSelectedItem.barcode).then(() => {
            const btn = document.getElementById('btnCopyBarcode');
            btn.textContent = '✓ Copied!';
            setTimeout(() => { btn.textContent = '📋 Copy'; }, 2000);
        });
    }
}

function openDrawerPhotoZoom() {
    if (currentSelectedItem) {
        viewImage(currentSelectedItem.fullImageUrl || currentSelectedItem.thumbnailUrl || fallbackSvg);
    }
}

/* ── Stock Adjustment Modal Controller ────────────────────── */
function openStockAdjustModal(item) {
    document.getElementById('adjustItemId').value = item.itemId;
    document.getElementById('adjustModalItemName').textContent = `${item.name} (${item.unitAbbreviation || 'Units'})`;
    document.getElementById('adjustCurrentStock').textContent = `${item.inStock} ${item.unitAbbreviation || ''}`;
    document.getElementById('adjustQtyInput').value = '';
    document.getElementById('stockAdjustModal').style.display = 'flex';
    document.getElementById('adjustQtyInput').focus();
}

function closeStockAdjustModal() {
    document.getElementById('stockAdjustModal').style.display = 'none';
}

/* ── Barcode Label Print Studio Modal ─────────────────────── */
function openLabelPrintFromDrawer() {
    if (!currentSelectedItem) return;
    document.getElementById('printItemName').textContent = currentSelectedItem.name;
    document.getElementById('printBarcodeText').textContent = currentSelectedItem.barcode || '0000000000';
    document.getElementById('printPriceTag').textContent = `${(currentSelectedItem.unitPrice || 0).toLocaleString()} XAF`;
    document.getElementById('printBarcodeSvg').innerHTML = renderBarcodeSvg(currentSelectedItem.barcode || '0000000000', 50, 2);
    document.getElementById('barcodePrintModal').style.display = 'flex';
}

function closeLabelPrintModal() {
    document.getElementById('barcodePrintModal').style.display = 'none';
}

function setLabelFormat(fmt) {
    activeLabelFormat = fmt;
    document.getElementById('btnLayoutSticker').className = fmt === 'sticker' ? 'filter-pill active' : 'filter-pill';
    document.getElementById('btnLayoutShelf').className = fmt === 'shelf' ? 'filter-pill active' : 'filter-pill';
    
    const preview = document.getElementById('labelPreviewContent');
    if (fmt === 'shelf') {
        preview.style.border = '2px solid #000';
        preview.style.padding = '12px 20px';
        preview.style.borderRadius = '4px';
        document.getElementById('printPriceTag').style.fontSize = '24px';
    } else {
        preview.style.border = 'none';
        preview.style.padding = '0';
        document.getElementById('printPriceTag').style.fontSize = '16px';
    }
}

/* ── Live Margin & Profit Calculator in Modal ─────────────── */
function calcMargin() {
    const unitPrice = parseFloat(document.getElementById('itemUnitPrice').value) || 0;
    const costPrice = parseFloat(document.getElementById('itemCostPrice').value) || 0;
    
    if (unitPrice > 0 && costPrice > 0) {
        const profit = unitPrice - costPrice;
        const margin = ((profit / unitPrice) * 100).toFixed(1);
        const markup = ((profit / costPrice) * 100).toFixed(1);
        
        document.getElementById('calcProfitVal').textContent = `${profit >= 0 ? '+' : ''}${profit.toLocaleString()} XAF`;
        document.getElementById('calcProfitVal').style.color = profit >= 0 ? '#059669' : '#dc2626';
        document.getElementById('calcMarginVal').textContent = `${margin}%`;
        document.getElementById('calcMarkupVal').textContent = `${markup}%`;
    } else {
        document.getElementById('calcProfitVal').textContent = '+0 XAF';
        document.getElementById('calcMarginVal').textContent = '0.0%';
        document.getElementById('calcMarkupVal').textContent = '0.0%';
    }
}

function generateRandomBarcode() {
    // Generate 12-digit EAN/SKU barcode with 614 prefix
    const randomSuffix = Math.floor(100000000 + Math.random() * 900000000);
    const barcode = `614${randomSuffix}`;
    document.getElementById('itemBarcode').value = barcode;
}

/* ── Filter & Search Sync Controller ──────────────────────── */
function setStockFilter(status) {
    document.getElementById('inputStockStatus').value = status;
    submitFilter();
}

function setViewMode(mode) {
    document.getElementById('inputViewMode').value = mode;
    submitFilter();
}

function submitFilter() {
    document.getElementById('filterForm').submit();
}

function resetFilters() {
    window.location.href = window.location.pathname;
}

/* ── Create / Edit Modal Controller ───────────────────────── */
const itemModal = document.getElementById('itemModal');
const itemForm = document.getElementById('itemForm');

function openCreate() {
    document.getElementById('modalTitle').textContent = 'New Product';
    itemForm.reset();
    document.getElementById('itemId').value = '';
    document.getElementById('itemStock').disabled = false;
    document.getElementById('stockHint').style.display = 'none';
    destroyCropper();
    calcMargin();
    itemModal.style.display = 'flex';
    document.getElementById('itemName').focus();
}

function openEditFromData(data) {
    document.getElementById('modalTitle').textContent = 'Edit Product';
    document.getElementById('itemId').value = data.itemId;
    document.getElementById('itemName').value = data.name || '';
    document.getElementById('itemDesc').value = data.description || '';
    document.getElementById('itemUnitPrice').value = data.unitPrice || 0;
    document.getElementById('itemCostPrice').value = data.costPrice != null ? data.costPrice : '';
    document.getElementById('itemStock').value = data.inStock || 0;
    document.getElementById('itemStock').disabled = true;
    document.getElementById('stockHint').style.display = 'block';
    document.getElementById('itemReorder').value = data.reorderLevel != null ? data.reorderLevel : '';
    document.getElementById('itemBarcode').value = data.barcode || '';
    document.getElementById('itemCat').value = data.categoryId || '';
    document.getElementById('itemUnit').value = data.unitId || '';
    destroyCropper();
    calcMargin();
    itemModal.style.display = 'flex';
    document.getElementById('itemName').focus();
}

function closeModal() {
    itemModal.style.display = 'none';
    destroyCropper();
}

/* ── Image Cropping & Zoom Lightbox ───────────────────────── */
const imageInput = document.getElementById('imageInput');
const cropContainer = document.getElementById('cropPreviewContainer');
const imageToCrop = document.getElementById('imageToCrop');

if (imageInput) {
    imageInput.addEventListener('change', function (e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (evt) {
                destroyCropper();
                imageToCrop.src = evt.target.result;
                cropContainer.style.display = 'block';
                if (typeof Cropper !== 'undefined') {
                    cropperInstance = new Cropper(imageToCrop, {
                        aspectRatio: 1,
                        viewMode: 1,
                        crop(event) {
                            document.getElementById('cropX').value = Math.round(event.detail.x);
                            document.getElementById('cropY').value = Math.round(event.detail.y);
                            document.getElementById('cropW').value = Math.round(event.detail.width);
                            document.getElementById('cropH').value = Math.round(event.detail.height);
                        }
                    });
                }
            };
            reader.readAsDataURL(file);
        }
    });
}

function destroyCropper() {
    if (cropperInstance) {
        cropperInstance.destroy();
        cropperInstance = null;
    }
    if (cropContainer) cropContainer.style.display = 'none';
}

function viewImage(src) {
    if (!src) return;
    document.getElementById('fullImagePreview').src = src;
    document.getElementById('imagePreviewModal').style.display = 'flex';
}

function closeImagePreview() {
    document.getElementById('imagePreviewModal').style.display = 'none';
}

/* ── Search Input Clear & Keyboard Listeners ──────────────── */
const searchInput = document.getElementById('catalogSearchInput');
const btnClear = document.getElementById('btnSearchClear');

if (searchInput) {
    if (searchInput.value) btnClear.style.display = 'block';
    
    searchInput.addEventListener('input', () => {
        btnClear.style.display = searchInput.value ? 'block' : 'none';
    });
    
    btnClear.addEventListener('click', () => {
        searchInput.value = '';
        btnClear.style.display = 'none';
        submitFilter();
    });
}

document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        closeDrawer();
        closeModal();
        closeStockAdjustModal();
        closeLabelPrintModal();
        closeImagePreview();
    }
});

/* ── Deep-Linking & Smart Scanner Auto-Triggers ───────────── */
document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const newBarcode = urlParams.get('newBarcode');
    const editId = urlParams.get('edit');
    const itemId = urlParams.get('item');

    if (newBarcode) {
        openCreate();
        document.getElementById('itemBarcode').value = newBarcode;
        document.getElementById('itemName').focus();
        window.history.replaceState({}, document.title, window.location.pathname);
    } else if (editId) {
        const row = document.querySelector(`[data-item*="${editId}"]`);
        if (row) {
            openDrawerFromElement(row);
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    } else if (itemId) {
        const row = document.querySelector(`[data-item*="${itemId}"]`);
        if (row) {
            openDrawerFromElement(row);
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    }
});
</script>
}
