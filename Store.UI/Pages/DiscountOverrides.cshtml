@page
@model StoreUI.Pages.DiscountOverridesModel
@{
    ViewData["Title"] = "Discount Override Requests";
    ViewData["ActivePage"] = "DiscountOverrides";
    ViewData["PageDescription"] = "Submit and manage discount override approval requests.";
    Layout = "~/Pages/Shared/_AppLayout.cshtml";

    var statuses = new[] { "Pending", "Approved", "Rejected", "Cancelled" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
}

<div class="ops-page">
    <div class="filter-bar" style="justify-content: space-between;">
        <form method="get" class="filter-row">
            <div class="filter-group">
                <label for="statusFilter">Status</label>
                <select id="statusFilter" name="status" onchange="this.form.submit()">
                    <option value="">All</option>
                    @foreach (var s in statuses)
                    {
                        <option value="@s" selected="@(Model.FilterStatus == s)">@s</option>
                    }
                </select>
            </div>
        </form>
        <button type="button" class="button-primary" data-open-modal="createOverrideModal">+ New Request</button>
    </div>

    <div class="card" style="padding:0; overflow:hidden;">
        @if (!Model.Overrides.Any())
        {
            <div class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <h4>No Override Requests Found</h4>
                <p>There are no records matching your criteria.</p>
            </div>
        }
        else
        {
            <div class="table-wrap" style="margin:0; border:none; border-radius:0;">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Item</th>
                            <th>Type</th>
                            <th>Value</th>
                            <th>Justification</th>
                            <th>Requested By</th>
                            <th>Status</th>
                            <th>Reviewed By</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Overrides)
                        {
                            var badgeClass = r.Status switch
                            {
                                "Approved" => "badge-green",
                                "Rejected" => "badge-red",
                                "Cancelled" => "badge-gray",
                                _ => "badge-yellow"
                            };
                            <tr>
                                <td>@r.DiscountOverrideRequestId</td>
                                <td>@(r.ItemName ?? "—")</td>
                                <td>@r.OverrideType</td>
                                <td>
                                    @if (r.OverrideType == "Percentage")
                                    {
                                        <span>@r.OverrideValue%</span>
                                    }
                                    else
                                    {
                                        <span>@r.OverrideValue.ToString("N2")</span>
                                    }
                                </td>
                                <td title="@(r.Justification ?? "")">
                                    @(string.IsNullOrWhiteSpace(r.Justification)
                                        ? "—"
                                        : (r.Justification!.Length > 40 ? r.Justification[..40] + "…" : r.Justification))
                                </td>
                                <td>@r.RequestedByUser</td>
                                <td><span class="badge @badgeClass">@r.Status</span></td>
                                <td>@(r.ReviewedByUser ?? "—")</td>
                                <td>@r.DateCreated.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    @if (r.Status == "Pending")
                                    {
                                        <div style="display:flex; gap:6px; flex-wrap:wrap;">
                                            <form method="post" asp-page-handler="Review">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="ReviewRequestId" value="@r.DiscountOverrideRequestId" />
                                                <input type="hidden" name="ReviewApproved" value="true" />
                                                <button type="submit" class="button-primary" title="Approve">Approve</button>
                                            </form>
                                            <button type="button"
                                                    class="button-command danger"
                                                    data-open-modal="rejectOverrideModal"
                                                    data-request-id="@r.DiscountOverrideRequestId"
                                                    title="Reject">Reject</button>
                                            <form method="post" asp-page-handler="Cancel"
                                                  onsubmit="return confirm('Cancel this override request?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="CancelRequestId" value="@r.DiscountOverrideRequestId" />
                                                <button type="submit" class="button-command" title="Cancel">Cancel</button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Create Request Modal -->
<div class="modal-overlay" id="createOverrideModal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="createOverrideTitle" style="width:min(520px,92vw);">
        <div class="modal-head">
            <h3 id="createOverrideTitle">New Override Request</h3>
            <button type="button" class="btn-close" data-close-modal="createOverrideModal" aria-label="Close">×</button>
        </div>
        <form method="post" asp-page-handler="Create">
            @Html.AntiForgeryToken()
            <div class="form-grid" style="grid-template-columns:1fr;">
                <div>
                    <label for="CreateInvoiceId">Invoice ID (optional)</label>
                    <input id="CreateInvoiceId" type="text" name="CreateInvoiceId"
                           placeholder="Paste invoice GUID" pattern="[0-9a-fA-F\-]{36}" />
                </div>
                <div>
                    <label for="CreateItemId">Item ID (optional)</label>
                    <input id="CreateItemId" type="text" name="CreateItemId"
                           placeholder="Paste item GUID" pattern="[0-9a-fA-F\-]{36}" />
                </div>
                <div>
                    <label for="CreateOverrideType">Override Type</label>
                    <select id="CreateOverrideType" name="CreateOverrideType">
                        @foreach (var t in Model.DiscountTypes)
                        {
                            <option value="@((int)t)">@t</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="CreateOverrideValue">Override Value <span class="req">*</span></label>
                    <input id="CreateOverrideValue" type="number" name="CreateOverrideValue" step="0.01" min="0.01" required />
                    <small class="help-text">Percentage: e.g. 10 for 10%. Fixed: deduction amount.</small>
                </div>
                <div>
                    <label for="CreateJustification">Justification</label>
                    <textarea id="CreateJustification" name="CreateJustification" rows="2" maxlength="1000"
                              placeholder="Why is this override needed?"></textarea>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="button-command" data-close-modal="createOverrideModal">Cancel</button>
                <button type="submit" class="button-primary">Submit Request</button>
            </div>
        </form>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal-overlay" id="rejectOverrideModal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="rejectOverrideTitle" style="width:min(480px,92vw);">
        <div class="modal-head">
            <h3 id="rejectOverrideTitle">Reject Override</h3>
            <button type="button" class="btn-close" data-close-modal="rejectOverrideModal" aria-label="Close">×</button>
        </div>
        <form method="post" asp-page-handler="Review">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReviewRequestId" id="rejectRequestId" />
            <input type="hidden" name="ReviewApproved" value="false" />
            <div class="form-grid" style="grid-template-columns:1fr;">
                <div>
                    <label for="ReviewNotes">Reason (optional)</label>
                    <textarea id="ReviewNotes" class="form-control" name="ReviewNotes" rows="3" maxlength="1000"></textarea>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="button-command" data-close-modal="rejectOverrideModal">Back</button>
                <button type="submit" class="button-command danger">Reject</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-open-modal="rejectOverrideModal"]').forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-request-id') || '';
            const input = document.getElementById('rejectRequestId');
            if (input) input.value = id;
        });
    });
});
</script>
}
