@page
@model StoreUI.Pages.PosModel
@using System.Text.Json
@{
    ViewData["Title"] = "POS Terminal";
    Layout = "_Layout";

    var catalogJson = JsonSerializer.Serialize(Model.CatalogItems.Select(i => new
    {
        itemId = i.ItemId,
        name = i.Name,
        barcode = i.Barcode,
        unitPrice = i.UnitPrice,
        inStock = i.InStock,
        categoryName = i.CategoryName,
        unit = i.UnitAbbreviation,
        discountPercentage = i.DiscountPercentage
    }));

    var customersJson = JsonSerializer.Serialize(Model.Customers.Select(c => new
    {
        customerId = c.CustomerId,
        fullName = c.FullName,
        primaryPhone = c.PrimaryPhone,
        loyaltyTier = c.LoyaltyTier.ToString(),
        loyaltyPoints = c.LoyaltyPoints
    }));
}

@section Styles {
    <link rel="stylesheet" href="~/css/pos.css" asp-append-version="true" />
    <style>
        .pos-tier-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.15rem 0.5rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .pos-tier-gold { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
        .pos-tier-silver { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
        .pos-tier-bronze { background: #ffedd5; color: #c2410c; border: 1px solid #fed7aa; }
        .customer-loyalty-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 0.35rem;
            font-size: 0.85rem;
        }
    </style>
}

<div class="pos-shell">
    <header class="pos-topbar">
        <div>
            <h1>POS Terminal</h1>
            <p>Fast checkout flow with offline resilience & background sync.</p>
        </div>
        <div class="pos-top-actions">
            <div class="pos-network-status" id="networkStatusBar">
                <span class="status-dot online" id="statusDot"></span>
                <span class="status-text" id="statusText">Online</span>
                <button type="button" class="btn btn-sm button-secondary" id="refreshCacheBtn" title="Cache catalog for offline scanning">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                    Cache
                </button>
                <button type="button" class="btn btn-sm button-secondary" id="viewOfflineLedgerBtn" title="View offline transactions">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    Queue (<span id="offlineCountBadge">0</span>)
                </button>
            </div>
            <a class="button-secondary" href="/Dashboard">Dashboard</a>
            <form method="post" asp-page-handler="Logout">
                <button type="submit" class="danger">Sign Out</button>
            </form>
        </div>
    </header>

    @if (Model.HasLoadError)
    {
        <div class="banner banner-error" role="alert">
            <strong>POS Load Error:</strong> @Model.LoadErrorMessage
        </div>
    }

    <div class="pos-grid">
        <section class="catalog-panel" id="catalog" aria-label="Product catalog">
            <div class="panel-head">
                <h2>Catalog</h2>
                <input id="catalogSearch" type="search" placeholder="Search products..." aria-label="Search products" />
            </div>

            <div class="scanner-row">
                <label for="barcodeInput">Barcode</label>
                <div class="scanner-input-wrap">
                    <input id="barcodeInput" type="text" placeholder="Scan or type barcode then press Enter" autocomplete="off" data-scanner-input />
                    <button type="button" class="button-primary" id="barcodeAddBtn">Add</button>
                </div>
            </div>

            <div id="catalogList" class="catalog-list"></div>
        </section>

        <section class="cart-panel" id="checkout" aria-label="Checkout cart">
            <div class="panel-head">
                <h2>Cart</h2>
                <div class="cart-head-actions">
                    <button type="button" class="button-secondary" id="suspendSaleBtn">Suspend</button>
                    <button type="button" class="btn btn-warning" id="clearCartBtn">Clear</button>
                </div>
            </div>

            <div id="cartEmpty" class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                <h4>Cart is Empty</h4>
                <p>Scan a barcode or select products from the catalog.</p>
            </div>
            <table id="cartTable" class="cart-table" hidden>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="cartBody"></tbody>
            </table>

            <div class="checkout-box">
                <div class="field-row">
                    <label for="customerSelect">Customer</label>
                    <select id="customerSelect">
                        <option value="">Walk-in Customer</option>
                    </select>
                    <div id="customerLoyaltyInfo" class="customer-loyalty-info" hidden>
                        <span id="customerLoyaltyBadge" class="pos-tier-badge"></span>
                        <span id="customerLoyaltyPoints"></span>
                        <span id="customerLoyaltyRefreshing" style="font-size:0.75rem; color:var(--pos-muted,#9ca3af);" hidden>(checking tier...)</span>
                    </div>
                </div>

                <div class="field-row">
                    <label for="couponCode">Coupon Code (optional)</label>
                    <input type="text" id="couponCode" placeholder="Enter coupon code" />
                </div>

                <div class="field-row">
                    <div class="tender-head">
                        <label>Payment</label>
                        <button type="button" class="button-secondary tender-add-btn" id="addTenderLineBtn">+ Add</button>
                    </div>
                    <div id="tenderLinesContainer"></div>
                    <div class="tender-summary">
                        <span>Tendered</span><strong id="tenderedTotal">0 XAF</strong>
                        <span>Remaining</span><strong id="tenderRemaining">0 XAF</strong>
                    </div>
                </div>

                <div class="field-row">
                    <label for="saleNotes">Notes</label>
                    <textarea id="saleNotes" rows="2" maxlength="300" placeholder="Optional note for this sale"></textarea>
                </div>

                <div class="totals">
                    <div><span>Subtotal</span><strong id="subtotalText">0</strong></div>
                    <div><span>Change</span><strong id="changeText">0</strong></div>
                    <div class="totals-split-note" id="splitNoteRow" hidden><span id="splitNoteText"></span></div>
                </div>

                <div class="suspended-sales">
                    <label for="suspendedSaleSelect">Suspended Sales</label>
                    <div class="suspended-actions">
                        <select id="suspendedSaleSelect">
                            <option value="">No suspended sale</option>
                        </select>
                        <button type="button" class="button-secondary" id="resumeSaleBtn">Resume</button>
                        <button type="button" class="danger" id="deleteSuspendedBtn">Delete</button>
                    </div>
                </div>

                <form id="checkoutForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" id="checkoutBtn" class="button-primary">Complete Checkout</button>
                </form>

                <div id="offlineQueueBanner" class="offline-queue-banner" hidden>
                    <span id="offlineQueueCount"></span>
                    <button type="button" id="syncQueueBtn" class="button-secondary">Sync Now</button>
                </div>

                <div id="checkoutMessage" class="checkout-message" role="status" aria-live="polite"></div>
            </div>
        </section>
    </div>
</div>

<div id="receiptBladeOverlay" class="blade-overlay" data-blade-id="receiptBlade"></div>
<div id="receiptBlade" class="blade" data-overlay-id="receiptBladeOverlay">
    <div class="blade-header">
        <h3 id="receiptTitle">Receipt</h3>
        <button type="button" class="btn-close" id="receiptCloseBtn" aria-label="Close receipt">&times;</button>
    </div>
    <div id="receiptContent" class="blade-body receipt-content"></div>
    <div class="blade-footer">
        <button type="button" class="button-primary" id="receiptPrintBtn">Print</button>
    </div>
</div>

<!-- Wave 23.B — per-line discount override modal. The cashier picks
     Percentage or FixedAmount, sets the value + justification, and
     submits to /api/discount-overrides with PosSessionId + CartFingerprint.
     The request appears on the cart line as a Pending badge. -->
<div class="modal-overlay" id="overrideModalOverlay" hidden>
    <div class="modal-dialog" role="dialog" aria-labelledby="overrideModalTitle">
        <div class="modal-header">
            <h3 id="overrideModalTitle">Request Discount Override</h3>
            <button type="button" class="btn-close" id="overrideCloseBtn" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
            <p id="overrideItemLabel" style="margin:0 0 1rem; font-weight:600"></p>
            <div class="field-row">
                <label for="overrideType">Type</label>
                <select id="overrideType">
                    <option value="Percentage">Percentage (%)</option>
                    <option value="FixedAmount">Fixed Amount (XAF)</option>
                </select>
            </div>
            <div class="field-row">
                <label for="overrideValue">Value</label>
                <input type="number" id="overrideValue" min="0.01" step="0.01" />
            </div>
            <div class="field-row">
                <label for="overrideJustification">Justification (visible to manager)</label>
                <textarea id="overrideJustification" rows="3" maxlength="1000" placeholder="e.g. loyal customer, damaged packaging, price-match"></textarea>
            </div>
            <p style="font-size:0.8rem;color:var(--text-secondary);margin-top:0.5rem">
                A manager must approve this request before the discount applies at checkout.
            </p>
        </div>
        <div class="modal-footer">
            <button type="button" class="button-secondary" id="overrideCancelBtn">Cancel</button>
            <button type="button" class="button-primary" id="overrideSubmitBtn">Submit for Approval</button>
        </div>
    </div>
</div>

<div id="offlineLedgerBladeOverlay" class="blade-overlay" data-blade-id="offlineLedgerBlade"></div>
<div id="offlineLedgerBlade" class="blade" data-overlay-id="offlineLedgerBladeOverlay">
    <div class="blade-header">
        <h3>Offline Transactions Ledger</h3>
        <button type="button" class="btn-close" id="ledgerCloseBtn" aria-label="Close offline ledger">&times;</button>
    </div>
    <div class="blade-body">
        <div class="ledger-actions-bar">
            <p style="margin:0;font-size:0.85rem;color:var(--pos-muted)">Transactions recorded during network outages. Automatically syncs when server becomes reachable.</p>
            <button type="button" class="button-primary" id="ledgerSyncNowBtn">Sync Queue</button>
        </div>
        <table class="table-compact">
            <thead>
                <tr>
                    <th>Receipt #</th>
                    <th>Queued At</th>
                    <th>Total</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="offlineLedgerBody">
                <tr><td colspan="4" style="text-align:center;color:var(--pos-muted)">No offline transactions recorded.</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="~/js/pos-offline.js" asp-append-version="true"></script>
<script>
(() => {
    // Register Service Worker for offline shell caching
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(e => console.warn('[SW] Registration:', e));
    }

    let catalog = @Html.Raw(catalogJson);
    let customers = @Html.Raw(customersJson);

    const cart = new Map();

    // Wave 23.B — POS per-line discount override session. Generated once on
    // page load (random 24 bytes URL-safe base64, mirrors the server-side
    // DeviceId generator) and sent on every override creation + checkout.
    // The server verifies every Approved override was approved for THIS
    // exact session id (anti-replay on a different session).
    const clientSessionId = (function () {
        const bytes = new Uint8Array(24);
        crypto.getRandomValues(bytes);
        return btoa(String.fromCharCode(...bytes))
            .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    })();

    // Wave 23.B — SHA-256 hex of the (itemId|quantity) pairs sorted. The
    // server recomputes this on checkout + compares against the value
    // stored at override-approval time. A mismatch means the cart drifted
    // after the override was approved → reject the checkout (HTTP 422).
    async function computeCartFingerprint() {
        const entries = Array.from(cart.values())
            .map(v => `${v.itemId}|${v.quantity}`)
            .sort();
        const joined = entries.join(';');
        const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(joined));
        return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
    }
    const catalogList = document.getElementById('catalogList');
    const catalogSearch = document.getElementById('catalogSearch');
    const cartBody = document.getElementById('cartBody');
    const cartTable = document.getElementById('cartTable');
    const cartEmpty = document.getElementById('cartEmpty');
    const subtotalText = document.getElementById('subtotalText');
    const changeText = document.getElementById('changeText');
    const customerSelect = document.getElementById('customerSelect');
    const checkoutForm = document.getElementById('checkoutForm');
    const checkoutBtn = document.getElementById('checkoutBtn');
    const tenderLinesContainer = document.getElementById('tenderLinesContainer');
    const addTenderLineBtn = document.getElementById('addTenderLineBtn');
    const tenderedTotal = document.getElementById('tenderedTotal');
    const tenderRemaining = document.getElementById('tenderRemaining');
    const splitNoteRow = document.getElementById('splitNoteRow');
    const splitNoteText = document.getElementById('splitNoteText');
    const saleNotes = document.getElementById('saleNotes');
    const couponCodeInput = document.getElementById('couponCode');
    const checkoutMessage = document.getElementById('checkoutMessage');

    // Offline Resilience Controls
    const statusDot = document.getElementById('statusDot');
    const statusText = document.getElementById('statusText');
    const refreshCacheBtn = document.getElementById('refreshCacheBtn');
    const viewOfflineLedgerBtn = document.getElementById('viewOfflineLedgerBtn');
    const offlineCountBadge = document.getElementById('offlineCountBadge');
    const offlineQueueBanner = document.getElementById('offlineQueueBanner');
    const offlineQueueCount = document.getElementById('offlineQueueCount');
    const syncQueueBtn = document.getElementById('syncQueueBtn');
    const offlineLedgerBlade = document.getElementById('offlineLedgerBlade');
    const ledgerCloseBtn = document.getElementById('ledgerCloseBtn');
    const offlineLedgerBody = document.getElementById('offlineLedgerBody');
    const ledgerSyncNowBtn = document.getElementById('ledgerSyncNowBtn');

    const PAYMENT_LABELS = ['Cash', 'Card', 'Bank Transfer', 'Mobile Money', 'Cheque', 'Credit'];

    function buildTenderTypeOptions(selectedValue) {
        return PAYMENT_LABELS.map((label, idx) =>
            `<option value="${idx}"${idx === selectedValue ? ' selected' : ''}>${label}</option>`
        ).join('');
    }

    function addTenderLine(typeValue = 0, amount = 0) {
        const row = document.createElement('div');
        row.className = 'tender-line';

        row.innerHTML = `
            <select class="tender-type">${buildTenderTypeOptions(typeValue)}</select>
            <input type="number" class="tender-amount" min="0" step="0.01" value="${amount}" placeholder="Amount" />
            <button type="button" class="danger tender-remove" style="padding:0.3rem 0.55rem">✕</button>
        `;

        row.querySelector('.tender-type').addEventListener('change', updateTenderTotals);
        row.querySelector('.tender-amount').addEventListener('input', updateTenderTotals);
        row.querySelector('.tender-remove').addEventListener('click', () => {
            if (tenderLinesContainer.children.length <= 1) return;
            tenderLinesContainer.removeChild(row);
            updateTenderTotals();
        });

        tenderLinesContainer.appendChild(row);
        updateTenderTotals();
    }

    function getTenderLines() {
        return Array.from(tenderLinesContainer.querySelectorAll('.tender-line')).map(row => ({
            type: parseInt(row.querySelector('.tender-type').value, 10),
            amount: parseFloat(row.querySelector('.tender-amount').value || '0')
        })).filter(l => l.amount > 0);
    }

    function getTotalTendered() {
        return Array.from(tenderLinesContainer.querySelectorAll('.tender-amount'))
            .reduce((sum, input) => sum + parseFloat(input.value || '0'), 0);
    }

    function getDominantPaymentType() {
        const lines = getTenderLines();
        if (lines.length === 0) return 0;
        return lines.reduce((a, b) => a.amount >= b.amount ? a : b).type;
    }

    function updateTenderTotals() {
        const total = getTotalTendered();
        const subtotal = getSubtotal();
        const remaining = Math.max(0, subtotal - total);
        const change = Math.max(0, total - subtotal);

        tenderedTotal.textContent = `${xaf(total)} XAF`;
        tenderRemaining.textContent = remaining > 0 ? `${xaf(remaining)} XAF` : '0 XAF';
        tenderRemaining.style.color = remaining > 0 ? 'var(--pos-danger)' : 'inherit';

        const lines = getTenderLines();
        if (lines.length > 1) {
            splitNoteRow.hidden = false;
            splitNoteText.textContent = lines.map(l =>
                `${PAYMENT_LABELS[l.type]}: ${xaf(l.amount)} XAF`
            ).join(' + ');
        } else {
            splitNoteRow.hidden = true;
        }

        changeText.textContent = `${xaf(change)} XAF`;
    }
    const clearCartBtn = document.getElementById('clearCartBtn');
    const barcodeInput = document.getElementById('barcodeInput');
    const barcodeAddBtn = document.getElementById('barcodeAddBtn');
    const suspendSaleBtn = document.getElementById('suspendSaleBtn');
    const suspendedSaleSelect = document.getElementById('suspendedSaleSelect');
    const resumeSaleBtn = document.getElementById('resumeSaleBtn');
    const deleteSuspendedBtn = document.getElementById('deleteSuspendedBtn');
    const receiptBlade = document.getElementById('receiptBlade');
    const receiptContent = document.getElementById('receiptContent');
    const receiptCloseBtn = document.getElementById('receiptCloseBtn');
    const receiptPrintBtn = document.getElementById('receiptPrintBtn');

    const suspendedSalesStorageKey = 'store-ui-pos-suspended-sales';

    function xaf(value) {
        return Number(value).toLocaleString('en-US', { maximumFractionDigits: 2 });
    }

    function normalizeBarcode(value) {
        return String(value ?? '').trim().toLowerCase();
    }

    function getSuspendedSales() {
        const raw = localStorage.getItem(suspendedSalesStorageKey);
        if (!raw) return [];
        try { return JSON.parse(raw) || []; }
        catch { return []; }
    }

    function setSuspendedSales(list) {
        localStorage.setItem(suspendedSalesStorageKey, JSON.stringify(list));
    }

    function renderSuspendedSales() {
        const sales = getSuspendedSales();
        suspendedSaleSelect.innerHTML = '<option value="">No suspended sale</option>';
        for (const s of sales) {
            const opt = document.createElement('option');
            opt.value = s.id;
            opt.textContent = `${s.label} (${s.lines?.length ?? 0} items)`;
            suspendedSaleSelect.appendChild(opt);
        }
    }

    function getEffectivePrice(item) {
        const base = item.unitPrice ?? 0;
        const discount = item.discountPercentage ?? 0;
        if (discount > 0) return base * (1 - (discount / 100));
        return base;
    }

    function getSubtotal() {
        let total = 0;
        for (const line of cart.values()) total += line.unitPrice * line.quantity;
        return total;
    }

    function renderCatalog(filter = '') {
        const needle = filter.trim().toLowerCase();
        const filtered = needle
            ? catalog.filter(i => (i.name?.toLowerCase() || '').includes(needle) || (i.barcode?.toLowerCase() || '').includes(needle))
            : catalog;

        catalogList.innerHTML = '';
        if (filtered.length === 0) {
            catalogList.innerHTML = '<p class="catalog-empty">No products found.</p>';
            return;
        }

        for (const item of filtered) {
            const card = document.createElement('div');
            card.className = 'catalog-card';
            const price = getEffectivePrice(item);
            card.innerHTML = `
                <h4>${item.name}</h4>
                <p class="meta">${item.categoryName || 'General'} &bull; ${item.inStock} in stock</p>
                <div class="price">${xaf(price)} XAF</div>
            `;
            card.addEventListener('click', () => addToCart(item));
            catalogList.appendChild(card);
        }
    }

    function addToCart(item) {
        if (!item || item.inStock <= 0) {
            setMessage('Item is out of stock.', true);
            return;
        }

        const effectivePrice = getEffectivePrice(item);
        if (cart.has(item.itemId)) {
            const existing = cart.get(item.itemId);
            if (existing.quantity + 1 > item.inStock) {
                setMessage(`Cannot add more than ${item.inStock} for ${item.name}.`, true);
                return;
            }
            existing.quantity++;
        } else {
            cart.set(item.itemId, {
                itemId: item.itemId,
                name: item.name,
                unitPrice: effectivePrice,
                maxStock: item.inStock,
                quantity: 1
            });
        }
        renderCart();
    }

    function renderCart() {
        if (cart.size === 0) {
            cartEmpty.hidden = false;
            cartTable.hidden = true;
            subtotalText.textContent = '0 XAF';
            updateTenderTotals();
            return;
        }

        cartEmpty.hidden = true;
        cartTable.hidden = false;
        cartBody.innerHTML = '';

        for (const line of cart.values()) {
            // Wave 23.B — per-line override badge: shown only when the
            // cashier has submitted an override request for this line.
            const ovr = line.overrideRequestId;
            const ovrStatus = line.overrideStatus; // 'Pending' | 'Approved' | 'Rejected'
            const badge = ovr
                ? `<span class="badge badge-${ovrStatus === 'Approved' ? 'success' : (ovrStatus === 'Rejected' ? 'danger' : 'warning')}" title="Override #${ovr}: ${ovrStatus}">${ovrStatus === 'Approved' ? '✓' : (ovrStatus === 'Rejected' ? '✗' : '⏳')} ${ovrStatus || 'Pending'}</span>`
                : '';
            const row = document.createElement('tr');
            row.innerHTML = `
                <td>
                    <strong>${line.name}</strong>
                    ${badge ? `<div style="margin-top:0.25rem">${badge}</div>` : ''}
                </td>
                <td>${xaf(line.unitPrice)}</td>
                <td>
                    <input type="number" min="1" max="${line.maxStock}" value="${line.quantity}" data-qty="${line.itemId}" style="width:60px;padding:0.25rem" />
                </td>
                <td><strong>${xaf(line.unitPrice * line.quantity)}</strong></td>
                <td style="white-space:nowrap">
                    <button type="button" class="button-secondary" data-override="${line.itemId}" style="padding:0.2rem 0.45rem;font-size:0.75rem" title="Request discount override">Override</button>
                    <button type="button" class="danger" data-del="${line.itemId}" style="padding:0.2rem 0.45rem">&times;</button>
                </td>
            `;
            cartBody.appendChild(row);
        }

        for (const input of cartBody.querySelectorAll('[data-qty]')) {
            input.addEventListener('change', (e) => {
                const itemId = e.target.dataset.qty;
                const qty = parseInt(e.target.value, 10) || 1;
                const line = cart.get(itemId);
                if (line) {
                    line.quantity = Math.min(Math.max(1, qty), line.maxStock);
                    renderCart();
                }
            });
        }

        for (const button of cartBody.querySelectorAll('[data-del]')) {
            button.addEventListener('click', (e) => {
                const target = e.target;
                cart.delete(target.dataset.del);
                renderCart();
            });
        }

        // Wave 23.B — per-line Override button click → opens the modal
        // pre-filled with the line's current price as a context anchor.
        for (const btn of cartBody.querySelectorAll('[data-override]')) {
            btn.addEventListener('click', (e) => {
                const itemId = e.target.dataset.override;
                openOverrideModal(itemId);
            });
        }

        const subtotal = getSubtotal();
        subtotalText.textContent = `${xaf(subtotal)} XAF`;
        updateTenderTotals();
    }

    function setMessage(message, isError = false) {
        checkoutMessage.textContent = message;
        checkoutMessage.className = isError ? 'checkout-message error' : 'checkout-message ok';
        if (window.showToast) window.showToast(isError ? 'error' : 'success', message);
    }

    function showReceipt(checkoutResult, saleLines, isOffline = false) {
        const createdAt = checkoutResult.createdAt
            ? new Date(checkoutResult.createdAt).toLocaleString()
            : new Date().toLocaleString();

        const lineItemsHtml = saleLines.map(line => `
            <tr>
                <td>${line.name}</td>
                <td>${line.quantity}</td>
                <td>${xaf(line.unitPrice)}</td>
                <td>${xaf(line.unitPrice * line.quantity)}</td>
            </tr>
        `).join('');

        const offlineBannerHtml = isOffline ? `
            <div class="receipt-offline-watermark">
                ⚡ OFFLINE TRANSACTION RECEIPT<br/>
                <span style="font-size:0.8rem;font-weight:400">Recorded offline on terminal. Queued for server sync.</span>
            </div>
        ` : '';

        receiptContent.innerHTML = `
            ${offlineBannerHtml}
            <div class="receipt-summary">
                <p><strong>Receipt #:</strong> ${checkoutResult.invoiceId || checkoutResult.offlineReceiptNumber}</p>
                <p><strong>Date:</strong> ${createdAt}</p>
                <p><strong>Payment:</strong> ${checkoutResult.paymentType}</p>
                <p><strong>Total:</strong> ${xaf(checkoutResult.totalAmount)} XAF</p>
                <p><strong>Tendered:</strong> ${xaf(checkoutResult.amountTendered)} XAF</p>
                <p><strong>Change:</strong> ${xaf(checkoutResult.changeGiven)} XAF</p>
            </div>
            <table class="receipt-table">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Unit</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    ${lineItemsHtml}
                </tbody>
            </table>
        `;

        window.openBlade('receiptBlade');
    }

    function closeReceipt() {
        window.closeBlade('receiptBlade');
    }

    function suspendCurrentSale() {
        if (cart.size === 0) {
            setMessage('Cart is empty, nothing to suspend.', true);
            return;
        }

        const suspendedSales = getSuspendedSales();
        const saleId = crypto.randomUUID();
        const snapshot = {
            id: saleId,
            label: `Sale ${new Date().toLocaleTimeString()}`,
            customerId: customerSelect.value || '',
            tenderLines: getTenderLines(),
            notes: saleNotes.value || '',
            lines: Array.from(cart.values())
        };

        suspendedSales.unshift(snapshot);
        setSuspendedSales(suspendedSales);
        renderSuspendedSales();

        cart.clear();
        tenderLinesContainer.innerHTML = '';
        addTenderLine(0, 0);
        saleNotes.value = '';
        couponCodeInput.value = '';
        customerSelect.value = '';
        handleCustomerSelectionChange();
        renderCart();
        setMessage('Sale suspended. You can resume it from the list.');
    }

    function restoreSuspendedSale(removeAfterRestore) {
        const suspendedId = suspendedSaleSelect.value;
        if (!suspendedId) {
            setMessage('Select a suspended sale first.', true);
            return;
        }

        const suspendedSales = getSuspendedSales();
        const snapshot = suspendedSales.find(s => s.id === suspendedId);
        if (!snapshot) {
            setMessage('Suspended sale not found.', true);
            renderSuspendedSales();
            return;
        }

        if (removeAfterRestore) {
            setSuspendedSales(suspendedSales.filter(s => s.id !== suspendedId));
        }

        cart.clear();
        for (const line of snapshot.lines ?? []) {
            const matchedItem = catalog.find(i => i.itemId === line.itemId);
            const maxStock = matchedItem ? matchedItem.inStock : line.maxStock;
            const safeQty = Math.min(line.quantity ?? 0, maxStock ?? 0);

            if (!matchedItem || safeQty <= 0) continue;

            cart.set(matchedItem.itemId, {
                itemId: matchedItem.itemId,
                name: matchedItem.name,
                unitPrice: getEffectivePrice(matchedItem),
                maxStock: matchedItem.inStock,
                quantity: safeQty
            });
        }

        customerSelect.value = snapshot.customerId || '';
        handleCustomerSelectionChange();
        tenderLinesContainer.innerHTML = '';
        const savedLines = snapshot.tenderLines ?? [];
        if (savedLines.length > 0) {
            for (const tl of savedLines) addTenderLine(tl.type, tl.amount);
        } else {
            addTenderLine(0, 0);
        }
        saleNotes.value = snapshot.notes || '';

        renderSuspendedSales();
        renderCart();
        setMessage('Suspended sale resumed into cart.');
    }

    function deleteSuspendedSale() {
        const suspendedId = suspendedSaleSelect.value;
        if (!suspendedId) {
            setMessage('Select a suspended sale to delete.', true);
            return;
        }

        const suspendedSales = getSuspendedSales();
        setSuspendedSales(suspendedSales.filter(s => s.id !== suspendedId));
        renderSuspendedSales();
        setMessage('Suspended sale deleted.');
    }

    let lastScannedBarcode = '';
    let lastScannedTime = 0;
    const DUPLICATE_SCAN_COOLDOWN_MS = 800;

    function addByBarcode(rawCode) {
        const scanValue = normalizeBarcode(rawCode !== undefined ? rawCode : barcodeInput.value);
        barcodeInput.value = '';
        if (!scanValue) {
            setMessage('Scan or type a barcode first.', true);
            return;
        }

        const now = Date.now();
        if (scanValue === lastScannedBarcode && (now - lastScannedTime) < DUPLICATE_SCAN_COOLDOWN_MS) {
            return;
        }

        lastScannedBarcode = scanValue;
        lastScannedTime = now;

        const item = catalog.find(i => normalizeBarcode(i.barcode) === scanValue);
        if (!item) {
            setMessage(`No catalog item found for barcode "${scanValue}".`, true);
            return;
        }

        addToCart(item);
        barcodeInput.focus();
        setMessage(`${item.name} added to cart.`);
    }

    async function checkoutAsync() {
        if (cart.size === 0) {
            setMessage('Add at least one item before checkout.', true);
            return;
        }

        const subtotal = getSubtotal();
        const tendered = getTotalTendered();
        if (tendered < subtotal) {
            setMessage('Total tendered must cover subtotal.', true);
            updateTenderTotals();
            return;
        }

        const payload = {
            customerId: customerSelect.value || null,
            couponCode: couponCodeInput.value || null,
            paymentType: getDominantPaymentType(),
            amountTendered: tendered,
            notes: saleNotes.value || null,
            // Wave 23.B — POS per-line override binding. Server validates
            // each PendingDiscountOverrideRequestIds entry is Approved,
            // belongs to this cashier, matches ClientSessionId, and the
            // current cart fingerprint still matches the approval-time
            // fingerprint.
            clientSessionId: clientSessionId,
            lines: Array.from(cart.values()).map(v => ({
                itemId: v.itemId,
                quantity: v.quantity,
                pendingDiscountOverrideRequestIds:
                    v.overrideStatus === 'Approved' && v.overrideRequestId
                        ? [v.overrideRequestId]
                        : [],
            })),
        };
        const saleLines = Array.from(cart.values());
        const antiforgery = checkoutForm.querySelector('input[name="__RequestVerificationToken"]')?.value;

        checkoutBtn.disabled = true;
        setMessage('Processing checkout...');

        // If explicitly offline, handle immediately via IndexedDB
        if (!navigator.onLine) {
            await handleOfflineCheckout(payload, saleLines, subtotal, tendered - subtotal);
            checkoutBtn.disabled = false;
            return;
        }

        try {
            const response = await fetch('?handler=Checkout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': antiforgery
                },
                body: JSON.stringify(payload)
            });

            const body = await response.json();
            if (!response.ok || !body.success) {
                setMessage(body.message ?? 'Checkout failed.', true);
                return;
            }

            cart.clear();
            saleNotes.value = '';
            tenderLinesContainer.innerHTML = '';
            addTenderLine(0, 0);
            renderCart();
            setMessage(`Invoice ${body.invoiceId} completed. Change: ${xaf(body.changeGiven)} XAF`);
            showReceipt(body, saleLines);
            renderCatalog(catalogSearch.value);
        } catch {
            // Server unreachable — transition to offline fallback
            await handleOfflineCheckout(payload, saleLines, subtotal, tendered - subtotal);
        } finally {
            checkoutBtn.disabled = false;
        }
    }

    async function handleOfflineCheckout(payload, saleLines, subtotal, changeGiven) {
        try {
            const offlineRecord = await StorePosOfflineDB.enqueueOfflineSale(payload, saleLines, subtotal, changeGiven);
            cart.clear();
            saleNotes.value = '';
            couponCodeInput.value = '';
            tenderLinesContainer.innerHTML = '';
            addTenderLine(0, 0);
            renderCart();
            renderCatalog(catalogSearch.value);
            updateOfflineUIState();
            setMessage(`⚡ OFFLINE SALE SAVED (${offlineRecord.offlineReceiptNumber}). Will auto-sync when online.`, false);
            showReceipt({
                offlineReceiptNumber: offlineRecord.offlineReceiptNumber,
                paymentType: PAYMENT_LABELS[payload.paymentType],
                totalAmount: subtotal,
                amountTendered: payload.amountTendered,
                changeGiven: changeGiven
            }, saleLines, true);
        } catch (err) {
            console.error('[POS] Failed to record offline sale in IndexedDB:', err);
            setMessage('Fatal: Could not save sale to offline storage.', true);
        }
    }

    function seedCustomers() {
        for (const c of customers) {
            const option = document.createElement('option');
            option.value = c.customerId;
            option.textContent = c.primaryPhone ? `${c.fullName} (${c.primaryPhone})` : c.fullName;
            customerSelect.appendChild(option);
        }
    }

    // GAP-29 — Re-fetch customer loyalty tier fresh from server on customer attach
    function renderCustomerLoyalty(tier, points) {
        const info = document.getElementById('customerLoyaltyInfo');
        const badge = document.getElementById('customerLoyaltyBadge');
        const pts = document.getElementById('customerLoyaltyPoints');
        if (!info || !badge || !pts) return;

        const tierName = tier || 'Bronze';
        badge.textContent = tierName;
        badge.className = `pos-tier-badge pos-tier-${tierName.toLowerCase()}`;
        pts.textContent = `${(points || 0).toLocaleString()} pts`;
        info.hidden = false;
    }

    async function handleCustomerSelectionChange() {
        const customerId = customerSelect.value;
        const info = document.getElementById('customerLoyaltyInfo');
        const refreshing = document.getElementById('customerLoyaltyRefreshing');

        if (!customerId) {
            if (info) info.hidden = true;
            return;
        }

        // 1. Render immediately from local cache if known
        const localCustomer = customers.find(c => String(c.customerId).toLowerCase() === String(customerId).toLowerCase());
        if (localCustomer) {
            renderCustomerLoyalty(localCustomer.loyaltyTier, localCustomer.loyaltyPoints);
        }

        // 2. GAP-29: Re-fetch fresh from server to detect demotion/promotion without stale cache
        if (navigator.onLine) {
            if (refreshing) refreshing.hidden = false;
            try {
                const resp = await fetch(`?handler=CustomerLoyalty&customerId=${encodeURIComponent(customerId)}`);
                if (resp.ok) {
                    const data = await resp.json();
                    if (data.success) {
                        const prevTier = localCustomer ? localCustomer.loyaltyTier : null;

                        if (localCustomer) {
                            localCustomer.loyaltyTier = data.loyaltyTier;
                            localCustomer.loyaltyPoints = data.loyaltyPoints;
                            localCustomer.fullName = data.fullName;
                            localCustomer.primaryPhone = data.primaryPhone;
                        }

                        // If still the active selection, refresh badge
                        if (customerSelect.value === customerId) {
                            renderCustomerLoyalty(data.loyaltyTier, data.loyaltyPoints);

                            // Notify if tier changed from cached version (e.g. demotion)
                            if (prevTier && prevTier.toLowerCase() !== data.loyaltyTier.toLowerCase()) {
                                setMessage(`Customer tier refreshed: ${prevTier} → ${data.loyaltyTier} (${data.loyaltyPoints.toLocaleString()} pts)`);
                            }
                        }

                        // Update offline IndexedDB cache with fresh details
                        StorePosOfflineDB.cacheCustomers(customers);
                    }
                }
            } catch (err) {
                console.warn('[POS] Could not refresh customer loyalty tier:', err);
            } finally {
                if (refreshing) refreshing.hidden = true;
            }
        }
    }

    // ── Offline Resilience & Sync Management ─────────────────────────────
    async function updateOfflineUIState() {
        try {
            const pending = await StorePosOfflineDB.getPendingQueue();
            const count = pending.length;

            offlineCountBadge.textContent = count;
            if (count > 0) {
                offlineQueueBanner.hidden = false;
                offlineQueueCount.textContent = `${count} offline sale${count > 1 ? 's' : ''} pending sync`;
            } else {
                offlineQueueBanner.hidden = true;
            }

            if (!navigator.onLine) {
                statusDot.className = 'status-dot offline';
                statusText.textContent = 'Offline Mode';
            } else {
                statusDot.className = 'status-dot online';
                statusText.textContent = 'Online';
            }
        } catch (e) {
            console.warn('[POS] Error updating offline UI state:', e);
        }
    }

    async function syncOfflineQueue() {
        if (!navigator.onLine) {
            setMessage('Cannot sync: Device is offline.', true);
            return;
        }

        const pending = await StorePosOfflineDB.getPendingQueue();
        if (pending.length === 0) {
            setMessage('No offline sales to sync.');
            updateOfflineUIState();
            return;
        }

        statusDot.className = 'status-dot syncing';
        statusText.textContent = `Syncing (${pending.length})...`;
        syncQueueBtn.disabled = true;
        ledgerSyncNowBtn.disabled = true;

        const antiforgery = checkoutForm.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const batchPayload = pending.map(p => ({
            clientTxId: p.clientTxId,
            offlineReceiptNumber: p.offlineReceiptNumber,
            payload: p.payload
        }));

        try {
            const resp = await fetch('?handler=OfflineBatchSync', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': antiforgery
                },
                body: JSON.stringify(batchPayload)
            });

            const data = await resp.json();
            if (resp.ok && data.success) {
                for (const res of data.results || []) {
                    if (res.success) {
                        await StorePosOfflineDB.markSaleSynced(res.clientTxId, res.serverInvoiceId);
                    } else {
                        await StorePosOfflineDB.markSaleFailed(res.clientTxId, res.errorMessage);
                    }
                }

                const msg = data.syncedCount > 0
                    ? `Synced ${data.syncedCount} offline sale${data.syncedCount > 1 ? 's' : ''} successfully.${data.failedCount > 0 ? ` (${data.failedCount} failed)` : ''}`
                    : `Sync failed for ${data.failedCount} transactions.`;
                setMessage(msg, data.failedCount > 0);
            } else {
                setMessage('Batch sync failed on server.', true);
            }
        } catch (err) {
            console.error('[POS] Sync network error:', err);
            setMessage('Sync failed — server unreachable.', true);
        } finally {
            syncQueueBtn.disabled = false;
            ledgerSyncNowBtn.disabled = false;
            updateOfflineUIState();
            renderOfflineLedger();
        }
    }

    async function refreshCatalogCache() {
        if (!navigator.onLine) {
            setMessage('Cannot refresh catalog: device is offline.', true);
            return;
        }

        setMessage('Refreshing offline product catalog...');
        refreshCacheBtn.disabled = true;

        try {
            const resp = await fetch('?handler=CatalogData');
            const data = await resp.json();
            if (resp.ok && data.success) {
                catalog = data.items || [];
                customers = data.customers || [];
                await StorePosOfflineDB.cacheCatalog(catalog);
                await StorePosOfflineDB.cacheCustomers(customers);
                renderCatalog(catalogSearch.value);
                setMessage(`Offline cache updated: ${catalog.length} items & ${customers.length} customers ready.`);
            } else {
                setMessage('Failed to refresh catalog cache.', true);
            }
        } catch (err) {
            setMessage('Failed to refresh catalog cache: ' + err.message, true);
        } finally {
            refreshCacheBtn.disabled = false;
        }
    }

    async function renderOfflineLedger() {
        try {
            const all = await StorePosOfflineDB.getAllQueue();
            if (all.length === 0) {
                offlineLedgerBody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:var(--pos-muted);padding:1rem">No offline transactions recorded.</td></tr>';
                return;
            }

            offlineLedgerBody.innerHTML = all.map(entry => {
                const statusBadge = entry.status === 'synced'
                    ? '<span class="badge badge-success">Synced</span>'
                    : (entry.status === 'failed'
                        ? '<span class="badge badge-danger" title="' + (entry.errorMessage || '') + '">Failed</span>'
                        : '<span class="badge badge-warning">Pending</span>');

                return `
                    <tr>
                        <td><strong>${entry.offlineReceiptNumber}</strong></td>
                        <td>${new Date(entry.queuedAt).toLocaleTimeString()}</td>
                        <td>${xaf(entry.totalAmount)} XAF</td>
                        <td>${statusBadge}</td>
                    </tr>
                `;
            }).join('');
        } catch (e) {
            console.warn('[POS] Error rendering ledger:', e);
        }
    }

