    // Wave 23.B — override modal handlers. Stored on a module-scope
    // variable so the open function can stamp the line on submit.
    let overrideTargetItemId = null;
    function openOverrideModal(itemId) {
        const line = cart.get(itemId);
        if (!line) return;
        overrideTargetItemId = itemId;
        document.getElementById('overrideItemLabel').textContent =
            `${line.name} — list price ${xaf(line.unitPrice)} XAF`;
        document.getElementById('overrideType').value = 'Percentage';
        document.getElementById('overrideValue').value = '';
        document.getElementById('overrideJustification').value = '';
        document.getElementById('overrideModalOverlay').hidden = false;
    }
    function closeOverrideModal() {
        document.getElementById('overrideModalOverlay').hidden = true;
        overrideTargetItemId = null;
    }
    document.getElementById('overrideCloseBtn').addEventListener('click', closeOverrideModal);
    document.getElementById('overrideCancelBtn').addEventListener('click', closeOverrideModal);
    document.getElementById('overrideSubmitBtn').addEventListener('click', async () => {
        if (!overrideTargetItemId) return;
        const line = cart.get(overrideTargetItemId);
        if (!line) return;
        const type = document.getElementById('overrideType').value;
        const value = parseFloat(document.getElementById('overrideValue').value);
        const justification = document.getElementById('overrideJustification').value.trim();
        if (!value || value <= 0) {
            setMessage('Override value must be positive.', true);
            return;
        }
        if (!justification) {
            setMessage('Justification is required.', true);
            return;
        }
        const fingerprint = await computeCartFingerprint();
        const submitBtn = document.getElementById('overrideSubmitBtn');
        submitBtn.disabled = true;
        try {
            const resp = await fetch('/api/discount-overrides', {
                method: 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    itemId: overrideTargetItemId,
                    overrideType: type,
                    overrideValue: value,
                    justification,
                    posSessionId: clientSessionId,
                    cartFingerprint: fingerprint,
                }),
            });
            if (!resp.ok) {
                const msg = (await resp.json().catch(() => null))?.message ?? `Failed (${resp.status})`;
                throw new Error(msg);
            }
            const body = await resp.json();
            const dto = body.data ?? body;
            line.overrideRequestId = dto.discountOverrideRequestId;
            line.overrideStatus = dto.status ?? 'Pending';
            closeOverrideModal();
            renderCart();
            setMessage(`Override #${dto.discountOverrideRequestId} submitted (${line.overrideStatus}). A manager must approve it before checkout.`);
        } catch (err) {
            setMessage(`Override request failed: ${err.message}`, true);
        } finally {
            submitBtn.disabled = false;
        }
    });

    // ── GAP-28 — Live Real-Time SignalR Listener for POS Discount Overrides ─────
    let posHubConnection = null;

    function handleDiscountOverrideUpdate(dto) {
        if (!dto) return;

        const reqId = dto.discountOverrideRequestId || dto.overrideId;
        let matched = false;

        for (const line of cart.values()) {
            const matchesId = line.overrideRequestId && (line.overrideRequestId === reqId || String(line.overrideRequestId) === String(reqId));
            const matchesItem = dto.itemId && String(line.itemId).toLowerCase() === String(dto.itemId).toLowerCase();

            if (matchesId || (line.overrideStatus === 'Pending' && matchesItem)) {
                matched = true;
                const prevStatus = line.overrideStatus;
                line.overrideStatus = dto.status; // 'Approved' | 'Rejected' | 'Expired'
                if (reqId) line.overrideRequestId = reqId;

                renderCart();

                if (dto.status === 'Approved') {
                    setMessage(`✓ Override #${reqId || ''} APPROVED for ${line.name}! Discount ready at checkout.`);
                    if (window.ToastBus) {
                        ToastBus.publish('pos.override', 'success', `Discount override #${reqId || ''} approved for ${line.name}`);
                    }
                } else if (dto.status === 'Rejected') {
                    const reason = dto.reason ? `: ${dto.reason}` : '';
                    setMessage(`✗ Override #${reqId || ''} REJECTED for ${line.name}${reason}`, true);
                    if (window.ToastBus) {
                        ToastBus.publish('pos.override', 'warning', `Discount override #${reqId || ''} rejected for ${line.name}${reason}`);
                    }
                } else if (dto.status === 'Expired') {
                    setMessage(`⏳ Override #${reqId || ''} expired for ${line.name}.`, true);
                }
                break;
            }
        }

        if (!matched && dto.status === 'Approved') {
            setMessage(`Notice: Discount override #${reqId || ''} was approved by ${dto.supervisorName || 'supervisor'}.`);
        }
    }

    function initPosSignalR() {
        if (typeof signalR === 'undefined') return;

        const token = (window.appConfig && window.appConfig.accessToken)
            || sessionStorage.getItem('access_token')
            || '';

        if (!token) return;

        const baseUrl = (window.appConfig && window.appConfig.apiBaseUrl) ? window.appConfig.apiBaseUrl : '';

        try {
            posHubConnection = new signalR.HubConnectionBuilder()
                .withUrl(baseUrl + '/hubs/notifications', {
                    accessTokenFactory: () => token
                })
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                .configureLogging(signalR.LogLevel.Warning)
                .build();

            posHubConnection.on('ReceiveDiscountOverrideUpdate', (dto) => {
                handleDiscountOverrideUpdate(dto);
            });

            posHubConnection.start().then(() => {
                if (clientSessionId) {
                    posHubConnection.invoke('JoinPosSession', clientSessionId).catch(() => {});
                }
            }).catch(() => {
                // SignalR optional fallback for offline / disconnected environments
            });

            posHubConnection.onreconnected(() => {
                if (clientSessionId) {
                    posHubConnection.invoke('JoinPosSession', clientSessionId).catch(() => {});
                }
            });
        } catch (e) {
            console.warn('[POS SignalR] Initialization failed:', e);
        }
    }

    window.addEventListener('discount-override-approved', (e) => {
        handleDiscountOverrideUpdate(e.detail);
    });
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            if (receiptBlade.classList.contains('open')) closeReceipt();
            if (offlineLedgerBlade.classList.contains('open')) window.closeBlade('offlineLedgerBlade');
        }
    });
    clearCartBtn.addEventListener('click', () => {
        cart.clear();
        customerSelect.value = '';
        handleCustomerSelectionChange();
        renderCart();
    });
    customerSelect.addEventListener('change', handleCustomerSelectionChange);
    checkoutForm.addEventListener('submit', (e) => {
        e.preventDefault();
        checkoutAsync();
    });

    // Startup Initialization
    seedCustomers();
    addTenderLine(0, 0);
    renderSuspendedSales();
    renderCatalog();
    renderCart();
    initPosSignalR();

    // Cache initial data into IndexedDB
    StorePosOfflineDB.cacheCatalog(catalog);
    StorePosOfflineDB.cacheCustomers(customers);
    updateOfflineUIState();

    // Deep-linking
    const urlParams = new URLSearchParams(window.location.search);
    const paramCustomerId = urlParams.get('customerId') || '@(Model.CustomerId?.ToString() ?? "")';
    const paramItemId = urlParams.get('itemId') || urlParams.get('addItem') || '@(Model.ItemId?.ToString() ?? Model.AddItem?.ToString() ?? "")';
    const paramBarcode = urlParams.get('barcode') || '@(Model.Barcode ?? "")';

    if (paramCustomerId) {
        customerSelect.value = paramCustomerId;
        const selectedOption = customerSelect.options[customerSelect.selectedIndex];
        if (selectedOption && selectedOption.value === paramCustomerId) {
            setMessage(`Customer selected: ${selectedOption.text}`);
        }
        handleCustomerSelectionChange();
    }

    if (paramBarcode) {
        barcodeInput.value = paramBarcode;
        addByBarcode();
        window.history.replaceState({}, document.title, window.location.pathname);
    } else if (paramItemId) {
        const itemToAdd = catalog.find(i => i.itemId.toLowerCase() === paramItemId.toLowerCase());
        if (itemToAdd) {
            addToCart(itemToAdd);
            setMessage(`${itemToAdd.name} added to cart.`);
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    }
})();
</script>
}
