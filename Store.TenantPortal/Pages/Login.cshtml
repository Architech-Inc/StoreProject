@page
@model Store.TenantPortal.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="portal-auth-container">
    <div class="portal-card" style="padding: 36px 32px;">
        <div style="text-align: center; margin-bottom: 28px;">
            <h2 style="font-size: 1.8rem; margin-bottom: 6px;">Sign in to your portal</h2>
            <p style="color: var(--p-text-muted); font-size: 0.9rem; margin: 0;">Access your store silos and cloud control panel</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="portal-alert danger">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="Input.ReturnUrl" />

            <div class="form-group">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" type="email" class="portal-input" placeholder="name@company.com" required />
                <span asp-validation-for="Input.Email" style="color: var(--p-danger); font-size: 12px;"></span>
            </div>

            <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <label asp-for="Input.Password" class="form-label" style="margin-bottom: 0;"></label>
                    <a href="#" style="font-size: 12px; color: var(--p-green); text-decoration: none;">Forgot password?</a>
                </div>
                <input asp-for="Input.Password" type="password" class="portal-input" placeholder="••••••••" required />
                <span asp-validation-for="Input.Password" style="color: var(--p-danger); font-size: 12px;"></span>
            </div>

            <button type="submit" class="btn-primary-glow" style="width: 100%; margin-top: 16px;">
                Sign In &rarr;
            </button>
        </form>

        <div style="text-align: center; margin-top: 24px; font-size: 13px; color: var(--p-text-muted);">
            Don't have an account yet? <a href="/Register" style="color: var(--p-green); text-decoration: none; font-weight: 600;">Get started</a>
        </div>
    </div>
</div>
