@page
@model Store.TenantPortal.Pages.DomainsModel
@{
    ViewData["Title"] = "Domain & Routing Configuration";
    var domainCfg = Model.DomainConfig;
}

<div class="portal-container">
    <!-- Header -->
    <div style="margin-bottom: 32px;">
        <h1 style="font-size: 2rem; margin-bottom: 6px;">Domain & DNS Configuration</h1>
        <p style="color: var(--p-text-muted); font-size: 0.95rem; margin: 0;">
            Manage platform subdomains and connect custom company domains with automated cryptographic DNS verification.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Model.FeedbackMessage))
    {
        <div class="portal-alert @(Model.IsError ? "danger" : "success") auto-dismiss">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@Model.FeedbackMessage</span>
        </div>
    }

    <!-- Platform Subdomain (Primary) -->
    <div class="portal-card" style="margin-bottom: 28px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div>
                <span class="status-badge healthy" style="margin-bottom: 8px;">
                    <span class="status-dot healthy"></span> Active &bull; Managed by ClexAn
                </span>
                <h3 style="font-size: 1.3rem; margin: 4px 0 0;">ClexAn Platform Subdomain</h3>
            </div>
        </div>

        <p style="color: var(--p-text-muted); font-size: 0.9rem; margin-bottom: 20px;">
            Your platform subdomain is provisioned automatically with instant SSL certificates. It is always active as a failover address.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px;">
            <div style="background: var(--p-surface-alt); padding: 14px; border-radius: 12px; border: 1px solid var(--p-border);">
                <div style="font-size: 12px; color: var(--p-text-muted); margin-bottom: 4px;">Store Web Application</div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="code-font" style="color: #4ade80; font-size: 13px;">@domainCfg?.PlatformUiUrl</span>
                    <button type="button" class="btn-glass" style="padding: 4px 10px; font-size: 11px;" onclick="copyToClipboard('@domainCfg?.PlatformUiUrl', this)">Copy</button>
                </div>
            </div>

            <div style="background: var(--p-surface-alt); padding: 14px; border-radius: 12px; border: 1px solid var(--p-border);">
                <div style="font-size: 12px; color: var(--p-text-muted); margin-bottom: 4px;">Store REST API Endpoint</div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="code-font" style="font-size: 13px;">@domainCfg?.PlatformApiUrl</span>
                    <button type="button" class="btn-glass" style="padding: 4px 10px; font-size: 11px;" onclick="copyToClipboard('@domainCfg?.PlatformApiUrl', this)">Copy</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Custom Domain (BYOD) -->
    <div class="portal-card">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div>
                @if (domainCfg?.CustomDomainStatus == "Verified")
                {
                    <span class="status-badge healthy" style="margin-bottom: 8px;">
                        <span class="status-dot healthy"></span> Verified & Active
                    </span>
                }
                else if (domainCfg?.CustomDomainStatus == "Pending")
                {
                    <span class="status-badge warning" style="margin-bottom: 8px;">
                        <span class="status-dot warning"></span> Verification Pending
                    </span>
                }
                else
                {
                    <span class="status-badge" style="background: rgba(255,255,255,0.06); color: var(--p-text-muted); margin-bottom: 8px;">
                        Not Configured
                    </span>
                }
                <h3 style="font-size: 1.3rem; margin: 4px 0 0;">Bring Your Own Domain (BYOD)</h3>
            </div>
        </div>

        @if (domainCfg?.CustomDomainStatus == "Verified")
        {
            <!-- VERIFIED STATE -->
            <div style="background: rgba(1, 156, 1, 0.04); border: 1px solid rgba(1, 156, 1, 0.2); border-radius: 14px; padding: 24px; margin-bottom: 24px;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--p-text-muted); margin-bottom: 4px;">Connected Custom Domain</div>
                        <div class="code-font" style="font-size: 1.2rem; color: #4ade80; font-weight: 700;">https://@domainCfg.CustomDomain</div>
                        <div style="font-size: 12px; color: var(--p-text-muted); margin-top: 4px;">
                            Verified on @domainCfg.CustomDomainVerifiedAt?.ToString("yyyy-MM-dd HH:mm UTC") &bull; Let's Encrypt TLS Active
                        </div>
                    </div>

                    <form method="post" asp-page-handler="RemoveCustomDomain" onsubmit="return confirm('Remove custom domain mapping?');">
                        <button type="submit" class="btn-danger-glass" style="font-size: 12px;">
                            Disconnect Domain
                        </button>
                    </form>
                </div>
            </div>
        }
        else if (domainCfg?.CustomDomainStatus == "Pending")
        {
            <!-- PENDING VERIFICATION STATE -->
            <p style="color: var(--p-text-muted); font-size: 0.9rem; margin-bottom: 20px;">
                Add the following <strong>TXT record</strong> in your domain registrar's DNS settings (e.g. Cloudflare, GoDaddy, Namecheap) to verify ownership:
            </p>

            <div style="background: var(--p-surface-alt); border: 1px solid var(--p-border); border-radius: 14px; padding: 20px; margin-bottom: 24px;">
                <div style="display: grid; grid-template-columns: 100px 1fr auto; gap: 14px; align-items: center; font-size: 13px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--p-border);">
                    <div style="color: var(--p-text-muted); font-weight: 600;">Record Type:</div>
                    <div class="code-font" style="color: #fbbf24; font-weight: 700;">TXT</div>
                    <div></div>
                </div>

                <div style="display: grid; grid-template-columns: 100px 1fr auto; gap: 14px; align-items: center; font-size: 13px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--p-border);">
                    <div style="color: var(--p-text-muted); font-weight: 600;">Host / Name:</div>
                    <div class="code-font" style="color: var(--p-text); word-break: break-all;">@domainCfg.VerificationRecordName</div>
                    <button type="button" class="btn-glass" style="padding: 4px 10px; font-size: 11px;" onclick="copyToClipboard('@domainCfg.VerificationRecordName', this)">Copy</button>
                </div>

                <div style="display: grid; grid-template-columns: 100px 1fr auto; gap: 14px; align-items: center; font-size: 13px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--p-border);">
                    <div style="color: var(--p-text-muted); font-weight: 600;">TXT Value:</div>
                    <div class="code-font" style="color: #4ade80; word-break: break-all;">@domainCfg.VerificationRecordValue</div>
                    <button type="button" class="btn-glass" style="padding: 4px 10px; font-size: 11px;" onclick="copyToClipboard('@domainCfg.VerificationRecordValue', this)">Copy</button>
                </div>

                <div style="display: grid; grid-template-columns: 100px 1fr auto; gap: 14px; align-items: center; font-size: 13px;">
                    <div style="color: var(--p-text-muted); font-weight: 600;">TTL:</div>
                    <div class="code-font" style="color: var(--p-text-muted);">300 (or Automatic)</div>
                    <div></div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(domainCfg.LastErrorMessage))
            {
                <div style="font-size: 12px; color: #fbbf24; margin-bottom: 16px; background: rgba(245, 158, 11, 0.08); padding: 10px 14px; border-radius: 8px; border: 1px solid rgba(245, 158, 11, 0.2);">
                    Diagnostic: @domainCfg.LastErrorMessage
                </div>
            }

            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                <form method="post" asp-page-handler="VerifyDomain">
                    <button type="submit" class="btn-primary-glow" style="font-size: 13px;">
                        ⟳ Check DNS Now
                    </button>
                </form>

                <form method="post" asp-page-handler="RemoveCustomDomain">
                    <button type="submit" class="btn-glass" style="font-size: 13px;">
                        Cancel / Change Domain
                    </button>
                </form>
            </div>
        }
        else
        {
            <!-- UNCONFIGURED STATE -->
            <p style="color: var(--p-text-muted); font-size: 0.9rem; margin-bottom: 20px;">
                Connect your organization's domain name (e.g. <span class="code-font">store.yourcompany.com</span>). You will be given a DNS TXT record to verify ownership.
            </p>

            <form method="post" asp-page-handler="SetCustomDomain" style="max-width: 500px;">
                <div class="form-group">
                    <label class="form-label">Domain Name</label>
                    <input name="domain" class="portal-input" placeholder="e.g. store.acmefoods.com" required />
                </div>
                <button type="submit" class="btn-primary-glow" style="font-size: 14px; padding: 10px 24px;">
                    Connect Custom Domain &rarr;
                </button>
            </form>
        }
    </div>
</div>
