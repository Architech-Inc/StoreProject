@page
@model Store.TenantPortal.Pages.DashboardModel
@{
    ViewData["Title"] = "Store Silo Dashboard";
    var tenant = Model.Tenant;
}

<div class="portal-container">
    <!-- Top Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 4px;">
                <h1 style="font-size: 2rem; margin: 0;">@tenant.Name</h1>
                <span class="status-badge @(tenant.IsHealthy ? "healthy" : "warning")">
                    <span class="status-dot @(tenant.IsHealthy ? "healthy" : "warning")"></span>
                    @(tenant.IsHealthy ? "Silo Active & Healthy" : "Checking Health")
                </span>
            </div>
            <p style="color: var(--p-text-muted); font-size: 0.9rem; margin: 0;">
                Slug: <span class="code-font" style="color: #4ade80;">@tenant.Slug</span> &bull; Plan: <strong style="color: #fff;">@tenant.PlanTier</strong> &bull; Currency: <strong>@tenant.Currency</strong>
            </p>
        </div>

        <div style="display: flex; gap: 12px;">
            <form method="post" asp-page-handler="CheckHealth">
                <button type="submit" class="btn-glass" style="padding: 10px 18px; font-size: 13px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
                    Refresh Health
                </button>
            </form>
            @if (!string.IsNullOrEmpty(tenant.UiUrl))
            {
                <a href="@tenant.UiUrl" target="_blank" class="btn-primary-glow" style="padding: 10px 22px; font-size: 14px;">
                    Launch Store UI &nearr;
                </a>
            }
        </div>
    </div>

    <!-- Container Health KPI Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 32px;">
        <!-- MySQL Container -->
        <div class="portal-card" style="padding: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <div style="width: 44px; height: 44px; border-radius: 12px; background: var(--chip-green); display: flex; align-items: center; justify-content: center; color: #4ade80;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
                </div>
                <span class="status-dot @(tenant.IsHealthy ? "healthy" : "warning")"></span>
            </div>
            <div style="font-size: 13px; color: var(--p-text-muted); margin-bottom: 4px;">Relational Database</div>
            <div style="font-size: 1.2rem; font-weight: 700; margin-bottom: 6px;">MySQL 8.0</div>
            <div class="code-font" style="font-size: 12px; color: var(--p-text-muted);">@(tenant.Slug)-mysql</div>
        </div>

        <!-- MongoDB Container -->
        <div class="portal-card" style="padding: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <div style="width: 44px; height: 44px; border-radius: 12px; background: var(--chip-teal); display: flex; align-items: center; justify-content: center; color: #2dd4bf;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"></path></svg>
                </div>
                <span class="status-dot @(tenant.IsHealthy ? "healthy" : "warning")"></span>
            </div>
            <div style="font-size: 13px; color: var(--p-text-muted); margin-bottom: 4px;">Document Store</div>
            <div style="font-size: 1.2rem; font-weight: 700; margin-bottom: 6px;">MongoDB 7.0</div>
            <div class="code-font" style="font-size: 12px; color: var(--p-text-muted);">@(tenant.Slug)-mongodb</div>
        </div>

        <!-- Store API Container -->
        <div class="portal-card" style="padding: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <div style="width: 44px; height: 44px; border-radius: 12px; background: var(--chip-green); display: flex; align-items: center; justify-content: center; color: #4ade80;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                </div>
                <span class="status-dot @(tenant.IsHealthy ? "healthy" : "warning")"></span>
            </div>
            <div style="font-size: 13px; color: var(--p-text-muted); margin-bottom: 4px;">Backend Service</div>
            <div style="font-size: 1.2rem; font-weight: 700; margin-bottom: 6px;">Store.API (.NET 8)</div>
            <div class="code-font" style="font-size: 12px; color: var(--p-text-muted);">@(tenant.Slug)-api</div>
        </div>

        <!-- Store UI Container -->
        <div class="portal-card" style="padding: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <div style="width: 44px; height: 44px; border-radius: 12px; background: var(--chip-purple); display: flex; align-items: center; justify-content: center; color: #c084fc;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                </div>
                <span class="status-dot @(tenant.IsHealthy ? "healthy" : "warning")"></span>
            </div>
            <div style="font-size: 13px; color: var(--p-text-muted); margin-bottom: 4px;">Frontend Portal</div>
            <div style="font-size: 1.2rem; font-weight: 700; margin-bottom: 6px;">Store.UI (Razor)</div>
            <div class="code-font" style="font-size: 12px; color: var(--p-text-muted);">@(tenant.Slug)-ui</div>
        </div>
    </div>

    <!-- Details Grid: Routing & Provisioning Log -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px;">
        <!-- Routing Summary Card -->
        <div class="portal-card">
            <h3 style="font-size: 1.2rem; margin-bottom: 16px;">Network & Routing Endpoints</h3>
            
            <div style="margin-bottom: 16px;">
                <div style="font-size: 12px; color: var(--p-text-muted); margin-bottom: 4px;">Platform Store URL</div>
                <div style="display: flex; justify-content: space-between; align-items: center; background: var(--p-surface-alt); padding: 10px 14px; border-radius: 10px; border: 1px solid var(--p-border);">
                    <span class="code-font" style="color: #4ade80; font-size: 13px;">@tenant.UiUrl</span>
                    <button type="button" class="btn-glass" style="padding: 4px 10px; font-size: 11px;" onclick="copyToClipboard('@tenant.UiUrl', this)">Copy</button>
                </div>
            </div>

            <div style="margin-bottom: 16px;">
                <div style="font-size: 12px; color: var(--p-text-muted); margin-bottom: 4px;">Platform REST API URL</div>
                <div style="display: flex; justify-content: space-between; align-items: center; background: var(--p-surface-alt); padding: 10px 14px; border-radius: 10px; border: 1px solid var(--p-border);">
                    <span class="code-font" style="font-size: 13px;">@tenant.ApiUrl</span>
                    <button type="button" class="btn-glass" style="padding: 4px 10px; font-size: 11px;" onclick="copyToClipboard('@tenant.ApiUrl', this)">Copy</button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(tenant.CustomDomain))
            {
                <div style="margin-bottom: 16px;">
                    <div style="font-size: 12px; color: var(--p-text-muted); margin-bottom: 4px;">Custom Domain</div>
                    <div style="background: var(--p-surface-alt); padding: 10px 14px; border-radius: 10px; border: 1px solid var(--p-border);">
                        <span class="code-font" style="color: #fbbf24; font-size: 13px;">@tenant.CustomDomain</span>
                    </div>
                </div>
            }
        </div>

        <!-- Provisioning Timeline Card -->
        <div class="portal-card">
            <h3 style="font-size: 1.2rem; margin-bottom: 16px;">Provisioning History</h3>
            
            <div style="display: flex; flex-direction: column; gap: 12px; max-height: 280px; overflow-y: auto; padding-right: 8px;">
                @if (tenant.ProvisioningLogs?.Any() == true)
                {
                    @foreach (var log in tenant.ProvisioningLogs.OrderBy(l => l.Timestamp))
                    {
                        <div style="display: flex; gap: 12px; font-size: 13px; border-bottom: 1px solid rgba(255,255,255,0.04); padding-bottom: 8px;">
                            <span style="color: var(--p-text-subtle); font-family: monospace; font-size: 11px; white-space: nowrap;">
                                @log.Timestamp.ToString("HH:mm:ss")
                            </span>
                            <div>
                                <span style="font-weight: 600; color: #4ade80;">[@log.Phase]</span>
                                <span style="color: var(--p-text-muted);">@log.Message</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p style="color: var(--p-text-muted); font-size: 13px;">Stack created on @tenant.DateCreated.ToString("yyyy-MM-dd HH:mm UTC").</p>
                }
            </div>
        </div>
    </div>

    <!-- Security & Audit Activity Trail -->
    <div class="portal-card" style="padding: 0; overflow: hidden; margin-bottom: 32px;">
        <div style="padding: 20px 24px; border-bottom: 1px solid var(--p-border); display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h3 style="font-size: 1.15rem; margin: 0 0 2px;">Security & Operational Audit Trail</h3>
                <p style="color: var(--p-text-muted); font-size: 12px; margin: 0;">Immutable audit log of all administrative actions and security events</p>
            </div>
            <span class="status-badge" style="background: rgba(255,255,255,0.06); color: var(--p-text-muted);">
                @(Model.AuditTrail?.Count ?? 0) recorded events
            </span>
        </div>

        @if (Model.AuditTrail?.Any() == true)
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--p-border); background: var(--p-surface-alt); color: var(--p-text-muted); font-size: 12px; text-transform: uppercase;">
                            <th style="padding: 14px 24px;">Timestamp (UTC)</th>
                            <th style="padding: 14px 16px;">Event Type</th>
                            <th style="padding: 14px 16px;">Actor</th>
                            <th style="padding: 14px 24px;">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var audit in Model.AuditTrail)
                        {
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
                                <td style="padding: 14px 24px; font-family: monospace; font-size: 12px; color: var(--p-text-muted); white-space: nowrap;">
                                    @audit.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                                </td>
                                <td style="padding: 14px 16px;">
                                    <span class="code-font" style="color: #4ade80; font-size: 12px; font-weight: 600;">@audit.ActionType</span>
                                </td>
                                <td style="padding: 14px 16px; font-size: 13px;">@audit.ActorEmail</td>
                                <td style="padding: 14px 24px; font-size: 13px; color: var(--p-text-muted);">@audit.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding: 32px 24px; text-align: center; color: var(--p-text-muted); font-size: 13px;">
                Audit records will populate automatically as administrative actions are performed.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Auto-refresh health every 60 seconds
        setInterval(() => {
            fetch(window.location.href, { method: 'GET', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        }, 60000);
    </script>
}
