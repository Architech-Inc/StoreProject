@page
@model Store.TenantPortal.Pages.RegisterModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="portal-auth-container">
    <div class="portal-card" style="padding: 36px 32px;">
        <div style="text-align: center; margin-bottom: 28px;">
            <h2 style="font-size: 1.8rem; margin-bottom: 6px;">Create your account</h2>
            <p style="color: var(--p-text-muted); font-size: 0.9rem; margin: 0;">Start managing your isolated multi-branch store</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="portal-alert danger">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form method="post">
            <div class="form-group">
                <label asp-for="Input.FullName" class="form-label"></label>
                <input asp-for="Input.FullName" class="portal-input" placeholder="e.g. Alice Walker" required />
                <span asp-validation-for="Input.FullName" style="color: var(--p-danger); font-size: 12px;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" type="email" class="portal-input" placeholder="name@company.com" required />
                <span asp-validation-for="Input.Email" style="color: var(--p-danger); font-size: 12px;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" type="password" class="portal-input" placeholder="Min. 8 characters" required />
                <span asp-validation-for="Input.Password" style="color: var(--p-danger); font-size: 12px;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" type="password" class="portal-input" placeholder="Repeat your password" required />
                <span asp-validation-for="Input.ConfirmPassword" style="color: var(--p-danger); font-size: 12px;"></span>
            </div>

            <div class="form-group" style="display: flex; align-items: flex-start; gap: 10px; margin-top: 24px;">
                <input asp-for="Input.AcceptTerms" type="checkbox" id="termsCheck" style="margin-top: 4px; accent-color: var(--p-green);" required />
                <label for="termsCheck" style="font-size: 13px; color: var(--p-text-muted); cursor: pointer;">
                    I agree to the <a href="#" style="color: var(--p-green); text-decoration: none;">Terms of Service</a> and <a href="#" style="color: var(--p-green); text-decoration: none;">Privacy Policy</a>.
                </label>
            </div>

            <button type="submit" class="btn-primary-glow" style="width: 100%; margin-top: 16px;">
                Create Portal Account &rarr;
            </button>
        </form>

        <div style="text-align: center; margin-top: 24px; font-size: 13px; color: var(--p-text-muted);">
            Already have an account? <a href="/Login" style="color: var(--p-green); text-decoration: none; font-weight: 600;">Sign in</a>
        </div>
    </div>
</div>
