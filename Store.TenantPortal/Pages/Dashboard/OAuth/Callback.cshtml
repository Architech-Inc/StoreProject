@page
@model Store.TenantPortal.Pages.Dashboard.OAuth.CallbackModel
@{
    ViewData["Title"] = "OAuth Authentication";
    Layout = "_DashboardLayout";
}

<div class="dashboard-header">
    <div>
        <h1 class="dashboard-title">Cloud Storage Connection</h1>
        <p class="dashboard-subtitle">Completing your OAuth 2.0 authentication.</p>
    </div>
</div>

<div class="portal-grid">
    <div class="portal-card" style="grid-column: 1 / -1;">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="portal-alert danger" style="margin-bottom: 20px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span>@Model.ErrorMessage</span>
            </div>
            
            <a href="/Dashboard/Backups" class="btn-glass">Return to Backups</a>
        }
        else
        {
            <div style="text-align: center; padding: 40px 20px;">
                <svg class="animate-spin" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-bottom: 20px; color: var(--primary-color);">
                    <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                    <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path>
                </svg>
                <h2 style="font-size: 1.5rem; margin-bottom: 8px;">Authenticating...</h2>
                <p style="color: var(--p-text-muted);">Please wait while we establish a secure connection with your provider.</p>
            </div>
        }
    </div>
</div>
