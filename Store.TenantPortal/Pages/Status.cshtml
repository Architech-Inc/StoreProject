@page "/Status/{slug}"
@model Store.TenantPortal.Pages.StatusModel
@{
    ViewData["Title"] = Model.Status is not null
        ? $"{Model.Status.Name} — Status"
        : "Tenant status";
}

<div class="tenant-status-page" style="max-width: 760px; margin: 48px auto; padding: 24px; background: var(--surface, #fff); border: 1px solid var(--border, #e5e7eb); border-radius: var(--radius-lg, 12px); box-shadow: var(--shadow-md, 0 4px 12px rgba(0,0,0,0.05));">

    @if (Model.TenantNotFound)
    {
        <h1 style="margin-top: 0; font-size: 1.5rem; color: var(--text-primary, #111827);">Tenant not found</h1>
        <p style="color: var(--text-secondary, #4b5563);">
            We couldn't find a tenant for the slug
            <code style="background: #f3f4f6; padding: 2px 6px; border-radius: 4px;">@Model.Slug</code>.
            Double-check the URL or contact your platform administrator.
        </p>
    }
    else if (Model.Status is null)
    {
        <h1 style="margin-top: 0;">Unable to load status</h1>
        <p>The status service is temporarily unavailable. Please retry in a few moments.</p>
    }
    else
    {
        <header style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px;">
            <div>
                <h1 style="margin: 0; font-size: 1.5rem; color: var(--text-primary, #111827);">@Model.Status.Name</h1>
                <div style="color: var(--text-secondary, #6b7280); font-size: 0.875rem; margin-top: 4px;">
                    <code style="background: #f3f4f6; padding: 2px 6px; border-radius: 4px;">@Model.Status.Slug</code>
                    · Status: @Model.Status.Status
                </div>
            </div>
            <div class="status-pill"
                 style="padding: 6px 14px; border-radius: 999px; font-size: 0.875rem; font-weight: 600;
                        background: @(Model.Status.IsHealthy ? "#d1fae5" : "#fee2e2");
                        color: @(Model.Status.IsHealthy ? "#065f46" : "#991b1b");">
                @(Model.Status.IsHealthy ? "● Operational" : "● Issues detected")
            </div>
        </header>

        @if (!Model.Status.IsAcceptingTraffic && Model.Status.ActiveMaintenance.Any())
        {
            <div role="alert"
                 style="padding: 12px 16px; background: #fef2f2; color: #991b1b; border-radius: 8px; margin-bottom: 16px;">
                <strong>Maintenance in progress.</strong>
                This tenant may experience partial or full outages until the window closes.
            </div>
        }

        @if (Model.Status.LastHealthCheckUtc.HasValue)
        {
            <p style="color: var(--text-secondary, #6b7280); font-size: 0.875rem; margin-bottom: 24px;">
                Last health check at @Model.Status.LastHealthCheckUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC
                @if (!string.IsNullOrEmpty(Model.Status.LastHealthMessage))
                {
                    <span> — @Model.Status.LastHealthMessage</span>
                }
            </p>
        }

        <section aria-labelledby="active-maintenance">
            <h2 id="active-maintenance" style="font-size: 1.125rem; margin: 24px 0 8px;">Active maintenance</h2>
            @if (!Model.Status.ActiveMaintenance.Any())
            {
                <p style="color: var(--text-secondary, #6b7280); font-size: 0.95rem;">No maintenance windows are currently in progress.</p>
            }
            else
            {
                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
                    @foreach (var w in Model.Status.ActiveMaintenance)
                    {
                        <li style="padding: 12px; border: 1px solid var(--border, #e5e7eb); border-radius: 8px; background: #fffbeb;">
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                <span style="padding: 2px 8px; border-radius: 999px; font-size: 0.75rem; font-weight: 600;
                                             background: @(w.Severity == "Critical" ? "#fee2e2" : w.Severity == "Warning" ? "#fef3c7" : "#dbeafe");
                                             color: @(w.Severity == "Critical" ? "#991b1b" : w.Severity == "Warning" ? "#92400e" : "#1e3a8a");">
                                    @w.Severity
                                </span>
                                <strong>@w.Title</strong>
                            </div>
                            @if (!string.IsNullOrEmpty(w.Description))
                            {
                                <p style="margin: 4px 0; color: var(--text-secondary, #374151);">@w.Description</p>
                            }
                            <p style="margin: 4px 0; font-size: 0.85rem; color: var(--text-secondary, #6b7280);">
                                Started @w.StartUtc.ToString("yyyy-MM-dd HH:mm") UTC — expected to end by @w.EndUtc.ToString("yyyy-MM-dd HH:mm") UTC
                            </p>
                        </li>
                    }
                </ul>
            }
        </section>

        <section aria-labelledby="upcoming-maintenance">
            <h2 id="upcoming-maintenance" style="font-size: 1.125rem; margin: 24px 0 8px;">Upcoming maintenance</h2>
            @if (!Model.Status.UpcomingMaintenance.Any())
            {
                <p style="color: var(--text-secondary, #6b7280); font-size: 0.95rem;">No upcoming maintenance scheduled.</p>
            }
            else
            {
                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
                    @foreach (var w in Model.Status.UpcomingMaintenance)
                    {
                        <li style="padding: 12px; border: 1px solid var(--border, #e5e7eb); border-radius: 8px;">
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                <span style="padding: 2px 8px; border-radius: 999px; font-size: 0.75rem; font-weight: 600;
                                             background: @(w.Severity == "Critical" ? "#fee2e2" : w.Severity == "Warning" ? "#fef3c7" : "#dbeafe");
                                             color: @(w.Severity == "Critical" ? "#991b1b" : w.Severity == "Warning" ? "#92400e" : "#1e3a8a");">
                                    @w.Severity
                                </span>
                                <strong>@w.Title</strong>
                            </div>
                            @if (!string.IsNullOrEmpty(w.Description))
                            {
                                <p style="margin: 4px 0; color: var(--text-secondary, #374151);">@w.Description</p>
                            }
                            <p style="margin: 4px 0; font-size: 0.85rem; color: var(--text-secondary, #6b7280);">
                                Scheduled @w.StartUtc.ToString("yyyy-MM-dd HH:mm") UTC → @w.EndUtc.ToString("yyyy-MM-dd HH:mm") UTC
                            </p>
                        </li>
                    }
                </ul>
            }
        </section>

        @if (Model.Status.RecentMaintenance.Any())
        {
            <section aria-labelledby="recent-maintenance">
                <h2 id="recent-maintenance" style="font-size: 1.125rem; margin: 24px 0 8px;">Recent maintenance (last 30 days)</h2>
                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
                    @foreach (var w in Model.Status.RecentMaintenance)
                    {
                        <li style="padding: 12px; border: 1px solid var(--border, #e5e7eb); border-radius: 8px; opacity: 0.85;">
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                <span style="padding: 2px 8px; border-radius: 999px; font-size: 0.75rem; font-weight: 600;
                                             background: #f3f4f6; color: #4b5563;">@w.Severity</span>
                                <strong>@w.Title</strong>
                                @if (w.IsResolved)
                                {
                                    <span style="font-size: 0.75rem; color: #065f46;">(resolved)</span>
                                }
                            </div>
                            <p style="margin: 4px 0; font-size: 0.85rem; color: var(--text-secondary, #6b7280);">
                                Ended @w.EndUtc.ToString("yyyy-MM-dd HH:mm") UTC
                            </p>
                        </li>
                    }
                </ul>
            </section>
        }

        <footer style="margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border, #e5e7eb); color: var(--text-secondary, #6b7280); font-size: 0.75rem;">
            Generated at @Model.Status.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC · Public status page (MT-07) · No authentication required.
        </footer>
    }
</div>