@page "/OnboardingStatus"
@model Store.TenantPortal.Pages.OnboardingStatusModel
@{
    ViewData["Title"] = "Provisioning in progress";
    ViewData["ActivePage"] = "Onboarding";
}

<div class="onboarding-status-page" style="max-width: 720px; margin: 48px auto; padding: 24px; background: var(--surface, #fff); border: 1px solid var(--border, #e5e7eb); border-radius: var(--radius-lg, 12px); box-shadow: var(--shadow-md, 0 4px 12px rgba(0,0,0,0.05));">
    <h1 style="margin-top: 0; font-size: 1.5rem; color: var(--text-primary, #111827);">
        Provisioning your store
    </h1>

    <p style="color: var(--text-secondary, #4b5563); margin-bottom: 24px;">
        We're spinning up your containers, DNS records, and TLS. This usually takes 30–90 seconds.
        You don't need to stay on this page — we'll email you when your store is live.
    </p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div role="alert" style="padding: 12px 16px; background: var(--error-bg, #fef2f2); color: var(--error, #991b1b); border-radius: 8px; margin-bottom: 16px;">
            @Model.ErrorMessage
        </div>
    }

    @if (Model.Job is not null)
    {
        <div data-job-id="@Model.JobId" data-status="@Model.Job.Status" aria-live="polite" aria-atomic="false">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                <div class="status-pill status-@Model.Job.Status.ToLowerInvariant()"
                     style="padding: 4px 12px; border-radius: 999px; font-size: 0.875rem; font-weight: 600;
                            background: @(Model.Job.Status == "Completed" ? "#d1fae5" :
                                       Model.Job.Status == "Failed" ? "#fee2e2" :
                                       Model.Job.Status == "InProgress" ? "#dbeafe" : "#fef3c7");
                            color: @(Model.Job.Status == "Completed" ? "#065f46" :
                                    Model.Job.Status == "Failed" ? "#991b1b" :
                                    Model.Job.Status == "InProgress" ? "#1e3a8a" : "#92400e");">
                    @Model.Job.Status
                </div>
                @if (!string.IsNullOrEmpty(Model.Job.StatusDetail))
                {
                    <span style="color: var(--text-secondary, #6b7280); font-size: 0.875rem;">
                        @Model.Job.StatusDetail
                    </span>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Job.FailureReason))
            {
                <div role="alert" style="padding: 12px 16px; background: #fef2f2; color: #991b1b; border-radius: 8px; margin-bottom: 16px;">
                    <strong>Provisioning failed:</strong> @Model.Job.FailureReason
                </div>
                <form method="post" asp-page-handler="Retry" style="margin-top: 16px;">
                    <input type="hidden" asp-for="JobId" />
                    <input type="hidden" asp-for="Slug" />
                    <button type="submit" class="button-primary"
                            style="padding: 10px 20px; background: var(--primary, #4f46e5); color: white; border: 0; border-radius: 8px; cursor: pointer;">
                        Retry provisioning
                    </button>
                </form>
            }
        </div>

        @if (Model.Job.Status == "Pending" || Model.Job.Status == "InProgress")
        {
            <div aria-hidden="true" style="margin-top: 16px; height: 6px; background: #f3f4f6; border-radius: 999px; overflow: hidden;">
                <div class="progress-bar-indeterminate"
                     style="height: 100%; width: 30%; background: var(--primary, #4f46e5); border-radius: 999px;
                            animation: onboarding-status-progress 1.2s ease-in-out infinite;"></div>
            </div>
            <style>
                @@keyframes onboarding-status-progress {
                    0% { transform: translateX(-100%); }
                    100% { transform: translateX(450%); }
                }
            </style>

            <noscript>
                <p style="margin-top: 12px; color: var(--text-secondary, #6b7280);">
                    JavaScript is required for live updates. Refresh this page to check progress.
                </p>
            </noscript>

            <p style="margin-top: 16px; color: var(--text-secondary, #6b7280); font-size: 0.875rem;">
                Job ID: <code style="background: #f3f4f6; padding: 2px 6px; border-radius: 4px;">@Model.JobId</code>
            </p>
        }
    }
</div>

@section Scripts {
    <script>
        (function () {
            const poll = document.querySelector('[data-job-id]');
            if (!poll) return;
            const jobId = poll.dataset.jobId;

            let stopped = false;
            async function tick() {
                if (stopped) return;
                try {
                    const res = await fetch(`?handler=Poll&jobId=${jobId}`, { credentials: 'include' });
                    if (!res.ok) { setTimeout(tick, 5000); return; }
                    const data = await res.json();
                    if (data.status === 'Completed') {
                        window.location.href = '/Dashboard';
                        return;
                    }
                    if (data.status === 'Failed') {
                        // Refresh page so the retry button renders server-side.
                        window.location.reload();
                        return;
                    }
                    setTimeout(tick, 3000);
                } catch (e) {
                    setTimeout(tick, 5000);
                }
            }
            // Poll every 3s while status is Pending/InProgress.
            setTimeout(tick, 3000);
            window.addEventListener('beforeunload', () => { stopped = true; });
        })();
    </script>
}
