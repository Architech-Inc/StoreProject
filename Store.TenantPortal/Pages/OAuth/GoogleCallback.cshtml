@page "/oauth/google/callback"
@model Store.TenantPortal.Pages.OAuth.GoogleCallbackModel
@{
    ViewData["Title"] = "Connecting Google Drive...";
}

<div class="portal-container" style="display: flex; justify-content: center; align-items: center; min-height: 60vh;">
    <div class="portal-card" style="max-width: 460px; text-align: center; padding: 40px 30px;">
        @if (Model.IsSuccess)
        {
            <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(1, 156, 1, 0.15); color: #4ade80; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <h2 style="font-size: 1.4rem; margin-bottom: 8px;">Google Drive Connected</h2>
            <p style="color: var(--p-text-muted); font-size: 0.9rem; margin-bottom: 24px;">
                @Model.Message
            </p>
            <a href="/Backups" class="btn-primary-glow" style="display: inline-block;">Return to Backups &rarr;</a>
        }
        else
        {
            <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(239, 68, 68, 0.15); color: #f87171; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
            </div>
            <h2 style="font-size: 1.4rem; margin-bottom: 8px;">Connection Failed</h2>
            <p style="color: #f87171; font-size: 0.9rem; margin-bottom: 24px;">
                @Model.Message
            </p>
            <a href="/Backups" class="btn-glass" style="display: inline-block;">Back to Backups</a>
        }
    </div>
</div>
