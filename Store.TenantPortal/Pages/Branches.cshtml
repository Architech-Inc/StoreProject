@page
@model Store.TenantPortal.Pages.BranchesModel
@{
    ViewData["Title"] = "Branch Subdomain Routing";
}

<div class="portal-container">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="font-size: 2rem; margin-bottom: 6px;">Branch Subdomain Routing</h1>
            <p style="color: var(--p-text-muted); font-size: 0.95rem; margin: 0;">
                Assign dedicated subdomains to physical store locations (e.g. <span class="code-font" style="color: #4ade80;">hq.acme.store.clexan.com</span> or <span class="code-font" style="color: #4ade80;">hq.acmefoods.com</span>).
            </p>
        </div>

        <button type="button" class="btn-primary-glow" onclick="document.getElementById('addBranchModal').style.display='flex';" style="font-size: 13px;">
            + Map New Branch Subdomain
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.FeedbackMessage))
    {
        <div class="portal-alert @(Model.IsError ? "danger" : "success") auto-dismiss">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@Model.FeedbackMessage</span>
        </div>
    }

    <!-- Branches Table Card -->
    <div class="portal-card" style="padding: 0; overflow: hidden;">
        <div style="padding: 20px 24px; border-bottom: 1px solid var(--p-border); display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 1.15rem; margin: 0;">Configured Branch Subdomains</h3>
            <span style="font-size: 13px; color: var(--p-text-muted);">@Model.Branches.Count @(Model.Branches.Count == 1 ? "branch" : "branches") active</span>
        </div>

        @if (Model.Branches.Any())
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--p-border); background: var(--p-surface-alt); color: var(--p-text-muted); font-size: 12px; text-transform: uppercase;">
                            <th style="padding: 14px 24px;">Branch Name</th>
                            <th style="padding: 14px 16px;">Type</th>
                            <th style="padding: 14px 16px;">Resolved Subdomain</th>
                            <th style="padding: 14px 16px;">Status</th>
                            <th style="padding: 14px 24px; text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Branches)
                        {
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.04); transition: background 0.2s ease;">
                                <td style="padding: 16px 24px; font-weight: 600;">@b.BranchName</td>
                                <td style="padding: 16px 16px;">
                                    <span style="font-size: 12px; color: var(--p-text-muted);">@b.DomainType</span>
                                </td>
                                <td style="padding: 16px 16px;">
                                    <a href="@b.ResolvedUrl" target="_blank" class="code-font" style="color: #4ade80; text-decoration: none;">
                                        @b.ResolvedUrl &nearr;
                                    </a>
                                </td>
                                <td style="padding: 16px 16px;">
                                    @if (b.VerificationStatus == "Verified")
                                    {
                                        <span class="status-badge healthy">
                                            <span class="status-dot healthy"></span> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge warning">
                                            <span class="status-dot warning"></span> Pending DNS
                                        </span>
                                    }
                                </td>
                                <td style="padding: 16px 24px; text-align: right;">
                                    <div style="display: flex; justify-content: flex-end; gap: 8px;">
                                        @if (b.VerificationStatus != "Verified")
                                        {
                                            <form method="post" asp-page-handler="VerifyBranch" asp-route-branchId="@b.BranchId">
                                                <button type="submit" class="btn-glass" style="padding: 4px 10px; font-size: 12px;">Verify</button>
                                            </form>
                                        }
                                        <form method="post" asp-page-handler="RemoveBranch" asp-route-branchId="@b.BranchId" onsubmit="return confirm('Remove branch subdomain mapping?');">
                                            <button type="submit" class="btn-danger-glass" style="padding: 4px 10px; font-size: 12px;">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding: 48px 24px; text-align: center; color: var(--p-text-muted);">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 12px; opacity: 0.5;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div style="font-size: 15px; font-weight: 600; color: #fff; margin-bottom: 4px;">No branch subdomains mapped</div>
                <div style="font-size: 13px; max-width: 400px; margin: 0 auto 20px;">
                    Map your physical stores (HQ, Northgate, Downtown) to dedicated subdomains for seamless cashier and manager entry.
                </div>
                <button type="button" class="btn-primary-glow" onclick="document.getElementById('addBranchModal').style.display='flex';" style="font-size: 13px;">
                    + Map First Branch
                </button>
            </div>
        }
    </div>
</div>

<!-- Add Branch Modal Dialog -->
<div id="addBranchModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(8px); z-index: 9999; justify-content: center; align-items: center; padding: 20px;">
    <div class="portal-card" style="width: 100%; max-width: 520px; background: rgba(10, 16, 11, 0.95); border: 1px solid var(--p-border-hover); box-shadow: 0 20px 50px rgba(0,0,0,0.6);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 style="font-size: 1.3rem; margin: 0;">Map Branch Subdomain</h3>
            <button type="button" onclick="document.getElementById('addBranchModal').style.display='none';" style="background: transparent; border: none; color: var(--p-text-muted); cursor: pointer; font-size: 20px;">&times;</button>
        </div>

        <form method="post" asp-page-handler="AddBranch">
            <div class="form-group">
                <label class="form-label">Branch Name</label>
                <input name="BranchName" class="portal-input" placeholder="e.g. Headquarters / Flagship Store" required />
            </div>

            <div class="form-group">
                <label class="form-label">Branch Slug / Prefix</label>
                <input name="BranchSlug" id="newBranchSlug" class="portal-input" placeholder="e.g. hq or northgate" required />
            </div>

            <div class="form-group">
                <label class="form-label">Subdomain Architecture</label>
                <select name="DomainType" id="newBranchType" class="portal-input" style="cursor: pointer;">
                    <option value="Platform">Platform Subdomain ([branch].[slug].store.clexan.com)</option>
                    <option value="Custom">Custom Subdomain ([branch].[your-custom-domain])</option>
                </select>
            </div>

            <div style="background: var(--p-surface-alt); padding: 12px; border-radius: 10px; border: 1px solid var(--p-border); margin-bottom: 24px; font-size: 12px;">
                <div style="color: var(--p-text-muted);">Target Resolved URL:</div>
                <div class="code-font" style="color: #4ade80; font-size: 13px; margin-top: 2px;">
                    https://<span id="previewBranchSlug">hq</span>.@(Model.Session?.TenantSlug).store.clexan.com
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="btn-glass" onclick="document.getElementById('addBranchModal').style.display='none';">Cancel</button>
                <button type="submit" class="btn-primary-glow">Map Subdomain &rarr;</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const slugInput = document.getElementById('newBranchSlug');
        const preview = document.getElementById('previewBranchSlug');
        if (slugInput && preview) {
            slugInput.addEventListener('input', () => {
                const val = slugInput.value.trim().toLowerCase().replace(/[^a-z0-9-]/g, '-');
                slugInput.value = val;
                preview.innerText = val || 'branch';
            });
        }
    </script>
}
