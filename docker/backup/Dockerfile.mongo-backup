FROM alpine:3.19

RUN apk add --no-cache \
    mongodb-tools \
    gzip \
    aws-cli \
    tzdata \
    dcron

WORKDIR /app

COPY mongo-backup.sh /app/mongo-backup.sh
RUN chmod +x /app/mongo-backup.sh

# Configure default cron (daily at 02:30 UTC)
ENV CRON_SCHEDULE="30 2 * * *"

ENTRYPOINT ["sh", "-c", "echo \"$CRON_SCHEDULE /app/mongo-backup.sh >> /var/log/cron.log 2>&1\" > /etc/crontabs/root && touch /var/log/cron.log && crond -b -l 8 && tail -f /var/log/cron.log"]
