# =============================================================================
# StoreProject Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to `.env` in the repository root or deployment directory.
# NEVER commit the active `.env` file containing production secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Edge Proxy (Traefik) Configuration (OPS-03)
# -----------------------------------------------------------------------------
# Set to `true` ONLY on local development to expose the Traefik dashboard.
# In production, NEVER enable the Traefik dashboard (defaults to false).
TRAEFIK_API_ENABLED=false
TRAEFIK_DASHBOARD_PORT=8080

# -----------------------------------------------------------------------------
# 2. Production Domain & Networking Settings (OPS-10)
# -----------------------------------------------------------------------------
# Hardcoded VPS IPs are eliminated. Configure DNS hostnames or local wildcard domains.
# Local Dev / Testing: store.127.0.0.1.nip.io / api.store.127.0.0.1.nip.io
# Production:          store.yourcompany.com / api.store.yourcompany.com
STORE_DOMAIN=store.127.0.0.1.nip.io
API_DOMAIN=api.store.127.0.0.1.nip.io
ROOT_DOMAIN=store.127.0.0.1.nip.io
HTTP_PORT=18080
HTTPS_PORT=18443

# -----------------------------------------------------------------------------
# 3. Platform & ControlPlane Orchestration Settings
# -----------------------------------------------------------------------------
IMAGE_PREFIX=ghcr.io/architech-inc/storeproject
IMAGE_TAG=latest
CONTROLPLANE_DB_CONNECTION_STRING=Server=store-controlplane-db;Port=3306;Database=store_controlplane;User Id=root;Password=OVERRIDE_ME__CONTROLPLANE_DB_ROOT_PASSWORD;
CONTROLPLANE_DB_ROOT_PASSWORD=OVERRIDE_ME__CONTROLPLANE_DB_ROOT_PASSWORD
CONTROLPLANE_MASTER_KEY=OVERRIDE_ME__MIN_32_CHAR_MASTER_KEY_2026
CONTROLPLANE_WEBHOOK_SIGNING_SECRET=OVERRIDE_ME__WEBHOOK_SIGNING_SECRET_KEY

# -----------------------------------------------------------------------------
# 4. Production Tenant Stack — Database Credentials & Connection Strings
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=OVERRIDE_ME__MYSQL_ROOT_PASSWORD
MYSQL_USER=store_user
MYSQL_PASSWORD=OVERRIDE_ME__MYSQL_USER_PASSWORD
MYSQL_DATABASE=store_db_v2

MONGO_INITDB_ROOT_USERNAME=store_mongo_admin
MONGO_INITDB_ROOT_PASSWORD=OVERRIDE_ME__MONGO_PASSWORD

STORE_CONNECTION_STRING=Server=store-mysql;Port=3306;Database=store_db_v2;User Id=store_user;Password=OVERRIDE_ME__MYSQL_USER_PASSWORD;
STORE_MONGO_CONNECTION_STRING=mongodb://store_mongo_admin:OVERRIDE_ME__MONGO_PASSWORD@store-mongodb:27017/?authSource=admin

# -----------------------------------------------------------------------------
# 5. Production Tenant Stack — Application Security & Cryptographic Secrets
# -----------------------------------------------------------------------------
# JWT secret must be >= 32 characters
STORE_JWT_SECRET=OVERRIDE_ME__JWT_SECRET_KEY_AT_LEAST_32_CHARS_LONG
# HMAC OTP pepper secret must be >= 32 characters
STORE_OTP_PEPPER=OVERRIDE_ME__HMAC_OTP_PEPPER_KEY_32_CHARS
# MoMo callback HMAC secret must be >= 32 characters
STORE_MOMO_CALLBACK_KEY=OVERRIDE_ME__MOMO_HMAC_CALLBACK_KEY_32_CHARS

# -----------------------------------------------------------------------------
# 6. Database Backup & Cloud Storage Configuration (OPS-02 / OPS-12)
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
MYSQL_BACKUP_CRON=0 2 * * *
MONGO_BACKUP_CRON=30 2 * * *
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# 7. Automated Production TLS & Let's Encrypt (ACME) Settings (OPS-05)
# -----------------------------------------------------------------------------
# Operator email used by Let's Encrypt for certificate registration and expiration alerts.
ACME_EMAIL=admin@yourcompany.com
# Directory URL for the ACME certificate authority:
# Production: https://acme-v02.api.letsencrypt.org/directory
# Staging:    https://acme-staging-v02.api.letsencrypt.org/directory (testing without rate limits)
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# -----------------------------------------------------------------------------
# 8. Watchtower Container Image Update Automation (OPS-06)
# -----------------------------------------------------------------------------
# Cron schedule for automated container image checks (default: daily at 04:00 AM UTC).
WATCHTOWER_SCHEDULE=0 0 4 * * *
# Remove old images after updating to conserve VPS storage.
WATCHTOWER_CLEANUP=true
# Check and update stopped containers in addition to running ones.
WATCHTOWER_INCLUDE_STOPPED=true
# Only update containers explicitly flagged with label `com.centurylinklabs.watchtower.enable=true` (never databases).
WATCHTOWER_LABEL_ENABLE=true
# Perform rolling container restarts sequentially.
WATCHTOWER_ROLLING_RESTART=true
# Stalled container shutdown timeout.
WATCHTOWER_TIMEOUT=60s

# -----------------------------------------------------------------------------
# 9. Centralized Structured Logging & Observability (Seq / OPS-07)
# -----------------------------------------------------------------------------
# Ingestion endpoint for Seq log collector (empty disables remote shipping).
SEQ_SERVER_URL=http://store-seq:5341
# Initial administrator password hash for Seq web dashboard (optional, empty prompts setup on first visit).
SEQ_ADMIN_PASSWORD_HASH=
# Optional Seq API key for restricted ingestion.
SEQ_API_KEY=

