# Dev-mode Traefik settings — copy this file to `.env` next to docker-compose.traefik.yml.
# In production, NEVER enable the Traefik dashboard (OPS-03).

# Set to `true` only on a local laptop to expose the Traefik dashboard on :8080.
# Defaults to `false` (production-safe).
TRAEFIK_API_ENABLED=false

# Port mapping for the dashboard. Ignored unless TRAEFIK_API_ENABLED=true.
TRAEFIK_DASHBOARD_PORT=8080
